# Claude Code worktrees (created by /batch and agent isolation)
.claude/worktrees/

# Serena MCP server working directory (project cache/memories — tool artifact)
.serena/

# Build outputs
**/bin/
**/obj/
**/TestResults/

# User-specific files
*.user
*.suo
.vs/

# NuGet
*.nupkg
**/packages/

# Rust build artifacts
lucid-native/target/

# OS
Thumbs.db
.DS_Store

# Generated release artifacts (~740 MB locally). The two JSON contract files are
# repo-tracked source consumed by scripts/validate-release-*.ps1 — keep them visible.
release/*
!release/release-metadata.json
!release/release-operations.json
# The symbol store (symbolPolicy.storePath) must exist on fresh checkouts/CI —
# validate-release-operations.ps1 requires the directory. Track an empty
# placeholder while still ignoring the retained PDBs published into it.
!release/symbols/
release/symbols/*
!release/symbols/.gitkeep
