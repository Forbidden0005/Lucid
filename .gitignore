# Claude Code worktrees (created by /batch and agent isolation)
.claude/worktrees/

# Serena MCP server working directory (project cache/memories — tool artifact)
.serena/

# Build outputs
**/bin/
**/obj/
**/TestResults/

# User-specific files
*.user
*.suo
.vs/

# NuGet
*.nupkg
**/packages/

# Rust build artifacts
lucid-native/target/

# OS
Thumbs.db
.DS_Store

# Generated release artifacts (~740 MB locally). The two JSON contract files are
# repo-tracked source consumed by scripts/validate-release-*.ps1 — keep them visible.
# The symbol store directory must exist for validate-release-operations.ps1 to pass
# on a fresh checkout/CI; its contents (actual symbols) stay ignored via the .gitkeep.
release/*
!release/release-metadata.json
!release/release-operations.json
# Track the symbol-store directory via its .gitkeep placeholder only; the actual
# retained PDBs published into it stay ignored.
!release/symbols/
release/symbols/*
!release/symbols/.gitkeep
