<win:Window
    x:Class="ExplainMyPC.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:win="using:Microsoft.UI.Xaml"
    mc:Ignorable="d"
    Title="ExplainMyPC">

    <Grid Background="#0F1115">

        <NavigationView
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            Background="#171A21"
            CompactPaneLength="60"
            OpenPaneLength="220">

            <NavigationView.PaneHeader>
                <StackPanel Margin="12">
                    <TextBlock
                        Text="ExplainMyPC"
                        FontSize="24"
                        FontWeight="SemiBold"
                        Foreground="White"/>
                </StackPanel>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>

                <NavigationViewItem Content="Dashboard"/>
                <NavigationViewItem Content="Explain My PC"/>
                <NavigationViewItem Content="Security"/>
                <NavigationViewItem Content="Processes"/>
                <NavigationViewItem Content="Storage"/>
                <NavigationViewItem Content="Apps"/>
                <NavigationViewItem Content="Privacy"/>
                <NavigationViewItem Content="Repairs"/>
                <NavigationViewItem Content="Settings"/>

            </NavigationView.MenuItems>

            <Grid Padding="32">

                <StackPanel Spacing="24">

                    <TextBlock
                        Text="Dashboard"
                        FontSize="36"
                        FontWeight="Bold"
                        Foreground="White"/>

                    <Border
                        Background="#1E2430"
                        CornerRadius="16"
                        Padding="24">

                        <StackPanel>

                            <TextBlock
                                Text="System Health"
                                FontSize="18"
                                Foreground="#AAB2C0"/>

                            <TextBlock
                                Text="87"
                                FontSize="64"
                                FontWeight="Bold"
                                Foreground="#4EA1FF"/>

                            <TextBlock
                                Text="Good"
                                FontSize="20"
                                Foreground="#57D68D"/>

                        </StackPanel>

                    </Border>

                    <Grid ColumnSpacing="16">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Background="#1E2430"
                            CornerRadius="16"
                            Padding="20">

                            <StackPanel>

                                <TextBlock
                                    Text="CPU Usage"
                                    Foreground="#AAB2C0"/>

                                <TextBlock
                                    Text="24%"
                                    FontSize="32"
                                    FontWeight="SemiBold"
                                    Foreground="White"/>

                            </StackPanel>

                        </Border>

                        <Border
                            Grid.Column="1"
                            Background="#1E2430"
                            CornerRadius="16"
                            Padding="20">

                            <StackPanel>

                                <TextBlock
                                    Text="Memory Usage"
                                    Foreground="#AAB2C0"/>

                                <TextBlock
                                    Text="58%"
                                    FontSize="32"
                                    FontWeight="SemiBold"
                                    Foreground="White"/>

                            </StackPanel>

                        </Border>

                    </Grid>

                </StackPanel>

            </Grid>

        </NavigationView>

    </Grid>

</win:Window>