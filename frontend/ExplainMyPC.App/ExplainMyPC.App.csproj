    <!-- Future feature code — excluded until ready to wire up -->
    <Compile Remove="Controls\**" />
    <Compile Remove="Intelligence\**" />
    <Compile Remove="Core\**" />
    <Compile Remove="Models\**" />
    <None Include="Controls\**" />
    <None Include="Intelligence\**" />
    <None Include="Core\**" />
    <None Include="Models\**" />
  </ItemGroup>

  <!-- Exclude custom controls XAML (they reference excluded code) -->
  <ItemGroup>
    <Page Remove="Controls\**" />
  </ItemGroup>

</Project>
