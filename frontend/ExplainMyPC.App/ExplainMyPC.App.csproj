<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>ExplainMyPC</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!--
      Disable XBind diagnostics on CLI builds.
      The 2-pass XAML pipeline (Pass1 → XamlPreCompile → Pass2) requires an
      intermediate DLL that only VS design-time builds produce. Disabling this
      lets dotnet build complete cleanly; x:Bind still works at runtime.
      Visual Studio re-enables it automatically via its own build path.
    -->
    <EnableXBindDiagnostics>false</EnableXBindDiagnostics>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinUI 3 via Windows App SDK -->
