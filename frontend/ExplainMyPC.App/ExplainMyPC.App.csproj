    <None Include="Services\**"
          Exclude="Services\ITelemetryService.cs;Services\ITelemetryHistoryBuffer.cs;Services\WindowsTelemetryService.cs;Services\TelemetryHistoryBuffer.cs;Services\Telemetry\TelemetryHistory.cs;Services\Telemetry\Samplers\CpuSampler.cs;Services\Telemetry\Samplers\RamSampler.cs;Services\Telemetry\Samplers\GpuSampler.cs;Services\Telemetry\Samplers\DiskSampler.cs;Services\Telemetry\Samplers\ThermalSampler.cs;Services\Telemetry\Samplers\ProcessSampler.cs;Services\Intelligence\SystemInsight.cs;Services\Intelligence\SystemAction.cs;Services\Intelligence\IInsightRule.cs;Services\Intelligence\ISynthesisRule.cs;Services\Intelligence\InsightSynthesisEngine.cs;Services\Intelligence\TrendAnalysis.cs;Services\Intelligence\ISystemInsightEngine.cs;Services\Intelligence\SystemInsightEngine.cs;Services\Intelligence\ProcessAttribution.cs;Services\Intelligence\ProcessAttributionHelper.cs;Services\Intelligence\Rules\SustainedHighCpuRule.cs;Services\Intelligence\Rules\ElevatedRamPressureRule.cs;Services\Intelligence\Rules\AbnormalGpuUsageRule.cs;Services\Intelligence\Rules\LowDiskSpaceRule.cs;Services\Intelligence\Rules\HighDiskThroughputRule.cs;Services\Intelligence\Rules\HighCpuTemperatureRule.cs;Services\Intelligence\Rules\SystemRunningWellRule.cs;Services\Intelligence\Rules\SharedProcessSynthesisRule.cs;Services\Intelligence\Rules\RisingRamTrendRule.cs;Services\Intelligence\Rules\CpuEscalationRule.cs;Services\Intelligence\Rules\PeriodicCpuSpikeRule.cs;Services\Intelligence\Rules\WorseningThermalTrendRule.cs;Services\Intelligence\Rules\LongRunningDiskPressureRule.cs;Services\Startup\StartupEntry.cs;Services\Startup\StartupSampler.cs;Services\Intelligence\Rules\StartupItemCountRule.cs;Services\Intelligence\Rules\HighImpactStartupAppsRule.cs;Services\Intelligence\Rules\StartupResourceCorrelationRule.cs;Services\Baseline\WelfordStats.cs;Services\Baseline\MachineBaseline.cs;Services\Baseline\ISystemBaselineService.cs;Services\Baseline\SystemBaselineService.cs;Services\Intelligence\Rules