<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>ExplainMyPC</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!--
      WindowsAppSDK 1.5 — stable channel, ships WinUI 3 + AppWindow APIs.
      SDK.BuildTools is marked PrivateAssets so it does not appear as a
      transitive dependency of consuming projects.
    -->
    <PackageReference Include="Microsoft.WindowsAppSDK"
                      Version="1.5.240802000" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools"
                      Version="10.0.26100.1742"
                      PrivateAssets="all" />

    <!-- Standard .NET DI container -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection"
                      Version="8.0.0" />

    <!-- Logging: abstractions + debug-output provider (writes to VS Output window) -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"
                      Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug"
                      Version="8.0.0" />

    <!--
      CommunityToolkit.Mvvm supplies ObservableObject, [ObservableProperty],
      RelayCommand, and AsyncRelayCommand via source generators — no
      boilerplate INotifyPropertyChanged needed in any ViewModel.
    -->
    <PackageReference Include="CommunityToolkit.Mvvm"
                      Version="8.2.2" />
  </ItemGroup>

</Project>
