<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>ExplainMyPC</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinUI 3 via Windows App SDK -->
    <PackageReference Include="Microsoft.WindowsAppSDK"
                      Version="1.5.240802000" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools"
                      Version="10.0.26100.1742"
                      PrivateAssets="all" />
    <PackageReference Include="CommunityToolkit.Mvvm"
                      Version="8.2.2" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter"
                      Version="8.0.0" />
  </ItemGroup>

  <!--
    Exclude advanced feature code from compilation.
    These folders contain future MVVM/service/engine code — not needed yet.
    Remove this section when you're ready to wire up the full architecture.
  -->
  <ItemGroup>
    <!-- ViewModels: DashboardViewModel + insight presentation layer -->
    <Compile Remove="ViewModels\**" />
    <Compile Include="ViewModels\DashboardViewModel.cs" />
    <Compile Include="ViewModels\InsightCardViewModel.cs" />
    <Compile Include="ViewModels\InsightGroupViewModel.cs" />
    <Compile Include="ViewModels\ActionCardViewModel.cs" />
    <Compile Include="ViewModels\ActionLogEntryViewModel.cs" />
    <Compile Include="ViewModels\ActionExecutionViewModel.cs" />
    <Compile Include="ViewModels\InsightsPageViewModel.cs" />
    <Compile Include="ViewModels\HistoryRecordViewModel.cs" />
    <None Include="ViewModels\**"
          Exclude="ViewModels\DashboardViewModel.cs;ViewModels\InsightCardViewModel.cs;ViewModels\InsightGroupViewModel.cs;ViewModels\ActionCardViewModel.cs;ViewModels\ActionLogEntryViewModel.cs;ViewModels\ActionExecutionViewModel.cs;ViewModels\InsightsPageViewModel.cs;ViewModels\HistoryRecordViewModel.cs" />

    <!--
      Services: compile the live telemetry service and its samplers.
      Other service files (MockTelemetryService, etc.) remain as None —
      visible in Solution Explorer but excluded from the build.
    -->
    <Compile Remove="Services\**" />
    <Compile Include="Services\ITelemetryService.cs" />
    <Compile Include="Services\ITelemetryHistoryBuffer.cs" />
    <Compile Include="Services\WindowsTelemetryService.cs" />
    <Compile Include="Services\TelemetryHistoryBuffer.cs" />
