<UserControl
    x:Class="ExplainMyPC.Controls.MetricCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ExplainMyPC.Controls">

    <!--
        MetricCard is the reusable building block for the live-telemetry row.
        It contains:
          • A header row (icon badge + title + status dot)
          • A large primary value
          • A secondary detail line
          • An embedded TelemetryGraph

        All visual properties are driven by DependencyProperties so the card
        is fully parameterised from DashboardPage.xaml without code-behind
        in the parent page.
    -->
    <Border x:Name="RootBorder"
            Background="#171A21"
            CornerRadius="10"
            BorderBrush="#252B38"
            BorderThickness="1"
            Padding="18,16,18,0">

        <StackPanel Spacing="0">

            <!-- ── Header row ────────────────────────────────────────────── -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Icon badge + title -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">

                    <Border x:Name="IconBadge"
                            Width="26" Height="26"
                            CornerRadius="5"
                            Background="#1E2430">
                        <FontIcon x:Name="TitleIcon"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="13"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                    </Border>

                    <TextBlock x:Name="TitleText"
                               FontFamily="Segoe UI Variable"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#AAB2C0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Status indicator dot -->
                <Ellipse x:Name="StatusDot"
                         Grid.Column="1"
                         Width="7" Height="7"
                         VerticalAlignment="Center" />
            </Grid>

            <!-- ── Primary value ──────────────────────────────────────────── -->
            <TextBlock x:Name="ValueText"
                       FontFamily="Segoe UI Variable Display"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="#F5F7FA"
                       Margin="0,0,0,2" />

            <!-- ── Secondary detail ───────────────────────────────────────── -->
            <TextBlock x:Name="DetailText"
                       FontFamily="Segoe UI Variable"
                       FontSize="12"
                       Foreground="#AAB2C0"
                       Margin="0,0,0,10"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis" />

            <!-- ── Live graph (no padding — fills the card bottom edge) ───── -->
            <controls:TelemetryGraph x:Name="Graph"
                                     Height="56"
                                     Margin="-18,0,-18,0" />

        </StackPanel>
    </Border>

</UserControl>
