<Page
    x:Class="ExplainMyPC.Views.WatchtowerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ExplainMyPC.Views"
    xmlns:vm="using:ExplainMyPC.ViewModels"
    Background="{StaticResource AppBackgroundBrush}">

    <!--
        WatchtowerPage.xaml — Autonomous Operational Watchtower
        ═══════════════════════════════════════════════════════════════════════
        Proactive operational guardianship: early warnings, drift analysis,
        stability forecasts, and maintenance planning.

        The Watchtower ONLY observes, suggests, and forecasts.
        It NEVER auto-remediates or generates fear-based copy.

        Sections (top to bottom):
          1. Page header + Refresh button
          2. Loading indicator
          3. Cold-start / no-data placeholder
          4. Insufficient history notice
          5. Stability Outlook headline
          6. Early Warning Center (alerts)
          7. Operational Drift (metric trends)
          8. Stability Forecasts
          9. Maintenance Planning
         10. Intervention Suggestions

        All content binds via DataContext = WatchtowerViewModel.
        No XAML converters — Visibility properties exposed from ViewModel.
    -->

    <ScrollViewer x:Name="RootScrollViewer"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32,32,32,56" Spacing="24">

            <!-- ═══════════════════════════════════════════════════════════════
                 1. PAGE HEADER
            ═══════════════════════════════════════════════════════════════ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock Text="Operational Watchtower"
                               Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Proactive pattern detection, stability forecasting, and maintenance planning — all local, all private"
                               Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>

                <Button Grid.Column="1"
                        Command="{Binding RefreshCommand}"
                        VerticalAlignment="Center"
                        Padding="14,8"
                        CornerRadius="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                        <TextBlock Text="Refresh" FontSize="13" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════════
                 2. LOADING INDICATOR
            ═══════════════════════════════════════════════════════════════ -->
            <Border Visibility="{Binding LoadingVisibility}"
                    Background="{StaticResource AppSurfaceBrush}"
                    CornerRadius="12" Padding="20,16">
                <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center">
                    <ProgressRing IsActive="True" Width="20" Height="20" />
                    <TextBlock Text="Running watchtower analysis…"
                               VerticalAlignment="Center"
                               Style="{StaticResource BodyTextStyle}" />
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════
                 3. NO-DATA PLACEHOLDER
            ═══════════════════════════════════════════════════════════════ -->
            <Border Visibility="{Binding NoDataVisibility}"
                    Background="{StaticResource AppSurfaceBrush}"
                    CornerRadius="12" Padding="40,36">
                <StackPanel HorizontalAlignment="Center" Spacing="12">
                    <FontIcon Glyph="&#xE7B7;"
                              FontFamily="Segoe MDL2 Assets"
                              FontSize="36"
                              Foreground="{StaticResource MutedTextBrush}"
                              HorizontalAlignment="Center" />
                    <TextBlock Text="Watchtower is initialising"
                               Style="{StaticResource SectionTitleStyle}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Click Refresh to run the first analysis pass."
                               Style="{StaticResource BodyTextStyle}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════
                 4. INSUFFICIENT HISTORY NOTICE
            ═══════════════════════════════════════════════════════════════ -->
            <Border Visibility="{Binding InsufficientHistoryVisibility}"
                    Background="{StaticResource AppSurfaceBrush}"
                    CornerRadius="12" Padding="24,20"
                    BorderBrush="{StaticResource AccentBlueBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE9CE;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="18"
                                  Foreground="{StaticResource AccentBlueBrush}" />
                        <TextBlock Text="Building operational baseline"
                                   Style="{StaticResource SectionTitleStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="The Watchtower needs at least a few days of telemetry data before it can produce reliable early warnings and forecasts. Keep ExplainMyPC running and check back soon."
                               Style="{StaticResource BodyTextStyle}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding OutlookNarrative}"
                               Style="{StaticResource CaptionTextStyle}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Content sections — only shown when sufficient history exists -->
            <StackPanel Visibility="{Binding SufficientHistoryVisibility}" Spacing="24">

                <!-- ═══════════════════════════════════════════════════════════
                     5. STABILITY OUTLOOK HEADLINE
                ═══════════════════════════════════════════════════════════ -->
                <Border Background="{StaticResource AppSurfaceBrush}"
                        CornerRadius="12" Padding="24,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Icon -->
                        <Border Grid.Column="0"
                                Width="52" Height="52"
                                CornerRadius="26"
                                Background="{StaticResource AppBackgroundBrush}"
                                Margin="0,0,16,0">
                            <FontIcon Glyph="&#xE7B7;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="22"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Foreground="{StaticResource AccentBlueBrush}" />
                        </Border>

                        <!-- Narrative -->
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="Stability Outlook"
                                       Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="{Binding OutlookNarrative}"
                                       Style="{StaticResource BodyTextStyle}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding LastComputedText}"
                                       Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>

                        <!-- Score badge -->
                        <Border Grid.Column="2"
                                CornerRadius="10"
                                Padding="14,8"
                                Margin="16,0,0,0"
                                Background="{StaticResource AppBackgroundBrush}"
                                VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center" Spacing="2">
                                <TextBlock Text="{Binding OutlookScore}"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center">
                                    <TextBlock.Foreground>
                                        <SolidColorBrush Color="{Binding OutlookColor}" />
                                    </TextBlock.Foreground>
                                </TextBlock>
                                <TextBlock Text="{Binding OutlookLabel}"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ═══════════════════════════════════════════════════════════
                     6. EARLY WARNING CENTER
                ═══════════════════════════════════════════════════════════ -->
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="2">
                            <TextBlock Text="Early Warning Center"
                                       Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Patterns detected from your operational history"
                                       Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>

                        <Border Grid.Column="1"
                                CornerRadius="10"
                                Padding="10,4"
                                Background="{StaticResource AppSurfaceBrush}"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding AlertsSummaryText}"
                                       Style="{StaticResource CaptionTextStyle}" />
                        </Border>
                    </Grid>

                    <!-- No alerts -->
                    <Border Visibility="{Binding NoAlertsVisibility}"
                            Background="{StaticResource AppSurfaceBrush}"
                            CornerRadius="10" Padding="20,16">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE930;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="16"
                                      Foreground="#34D399" />
                            <TextBlock Text="No patterns detected — system appears to be operating normally."
                                       Style="{StaticResource BodyTextStyle}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Alert cards -->
                    <ItemsControl Visibility="{Binding AlertsListVisibility}"
                                  ItemsSource="{Binding Alerts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AlertCardViewModel">
                                <Border Background="{StaticResource AppSurfaceBrush}"
                                        CornerRadius="10" Padding="18,14"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Severity accent bar -->
                                        <Border Grid.Column="0"
                                                CornerRadius="2"
                                                Margin="0,0,14,0">
                                            <Border.Background>
                                                <SolidColorBrush Color="{x:Bind AccentColor}" />
                                            </Border.Background>
                                        </Border>

                                        <!-- Content -->
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="{x:Bind Title}"
                                                       Style="{StaticResource CardTitleStyle}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind Explanation}"
                                                       Style="{StaticResource BodyTextStyle}"
                                                       TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                                                <TextBlock Text="{x:Bind ConfidenceText}"
                                                           Style="{StaticResource CaptionTextStyle}" />
                                                <TextBlock Text="{x:Bind TimeText}"
                                                           Style="{StaticResource CaptionTextStyle}" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind ActionHint}"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       Foreground="{StaticResource AccentBlueBrush}"
                                                       Visibility="{x:Bind HasActionHintVisibility}" />
                                        </StackPanel>

                                        <!-- Severity badge -->
                                        <Border Grid.Column="2"
                                                CornerRadius="6"
                                                Padding="8,4"
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Top">
                                            <Border.Background>
                                                <SolidColorBrush Color="{x:Bind SeverityColor}"
                                                                 Opacity="0.15" />
                                            </Border.Background>
                                            <TextBlock Text="{x:Bind SeverityLabel}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold">
                                                <TextBlock.Foreground>
                                                    <SolidColorBrush Color="{x:Bind SeverityColor}" />
                                                </TextBlock.Foreground>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ═══════════════════════════════════════════════════════════
                     7. OPERATIONAL DRIFT
                ═══════════════════════════════════════════════════════════ -->
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Operational Drift"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="How key metrics have shifted over time (7-day vs 30-day averages)"
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>

                    <Border Visibility="{Binding NoDriftVisibility}"
                            Background="{StaticResource AppSurfaceBrush}"
                            CornerRadius="10" Padding="20,16">
                        <TextBlock Text="Insufficient historical data to compute drift."
                                   Style="{StaticResource BodyTextStyle}" />
                    </Border>

                    <Border Visibility="{Binding DriftListVisibility}"
                            Background="{StaticResource AppSurfaceBrush}"
                            CornerRadius="10" Padding="0,4">
                        <ItemsControl ItemsSource="{Binding DriftRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DriftRowViewModel">
                                    <Grid Padding="18,12" MinHeight="52">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <FontIcon Grid.Column="0"
                                                  Glyph="{x:Bind Glyph}"
                                                  FontFamily="Segoe MDL2 Assets"
                                                  FontSize="14"
                                                  Foreground="{StaticResource MutedTextBrush}" />

                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind MetricName}"
                                                   Style="{StaticResource BodyTextStyle}"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold" />

                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    Spacing="16"
                                                    VerticalAlignment="Center">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="7-day" Style="{StaticResource CaptionTextStyle}" />
                                                <TextBlock Text="{x:Bind SevenDayText}"
                                                           Style="{StaticResource BodyTextStyle}"
                                                           FontSize="12" />
                                            </StackPanel>
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="30-day" Style="{StaticResource CaptionTextStyle}" />
                                                <TextBlock Text="{x:Bind ThirtyDayText}"
                                                           Style="{StaticResource BodyTextStyle}"
                                                           FontSize="12" />
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock Grid.Column="3"
                                                   Text="{x:Bind DriftLabel}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0">
                                            <TextBlock.Foreground>
                                                <SolidColorBrush Color="{x:Bind DriftColor}" />
                                            </TextBlock.Foreground>
                                        </TextBlock>

                                        <TextBlock Grid.Column="4"
                                                   Text="{x:Bind SignificanceIndicator}"
                                                   FontSize="10"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource AccentBlueBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>

                <!-- ═══════════════════════════════════════════════════════════
                     8. STABILITY FORECASTS
                ═══════════════════════════════════════════════════════════ -->
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Stability Forecasts"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Forward-looking projections based on current trends — not predictions, just patterns"
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>

                    <Border Visibility="{Binding NoForecastsVisibility}"
                            Background="{StaticResource AppSurfaceBrush}"
                            CornerRadius="10" Padding="20,16">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE930;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="16"
                                      Foreground="#34D399" />
                            <TextBlock Text="No stability risks projected from current trends."
                                       Style="{StaticResource BodyTextStyle}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <ItemsControl Visibility="{Binding ForecastsListVisibility}"
                                  ItemsSource="{Binding Forecasts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ForecastCardViewModel">
                                <Border Background="{StaticResource AppSurfaceBrush}"
                                        CornerRadius="10" Padding="18,14"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Text="{x:Bind Title}"
                                                       Style="{StaticResource CardTitleStyle}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind Description}"
                                                       Style="{StaticResource BodyTextStyle}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind SignalsText}"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind ConfidenceText}"
                                                       Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                                    Margin="16,0,0,0"
                                                    VerticalAlignment="Top"
                                                    HorizontalAlignment="Center"
                                                    Spacing="4">
                                            <TextBlock Text="{x:Bind RiskScoreText}"
                                                       FontSize="18"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center">
                                                <TextBlock.Foreground>
                                                    <SolidColorBrush Color="{x:Bind RiskColor}" />
                                                </TextBlock.Foreground>
                                            </TextBlock>
                                            <TextBlock Text="risk"
                                                       FontSize="10"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Text="{x:Bind DaysToImpactText}"
                                                       FontSize="10"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{StaticResource MutedTextBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ═══════════════════════════════════════════════════════════
                     9. MAINTENANCE PLANNING
                ═══════════════════════════════════════════════════════════ -->
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Maintenance Planning"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Suggested maintenance actions based on usage patterns and system state"
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>

                    <Border Visibility="{Binding NoMaintenanceVisibility}"
                            Background="{StaticResource AppSurfaceBrush}"
                            CornerRadius="10" Padding="20,16">
                        <TextBlock Text="No maintenance recommendations at this time."
                                   Style="{StaticResource BodyTextStyle}" />
                    </Border>

                    <ItemsControl Visibility="{Binding MaintenanceListVisibility}"
                                  ItemsSource="{Binding Maintenance}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MaintenanceCardViewModel">
                                <Border Background="{StaticResource AppSurfaceBrush}"
                                        CornerRadius="10" Padding="18,14"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <FontIcon Grid.Column="0"
                                                  Glyph="{x:Bind PriorityGlyph}"
                                                  FontFamily="Segoe MDL2 Assets"
                                                  FontSize="16"
                                                  Margin="0,0,14,0"
                                                  VerticalAlignment="Top">
                                            <FontIcon.Foreground>
                                                <SolidColorBrush Color="{x:Bind PriorityColor}" />
                                            </FontIcon.Foreground>
                                        </FontIcon>

                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="{x:Bind Title}"
                                                       Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="{x:Bind Rationale}"
                                                       Style="{StaticResource BodyTextStyle}"
                                                       TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                                                <FontIcon Glyph="&#xE917;"
                                                          FontFamily="Segoe MDL2 Assets"
                                                          FontSize="11"
                                                          Foreground="{StaticResource MutedTextBrush}" />
                                                <TextBlock Text="{x:Bind TimingText}"
                                                           Style="{StaticResource CaptionTextStyle}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <Border Grid.Column="2"
                                                CornerRadius="6"
                                                Padding="8,4"
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Top">
                                            <Border.Background>
                                                <SolidColorBrush Color="{x:Bind PriorityColor}"
                                                                 Opacity="0.15" />
                                            </Border.Background>
                                            <TextBlock Text="{x:Bind PriorityLabel}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold">
                                                <TextBlock.Foreground>
                                                    <SolidColorBrush Color="{x:Bind PriorityColor}" />
                                                </TextBlock.Foreground>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ═══════════════════════════════════════════════════════════
                     10. INTERVENTION SUGGESTIONS
                ═══════════════════════════════════════════════════════════ -->
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Suggested Actions"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Ranked suggestions based on active patterns and what has helped this machine before"
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>

                    <Border Visibility="{Binding NoInterventionsVisibility}"
                            Background="{StaticResource AppSurfaceBrush}"
                            CornerRadius="10" Padding="20,16">
                        <TextBlock Text="No intervention suggestions at this time."
                                   Style="{StaticResource BodyTextStyle}" />
                    </Border>

                    <ItemsControl Visibility="{Binding InterventionsListVisibility}"
                                  ItemsSource="{Binding Interventions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:InterventionCardViewModel">
                                <Border Background="{StaticResource AppSurfaceBrush}"
                                        CornerRadius="10" Padding="18,14"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Priority badge -->
                                        <Border Grid.Column="0"
                                                Width="32" Height="32"
                                                CornerRadius="16"
                                                Background="{StaticResource AppBackgroundBrush}"
                                                Margin="0,0,14,0"
                                                VerticalAlignment="Top">
                                            <TextBlock Text="{x:Bind PriorityBadge}"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource AccentBlueBrush}" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="{x:Bind Title}"
                                                       Style="{StaticResource CardTitleStyle}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind Rationale}"
                                                       Style="{StaticResource BodyTextStyle}"
                                                       TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                                                <TextBlock Text="{x:Bind EffectivenessLabel}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold">
                                                    <TextBlock.Foreground>
                                                        <SolidColorBrush Color="{x:Bind EffectivenessColor}" />
                                                    </TextBlock.Foreground>
                                                </TextBlock>
                                                <TextBlock Text="{x:Bind ConfidenceText}"
                                                           Style="{StaticResource CaptionTextStyle}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <FontIcon Grid.Column="2"
                                                  Glyph="&#xE76C;"
                                                  FontFamily="Segoe MDL2 Assets"
                                                  FontSize="14"
                                                  Foreground="{StaticResource MutedTextBrush}"
                                                  Margin="12,0,0,0"
                                                  VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ═══════════════════════════════════════════════════════════
                     PRIVACY STATEMENT
                ═══════════════════════════════════════════════════════════ -->
                <Border Background="{StaticResource AppSurfaceBrush}"
                        CornerRadius="10" Padding="18,14">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72E;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="13"
                                      Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Text="Fully local analysis"
                                       Style="{StaticResource CaptionTextStyle}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="All Watchtower analysis runs entirely on this device. No operational data, alerts, or forecasts are transmitted anywhere. Everything you see here is computed from your local operational database."
                                   Style="{StaticResource CaptionTextStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

            </StackPanel>
            <!-- /SufficientHistoryVisibility -->

        </StackPanel>
    </ScrollViewer>
</Page>
