<Page
    x:Class="ExplainMyPC.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="Page_Loaded">

    <Page.Resources>
        <!-- Hover card style — adds subtle scale + brightness on hover -->
        <Style x:Key="HoverCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource AppSurfaceBrush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <CompositeTransform />
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Animated progress bar colors -->
        <SolidColorBrush x:Key="CpuBarBrush" Color="{StaticResource AccentBlueColor}" />
        <SolidColorBrush x:Key="RamBarBrush" Color="{StaticResource AccentCyanColor}" />
        <SolidColorBrush x:Key="GpuBarBrush" Color="{StaticResource SuccessColor}" />
        <SolidColorBrush x:Key="DiskBarBrush" Color="{StaticResource WarningColor}" />

        <!-- Progress bar track color -->
        <SolidColorBrush x:Key="BarTrackBrush" Color="#1AFFFFFF" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32,32,32,48" Spacing="28">

            <!-- ══════════════════════════════════════════════════════════
                 PAGE HEADER
            ══════════════════════════════════════════════════════════ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock Text="Dashboard"
                               Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Your system at a glance"
                               Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>

                <!-- Status pill -->
                <Border Grid.Column="1"
                        Background="#1E57D68D"
                        CornerRadius="12"
                        Padding="12,6"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" />
                        <TextBlock Text="All systems normal"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Foreground="{StaticResource SuccessBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════
                 HEALTH SCORE CARD
            ══════════════════════════════════════════════════════════ -->
            <Border Style="{StaticResource HoverCardStyle}"
                    Padding="28"
                    PointerEntered="Card_PointerEntered"
                    PointerExited="Card_PointerExited">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Score ring -->
                    <Grid Grid.Column="0" Width="90" Height="90">
                        <!-- Background track -->
                        <ProgressRing IsIndeterminate="False"
                                      Value="87"
                                      Maximum="100"
                                      Width="90" Height="90"
                                      Background="Transparent"
                                      Foreground="{StaticResource SuccessBrush}" />
                        <!-- Score number overlay -->
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="87"
                                       Style="{StaticResource MetricLargeStyle}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="/100"
                                       Style="{StaticResource CaptionTextStyle}"
                                       HorizontalAlignment="Center"
                                       Margin="0,-4,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- Health details -->
                    <StackPanel Grid.Column="1"
                                Margin="28,0,0,0"
                                VerticalAlignment="Center"
                                Spacing="8">
                        <TextBlock Text="System Health: Good"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Your PC is running well. No critical issues detected. Performance is stable across all components."
                                   Style="{StaticResource BodyTextStyle}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />

                        <!-- Sub-scores row -->
                        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Performance 92" Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Security 95" Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource WarningBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Storage 71" Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Privacy 88" Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Trend indicator -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                        <FontIcon Glyph="&#xE70E;" FontFamily="Segoe MDL2 Assets"
                                  FontSize="16" Foreground="{StaticResource SuccessBrush}"
                                  HorizontalAlignment="Center" />
                        <TextBlock Text="+3"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Foreground="{StaticResource SuccessBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="this week"
                                   Style="{StaticResource CaptionTextStyle}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════
                 LIVE METRICS — with animated progress bars
            ══════════════════════════════════════════════════════════ -->
            <TextBlock Text="Live Metrics"
                       Style="{StaticResource SectionTitleStyle}" />

            <Grid ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- CPU Card -->
                <Border Grid.Column="0" Style="{StaticResource HoverCardStyle}"
                        Padding="20"
                        PointerEntered="Card_PointerEntered"
                        PointerExited="Card_PointerExited">
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="28" Height="28" CornerRadius="6"
                                        Background="#1E4EA1FF">
                                    <FontIcon Glyph="&#xE950;" FontFamily="Segoe MDL2 Assets"
                                              FontSize="13" Foreground="{StaticResource AccentBlueBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="CPU" Style="{StaticResource CardTitleStyle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <!-- Status dot -->
                            <Ellipse Grid.Column="1" Width="8" Height="8"
                                     Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="23%" Style="{StaticResource MetricMediumStyle}" />

                        <!-- Animated progress bar -->
                        <ProgressBar x:Name="CpuBar"
                                     Value="23" Maximum="100"
                                     Height="4" CornerRadius="2"
                                     Foreground="{StaticResource CpuBarBrush}"
                                     Background="{StaticResource BarTrackBrush}" />

                        <TextBlock Text="42&#x00B0;C  &#x2022;  3.80 GHz"
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Border>

                <!-- RAM Card -->
                <Border Grid.Column="1" Style="{StaticResource HoverCardStyle}"
                        Padding="20"
                        PointerEntered="Card_PointerEntered"
                        PointerExited="Card_PointerExited">
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="28" Height="28" CornerRadius="6"
                                        Background="#1E55D6FF">
                                    <FontIcon Glyph="&#xE964;" FontFamily="Segoe MDL2 Assets"
                                              FontSize="13" Foreground="{StaticResource AccentCyanBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="RAM" Style="{StaticResource CardTitleStyle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Ellipse Grid.Column="1" Width="8" Height="8"
                                     Fill="{StaticResource WarningBrush}" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="61%" Style="{StaticResource MetricMediumStyle}" />

                        <ProgressBar x:Name="RamBar"
                                     Value="61" Maximum="100"
                                     Height="4" CornerRadius="2"
                                     Foreground="{StaticResource RamBarBrush}"
                                     Background="{StaticResource BarTrackBrush}" />

                        <TextBlock Text="9.8 GB / 16 GB"
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Border>

                <!-- GPU Card -->
                <Border Grid.Column="2" Style="{StaticResource HoverCardStyle}"
                        Padding="20"
                        PointerEntered="Card_PointerEntered"
                        PointerExited="Card_PointerExited">
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="28" Height="28" CornerRadius="6"
                                        Background="#1E57D68D">
                                    <FontIcon Glyph="&#xE7F4;" FontFamily="Segoe MDL2 Assets"
                                              FontSize="13" Foreground="{StaticResource SuccessBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="GPU" Style="{StaticResource CardTitleStyle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Ellipse Grid.Column="1" Width="8" Height="8"
                                     Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="12%" Style="{StaticResource MetricMediumStyle}" />

                        <ProgressBar x:Name="GpuBar"
                                     Value="12" Maximum="100"
                                     Height="4" CornerRadius="2"
                                     Foreground="{StaticResource GpuBarBrush}"
                                     Background="{StaticResource BarTrackBrush}" />

                        <TextBlock Text="38&#x00B0;C  &#x2022;  1.2 GB VRAM"
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Border>

                <!-- Disk Card -->
                <Border Grid.Column="3" Style="{StaticResource HoverCardStyle}"
                        Padding="20"
                        PointerEntered="Card_PointerEntered"
                        PointerExited="Card_PointerExited">
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="28" Height="28" CornerRadius="6"
                                        Background="#1EFFB347">
                                    <FontIcon Glyph="&#xEDA2;" FontFamily="Segoe MDL2 Assets"
                                              FontSize="13" Foreground="{StaticResource WarningBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Disk" Style="{StaticResource CardTitleStyle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Ellipse Grid.Column="1" Width="8" Height="8"
                                     Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="46%" Style="{StaticResource MetricMediumStyle}" />

                        <ProgressBar x:Name="DiskBar"
                                     Value="46" Maximum="100"
                                     Height="4" CornerRadius="2"
                                     Foreground="{StaticResource DiskBarBrush}"
                                     Background="{StaticResource BarTrackBrush}" />

                        <TextBlock Text="237 GB / 512 GB"
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════
                 TRENDS SECTION
            ══════════════════════════════════════════════════════════ -->
            <TextBlock Text="Recent Trends"
                       Style="{StaticResource SectionTitleStyle}"
                       Margin="0,4,0,0" />

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Trend: Boot time -->
                <Border Grid.Column="0" Style="{StaticResource HoverCardStyle}"
                        Padding="20"
                        PointerEntered="Card_PointerEntered"
                        PointerExited="Card_PointerExited">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xEC49;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="14" Foreground="{StaticResource AccentBlueBrush}" />
                            <TextBlock Text="Boot Time" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="18s" Style="{StaticResource MetricMediumStyle}" />
                            <Border Background="#1E57D68D" CornerRadius="4" Padding="6,2"
                                    VerticalAlignment="Center">
                                <TextBlock Text="&#x2193; 2s faster"
                                           FontSize="11"
                                           Foreground="{StaticResource SuccessBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="vs. last week average"
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Border>

                <!-- Trend: Avg CPU -->
                <Border Grid.Column="1" Style="{StaticResource HoverCardStyle}"
                        Padding="20"
                        PointerEntered="Card_PointerEntered"
                        PointerExited="Card_PointerExited">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE9D2;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="14" Foreground="{StaticResource AccentCyanBrush}" />
                            <TextBlock Text="Avg CPU (24h)" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="31%" Style="{StaticResource MetricMediumStyle}" />
                            <Border Background="#1EFFB347" CornerRadius="4" Padding="6,2"
                                    VerticalAlignment="Center">
                                <TextBlock Text="&#x2191; 4% higher"
                                           FontSize="11"
                                           Foreground="{StaticResource WarningBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="vs. last week average"
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Border>

                <!-- Trend: Disk Free -->
                <Border Grid.Column="2" Style="{StaticResource HoverCardStyle}"
                        Padding="20"
                        PointerEntered="Card_PointerEntered"
                        PointerExited="Card_PointerExited">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xEDA2;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="14" Foreground="{StaticResource WarningBrush}" />
                            <TextBlock Text="Disk Free" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="275 GB" Style="{StaticResource MetricMediumStyle}" />
                            <Border Background="#1EFF6B6B" CornerRadius="4" Padding="6,2"
                                    VerticalAlignment="Center">
                                <TextBlock Text="&#x2193; 12 GB lost"
                                           FontSize="11"
                                           Foreground="{StaticResource DangerBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="in the last 7 days"
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════
                 QUICK ACTIONS
            ══════════════════════════════════════════════════════════ -->
            <TextBlock Text="Quick Actions"
                       Style="{StaticResource SectionTitleStyle}"
                       Margin="0,4,0,0" />

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Action: Explain -->
                <Button Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        Padding="16,14"
                        CornerRadius="8"
                        Background="{StaticResource AppSurfaceBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}">
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE946;" FontFamily="Segoe MDL2 Assets"
                                  FontSize="18" Foreground="{StaticResource AccentBlueBrush}"
                                  HorizontalAlignment="Center" />
                        <TextBlock Text="Explain My PC"
                                   Style="{StaticResource CaptionTextStyle}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Action: Scan -->
                <Button Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        Padding="16,14"
                        CornerRadius="8"
                        Background="{StaticResource AppSurfaceBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}">
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE71C;" FontFamily="Segoe MDL2 Assets"
                                  FontSize="18" Foreground="{StaticResource AccentCyanBrush}"
                                  HorizontalAlignment="Center" />
                        <TextBlock Text="Full Scan"
                                   Style="{StaticResource CaptionTextStyle}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Action: Cleanup -->
                <Button Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        Padding="16,14"
                        CornerRadius="8"
                        Background="{StaticResource AppSurfaceBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}">
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                  FontSize="18" Foreground="{StaticResource SuccessBrush}"
                                  HorizontalAlignment="Center" />
                        <TextBlock Text="Cleanup"
                                   Style="{StaticResource CaptionTextStyle}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Action: Startup -->
                <Button Grid.Column="3"
                        HorizontalAlignment="Stretch"
                        Padding="16,14"
                        CornerRadius="8"
                        Background="{StaticResource AppSurfaceBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}">
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE7B3;" FontFamily="Segoe MDL2 Assets"
                                  FontSize="18" Foreground="{StaticResource WarningBrush}"
                                  HorizontalAlignment="Center" />
                        <TextBlock Text="Startup Apps"
                                   Style="{StaticResource CaptionTextStyle}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════
                 ACTIVE INSIGHTS
            ══════════════════════════════════════════════════════════ -->
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Active Insights"
                           Style="{StaticResource SectionTitleStyle}" />
                <Border Grid.Column="1" Background="#1E4EA1FF"
                        CornerRadius="10" Padding="8,3">
                    <TextBlock Text="3 findings"
                               FontSize="11"
                               Foreground="{StaticResource AccentBlueBrush}" />
                </Border>
            </Grid>

            <!-- Insight: Startup apps (warning) -->
            <Border Style="{StaticResource HoverCardStyle}"
                    Padding="20"
                    PointerEntered="Card_PointerEntered"
                    PointerExited="Card_PointerExited">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="40" Height="40" CornerRadius="10"
                            Background="#1EFFB347" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE7B3;" FontFamily="Segoe MDL2 Assets"
                                  FontSize="16" Foreground="{StaticResource WarningBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="4">
                        <TextBlock Text="12 apps launch at startup"
                                   Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="This may slow your boot by ~8 seconds. Consider disabling apps you don't need immediately."
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>

                    <!-- Severity badge -->
                    <Border Grid.Column="2" Background="#1EFFB347"
                            CornerRadius="4" Padding="8,4"
                            VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="Moderate"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource WarningBrush}" />
                    </Border>
                </Grid>
            </Border>

            <!-- Insight: Disk space trending down (warning) -->
            <Border Style="{StaticResource HoverCardStyle}"
                    Padding="20"
                    PointerEntered="Card_PointerEntered"
                    PointerExited="Card_PointerExited">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="40" Height="40" CornerRadius="10"
                            Background="#1EFFB347" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xEDA2;" FontFamily="Segoe MDL2 Assets"
                                  FontSize="16" Foreground="{StaticResource WarningBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="4">
                        <TextBlock Text="Disk space declining steadily"
                                   Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="You've lost 12 GB in the past week. 5.7 GB can be safely reclaimed from caches and temp files."
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>

                    <Border Grid.Column="2" Background="#1EFFB347"
                            CornerRadius="4" Padding="8,4"
                            VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="Moderate"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource WarningBrush}" />
                    </Border>
                </Grid>
            </Border>

            <!-- Insight: Security good (info) -->
            <Border Style="{StaticResource HoverCardStyle}"
                    Padding="20"
                    PointerEntered="Card_PointerEntered"
                    PointerExited="Card_PointerExited">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="40" Height="40" CornerRadius="10"
                            Background="#1E57D68D" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE72E;" FontFamily="Segoe MDL2 Assets"
                                  FontSize="16" Foreground="{StaticResource SuccessBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="4">
                        <TextBlock Text="Windows Defender is active and current"
                                   Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="Real-time protection enabled. Definitions updated 2 hours ago. Last full scan found no threats."
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>

                    <Border Grid.Column="2" Background="#1E57D68D"
                            CornerRadius="4" Padding="8,4"
                            VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="Good"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource SuccessBrush}" />
                    </Border>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
