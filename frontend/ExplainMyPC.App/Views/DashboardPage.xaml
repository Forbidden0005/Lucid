<Page
    x:Class="ExplainMyPC.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="Page_Loaded">

    <!--
        DashboardPage.xaml — System overview with health score, live metrics,
        trends, quick actions, and active insights.

        All card styles, badge styles, progress bar styles, and button styles
        are sourced from the shared design system (AppCards/AppBadges/
        AppProgress/AppButtons.xaml merged in App.xaml).

        Code-behind: animates progress bars on load; delegates hover effects
        to AnimationHelper (scale + border brighten on pointer enter/exit).

        NOTE: Each animated Border has its own inline CompositeTransform.
        See AppCards.xaml for an explanation of why this is required.
    -->

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32,32,32,48" Spacing="28">

            <!-- ══════════════════════════════════════════════════════════
                 PAGE HEADER
            ══════════════════════════════════════════════════════════ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock Text="Dashboard"
                               Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Your system at a glance"
                               Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>

                <!-- "All systems normal" status pill -->
                <Border Grid.Column="1"
                        Background="{StaticResource StatusGoodSubtleBrush}"
                        CornerRadius="12" Padding="12,6"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="8" Height="8"
                                 Fill="{StaticResource StatusGoodBrush}" />
                        <TextBlock Text="All systems normal"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Foreground="{StaticResource StatusGoodBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════
                 HEALTH SCORE CARD
            ══════════════════════════════════════════════════════════ -->
            <Border Style="{StaticResource CardSurface}"
                    Padding="28"
                    PointerEntered="Card_PointerEntered"
                    PointerExited="Card_PointerExited">
                <Border.RenderTransform>
                    <CompositeTransform />
                </Border.RenderTransform>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Score ring -->
                    <Grid Grid.Column="0" Width="90" Height="90">
                        <ProgressRing IsIndeterminate="False"
                                      Value="87" Maximum="100"
                                      Width="90" Height="90"
                                      Background="Transparent"
                                      Foreground="{StaticResource StatusGoodBrush}" />
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="87"
                                       Style="{StaticResource MetricLargeStyle}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="/100"
                                       Style="{StaticResource CaptionTextStyle}"
                                       HorizontalAlignment="Center"
                                       Margin="0,-4,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- Health details -->
                    <StackPanel Grid.Column="1"
                                Margin="28,0,0,0"
                                VerticalAlignment="Center"
                                Spacing="8">
                        <TextBlock Text="System Health: Good"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Your PC is running well. No critical issues detected. Performance is stable across all components."
                                   Style="{StaticResource BodyTextStyle}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />

                        <!-- Sub-scores -->
                        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Width="6" Height="6"
                                         Fill="{StaticResource StatusGoodBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="Performance 92"
                                           Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Width="6" Height="6"
                                         Fill="{StaticResource StatusGoodBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="Security 95"
                                           Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Width="6" Height="6"
                                         Fill="{StaticResource StatusModerateBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="Storage 71"
                                           Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Width="6" Height="6"
                                         Fill="{StaticResource StatusGoodBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="Privacy 88"
                                           Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Weekly trend indicator -->
                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center"
                                Spacing="2">
                        <FontIcon Glyph="&#xE70E;" FontFamily="Segoe MDL2 Assets"
                                  FontSize="16"
                                  Foreground="{StaticResource StatusGoodBrush}"
                                  HorizontalAlignment="Center" />
                        <TextBlock Text="+3"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Foreground="{StaticResource StatusGoodBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="this week"
                                   Style="{StaticResource CaptionTextStyle}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════
                 LIVE METRICS — progress bars animate on page load
            ══════════════════════════════════════════════════════════ -->
            <TextBlock Text="Live Metrics"
                       Style="{StaticResource SectionTitleStyle}" />

            <Grid ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- CPU Card -->
                <Border Grid.Column="0"
                        Style="{StaticResource CardSurface}"
                        Padding="20"
                        PointerEntered="Card_PointerEntered"
                        PointerExited="Card_PointerExited">
                    <Border.RenderTransform>
                        <CompositeTransform />
                    </Border.RenderTransform>
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <!-- Small 28px icon container — CornerRadius="6" for compact size -->
                                <Border Width="28" Height="28" CornerRadius="6"
                                        Background="{StaticResource StatusInfoTintBrush}">
                                    <FontIcon Glyph="&#xE950;" FontFamily="Segoe MDL2 Assets"
                                              FontSize="13"
                                              Foreground="{StaticResource StatusInfoBrush}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="CPU"
                                           Style="{StaticResource CardTitleStyle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Ellipse Grid.Column="1" Width="8" Height="8"
                                     Fill="{StaticResource StatusGoodBrush}"
                                     VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="23%"
                                   Style="{StaticResource MetricMediumStyle}" />

                        <ProgressBar x:Name="CpuBar"
                                     Style="{StaticResource UsageBar}"
                                     Value="23"
                                     Foreground="{StaticResource AccentBlueBrush}" />

                        <TextBlock Text="42&#x00B0;C  &#x2022;  3.80 GHz"
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Border>

                <!-- RAM Card -->
                <Border Grid.Column="1"
                        Style="{StaticResource CardSurface}"
                        Padding="20"
                        PointerEntered="Card_PointerEntered"
                        PointerExited="Card_PointerExited">
                    <Border.RenderTransform>
                        <CompositeTransform />
                    </Border.RenderTransform>
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="28" Height="28" CornerRadius="6"
                                        Background="{StaticResource AccentCyanTintBrush}">
                                    <FontIcon Glyph="&#xE964;" FontFamily="Segoe MDL2 Assets"
                                              FontSize="13"
                                              Foreground="{StaticResource AccentCyanBrush}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="RAM"
                                           Style="{StaticResource CardTitleStyle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Ellipse Grid.Column="1" Width="8" Height="8"
                                     Fill="{StaticResource StatusModerateBrush}"
                                     VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="61%"
                                   Style="{StaticResource MetricMediumStyle}" />

                        <ProgressBar x:Name="RamBar"
                                     Style="{StaticResource UsageBar}"
                                     Value="61"
                                     Foreground="{StaticResource AccentCyanBrush}" />

                        <TextBlock Text="9.8 GB / 16 GB"
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Border>

                <!-- GPU Card -->
                <Border Grid.Column="2"
                        Style="{StaticResource CardSurface}"
                        Padding="20"
                        PointerEntered="Card_PointerEntered"
                        PointerExited="Card_PointerExited">
                    <Border.RenderTransform>
                        <CompositeTransform />
                    </Border.RenderTransform>
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="28" Height="28" CornerRadius="6"
                                        Background="{StaticResource StatusGoodTintBrush}">
                                    <FontIcon Glyph="&#xE7F4;" FontFamily="Segoe MDL2 Assets"
                                              FontSize="13"
                                              Foreground="{StaticResource StatusGoodBrush}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="GPU"
                                           Style="{StaticResource CardTitleStyle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Ellipse Grid.Column="1" Width="8" Height="8"
                                     Fill="{StaticResource StatusGoodBrush}"
                                     VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="12%"
                                   Style="{StaticResource MetricMediumStyle}" />

                        <ProgressBar x:Name="GpuBar"
                                     Style="{StaticResource UsageBar}"
                                     Value="12"
                                     Foreground="{StaticResource StatusGoodBrush}" />

                        <TextBlock Text="38&#x00B0;C  &#x2022;  1.2 GB VRAM"
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Border>

                <!-- Disk Card -->
                <Border Grid.Column="3"
                        Style="{StaticResource CardSurface}"
                        Padding="20"
                        PointerEntered="Card_PointerEntered"
                        PointerExited="Card_PointerExited">
                    <Border.RenderTransform>
                        <CompositeTransform />
                    </Border.RenderTransform>
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="28" Height="28" CornerRadius="6"
                                        Background="{StaticResource StatusModerateTintBrush}">
                                    <FontIcon Glyph="&#xEDA2;" FontFamily="Segoe MDL2 Assets"
                                              FontSize="13"
                                              Foreground="{StaticResource StatusModerateBrush}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Disk"
                                           Style="{StaticResource CardTitleStyle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Ellipse Grid.Column="1" Width="8" Height="8"
                                     Fill="{StaticResource StatusGoodBrush}"
                                     VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="46%"
                                   Style="{StaticResource MetricMediumStyle}" />

                        <ProgressBar x:Name="DiskBar"
                                     Style="{StaticResource UsageBar}"
                                     Value="46"
                                     Foreground="{StaticResource StatusModerateBrush}" />

                        <TextBlock Text="237 GB / 512 GB"
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════
                 RECENT TRENDS
            ══════════════════════════════════════════════════════════ -->
            <TextBlock Text="Recent Trends"
                       Style="{StaticResource SectionTitleStyle}"
                       Margin="0,4,0,0" />

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Boot time -->
                <Border Grid.Column="0"
                        Style="{StaticResource CardSurface}"
                        Padding="20"
                        PointerEntered="Card_PointerEntered"
                        PointerExited="Card_PointerExited">
                    <Border.RenderTransform>
                        <CompositeTransform />
                    </Border.RenderTransform>
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xEC49;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="14"
                                      Foreground="{StaticResource AccentBlueBrush}" />
                            <TextBlock Text="Boot Time"
                                       Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="18s"
                                       Style="{StaticResource MetricMediumStyle}" />
                            <Border Background="{StaticResource StatusGoodSubtleBrush}"
                                    CornerRadius="4" Padding="6,2"
                                    VerticalAlignment="Center">
                                <TextBlock Text="&#x2193; 2s faster"
                                           FontSize="11"
                                           Foreground="{StaticResource StatusGoodBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="vs. last week average"
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Border>

                <!-- Avg CPU -->
                <Border Grid.Column="1"
                        Style="{StaticResource CardSurface}"
                        Padding="20"
                        PointerEntered="Card_PointerEntered"
                        PointerExited="Card_PointerExited">
                    <Border.RenderTransform>
                        <CompositeTransform />
                    </Border.RenderTransform>
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE9D2;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="14"
                                      Foreground="{StaticResource AccentCyanBrush}" />
                            <TextBlock Text="Avg CPU (24h)"
                                       Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="31%"
                                       Style="{StaticResource MetricMediumStyle}" />
                            <Border Background="{StaticResource StatusModerateSubtleBrush}"
                                    CornerRadius="4" Padding="6,2"
                                    VerticalAlignment="Center">
                                <TextBlock Text="&#x2191; 4% higher"
                                           FontSize="11"
                                           Foreground="{StaticResource StatusModerateBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="vs. last week average"
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Border>

                <!-- Disk free -->
                <Border Grid.Column="2"
                        Style="{StaticResource CardSurface}"
                        Padding="20"
                        PointerEntered="Card_PointerEntered"
                        PointerExited="Card_PointerExited">
                    <Border.RenderTransform>
                        <CompositeTransform />
                    </Border.RenderTransform>
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xEDA2;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="14"
                                      Foreground="{StaticResource StatusModerateBrush}" />
                            <TextBlock Text="Disk Free"
                                       Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="275 GB"
                                       Style="{StaticResource MetricMediumStyle}" />
                            <Border Background="{StaticResource StatusCriticalSubtleBrush}"
                                    CornerRadius="4" Padding="6,2"
                                    VerticalAlignment="Center">
                                <TextBlock Text="&#x2193; 12 GB lost"
                                           FontSize="11"
                                           Foreground="{StaticResource StatusCriticalBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="in the last 7 days"
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════
                 QUICK ACTIONS
            ══════════════════════════════════════════════════════════ -->
            <TextBlock Text="Quick Actions"
                       Style="{StaticResource SectionTitleStyle}"
                       Margin="0,4,0,0" />

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource ActionButton}">
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE946;" FontFamily="Segoe MDL2 Assets"
                                  FontSize="18"
                                  Foreground="{StaticResource AccentBlueBrush}"
                                  HorizontalAlignment="Center" />
                        <TextBlock Text="Explain My PC"
                                   Style="{StaticResource CaptionTextStyle}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="1" Style="{StaticResource ActionButton}">
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE71C;" FontFamily="Segoe MDL2 Assets"
                                  FontSize="18"
                                  Foreground="{StaticResource AccentCyanBrush}"
                                  HorizontalAlignment="Center" />
                        <TextBlock Text="Full Scan"
                                   Style="{StaticResource CaptionTextStyle}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="2" Style="{StaticResource ActionButton}">
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                  FontSize="18"
                                  Foreground="{StaticResource StatusGoodBrush}"
                                  HorizontalAlignment="Center" />
                        <TextBlock Text="Cleanup"
                                   Style="{StaticResource CaptionTextStyle}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="3" Style="{StaticResource ActionButton}">
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE7B3;" FontFamily="Segoe MDL2 Assets"
                                  FontSize="18"
                                  Foreground="{StaticResource StatusModerateBrush}"
                                  HorizontalAlignment="Center" />
                        <TextBlock Text="Startup Apps"
                                   Style="{StaticResource CaptionTextStyle}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════
                 ACTIVE INSIGHTS
            ══════════════════════════════════════════════════════════ -->
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Active Insights"
                           Style="{StaticResource SectionTitleStyle}" />
                <Border Grid.Column="1"
                        Background="{StaticResource StatusInfoSubtleBrush}"
                        CornerRadius="10" Padding="8,3">
                    <TextBlock Text="3 findings"
                               FontSize="11"
                               Foreground="{StaticResource StatusInfoBrush}" />
                </Border>
            </Grid>

            <!-- Insight: Startup apps — Moderate -->
            <Border Style="{StaticResource CardSurface}"
                    Padding="20"
                    PointerEntered="Card_PointerEntered"
                    PointerExited="Card_PointerExited">
                <Border.RenderTransform>
                    <CompositeTransform />
                </Border.RenderTransform>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="40" Height="40"
                            Style="{StaticResource IconContainerWarning}"
                            VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE7B3;" FontFamily="Segoe MDL2 Assets"
                                  FontSize="16"
                                  Foreground="{StaticResource StatusModerateBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="4">
                        <TextBlock Text="12 apps launch at startup"
                                   Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="This may slow your boot by ~8 seconds. Consider disabling apps you don't need immediately."
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>

                    <Border Grid.Column="2" Style="{StaticResource BadgeInlineModerate}">
                        <TextBlock Text="Moderate"
                                   Style="{StaticResource BadgeLabelModerate}" />
                    </Border>
                </Grid>
            </Border>

            <!-- Insight: Disk space declining — Moderate -->
            <Border Style="{StaticResource CardSurface}"
                    Padding="20"
                    PointerEntered="Card_PointerEntered"
                    PointerExited="Card_PointerExited">
                <Border.RenderTransform>
                    <CompositeTransform />
                </Border.RenderTransform>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="40" Height="40"
                            Style="{StaticResource IconContainerWarning}"
                            VerticalAlignment="Center">
                        <FontIcon Glyph="&#xEDA2;" FontFamily="Segoe MDL2 Assets"
                                  FontSize="16"
                                  Foreground="{StaticResource StatusModerateBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="4">
                        <TextBlock Text="Disk space declining steadily"
                                   Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="You've lost 12 GB in the past week. 5.7 GB can be safely reclaimed from caches and temp files."
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>

                    <Border Grid.Column="2" Style="{StaticResource BadgeInlineModerate}">
                        <TextBlock Text="Moderate"
                                   Style="{StaticResource BadgeLabelModerate}" />
                    </Border>
                </Grid>
            </Border>

            <!-- Insight: Security healthy — Good -->
            <Border Style="{StaticResource CardSurface}"
                    Padding="20"
                    PointerEntered="Card_PointerEntered"
                    PointerExited="Card_PointerExited">
                <Border.RenderTransform>
                    <CompositeTransform />
                </Border.RenderTransform>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="40" Height="40"
                            Style="{StaticResource IconContainerGreen}"
                            VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE72E;" FontFamily="Segoe MDL2 Assets"
                                  FontSize="16"
                                  Foreground="{StaticResource StatusGoodBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="4">
                        <TextBlock Text="Windows Defender is active and current"
                                   Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="Real-time protection enabled. Definitions updated 2 hours ago. Last full scan found no threats."
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>

                    <Border Grid.Column="2" Style="{StaticResource BadgeInlineGood}">
                        <TextBlock Text="Good"
                                   Style="{StaticResource BadgeLabelGood}" />
                    </Border>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
