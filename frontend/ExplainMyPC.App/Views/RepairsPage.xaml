<Page
    x:Class="ExplainMyPC.Views.RepairsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource AppBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32" Spacing="24">

            <StackPanel Spacing="4">
                <TextBlock Text="Repairs"
                           Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Safe fix and rollback workflows"
                           Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>

            <!-- Available repairs -->
            <TextBlock Text="Available Repairs"
                       Style="{StaticResource SectionTitleStyle}" />

            <!-- SFC -->
            <Border Background="{StaticResource AppSurfaceBrush}"
                    CornerRadius="10" Padding="20"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Width="40" Height="40" CornerRadius="8"
                            Background="#1E4EA1FF" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE90F;" FontFamily="Segoe MDL2 Assets"
                                  FontSize="18" Foreground="{StaticResource AccentBlueBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="2">
                        <TextBlock Text="System File Checker (SFC)"
                                   Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="Scans and repairs protected Windows system files. Safe and non-destructive."
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- DISM -->
            <Border Background="{StaticResource AppSurfaceBrush}"
                    CornerRadius="10" Padding="20"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Width="40" Height="40" CornerRadius="8"
                            Background="#1E4EA1FF" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE90F;" FontFamily="Segoe MDL2 Assets"
                                  FontSize="18" Foreground="{StaticResource AccentBlueBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="2">
                        <TextBlock Text="DISM Health Restore"
                                   Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="Repairs the Windows component store. Run this if SFC reports issues it cannot fix."
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Disk cleanup -->
            <Border Background="{StaticResource AppSurfaceBrush}"
                    CornerRadius="10" Padding="20"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Width="40" Height="40" CornerRadius="8"
                            Background="#1E57D68D" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xEDA2;" FontFamily="Segoe MDL2 Assets"
                                  FontSize="18" Foreground="{StaticResource SuccessBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="2">
                        <TextBlock Text="Safe Disk Cleanup"
                                   Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="Removes temporary files, caches, and update leftovers. Always explains what will be deleted."
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
