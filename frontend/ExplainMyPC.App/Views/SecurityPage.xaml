<Page
    x:Class="ExplainMyPC.Views.SecurityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource AppBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32" Spacing="24">

            <StackPanel Spacing="4">
                <TextBlock Text="Security"
                           Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Threat visibility and protection status"
                           Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>

            <!-- Status card -->
            <Border Background="{StaticResource AppSurfaceBrush}"
                    CornerRadius="10" Padding="24"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Width="48" Height="48" CornerRadius="24"
                            Background="#1E57D68D" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE72E;" FontFamily="Segoe MDL2 Assets"
                                  FontSize="20" Foreground="{StaticResource SuccessBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="4">
                        <TextBlock Text="Protection Active"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Windows Defender real-time protection is enabled. No threats detected."
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Placeholder items -->
            <TextBlock Text="Security Checks"
                       Style="{StaticResource SectionTitleStyle}" />

            <Border Background="{StaticResource AppSurfaceBrush}"
                    CornerRadius="10" Padding="20"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                  FontSize="14" Foreground="{StaticResource SuccessBrush}" />
                        <TextBlock Text="Firewall enabled" Style="{StaticResource BodyTextStyle}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                  FontSize="14" Foreground="{StaticResource SuccessBrush}" />
                        <TextBlock Text="Virus definitions up to date" Style="{StaticResource BodyTextStyle}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                  FontSize="14" Foreground="{StaticResource SuccessBrush}" />
                        <TextBlock Text="No suspicious startup entries" Style="{StaticResource BodyTextStyle}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE7BA;" FontFamily="Segoe MDL2 Assets"
                                  FontSize="14" Foreground="{StaticResource WarningBrush}" />
                        <TextBlock Text="2 apps have broad network access" Style="{StaticResource BodyTextStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
