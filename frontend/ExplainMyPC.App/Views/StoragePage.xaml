<Page
    x:Class="ExplainMyPC.Views.StoragePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource AppBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32" Spacing="24">

            <StackPanel Spacing="4">
                <TextBlock Text="Storage"
                           Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Disk health, space usage, and cleanup opportunities"
                           Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>

            <!-- Drive overview -->
            <Border Background="{StaticResource AppSurfaceBrush}"
                    CornerRadius="10" Padding="24"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xEDA2;" FontFamily="Segoe MDL2 Assets"
                                  FontSize="20" Foreground="{StaticResource AccentBlueBrush}" />
                        <TextBlock Text="C: Drive (NVMe SSD)"
                                   Style="{StaticResource SectionTitleStyle}" />
                    </StackPanel>

                    <!-- Usage bar -->
                    <Grid Height="8" CornerRadius="4">
                        <Border Background="{StaticResource AppElevatedSurfaceBrush}"
                                CornerRadius="4" />
                        <Border Background="{StaticResource AccentBlueBrush}"
                                CornerRadius="4"
                                HorizontalAlignment="Left"
                                Width="240" />
                    </Grid>

                    <TextBlock Text="237 GB used of 512 GB (46%)"
                               Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>
            </Border>

            <!-- Cleanup opportunities -->
            <TextBlock Text="Cleanup Opportunities"
                       Style="{StaticResource SectionTitleStyle}" />

            <Border Background="{StaticResource AppSurfaceBrush}"
                    CornerRadius="10" Padding="20"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Windows Update cache" Style="{StaticResource BodyTextStyle}" />
                        <TextBlock Grid.Column="1" Text="3.2 GB"
                                   Style="{StaticResource BodyTextStyle}"
                                   Foreground="{StaticResource WarningBrush}" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Temporary files" Style="{StaticResource BodyTextStyle}" />
                        <TextBlock Grid.Column="1" Text="1.8 GB"
                                   Style="{StaticResource BodyTextStyle}"
                                   Foreground="{StaticResource WarningBrush}" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Recycle Bin" Style="{StaticResource BodyTextStyle}" />
                        <TextBlock Grid.Column="1" Text="680 MB"
                                   Style="{StaticResource BodyTextStyle}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
