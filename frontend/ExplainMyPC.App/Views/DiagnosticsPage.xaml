<Page
    x:Class="ExplainMyPC.Views.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ExplainMyPC.Views"
    xmlns:vm="using:ExplainMyPC.ViewModels"
    xmlns:diag="using:ExplainMyPC.Services.Diagnostics"
    Background="{StaticResource AppBackgroundBrush}">

    <!--
        DiagnosticsPage.xaml — Internal Diagnostics
        ═══════════════════════════════════════════════════════════════════════
        Self-observability workspace: service health, runtime anomalies,
        failure history, and recovery controls.

        Sections (top to bottom):
          1. Page header + Refresh
          2. Degraded mode banner (hidden when Full)
          3. Loading indicator
          4. Self-telemetry metrics row
          5. Service health cards
          6. Diagnostics event timeline
          7. Executor failure summary
          8. Recovery center
    -->

    <ScrollViewer x:Name="RootScrollViewer"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32,32,32,56" Spacing="24">

            <!-- ═══════════════════════════════════════════════════════════════
                 1. PAGE HEADER
            ═══════════════════════════════════════════════════════════════ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock Text="Internal Diagnostics"
                               Style="{StaticResource TitleTextBlockStyle}"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock Text="Service health, runtime anomalies, and recovery controls — ExplainMyPC observing itself."
                               Style="{StaticResource SecondaryBodyStyle}" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource AccentButtonStyle}" />
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════════
                 2. DEGRADED MODE BANNER
            ═══════════════════════════════════════════════════════════════ -->
            <Border Visibility="{Binding DegradedModeBannerVisibility}"
                    CornerRadius="8" Padding="20,14"
                    Background="#1D1700"
                    BorderBrush="{Binding DegradedModeColor}"
                    BorderThickness="0,0,0,2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Glyph="&#xE7BA;" FontFamily="Segoe MDL2 Assets"
                              Foreground="{Binding DegradedModeColor}"
                              FontSize="20" VerticalAlignment="Center"
                              Margin="0,0,16,0" />

                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="{Binding DegradedModeLabel}"
                                   FontWeight="SemiBold" FontSize="15"
                                   Foreground="{Binding DegradedModeColor}" />
                        <TextBlock Text="{Binding DegradedModeDescription}"
                                   Style="{StaticResource SecondaryBodyStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════
                 3. LOADING INDICATOR
            ═══════════════════════════════════════════════════════════════ -->
            <StackPanel Visibility="{Binding LoadingVisibility}"
                        HorizontalAlignment="Center" Margin="0,32,0,0" Spacing="12">
                <ProgressRing IsActive="True" Width="40" Height="40"
                              Foreground="{StaticResource AccentPurpleBrush}" />
                <TextBlock Text="Loading diagnostics…"
                           Style="{StaticResource SecondaryBodyStyle}"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Content panel -->
            <StackPanel Visibility="{Binding ContentVisibility}" Spacing="24">

                <!-- ═══════════════════════════════════════════════════════════
                     4. SELF-TELEMETRY METRICS
                ═══════════════════════════════════════════════════════════ -->
                <TextBlock Text="Runtime Pressure"
                           Style="{StaticResource SectionHeaderStyle}" />

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource CardBackgroundBrush}"
                            CornerRadius="8" Padding="14,12">
                        <StackPanel Spacing="4">
                            <FontIcon Glyph="&#xE9F5;" FontFamily="Segoe MDL2 Assets"
                                      Foreground="{StaticResource AccentPurpleBrush}" FontSize="14" />
                            <TextBlock Text="{Binding ProcessMemoryText}"
                                       FontSize="20" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBlock Text="Working Set"
                                       Style="{StaticResource SecondaryBodyStyle}" FontSize="11" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="{StaticResource CardBackgroundBrush}"
                            CornerRadius="8" Padding="14,12">
                        <StackPanel Spacing="4">
                            <FontIcon Glyph="&#xE790;" FontFamily="Segoe MDL2 Assets"
                                      Foreground="{StaticResource AccentPurpleBrush}" FontSize="14" />
                            <TextBlock Text="{Binding HeapMemoryText}"
                                       FontSize="20" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBlock Text="Managed Heap"
                                       Style="{StaticResource SecondaryBodyStyle}" FontSize="11" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="{StaticResource CardBackgroundBrush}"
                            CornerRadius="8" Padding="14,12">
                        <StackPanel Spacing="4">
                            <FontIcon Glyph="&#xE768;" FontFamily="Segoe MDL2 Assets"
                                      Foreground="{StaticResource AccentPurpleBrush}" FontSize="14" />
                            <TextBlock Text="{Binding ActiveWorkloadsText}"
                                       FontSize="20" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBlock Text="Active Workloads"
                                       Style="{StaticResource SecondaryBodyStyle}" FontSize="11" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Background="{StaticResource CardBackgroundBrush}"
                            CornerRadius="8" Padding="14,12">
                        <StackPanel Spacing="4">
                            <FontIcon Glyph="&#xE7C3;" FontFamily="Segoe MDL2 Assets"
                                      Foreground="{StaticResource AccentPurpleBrush}" FontSize="14" />
                            <TextBlock Text="{Binding QueueDepthText}"
                                       FontSize="20" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBlock Text="SQLite Queue"
                                       Style="{StaticResource SecondaryBodyStyle}" FontSize="11" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Background="{StaticResource CardBackgroundBrush}"
                            CornerRadius="8" Padding="14,12">
                        <StackPanel Spacing="4">
                            <FontIcon Glyph="&#xE9F3;" FontFamily="Segoe MDL2 Assets"
                                      Foreground="{StaticResource AccentPurpleBrush}" FontSize="14" />
                            <TextBlock Text="{Binding PersistenceStatus}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBlock Text="Persistence DB"
                                       Style="{StaticResource SecondaryBodyStyle}" FontSize="11" />
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Text="{Binding SnapshotTimeText}"
                           Style="{StaticResource SecondaryBodyStyle}"
                           FontSize="11" HorizontalAlignment="Right" />

                <!-- ═══════════════════════════════════════════════════════════
                     5. SERVICE HEALTH CARDS
                ═══════════════════════════════════════════════════════════ -->
                <TextBlock Text="Service Health"
                           Style="{StaticResource SectionHeaderStyle}" />

                <ItemsControl ItemsSource="{Binding ServiceCards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ServiceHealthCardViewModel">
                            <Border Background="{StaticResource CardBackgroundBrush}"
                                    CornerRadius="8" Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Status indicator dot -->
                                    <Ellipse Grid.Column="0"
                                             Width="10" Height="10"
                                             VerticalAlignment="Center">
                                        <Ellipse.Fill>
                                            <SolidColorBrush Color="{x:Bind StatusColor}" />
                                        </Ellipse.Fill>
                                    </Ellipse>

                                    <!-- Service name -->
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind Name}"
                                               FontWeight="SemiBold" FontSize="13"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               VerticalAlignment="Center"
                                               Margin="10,0,0,0" />

                                    <!-- Uptime -->
                                    <TextBlock Grid.Column="2"
                                               Text="{x:Bind UptimeText}"
                                               Style="{StaticResource SecondaryBodyStyle}"
                                               FontSize="12" VerticalAlignment="Center"
                                               Margin="0,0,16,0" />

                                    <!-- Failure count -->
                                    <TextBlock Grid.Column="3"
                                               Text="{x:Bind FailureText}"
                                               Style="{StaticResource SecondaryBodyStyle}"
                                               FontSize="12" VerticalAlignment="Center" />

                                    <!-- Last event -->
                                    <TextBlock Grid.Column="4"
                                               Text="{x:Bind LastEventText}"
                                               Style="{StaticResource SecondaryBodyStyle}"
                                               FontSize="12" VerticalAlignment="Center"
                                               HorizontalAlignment="Right" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ═══════════════════════════════════════════════════════════
                     6. DIAGNOSTICS EVENT TIMELINE
                ═══════════════════════════════════════════════════════════ -->
                <TextBlock Text="Diagnostics Timeline"
                           Style="{StaticResource SectionHeaderStyle}" />

                <!-- Empty state -->
                <Border Visibility="{Binding NoEventsVisibility}"
                        Background="{StaticResource CardBackgroundBrush}"
                        CornerRadius="8" Padding="24,20">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                  Foreground="#22C55E" FontSize="28"
                                  HorizontalAlignment="Center" />
                        <TextBlock Text="No diagnostics events yet — platform operating cleanly."
                                   Style="{StaticResource SecondaryBodyStyle}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Event list -->
                <ItemsControl Visibility="{Binding HasEventsVisibility}"
                              ItemsSource="{Binding RecentEvents}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DiagnosticsEventViewModel">
                            <Border Background="{StaticResource CardBackgroundBrush}"
                                    CornerRadius="6" Padding="14,10"
                                    Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Time -->
                                    <TextBlock Text="{x:Bind TimeText}"
                                               FontSize="11" FontFamily="Consolas"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               VerticalAlignment="Center" />

                                    <!-- Service name -->
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind ServiceName}"
                                               FontSize="11" FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="{x:Bind SeverityColor}" />
                                        </TextBlock.Foreground>
                                    </TextBlock>

                                    <!-- Message -->
                                    <StackPanel Grid.Column="2" Spacing="2"
                                                VerticalAlignment="Center"
                                                Margin="8,0,0,0">
                                        <TextBlock Text="{x:Bind Message}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind Detail}"
                                                   FontSize="11"
                                                   Visibility="{x:Bind HasDetail}"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ═══════════════════════════════════════════════════════════
                     7. EXECUTOR FAILURE SUMMARY
                ═══════════════════════════════════════════════════════════ -->
                <TextBlock Text="Executor Failures"
                           Style="{StaticResource SectionHeaderStyle}" />

                <!-- Empty state -->
                <Border Visibility="{Binding NoExecutorIssuesVisibility}"
                        Background="{StaticResource CardBackgroundBrush}"
                        CornerRadius="8" Padding="24,20">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                  Foreground="#22C55E" FontSize="28"
                                  HorizontalAlignment="Center" />
                        <TextBlock Text="No executor failures recorded."
                                   Style="{StaticResource SecondaryBodyStyle}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Executor failures list -->
                <ItemsControl Visibility="{Binding HasExecutorIssuesVisibility}"
                              ItemsSource="{Binding ExecutorIssues}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="diag:ExecutorFailureSummary">
                            <Border Background="{StaticResource CardBackgroundBrush}"
                                    CornerRadius="8" Padding="16,12"
                                    Margin="0,0,0,6"
                                    BorderBrush="#F59E0B40" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{x:Bind ActionId}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   FontFamily="Consolas"
                                                   Foreground="{StaticResource PrimaryTextBrush}" />
                                        <TextBlock Text="{x:Bind LastFailureDetail}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="2"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Right"
                                                Margin="16,0">
                                        <TextBlock Text="{x:Bind TotalFailures}"
                                                   FontSize="18" FontWeight="SemiBold"
                                                   Foreground="#F59E0B"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="failures"
                                                   FontSize="10"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Spacing="2"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Right">
                                        <TextBlock Text="{x:Bind ConsecutiveFailures}"
                                                   FontSize="18" FontWeight="SemiBold"
                                                   Foreground="#EF4444"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="consecutive"
                                                   FontSize="10"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ═══════════════════════════════════════════════════════════
                     8. RECOVERY CENTER
                ═══════════════════════════════════════════════════════════ -->
                <TextBlock Text="Recovery Center"
                           Style="{StaticResource SectionHeaderStyle}" />

                <!-- Recovery result feedback -->
                <Border Visibility="{Binding RecoveryResultVisibility}"
                        Background="{StaticResource CardBackgroundBrush}"
                        CornerRadius="8" Padding="16,12"
                        BorderBrush="#22C55E40" BorderThickness="1">
                    <TextBlock Text="{Binding RecoveryResultText}"
                               FontSize="13"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               TextWrapping="Wrap" />
                </Border>

                <!-- Recovery action cards -->
                <ItemsControl ItemsSource="{Binding RecoveryActions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="diag:RecoveryAction">
                            <Border Background="{StaticResource CardBackgroundBrush}"
                                    CornerRadius="8" Padding="16,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="3"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Label}"
                                                   FontWeight="SemiBold" FontSize="14"
                                                   Foreground="{StaticResource PrimaryTextBrush}" />
                                        <TextBlock Text="{x:Bind Description}"
                                                   Style="{StaticResource SecondaryBodyStyle}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Content="Run"
                                            Command="{Binding DataContext.ExecuteRecoveryActionCommand, ElementName=RootScrollViewer}"
                                            CommandParameter="{x:Bind ActionId}"
                                            VerticalAlignment="Center"
                                            Margin="16,0,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
            <!-- end ContentVisibility panel -->

        </StackPanel>
    </ScrollViewer>
</Page>
