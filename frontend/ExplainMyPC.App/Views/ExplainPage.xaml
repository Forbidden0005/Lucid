<Page
    x:Class="ExplainMyPC.Views.ExplainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource AppBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32" Spacing="24">

            <StackPanel Spacing="4">
                <TextBlock Text="Explain My PC"
                           Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Plain-language system analysis"
                           Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>

            <!-- Explanation output card -->
            <Border Background="{StaticResource AppSurfaceBrush}"
                    CornerRadius="10" Padding="24"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE946;" FontFamily="Segoe MDL2 Assets"
                                  FontSize="20" Foreground="{StaticResource AccentBlueBrush}" />
                        <TextBlock Text="System Analysis"
                                   Style="{StaticResource SectionTitleStyle}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource BodyTextStyle}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="Your PC is running normally. CPU usage is low at 23%, and you have plenty of free RAM. Your disk has about 275 GB of free space remaining. No unusual processes detected." />

                    <TextBlock Style="{StaticResource BodyTextStyle}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="Startup time could be improved — 12 applications launch automatically when Windows starts. Consider disabling apps you don't need immediately." />
                </StackPanel>
            </Border>

            <!-- Ask a question placeholder -->
            <Border Background="{StaticResource AppSurfaceBrush}"
                    CornerRadius="10" Padding="24"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="Ask about your PC"
                               Style="{StaticResource CardTitleStyle}" />
                    <TextBlock Text="Coming soon: type a question like &#x22;Why is my PC slow?&#x22; and get a clear, evidence-based answer."
                               Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
