<Page
    x:Class="ExplainMyPC.Views.ExplainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="Page_Loaded">

    <!--
        ExplainPage.xaml — Conversational system analysis with diagnostic
        findings and actionable recommendations.

        All card styles, badge styles, and progress bar styles are sourced
        from the shared design system merged in App.xaml.

        Code-behind: staggered card entrance + confidence bar fill on load;
        card hover effects delegated to AnimationHelper.

        NOTE: Each named card has its own inline CompositeTransform.
        See AppCards.xaml for the full explanation of why this is required.
    -->

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32,32,32,48" Spacing="28">

            <!-- ═══════════════════════════════════════════════════════
                 PAGE HEADER
            ═══════════════════════════════════════════════════════ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock Text="Explain My PC"
                               Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="A plain-language analysis of your system right now"
                               Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>

                <!-- Last analysed pill -->
                <Border Grid.Column="1"
                        Background="{StaticResource AppSurfaceBrush}"
                        CornerRadius="12" Padding="12,6"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE121;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="11"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="Analysed just now"
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════
                 SYSTEM SUMMARY — the "opening statement"
            ═══════════════════════════════════════════════════════ -->
            <Border x:Name="CardSummary"
                    Style="{StaticResource CardElevated}"
                    Padding="28"
                    PointerEntered="Card_PointerEntered"
                    PointerExited="Card_PointerExited">
                <Border.RenderTransform>
                    <CompositeTransform />
                </Border.RenderTransform>
                <StackPanel Spacing="16">

                    <!-- Header row -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Width="40" Height="40"
                                Style="{StaticResource IconContainerBlue}">
                            <FontIcon Glyph="&#xE946;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="18"
                                      Foreground="{StaticResource AccentBlueBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="System Summary"
                                       Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Overall health: Good"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Foreground="{StaticResource StatusGoodBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Divider -->
                    <Border Height="1"
                            Background="{StaticResource BorderSubtleBrush}"
                            HorizontalAlignment="Stretch" />

                    <!-- Plain-language paragraphs -->
                    <TextBlock Style="{StaticResource BodyTextStyle}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Text="Your PC is in good shape right now. CPU and RAM are comfortable — nothing is competing for resources aggressively. The thing most worth your attention is startup: 12 applications load automatically when Windows starts, which is adding around 8 seconds to your boot time and keeping background memory usage higher than it needs to be." />

                    <TextBlock Style="{StaticResource BodyTextStyle}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Text="Disk space is also worth a look — you've been losing roughly 1.7 GB per day and around 5.7 GB can be reclaimed safely right now. Everything else — security, thermals, and GPU — looks healthy." />

                    <!-- Confidence row -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Background="{StaticResource StatusInfoSubtleBrush}"
                                CornerRadius="6" Padding="8,4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8D4;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="11"
                                          Foreground="{StaticResource StatusInfoBrush}" />
                                <TextBlock Text="96% confidence"
                                           FontSize="11"
                                           Foreground="{StaticResource StatusInfoBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource AppSurfaceBrush}"
                                CornerRadius="6" Padding="8,4"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1">
                            <TextBlock Text="Based on 47 data points"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </Border>
                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════
                 DIAGNOSTIC FINDINGS
            ═══════════════════════════════════════════════════════ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Diagnostic Findings"
                           Style="{StaticResource SectionTitleStyle}" />
                <Border Grid.Column="1"
                        Background="{StaticResource AppSurfaceBrush}"
                        CornerRadius="10" Padding="8,3"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1">
                    <TextBlock Text="5 areas checked"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </Border>
            </Grid>

            <!-- Finding 1: Startup congested — Moderate -->
            <Border x:Name="CardFinding1"
                    Style="{StaticResource CardSurface}"
                    Padding="20"
                    PointerEntered="Card_PointerEntered"
                    PointerExited="Card_PointerExited">
                <Border.RenderTransform>
                    <CompositeTransform />
                </Border.RenderTransform>
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="44" Height="44"
                            Style="{StaticResource IconContainerWarning}"
                            VerticalAlignment="Top">
                        <FontIcon Glyph="&#xE7B3;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="18"
                                  Foreground="{StaticResource StatusModerateBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="Startup is congested"
                                   Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}"
                                   TextWrapping="Wrap"
                                   Text="12 apps launch automatically when Windows starts. This adds roughly 8 seconds to your boot time and keeps about 1.1 GB of RAM reserved before you've done anything." />

                        <StackPanel Margin="0,4,0,0" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Confidence"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="94%"
                                           FontSize="11"
                                           Foreground="{StaticResource StatusModerateBrush}" />
                            </StackPanel>
                            <ProgressBar x:Name="ConfBar1"
                                         Style="{StaticResource ConfidenceBar}"
                                         Value="0"
                                         Foreground="{StaticResource StatusModerateBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="2" Style="{StaticResource BadgeModerate}">
                        <TextBlock Text="Moderate"
                                   Style="{StaticResource BadgeLabelModerate}" />
                    </Border>
                </Grid>
            </Border>

            <!-- Finding 2: Disk space trending down — Moderate -->
            <Border x:Name="CardFinding2"
                    Style="{StaticResource CardSurface}"
                    Padding="20"
                    PointerEntered="Card_PointerEntered"
                    PointerExited="Card_PointerExited">
                <Border.RenderTransform>
                    <CompositeTransform />
                </Border.RenderTransform>
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="44" Height="44"
                            Style="{StaticResource IconContainerWarning}"
                            VerticalAlignment="Top">
                        <FontIcon Glyph="&#xEDA2;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="18"
                                  Foreground="{StaticResource StatusModerateBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="Disk space is trending down"
                                   Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}"
                                   TextWrapping="Wrap"
                                   Text="You've lost 12 GB in the past 7 days — about 1.7 GB per day. At this rate, your drive will be over 80% full within 3 weeks. Around 5.7 GB can be reclaimed safely from caches and temporary files right now." />

                        <StackPanel Margin="0,4,0,0" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Confidence"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="89%"
                                           FontSize="11"
                                           Foreground="{StaticResource StatusModerateBrush}" />
                            </StackPanel>
                            <ProgressBar x:Name="ConfBar2"
                                         Style="{StaticResource ConfidenceBar}"
                                         Value="0"
                                         Foreground="{StaticResource StatusModerateBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="2" Style="{StaticResource BadgeModerate}">
                        <TextBlock Text="Moderate"
                                   Style="{StaticResource BadgeLabelModerate}" />
                    </Border>
                </Grid>
            </Border>

            <!-- Finding 3: CPU calm — Good -->
            <Border x:Name="CardFinding3"
                    Style="{StaticResource CardSurface}"
                    Padding="20"
                    PointerEntered="Card_PointerEntered"
                    PointerExited="Card_PointerExited">
                <Border.RenderTransform>
                    <CompositeTransform />
                </Border.RenderTransform>
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="44" Height="44"
                            Style="{StaticResource IconContainerGreen}"
                            VerticalAlignment="Top">
                        <FontIcon Glyph="&#xE950;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="18"
                                  Foreground="{StaticResource StatusGoodBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="CPU is calm"
                                   Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}"
                                   TextWrapping="Wrap"
                                   Text="Averaging 23% over the last hour with no throttling detected. Your processor is running at a healthy 3.80 GHz and temperatures are well inside safe limits at 42&#x00B0;C. No single process is monopolising it." />

                        <StackPanel Margin="0,4,0,0" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Confidence"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="98%"
                                           FontSize="11"
                                           Foreground="{StaticResource StatusGoodBrush}" />
                            </StackPanel>
                            <ProgressBar x:Name="ConfBar3"
                                         Style="{StaticResource ConfidenceBar}"
                                         Value="0"
                                         Foreground="{StaticResource StatusGoodBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="2" Style="{StaticResource BadgeGood}">
                        <TextBlock Text="Good"
                                   Style="{StaticResource BadgeLabelGood}" />
                    </Border>
                </Grid>
            </Border>

            <!-- Finding 4: RAM comfortable — Good -->
            <Border x:Name="CardFinding4"
                    Style="{StaticResource CardSurface}"
                    Padding="20"
                    PointerEntered="Card_PointerEntered"
                    PointerExited="Card_PointerExited">
                <Border.RenderTransform>
                    <CompositeTransform />
                </Border.RenderTransform>
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="44" Height="44"
                            Style="{StaticResource IconContainerGreen}"
                            VerticalAlignment="Top">
                        <FontIcon Glyph="&#xE964;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="18"
                                  Foreground="{StaticResource StatusGoodBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="RAM is comfortable"
                                   Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}"
                                   TextWrapping="Wrap"
                                   Text="Using 9.8 GB of 16 GB (61%). Windows has not needed to use the page file recently, which means there's no hidden disk slowdown caused by memory pressure. You have a healthy buffer for demanding tasks." />

                        <StackPanel Margin="0,4,0,0" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Confidence"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="97%"
                                           FontSize="11"
                                           Foreground="{StaticResource StatusGoodBrush}" />
                            </StackPanel>
                            <ProgressBar x:Name="ConfBar4"
                                         Style="{StaticResource ConfidenceBar}"
                                         Value="0"
                                         Foreground="{StaticResource StatusGoodBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="2" Style="{StaticResource BadgeGood}">
                        <TextBlock Text="Good"
                                   Style="{StaticResource BadgeLabelGood}" />
                    </Border>
                </Grid>
            </Border>

            <!-- Finding 5: Security posture strong — Good -->
            <Border x:Name="CardFinding5"
                    Style="{StaticResource CardSurface}"
                    Padding="20"
                    PointerEntered="Card_PointerEntered"
                    PointerExited="Card_PointerExited">
                <Border.RenderTransform>
                    <CompositeTransform />
                </Border.RenderTransform>
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="44" Height="44"
                            Style="{StaticResource IconContainerGreen}"
                            VerticalAlignment="Top">
                        <FontIcon Glyph="&#xE72E;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="18"
                                  Foreground="{StaticResource StatusGoodBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="Security posture is strong"
                                   Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}"
                                   TextWrapping="Wrap"
                                   Text="Defender is active with up-to-date definitions. Firewall is on. No suspicious processes were found in the startup registry or scheduled tasks. No known persistence mechanisms detected." />

                        <StackPanel Margin="0,4,0,0" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Confidence"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="95%"
                                           FontSize="11"
                                           Foreground="{StaticResource StatusGoodBrush}" />
                            </StackPanel>
                            <ProgressBar x:Name="ConfBar5"
                                         Style="{StaticResource ConfidenceBar}"
                                         Value="0"
                                         Foreground="{StaticResource StatusGoodBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="2" Style="{StaticResource BadgeGood}">
                        <TextBlock Text="Good"
                                   Style="{StaticResource BadgeLabelGood}" />
                    </Border>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════════════
                 RECOMMENDATIONS
            ═══════════════════════════════════════════════════════ -->
            <TextBlock Text="Recommendations"
                       Style="{StaticResource SectionTitleStyle}"
                       Margin="0,4,0,0" />

            <!-- Rec 1: Trim startup apps -->
            <Border x:Name="CardRec1"
                    Style="{StaticResource CardSurface}"
                    Padding="20"
                    PointerEntered="Card_PointerEntered"
                    PointerExited="Card_PointerExited">
                <Border.RenderTransform>
                    <CompositeTransform />
                </Border.RenderTransform>
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Step number circle -->
                    <Border Width="36" Height="36" CornerRadius="18"
                            Background="{StaticResource AccentBlueBrush}"
                            VerticalAlignment="Top">
                        <TextBlock Text="1"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="Trim your startup apps"
                                   Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}"
                                   TextWrapping="Wrap"
                                   Text="Open Task Manager &#x2192; Startup apps, then disable anything you don't need at login — Spotify and Discord are common culprits. This is safe and reversible at any time." />

                        <!-- Impact chips -->
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                            <Border Background="{StaticResource StatusInfoSubtleBrush}"
                                    CornerRadius="4" Padding="7,3">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xEC49;"
                                              FontFamily="Segoe MDL2 Assets"
                                              FontSize="10"
                                              Foreground="{StaticResource StatusInfoBrush}" />
                                    <TextBlock Text="~8s faster boot"
                                               FontSize="11"
                                               Foreground="{StaticResource StatusInfoBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource StatusGoodSubtleBrush}"
                                    CornerRadius="4" Padding="7,3">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE964;"
                                              FontFamily="Segoe MDL2 Assets"
                                              FontSize="10"
                                              Foreground="{StaticResource StatusGoodBrush}" />
                                    <TextBlock Text="~1.1 GB RAM freed"
                                               FontSize="11"
                                               Foreground="{StaticResource StatusGoodBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Effort pill -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Top" Spacing="4">
                        <Border Background="{StaticResource AppSurfaceBrush}"
                                CornerRadius="6" Padding="8,4"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1">
                            <TextBlock Text="2 min"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock Text="effort"
                                   FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Rec 2: Run disk cleanup -->
            <Border x:Name="CardRec2"
                    Style="{StaticResource CardSurface}"
                    Padding="20"
                    PointerEntered="Card_PointerEntered"
                    PointerExited="Card_PointerExited">
                <Border.RenderTransform>
                    <CompositeTransform />
                </Border.RenderTransform>
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="36" Height="36" CornerRadius="18"
                            Background="{StaticResource AccentBlueBrush}"
                            VerticalAlignment="Top">
                        <TextBlock Text="2"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="Reclaim 5.7 GB of disk space"
                                   Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}"
                                   TextWrapping="Wrap"
                                   Text="Windows Update cache (3.2 GB) and temporary files (1.8 GB) can be deleted safely. Neither contains user data. Head to Storage &#x2192; Cleanup in this app, or use the built-in Disk Cleanup tool." />

                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                            <Border Background="{StaticResource StatusModerateSubtleBrush}"
                                    CornerRadius="4" Padding="7,3">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xEDA2;"
                                              FontFamily="Segoe MDL2 Assets"
                                              FontSize="10"
                                              Foreground="{StaticResource StatusModerateBrush}" />
                                    <TextBlock Text="5.7 GB reclaimed"
                                               FontSize="11"
                                               Foreground="{StaticResource StatusModerateBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource StatusGoodSubtleBrush}"
                                    CornerRadius="4" Padding="7,3">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE73E;"
                                              FontFamily="Segoe MDL2 Assets"
                                              FontSize="10"
                                              Foreground="{StaticResource StatusGoodBrush}" />
                                    <TextBlock Text="Fully reversible"
                                               FontSize="11"
                                               Foreground="{StaticResource StatusGoodBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Top" Spacing="4">
                        <Border Background="{StaticResource AppSurfaceBrush}"
                                CornerRadius="6" Padding="8,4"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1">
                            <TextBlock Text="1 min"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock Text="effort"
                                   FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Rec 3: Nothing to do on security -->
            <Border x:Name="CardRec3"
                    Style="{StaticResource CardSurface}"
                    Padding="20"
                    PointerEntered="Card_PointerEntered"
                    PointerExited="Card_PointerExited">
                <Border.RenderTransform>
                    <CompositeTransform />
                </Border.RenderTransform>
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Checkmark circle (no action needed) -->
                    <Border Width="36" Height="36" CornerRadius="18"
                            Background="{StaticResource AppElevatedSurfaceBrush}"
                            BorderBrush="{StaticResource BorderDefaultBrush}"
                            BorderThickness="1"
                            VerticalAlignment="Top">
                        <FontIcon Glyph="&#xE73E;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="14"
                                  Foreground="{StaticResource StatusGoodBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="Nothing to do on security"
                                   Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}"
                                   TextWrapping="Wrap"
                                   Text="Protection is active, definitions are fresh, and no suspicious behaviour was found. No action needed — check back if you install new software or notice unusual slowdowns." />
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Top" Spacing="4">
                        <Border Background="{StaticResource StatusGoodSubtleBrush}"
                                CornerRadius="6" Padding="8,4">
                            <TextBlock Text="None"
                                       FontSize="11"
                                       Foreground="{StaticResource StatusGoodBrush}"
                                       HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock Text="effort"
                                   FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
