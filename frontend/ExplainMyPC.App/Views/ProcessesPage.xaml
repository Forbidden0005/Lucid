<Page
    x:Class="ExplainMyPC.Views.ProcessesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource AppBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32" Spacing="24">

            <StackPanel Spacing="4">
                <TextBlock Text="Processes"
                           Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Live CPU, RAM, and process activity"
                           Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>

            <!-- Top processes placeholder -->
            <TextBlock Text="Top Processes by CPU"
                       Style="{StaticResource SectionTitleStyle}" />

            <Border Background="{StaticResource AppSurfaceBrush}"
                    CornerRadius="10" Padding="20"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="14">
                    <!-- Process row 1 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Chrome (12 tabs)" Style="{StaticResource BodyTextStyle}" />
                        <TextBlock Grid.Column="1" Text="8.2%" Style="{StaticResource BodyTextStyle}"
                                   Foreground="{StaticResource AccentBlueBrush}" />
                        <TextBlock Grid.Column="2" Text="1.4 GB" Style="{StaticResource CaptionTextStyle}" />
                    </Grid>
                    <!-- Process row 2 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Visual Studio" Style="{StaticResource BodyTextStyle}" />
                        <TextBlock Grid.Column="1" Text="5.1%" Style="{StaticResource BodyTextStyle}"
                                   Foreground="{StaticResource AccentBlueBrush}" />
                        <TextBlock Grid.Column="2" Text="890 MB" Style="{StaticResource CaptionTextStyle}" />
                    </Grid>
                    <!-- Process row 3 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Spotify" Style="{StaticResource BodyTextStyle}" />
                        <TextBlock Grid.Column="1" Text="2.3%" Style="{StaticResource BodyTextStyle}"
                                   Foreground="{StaticResource AccentBlueBrush}" />
                        <TextBlock Grid.Column="2" Text="320 MB" Style="{StaticResource CaptionTextStyle}" />
                    </Grid>
                    <!-- Process row 4 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Discord" Style="{StaticResource BodyTextStyle}" />
                        <TextBlock Grid.Column="1" Text="1.8%" Style="{StaticResource BodyTextStyle}"
                                   Foreground="{StaticResource AccentBlueBrush}" />
                        <TextBlock Grid.Column="2" Text="280 MB" Style="{StaticResource CaptionTextStyle}" />
                    </Grid>
                    <!-- Process row 5 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Windows Explorer" Style="{StaticResource BodyTextStyle}" />
                        <TextBlock Grid.Column="1" Text="0.9%" Style="{StaticResource BodyTextStyle}"
                                   Foreground="{StaticResource AccentBlueBrush}" />
                        <TextBlock Grid.Column="2" Text="110 MB" Style="{StaticResource CaptionTextStyle}" />
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
