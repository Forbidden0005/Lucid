<Window
    x:Class="ExplainMyPC.Views.CompanionOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:companion="using:ExplainMyPC.Services.Companion"
    Title="ExplainMyPC Companion">

    <!--
        Companion Overlay Window — floats above all other windows.

        Two layout modes driven by ICompanionSessionManager state:
          Bubble   (72×72)   — circular icon; tap to expand, drag to reposition
          Expanded (380×600) — full conversation panel with quick actions

        Architecture:
          • No OS title bar (ExtendsContentIntoTitleBar = true, SetTitleBar(null))
          • Drag is handled manually in code-behind via P/Invoke GetCursorPos
          • Window opacity drops to 0.85 while dragging
          • Snap-to-edge is scaffolded in code-behind (full impl: future phase)
          • Visibility strings come from CompanionChatViewModel — no converters

        Companion doctrine (Phase 17A):
          • Placeholder messages only — OperationalConversationEngine not wired
          • No automation, no LLM, no desktop control
          • All local, all deterministic, all explainable
    -->

    <Grid x:Name="RootGrid"
          RequestedTheme="Dark">


        <!-- ══════════════════════════════════════════════════════════════════
             BUBBLE MODE — 72×72 circular floating icon
             Tap: expand to full panel
             Drag: reposition window (handled in code-behind)
        ══════════════════════════════════════════════════════════════════ -->
        <Grid Visibility="{x:Bind ViewModel.BubbleVisibility, Mode=OneWay}"
              Width="72" Height="72"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              PointerPressed="BubbleRoot_PointerPressed"
              PointerMoved="BubbleRoot_PointerMoved"
              PointerReleased="BubbleRoot_PointerReleased">

            <!-- Outer glow ring -->
            <Ellipse Width="72" Height="72"
                     Fill="Transparent"
                     Stroke="#2A3A5C"
                     StrokeThickness="1" />

            <!-- Main bubble body -->
            <Border Width="66" Height="66"
                    CornerRadius="33"
                    Background="#1A1A2E"
                    BorderBrush="#3F3F5A"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <Grid>
                    <!-- Companion glyph -->
                    <FontIcon Glyph="&#xE946;"
                              FontFamily="Segoe MDL2 Assets"
                              FontSize="24"
                              Foreground="#4E9FFF"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />

                    <!-- Unread / active indicator dot -->
                    <Ellipse Width="10" Height="10"
                             Fill="#4E9FFF"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Top"
                             Margin="0,8,8,0" />
                </Grid>
            </Border>
        </Grid>


        <!-- ══════════════════════════════════════════════════════════════════
             EXPANDED MODE — 380×600 conversation panel
        ══════════════════════════════════════════════════════════════════ -->
        <Border Visibility="{x:Bind ViewModel.ExpandedVisibility, Mode=OneWay}"
                CornerRadius="14"
                Background="#1A1A2E"
                BorderBrush="#3F3F5A"
                BorderThickness="1">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />    <!-- Header / drag handle -->
                    <RowDefinition Height="*" />     <!-- Message list -->
                    <RowDefinition Height="Auto" />  <!-- Quick actions -->
                    <RowDefinition Height="Auto" />  <!-- Input area -->
                </Grid.RowDefinitions>

                <!-- ── Header (drag handle + controls) ──────────────────────── -->
                <Grid Grid.Row="0"
                      x:Name="ExpandedDragHandle"
                      Background="Transparent"
                      Padding="14,0,8,0"
                      PointerPressed="DragHandle_PointerPressed"
                      PointerMoved="DragHandle_PointerMoved"
                      PointerReleased="DragHandle_PointerReleased">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- App icon badge -->
                    <Border Grid.Column="0"
                            Width="24" Height="24"
                            CornerRadius="6"
                            Background="#4E9FFF"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">
                        <FontIcon Glyph="&#xE946;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="12"
                                  Foreground="White"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                    </Border>

                    <!-- Title area -->
                    <StackPanel Grid.Column="1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <TextBlock Text="Operational Companion"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#E4E4F0" />
                        <TextBlock Text="Local · Deterministic · Explainable"
                                   FontSize="10"
                                   Foreground="#6B6B8A" />
                    </StackPanel>

                    <!-- Action buttons (outside drag region — pointer events preserved) -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="2"
                                VerticalAlignment="Center">

                        <!-- Clear conversation -->
                        <Button Width="32" Height="32"
                                CornerRadius="8"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="ClearButton_Click"
                                ToolTipService.ToolTip="Clear conversation">
                            <FontIcon Glyph="&#xE74D;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="12"
                                      Foreground="#6B6B8A" />
                        </Button>

                        <!-- Collapse to bubble -->
                        <Button Width="32" Height="32"
                                CornerRadius="8"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="CollapseButton_Click"
                                ToolTipService.ToolTip="Minimize to bubble">
                            <FontIcon Glyph="&#xE921;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="12"
                                      Foreground="#6B6B8A" />
                        </Button>

                        <!-- Close / hide -->
                        <Button Width="32" Height="32"
                                CornerRadius="8"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="CloseButton_Click"
                                ToolTipService.ToolTip="Close companion">
                            <FontIcon Glyph="&#xE8BB;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="12"
                                      Foreground="#6B6B8A" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ── Divider ─────────────────────────────────────────────── -->
                <Border Grid.Row="0"
                        Height="1"
                        Background="#2A2A3E"
                        VerticalAlignment="Bottom"
                        IsHitTestVisible="False" />

                <!-- ── Message list ──────────────────────────────────────────── -->
                <ScrollViewer Grid.Row="1"
                              x:Name="MessageScroller"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,8,0,4">
                    <StackPanel Spacing="0">

                        <!-- Empty state hint -->
                        <Border Visibility="{x:Bind ViewModel.NoMessagesVisibility, Mode=OneWay}"
                                Margin="20,32,20,0">
                            <StackPanel Spacing="10" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE946;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="32"
                                          Foreground="#3F3F5A"
                                          HorizontalAlignment="Center" />
                                <TextBlock Text="Ask me anything about your system."
                                           FontSize="12"
                                           Foreground="#6B6B8A"
                                           TextAlignment="Center"
                                           TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Border>

                        <!-- Message bubbles -->
                        <ItemsRepeater x:Name="MessageList"
                                       ItemsSource="{x:Bind ViewModel.Messages, Mode=OneWay}"
                                       Margin="8,0">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="4" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="companion:CompanionMessage">
                                    <Grid Margin="4,4,4,0">

                                        <!-- User message — right-aligned blue bubble -->
                                        <Border Visibility="{x:Bind UserBubbleVisibility}"
                                                Background="#1E2F52"
                                                CornerRadius="12,12,4,12"
                                                Padding="12,8"
                                                MaxWidth="280"
                                                HorizontalAlignment="Right">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{x:Bind Text}"
                                                           FontSize="12.5"
                                                           Foreground="#E4E4F0"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind TimeLabel}"
                                                           FontSize="10"
                                                           Foreground="#6B7280"
                                                           HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Border>

                                        <!-- System message — left-aligned with icon -->
                                        <Grid Visibility="{x:Bind SystemBubbleVisibility}"
                                              HorizontalAlignment="Left"
                                              MaxWidth="305">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Category icon -->
                                            <Border Grid.Column="0"
                                                    Width="24" Height="24"
                                                    CornerRadius="12"
                                                    Background="#23233A"
                                                    VerticalAlignment="Top"
                                                    Margin="0,2,8,0">
                                                <FontIcon Glyph="{x:Bind CategoryGlyph}"
                                                          FontFamily="Segoe MDL2 Assets"
                                                          FontSize="11"
                                                          Foreground="{x:Bind CategoryColor}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                            </Border>

                                            <!-- Message bubble -->
                                            <Border Grid.Column="1"
                                                    Background="#23233A"
                                                    CornerRadius="4,12,12,12"
                                                    Padding="12,8">
                                                <StackPanel Spacing="5">
                                                    <TextBlock Text="{x:Bind Text}"
                                                               FontSize="12.5"
                                                               Foreground="#D4D4E8"
                                                               TextWrapping="Wrap"
                                                               LineHeight="18" />
                                                    <TextBlock Text="{x:Bind TimeLabel}"
                                                               FontSize="10"
                                                               Foreground="#4B5563" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <Border Height="8" />
                    </StackPanel>
                </ScrollViewer>

                <!-- ── Quick actions row ─────────────────────────────────────── -->
                <Border Grid.Row="2"
                        Background="#16162A"
                        BorderBrush="#2A2A3E"
                        BorderThickness="0,1,0,0">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  Padding="10,8">
                        <ItemsRepeater x:Name="QuickActionList"
                                       ItemsSource="{x:Bind ViewModel.QuickActions}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="6" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="companion:QuickAction">
                                    <!--
                                        Tag="{x:Bind}" passes the QuickAction object
                                        to the Click handler in code-behind.
                                        WinUI 3 x:Bind cannot resolve ViewModel commands
                                        from a DataTemplate whose DataContext is the item.
                                    -->
                                    <Button Background="#1E2233"
                                            BorderBrush="#3F3F5A"
                                            BorderThickness="1"
                                            CornerRadius="16"
                                            Padding="10,6"
                                            FontSize="11.5"
                                            Foreground="#B0B0C8"
                                            Tag="{x:Bind}"
                                            Click="QuickAction_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon Glyph="{x:Bind Glyph}"
                                                      FontFamily="Segoe MDL2 Assets"
                                                      FontSize="11"
                                                      Foreground="#6B9FFF" />
                                            <TextBlock Text="{x:Bind Label}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                </Border>

                <!-- ── Input area ────────────────────────────────────────────── -->
                <Border Grid.Row="3"
                        Background="#16162A"
                        BorderBrush="#2A2A3E"
                        BorderThickness="0,1,0,0"
                        Padding="10,8"
                        CornerRadius="0,0,14,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 x:Name="InputBox"
                                 Text="{x:Bind ViewModel.InputText, Mode=TwoWay}"
                                 PlaceholderText="Ask about your system…"
                                 Background="#0D0D1A"
                                 BorderBrush="#3F3F5A"
                                 Foreground="#E4E4F0"
                                 FontSize="12.5"
                                 CornerRadius="10,4,4,10"
                                 Padding="12,8"
                                 MinHeight="36"
                                 AcceptsReturn="False"
                                 TextWrapping="NoWrap"
                                 KeyDown="InputBox_KeyDown" />

                        <Button Grid.Column="1"
                                Width="36" Height="36"
                                CornerRadius="4,10,10,4"
                                Background="#4E9FFF"
                                BorderThickness="0"
                                Margin="4,0,0,0"
                                Click="SendButton_Click"
                                ToolTipService.ToolTip="Send (Enter)">
                            <FontIcon Glyph="&#xE724;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="14"
                                      Foreground="White" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

    </Grid>
</Window>
