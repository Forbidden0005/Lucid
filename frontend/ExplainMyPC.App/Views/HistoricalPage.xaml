<Page
    x:Class="ExplainMyPC.Views.HistoricalPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ExplainMyPC.Views"
    xmlns:vm="using:ExplainMyPC.ViewModels"
    Background="{StaticResource AppBackgroundBrush}">

    <!--
        HistoricalPage.xaml — Historical Intelligence
        ═══════════════════════════════════════════════════════════════════════
        Surfaces long-term operational patterns from the local SQLite database.

        Sections (top to bottom):
          1. Page header + Refresh button
          2. Loading indicator
          3. No-data placeholder (cold start)
          4. Coverage metadata bar
          5. Health score cards (7-day / 30-day side-by-side)
          6. Metric trend indicators (CPU · RAM · Disk)
          7. Recurring patterns list
          8. Narrative summary

        All content binds to HistoricalViewModel via DataContext (set in code-behind).
        No converters needed — all Visibility properties exposed directly from ViewModel.
    -->

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32,32,32,56" Spacing="24">

            <!-- ═══════════════════════════════════════════════════════════════
                 1. PAGE HEADER
            ═══════════════════════════════════════════════════════════════ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock Text="Historical Intelligence"
                               Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Long-term health scores, metric trends, and recurring patterns — built from your local operational database"
                               Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>

                <Button Grid.Column="1"
                        Command="{Binding RefreshCommand}"
                        VerticalAlignment="Center"
                        Padding="14,8"
                        CornerRadius="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                        <TextBlock Text="Refresh" FontSize="13" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════════
                 2. LOADING INDICATOR
            ═══════════════════════════════════════════════════════════════ -->
            <Border Visibility="{Binding LoadingVisibility}"
                    Background="{StaticResource AppSurfaceBrush}"
                    CornerRadius="12" Padding="20,16">
                <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center">
                    <ProgressRing IsActive="True" Width="20" Height="20" />
                    <TextBlock Text="Computing historical analysis…"
                               VerticalAlignment="Center"
                               Style="{StaticResource BodyTextStyle}" />
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════
                 3. NO-DATA PLACEHOLDER (cold start)
            ═══════════════════════════════════════════════════════════════ -->
            <Border Visibility="{Binding NoDataVisibility}"
                    Background="{StaticResource AppSurfaceBrush}"
                    CornerRadius="12" Padding="40,36">
                <StackPanel HorizontalAlignment="Center" Spacing="12">
                    <FontIcon Glyph="&#xE823;"
                              FontFamily="Segoe MDL2 Assets"
                              FontSize="40"
                              Foreground="{StaticResource SecondaryTextBrush}"
                              HorizontalAlignment="Center" />
                    <TextBlock Text="No historical data yet"
                               Style="{StaticResource SectionHeaderStyle}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="ExplainMyPC builds operational history as it runs. Leave the app open and historical intelligence will grow over days and weeks."
                               Style="{StaticResource SecondaryBodyStyle}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               MaxWidth="440" />
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════
                 DATA SECTIONS — only visible when HasData = true
            ═══════════════════════════════════════════════════════════════ -->
            <StackPanel Visibility="{Binding HasDataVisibility}" Spacing="24">

                <!-- ── 4. COVERAGE METADATA ───────────────────────────────── -->
                <Border Background="{StaticResource AppSurfaceBrush}"
                        CornerRadius="10" Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xEDA2;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="13"
                                      Foreground="{StaticResource AccentBlueBrush}" />
                            <TextBlock Text="{Binding OldestDataText}"
                                       Style="{StaticResource BodyTextStyle}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding CoverageDetail}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right" />
                    </Grid>
                </Border>

                <!-- ── 5. HEALTH SCORE CARDS ──────────────────────────────── -->
                <TextBlock Text="Health Scores"
                           Style="{StaticResource SectionHeaderStyle}" />

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 7-day health card -->
                    <Border Background="{StaticResource AppSurfaceBrush}"
                            CornerRadius="12" Padding="20,18">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE823;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="14"
                                          Foreground="{StaticResource AccentBlueBrush}" />
                                <TextBlock Text="7-Day Health"
                                           Style="{StaticResource MetricLabelStyle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Score + label -->
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SevenDayScore}"
                                           FontSize="40"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding SevenDayLabel}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryTextBrush}" />
                                    <TextBlock Text="{Binding SevenDayTrend}"
                                               Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Score bar -->
                            <ProgressBar Value="{Binding SevenDayScore}"
                                         Minimum="0" Maximum="100"
                                         Height="6" CornerRadius="3" />

                            <TextBlock Text="{Binding SevenDayDetail}"
                                       Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                    </Border>

                    <!-- 30-day health card -->
                    <Border Grid.Column="1"
                            Background="{StaticResource AppSurfaceBrush}"
                            CornerRadius="12" Padding="20,18">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE823;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="14"
                                          Foreground="{StaticResource AccentPurpleBrush}" />
                                <TextBlock Text="30-Day Health"
                                           Style="{StaticResource MetricLabelStyle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Score + label -->
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ThirtyDayScore}"
                                           FontSize="40"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding ThirtyDayLabel}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryTextBrush}" />
                                    <TextBlock Text="{Binding ThirtyDayTrend}"
                                               Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Score bar -->
                            <ProgressBar Value="{Binding ThirtyDayScore}"
                                         Minimum="0" Maximum="100"
                                         Height="6" CornerRadius="3" />

                            <TextBlock Text="{Binding ThirtyDayDetail}"
                                       Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ── 6. METRIC TRENDS ───────────────────────────────────── -->
                <TextBlock Text="Metric Trends"
                           Style="{StaticResource SectionHeaderStyle}" />

                <Border Background="{StaticResource AppSurfaceBrush}"
                        CornerRadius="12" Padding="20,16">
                    <StackPanel Spacing="0">

                        <!-- CPU -->
                        <Grid Padding="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE9F5;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="13"
                                          Foreground="{StaticResource AccentBlueBrush}" />
                                <TextBlock Text="CPU"
                                           Style="{StaticResource MetricLabelStyle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding CpuAvgText}"
                                       Style="{StaticResource CaptionTextStyle}"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0" />

                            <TextBlock Grid.Column="2"
                                       Text="{Binding CpuTrendLabel}"
                                       Style="{StaticResource BodyTextStyle}"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold" />
                        </Grid>

                        <Rectangle Height="1" Fill="{StaticResource SubtleDividerBrush}" />

                        <!-- RAM -->
                        <Grid Padding="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE950;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="13"
                                          Foreground="{StaticResource AccentGreenBrush}" />
                                <TextBlock Text="RAM"
                                           Style="{StaticResource MetricLabelStyle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding RamAvgText}"
                                       Style="{StaticResource CaptionTextStyle}"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0" />

                            <TextBlock Grid.Column="2"
                                       Text="{Binding RamTrendLabel}"
                                       Style="{StaticResource BodyTextStyle}"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold" />
                        </Grid>

                        <Rectangle Height="1" Fill="{StaticResource SubtleDividerBrush}" />

                        <!-- Disk -->
                        <Grid Padding="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xEDA2;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="13"
                                          Foreground="{StaticResource AccentOrangeBrush}" />
                                <TextBlock Text="Disk"
                                           Style="{StaticResource MetricLabelStyle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding DiskAvgText}"
                                       Style="{StaticResource CaptionTextStyle}"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0" />

                            <TextBlock Grid.Column="2"
                                       Text="{Binding DiskTrendLabel}"
                                       Style="{StaticResource BodyTextStyle}"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── 7. RECURRING PATTERNS ──────────────────────────────── -->
                <TextBlock Text="Recurring Issues"
                           Style="{StaticResource SectionHeaderStyle}" />

                <!-- Empty state for patterns (shown when Patterns collection is empty) -->
                <Border Background="{StaticResource AppSurfaceBrush}"
                        CornerRadius="10" Padding="20,14"
                        Visibility="{Binding NoPatternsVisibility}">
                    <TextBlock Text="No recurring issues detected in the past 30 days."
                               Style="{StaticResource SecondaryBodyStyle}" />
                </Border>

                <ItemsControl ItemsSource="{Binding Patterns}"
                              Visibility="{Binding HasPatternsVisibility}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RecurringPatternViewModel">
                            <Border Background="{StaticResource AppSurfaceBrush}"
                                    CornerRadius="10"
                                    Padding="18,14"
                                    Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE7BA;"
                                                      FontFamily="Segoe MDL2 Assets"
                                                      FontSize="13"
                                                      Foreground="{StaticResource StatusWarningBrush}" />
                                            <TextBlock Text="{x:Bind Title}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryTextBrush}" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,2,0,0">
                                            <TextBlock Text="{x:Bind OccurrencesText}"
                                                       Style="{StaticResource CaptionTextStyle}" />
                                            <TextBlock Text="·"
                                                       Style="{StaticResource CaptionTextStyle}" />
                                            <TextBlock Text="{x:Bind AvgDurationText}"
                                                       Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>

                                        <TextBlock Text="{x:Bind LastSeenText}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>

                                    <!-- Right side: frequency + escalating badge -->
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Spacing="6"
                                                HorizontalAlignment="Right">
                                        <Border Background="{StaticResource AppBackgroundBrush}"
                                                CornerRadius="6"
                                                Padding="8,3">
                                            <TextBlock Text="{x:Bind FrequencyLabel}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource SecondaryTextBrush}" />
                                        </Border>

                                        <!-- Escalating badge — only shown when escalating -->
                                        <Border Background="{StaticResource StatusWarningBrush}"
                                                CornerRadius="6"
                                                Padding="8,3"
                                                Visibility="{x:Bind EscalatingVisibility}">
                                            <TextBlock Text="{x:Bind EscalatingLabel}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="Black" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ── 8. NARRATIVE SUMMARY ────────────────────────────────── -->
                <TextBlock Text="Summary"
                           Style="{StaticResource SectionHeaderStyle}" />

                <Border Background="{StaticResource AppSurfaceBrush}"
                        CornerRadius="12" Padding="20,18">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{Binding NarrativeSummary}"
                                   Style="{StaticResource BodyTextStyle}"
                                   TextWrapping="Wrap"
                                   LineHeight="22" />
                        <TextBlock Text="{Binding ComputedAtText}"
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Border>

            </StackPanel>
            <!-- end HasDataVisibility panel -->

        </StackPanel>
    </ScrollViewer>
</Page>
