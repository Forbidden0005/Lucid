<Page
    x:Class="ExplainMyPC.Views.InsightsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ExplainMyPC.Views"
    xmlns:vm="using:ExplainMyPC.ViewModels"
    xmlns:intel="using:ExplainMyPC.Services.Intelligence"
    xmlns:learn="using:ExplainMyPC.Services.Learning"
    Background="{StaticResource AppBackgroundBrush}">

    <!--
        InsightsPage — Intelligence Workspace
        ═══════════════════════════════════════════════════════════════════════

        Layout: fixed header → tab bar → filter/sort bar → scrollable content.
        The outer Grid pins the top three rows and lets Row 3 (the content
        ScrollViewer) fill the remaining height so the page controls stay
        anchored while findings scroll.

        Templates:
          ActionCardTemplate   — exact copy from DashboardPage, no hover events
          InsightCardTemplate  — exact copy from DashboardPage, no hover events
          HistoryRecordTemplate — new timeline card for OperationRecord display

        Note: CompositeTransform is omitted from the insight card Border here
        (no hover-scale animation on this page). Each card in a long workspace
        list animating on hover would be expensive; the interaction model on
        this page is expand/collapse + action execution, not quick scan.
    -->
    <Page.Resources>

        <!--
            ══════════════════════════════════════════════════════════════════
            ACTION CARD TEMPLATE
            Immutable display card for a SystemAction. Identical to the one
            in DashboardPage — see that file for authoring notes.
            ══════════════════════════════════════════════════════════════════
        -->
        <DataTemplate x:Key="ActionCardTemplate"
                      x:DataType="vm:ActionCardViewModel">
            <Border Background="#0AFFFFFF"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,12">
                <StackPanel Spacing="10">

                    <!-- ── Header: icon · title / description · risk badge ── -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="32" Height="32"
                                CornerRadius="8"
                                Background="{x:Bind ImpactBackground}"
                                VerticalAlignment="Top">
                            <FontIcon Glyph="&#xE8BD;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="13"
                                      Foreground="{x:Bind ImpactBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="3">
                            <TextBlock Text="{x:Bind Title}"
                                       FontFamily="Segoe UI Variable"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{x:Bind Description}"
                                       Style="{StaticResource CaptionTextStyle}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Grid.Column="2"
                                Background="{x:Bind RiskBackground}"
                                CornerRadius="6"
                                Padding="8,4"
                                VerticalAlignment="Top">
                            <TextBlock Text="{x:Bind RiskLabel}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{x:Bind RiskBrush}" />
                        </Border>
                    </Grid>

                    <!-- ── Chips: impact · effort · reversible ──────────── -->
                    <StackPanel Orientation="Horizontal"
                                Spacing="6"
                                Margin="44,0,0,0">

                        <Border Background="{x:Bind ImpactBackground}"
                                CornerRadius="4"
                                Padding="8,3">
                            <TextBlock Text="{x:Bind ImpactLabel}"
                                       FontSize="11"
                                       Foreground="{x:Bind ImpactBrush}" />
                        </Border>

                        <Border Background="#0AFFFFFF"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,3">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE823;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="10"
                                          Foreground="{StaticResource TextSecondaryBrush}"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind EffortText}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Visibility="{x:Bind ReversibleVisibility}"
                                Background="{StaticResource StatusGoodSubtleBrush}"
                                CornerRadius="4"
                                Padding="8,3">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE72C;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="10"
                                          Foreground="{StaticResource StatusGoodBrush}"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="Reversible"
                                           FontSize="11"
                                           Foreground="{StaticResource StatusGoodBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ── Static confirmation risk notice ─────────────────── -->
                    <Border Visibility="{x:Bind ConfirmationVisibility}"
                            Background="{StaticResource StatusModerateSubtleBrush}"
                            CornerRadius="6"
                            Padding="10,7"
                            Margin="44,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7BA;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="12"
                                      Foreground="{StaticResource StatusModerateBrush}"
                                      VerticalAlignment="Top"
                                      Margin="0,1,0,0" />
                            <TextBlock Text="{x:Bind ConfirmationMessage}"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Foreground="{StaticResource StatusModerateBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- ══════════════════════════════════════════════════════
                         EXECUTION PANEL — identical to DashboardPage
                    ══════════════════════════════════════════════════════ -->

                    <Border Height="1"
                            Background="{StaticResource BorderSubtleBrush}"
                            Margin="44,2,0,2" />

                    <!-- IDLE: Run + Preview buttons -->
                    <StackPanel Visibility="{x:Bind Execution.IdleControlsVisibility, Mode=OneWay}"
                                Orientation="Horizontal"
                                Spacing="8"
                                Margin="44,0,0,0">
                        <Button Command="{x:Bind Execution.DryRunCommand}"
                                CornerRadius="5"
                                Padding="10,5">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE946;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="11"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="Preview"
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{x:Bind Execution.RunCommand}"
                                Background="{StaticResource StatusInfoTintBrush}"
                                CornerRadius="5"
                                Padding="10,5">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE768;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="11"
                                          Foreground="{StaticResource StatusInfoBrush}"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="Run"
                                           FontSize="12"
                                           Foreground="{StaticResource StatusInfoBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- IDLE: Coming soon chip -->
                    <Border Visibility="{x:Bind Execution.NotImplementedVisibility}"
                            Background="#08FFFFFF"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="9,4"
                            Margin="44,0,0,0"
                            HorizontalAlignment="Left">
                        <TextBlock Text="Coming soon"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </Border>

                    <!-- CONFIRMATION PENDING -->
                    <Border Visibility="{x:Bind Execution.ConfirmationVisibility, Mode=OneWay}"
                            Background="{StaticResource StatusModerateSubtleBrush}"
                            CornerRadius="8"
                            Padding="12,10"
                            Margin="44,0,0,0">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7BA;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="13"
                                          Foreground="{StaticResource StatusModerateBrush}"
                                          VerticalAlignment="Top"
                                          Margin="0,2,0,0" />
                                <TextBlock Text="{x:Bind Execution.ConfirmationMessage}"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Foreground="{StaticResource StatusModerateBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Command="{x:Bind Execution.ConfirmCommand}"
                                        CornerRadius="5"
                                        Padding="12,5">
                                    <TextBlock Text="Confirm" FontSize="12" />
                                </Button>
                                <Button Command="{x:Bind Execution.CancelConfirmationCommand}"
                                        CornerRadius="5"
                                        Padding="12,5">
                                    <TextBlock Text="Cancel" FontSize="12" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- RUNNING / DRY-RUNNING -->
                    <StackPanel Visibility="{x:Bind Execution.ProgressVisibility, Mode=OneWay}"
                                Orientation="Horizontal"
                                Spacing="10"
                                Margin="44,0,0,0">
                        <ProgressRing IsActive="{x:Bind Execution.IsRunning, Mode=OneWay}"
                                      Width="16" Height="16" />
                        <TextBlock Text="{x:Bind Execution.StatusMessage, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   VerticalAlignment="Center" />
                        <Button Command="{x:Bind Execution.CancelExecutionCommand}"
                                CornerRadius="4"
                                Padding="8,3"
                                VerticalAlignment="Center">
                            <TextBlock Text="Cancel" FontSize="11" />
                        </Button>
                    </StackPanel>

                    <!-- RESULT -->
                    <StackPanel Visibility="{x:Bind Execution.ResultVisibility, Mode=OneWay}"
                                Spacing="6"
                                Margin="44,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="{x:Bind Execution.StateGlyph, Mode=OneWay}"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="14"
                                      Foreground="{x:Bind Execution.StateBrush, Mode=OneWay}"
                                      VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind Execution.StatusMessage, Mode=OneWay}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{x:Bind Execution.StateBrush, Mode=OneWay}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Visibility="{x:Bind Execution.RollbackVisibility, Mode=OneWay}"
                                    Command="{x:Bind Execution.RollbackCommand}"
                                    CornerRadius="5"
                                    Padding="10,4">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE72C;"
                                              FontFamily="Segoe MDL2 Assets"
                                              FontSize="11"
                                              VerticalAlignment="Center" />
                                    <TextBlock Text="Undo"
                                               FontSize="11"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <HyperlinkButton Command="{x:Bind Execution.ResetToIdleCommand}"
                                             Content="Run again"
                                             FontSize="11"
                                             Padding="0"
                                             VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- LOG PANEL -->
                    <Border Visibility="{x:Bind Execution.LogVisibility, Mode=OneWay}"
                            Background="#07FFFFFF"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,8"
                            Margin="44,0,0,0">
                        <StackPanel Spacing="4">
                            <TextBlock Text="EXECUTION LOG"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       CharacterSpacing="100"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,4" />
                            <ItemsRepeater ItemsSource="{x:Bind Execution.LogEntries, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="3" Orientation="Vertical" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ActionLogEntryViewModel">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Timestamp}"
                                                       FontSize="10"
                                                       FontFamily="Cascadia Code, Consolas, Courier New"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Top" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind LevelLabel}"
                                                       FontSize="10"
                                                       FontFamily="Cascadia Code, Consolas, Courier New"
                                                       Foreground="{x:Bind LevelBrush}"
                                                       VerticalAlignment="Top" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{x:Bind Message}"
                                                       FontSize="11"
                                                       Foreground="{x:Bind LevelBrush}"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Top" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>
        </DataTemplate>

        <!--
            ══════════════════════════════════════════════════════════════════
            INSIGHT CARD TEMPLATE
            Live DataTemplate bound to InsightCardViewModel.
            Identical to DashboardPage except: no PointerEntered/PointerExited
            handlers and no CompositeTransform (no hover-scale animation here).
            ══════════════════════════════════════════════════════════════════
        -->
        <DataTemplate x:Key="InsightCardTemplate"
                      x:DataType="vm:InsightCardViewModel">
            <Border Style="{StaticResource CardSurface}"
                    Padding="20">
                <StackPanel Spacing="10">

                    <!-- ── Always-visible header row ────────────────────── -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Icon container -->
                        <Border Width="40" Height="40"
                                CornerRadius="10"
                                Background="{x:Bind IconContainerBackground, Mode=OneWay}"
                                VerticalAlignment="Top">
                            <FontIcon Glyph="{x:Bind IconGlyph, Mode=OneWay}"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="16"
                                      Foreground="{x:Bind AccentBrush, Mode=OneWay}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>

                        <!-- Title + one-line preview + confidence/timestamp -->
                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="4">
                            <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                       Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="{x:Bind DetailPreview, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextStyle}"
                                       TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal"
                                        Spacing="6"
                                        Margin="0,2,0,0">
                                <TextBlock Text="{x:Bind ConfidenceText, Mode=OneWay}"
                                           FontSize="11"
                                           Foreground="{x:Bind AccentBrush, Mode=OneWay}" />
                                <TextBlock Text="confidence  ·"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{x:Bind RelativeTime, Mode=OneWay}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Severity badge + correlation tag + expand toggle -->
                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Top"
                                    HorizontalAlignment="Right"
                                    Spacing="6">
                            <Border Background="{x:Bind BadgeBackground, Mode=OneWay}"
                                    CornerRadius="6"
                                    Padding="10,5">
                                <TextBlock Text="{x:Bind SeverityLabel, Mode=OneWay}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{x:Bind AccentBrush, Mode=OneWay}" />
                            </Border>

                            <!-- Correlated tag — only visible for synthesis insights -->
                            <Border Visibility="{x:Bind CorrelatedTagVisibility, Mode=OneWay}"
                                    Background="#0AFFFFFF"
                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,5"
                                    HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE71B;"
                                              FontFamily="Segoe MDL2 Assets"
                                              FontSize="10"
                                              Foreground="{StaticResource TextSecondaryBrush}"
                                              VerticalAlignment="Center" />
                                    <TextBlock Text="Correlated"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Trend tag — only visible for trend-aware findings -->
                            <Border Visibility="{x:Bind TrendTagVisibility, Mode=OneWay}"
                                    Background="{StaticResource StatusInfoTintBrush}"
                                    CornerRadius="6"
                                    Padding="10,5"
                                    HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE9D2;"
                                              FontFamily="Segoe MDL2 Assets"
                                              FontSize="10"
                                              Foreground="{StaticResource StatusInfoBrush}"
                                              VerticalAlignment="Center" />
                                    <TextBlock Text="Trend"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource StatusInfoBrush}" />
                                </StackPanel>
                            </Border>

                            <Button Command="{x:Bind ToggleExpandedCommand}"
                                    HorizontalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="4,2"
                                    CornerRadius="4">
                                <FontIcon Glyph="{x:Bind ExpandChevron, Mode=OneWay}"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="11"
                                          Foreground="{StaticResource TextSecondaryBrush}" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- ── Sparkline strip (metric history + trend) ─────── -->
                    <local:SparklineControl
                        Visibility="{x:Bind SparklineVisibility, Mode=OneWay}"
                        SparklineData="{x:Bind SparklineData, Mode=OneWay}"
                        Margin="0,4,0,0" />

                    <!-- ── Expandable detail panel ───────────────────────── -->
                    <StackPanel Visibility="{x:Bind ExpandedVisibility, Mode=OneWay}"
                                Spacing="12">

                        <Border Height="1"
                                Background="{StaticResource BorderSubtleBrush}" />

                        <!-- Full detail paragraph -->
                        <TextBlock Text="{x:Bind Detail, Mode=OneWay}"
                                   Style="{StaticResource BodyTextStyle}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />

                        <!-- Process attribution section -->
                        <Border Visibility="{x:Bind AttributionsVisibility, Mode=OneWay}"
                                Background="#07FFFFFF"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,10">
                            <StackPanel Spacing="8">
                                <TextBlock Text="ATTRIBUTED PROCESSES"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           CharacterSpacing="100"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <ItemsRepeater ItemsSource="{x:Bind AttributedProcesses, Mode=OneWay}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Spacing="6" Orientation="Vertical" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="intel:ProcessAttribution">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind DisplayName}"
                                                           FontFamily="Segoe UI Variable"
                                                           FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{x:Bind UsageText}"
                                                           FontFamily="Segoe UI Variable"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                           VerticalAlignment="Center" />
                                                <Border Grid.Column="2"
                                                        Background="#0AFFFFFF"
                                                        BorderBrush="{StaticResource BorderSubtleBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="7,2"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind KindLabel}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </Border>

                        <!-- Action hint chip -->
                        <Border Visibility="{x:Bind ActionHintVisibility}"
                                Background="{x:Bind ActionHintBackground}"
                                CornerRadius="6"
                                Padding="12,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE946;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="12"
                                          Foreground="{x:Bind AccentBrush}"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind ActionHint}"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Foreground="{x:Bind AccentBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Confidence bar -->
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Confidence"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ConfidenceText, Mode=OneWay}"
                                           FontSize="11"
                                           Foreground="{x:Bind AccentBrush, Mode=OneWay}" />
                            </StackPanel>
                            <ProgressBar Value="{x:Bind ConfidencePercent, Mode=OneWay}"
                                         Maximum="100"
                                         Style="{StaticResource ConfidenceBar}"
                                         Foreground="{x:Bind AccentBrush, Mode=OneWay}" />
                        </StackPanel>

                        <!-- Recommended actions -->
                        <StackPanel Visibility="{x:Bind ActionsVisibility, Mode=OneWay}"
                                    Spacing="8">
                            <Border Height="1"
                                    Background="{StaticResource BorderSubtleBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8BD;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="11"
                                          Foreground="{StaticResource TextSecondaryBrush}"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="Recommended Actions"
                                           FontFamily="Segoe UI Variable"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <ItemsRepeater ItemsSource="{x:Bind Actions, Mode=OneWay}"
                                           ItemTemplate="{StaticResource ActionCardTemplate}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="6" Orientation="Vertical" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                        </StackPanel>

                        <!-- Investigate link — drill into the full workspace -->
                        <Border Height="1"
                                Background="{StaticResource BorderSubtleBrush}" />
                        <Button Command="{x:Bind ViewDetailsCommand}"
                                HorizontalAlignment="Right"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="4,2"
                                CornerRadius="4">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="Investigate"
                                           FontFamily="Segoe UI Variable"
                                           FontSize="12"
                                           Foreground="{x:Bind AccentBrush, Mode=OneWay}"
                                           VerticalAlignment="Center" />
                                <FontIcon Glyph="&#xE76C;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="10"
                                          Foreground="{x:Bind AccentBrush, Mode=OneWay}"
                                          VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!--
            ══════════════════════════════════════════════════════════════════
            HISTORY RECORD TEMPLATE
            Timeline-style card for a persisted OperationRecord.
            Shows: status icon · title / timestamp / duration · message ·
            outcome badge · type badge · rollback/warning/error chips.
            ══════════════════════════════════════════════════════════════════
        -->
        <DataTemplate x:Key="HistoryRecordTemplate"
                      x:DataType="vm:HistoryRecordViewModel">
            <Border Background="#0AFFFFFF"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16,14">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Status icon circle -->
                    <Border Width="38" Height="38"
                            CornerRadius="19"
                            Background="{x:Bind StatusBackground}"
                            VerticalAlignment="Top">
                        <FontIcon Glyph="{x:Bind StatusGlyph}"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="15"
                                  Foreground="{x:Bind StatusBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                    </Border>

                    <!-- Content column -->
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Top">

                        <TextBlock Text="{x:Bind ActionTitle}"
                                   FontFamily="Segoe UI Variable"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                        <!-- Timing row -->
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{x:Bind TimestampText}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="·"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{x:Bind DurationText}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="·"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{x:Bind RelativeTime}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>

                        <!-- Outcome message -->
                        <TextBlock Text="{x:Bind Message}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />

                        <!-- Status chips row -->
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6"
                                    Margin="0,4,0,0">

                            <!-- Rolled-back indicator (forward execution that was later undone) -->
                            <Border Visibility="{x:Bind RolledBackBadgeVisibility}"
                                    Background="{StaticResource StatusInfoTintBrush}"
                                    CornerRadius="4"
                                    Padding="7,3">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE72C;"
                                              FontFamily="Segoe MDL2 Assets"
                                              FontSize="9"
                                              Foreground="{StaticResource StatusInfoBrush}"
                                              VerticalAlignment="Center" />
                                    <TextBlock Text="Later rolled back"
                                               FontSize="10"
                                               Foreground="{StaticResource StatusInfoBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Warning chip -->
                            <Border Visibility="{x:Bind WarningVisibility}"
                                    Background="{StaticResource StatusModerateSubtleBrush}"
                                    CornerRadius="4"
                                    Padding="7,3">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE7BA;"
                                              FontFamily="Segoe MDL2 Assets"
                                              FontSize="9"
                                              Foreground="{StaticResource StatusModerateBrush}"
                                              VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind WarningsText}"
                                               FontSize="10"
                                               Foreground="{StaticResource StatusModerateBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Error chip -->
                            <Border Visibility="{x:Bind ErrorVisibility}"
                                    Background="{StaticResource StatusCriticalSubtleBrush}"
                                    CornerRadius="4"
                                    Padding="7,3">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xEA39;"
                                              FontFamily="Segoe MDL2 Assets"
                                              FontSize="9"
                                              Foreground="{StaticResource StatusCriticalBrush}"
                                              VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind ErrorsText}"
                                               FontSize="10"
                                               Foreground="{StaticResource StatusCriticalBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </StackPanel>

                    <!-- Badge column: outcome + type -->
                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Top"
                                HorizontalAlignment="Right"
                                Spacing="4">
                        <Border Background="{x:Bind StatusBackground}"
                                CornerRadius="6"
                                Padding="9,4">
                            <TextBlock Text="{x:Bind StatusLabel}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{x:Bind StatusBrush}" />
                        </Border>
                        <Border Background="#0AFFFFFF"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="7,3"
                                HorizontalAlignment="Right">
                            <TextBlock Text="{x:Bind TypeLabel}"
                                       FontSize="10"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </Border>
                    </StackPanel>

                </Grid>
            </Border>
        </DataTemplate>

        <!--
            ══════════════════════════════════════════════════════════════════
            PRIORITIZED ACTION CARD TEMPLATE
            Display card for a PrioritizedActionViewModel on the Actions tab.
            Shows: impact glyph · title / effectiveness / source · priority badge.
            Read-only — no execution buttons (navigate to insight card to run).
            ══════════════════════════════════════════════════════════════════
        -->
        <DataTemplate x:Key="PrioritizedActionCardTemplate"
                      x:DataType="vm:PrioritizedActionViewModel">
            <Border Background="#0AFFFFFF"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16,14">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Impact icon circle -->
                    <Border Width="38" Height="38"
                            CornerRadius="10"
                            Background="#0AFFFFFF"
                            VerticalAlignment="Top">
                        <FontIcon Glyph="{x:Bind ImpactGlyph}"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="15"
                                  Foreground="{x:Bind ImpactColor}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                    </Border>

                    <!-- Content column -->
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Top">

                        <TextBlock Text="{x:Bind Title}"
                                   FontFamily="Segoe UI Variable"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                        <TextBlock Text="{x:Bind Description}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   TextWrapping="Wrap" />

                        <!-- Effectiveness + source attribution row -->
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    Margin="0,2,0,0">
                            <TextBlock Text="{x:Bind EffectivenessLabel}"
                                       FontSize="11"
                                       Foreground="{x:Bind EffectivenessColor}" />
                            <TextBlock Text="&#xB7;"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{x:Bind SourceInsightTitle}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                    </StackPanel>

                    <!-- Priority badge -->
                    <Border Grid.Column="2"
                            Background="#0AFFFFFF"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,5"
                            VerticalAlignment="Top">
                        <TextBlock Text="{x:Bind PriorityLabel}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{x:Bind PriorityColor}" />
                    </Border>

                </Grid>
            </Border>
        </DataTemplate>

    </Page.Resources>

    <!--
        ════════════════════════════════════════════════════════════════════
        PAGE ROOT — fixed header, tab bar, filter bar; scrollable content
        ════════════════════════════════════════════════════════════════════
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- Row 0: header -->
            <RowDefinition Height="Auto" />   <!-- Row 1: tab bar -->
            <RowDefinition Height="Auto" />   <!-- Row 2: filter + sort bar -->
            <RowDefinition Height="*" />      <!-- Row 3: scrollable content -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════════════
             ROW 0 — PAGE HEADER
             Title, subtitle, live indicator, and stat summary badges.
        ══════════════════════════════════════════════════════════════ -->
        <StackPanel Grid.Row="0"
                    Padding="32,32,32,20"
                    Spacing="20">

            <!-- Title row -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock Text="Intelligence Workspace"
                               Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Active findings, trend analysis, and correlated insights"
                               Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>

                <!-- Live indicator pill -->
                <Border Grid.Column="1"
                        Background="{StaticResource StatusGoodSubtleBrush}"
                        CornerRadius="12"
                        Padding="12,6"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="8" Height="8"
                                 Fill="{StaticResource StatusGoodBrush}" />
                        <TextBlock Text="Live"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Foreground="{StaticResource StatusGoodBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Stat summary badges -->
            <StackPanel Orientation="Horizontal" Spacing="10">

                <!-- All findings count -->
                <Border Background="#0AFFFFFF"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,8">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="32" Height="32"
                                CornerRadius="8"
                                Background="#0AFFFFFF">
                            <FontIcon Glyph="&#xE9CE;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="13"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.AllCountText, Mode=OneWay}"
                                       FontFamily="Segoe UI Variable"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="total findings"
                                       FontSize="10"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Warnings badge (hidden when 0) -->
                <Border Visibility="{x:Bind ViewModel.WarningBadgeVisibility, Mode=OneWay}"
                        Background="{StaticResource StatusModerateSubtleBrush}"
                        CornerRadius="8"
                        Padding="14,8">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="32" Height="32"
                                CornerRadius="8"
                                Background="{StaticResource StatusModerateSubtleBrush}">
                            <FontIcon Glyph="&#xE7BA;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="13"
                                      Foreground="{StaticResource StatusModerateBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.WarningCountText, Mode=OneWay}"
                                       FontFamily="Segoe UI Variable"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource StatusModerateBrush}" />
                            <TextBlock Text="warnings"
                                       FontSize="10"
                                       Foreground="{StaticResource StatusModerateBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Trend findings badge (hidden when 0) -->
                <Border Visibility="{x:Bind ViewModel.TrendBadgeVisibility, Mode=OneWay}"
                        Background="{StaticResource StatusInfoTintBrush}"
                        CornerRadius="8"
                        Padding="14,8">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="32" Height="32"
                                CornerRadius="8"
                                Background="{StaticResource StatusInfoTintBrush}">
                            <FontIcon Glyph="&#xE9D2;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="13"
                                      Foreground="{StaticResource StatusInfoBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.TrendCountText, Mode=OneWay}"
                                       FontFamily="Segoe UI Variable"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource StatusInfoBrush}" />
                            <TextBlock Text="trend findings"
                                       FontSize="10"
                                       Foreground="{StaticResource StatusInfoBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Correlated badge (hidden when 0) -->
                <Border Visibility="{x:Bind ViewModel.CorrelatedBadgeVisibility, Mode=OneWay}"
                        Background="{StaticResource StatusGoodSubtleBrush}"
                        CornerRadius="8"
                        Padding="14,8">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="32" Height="32"
                                CornerRadius="8"
                                Background="{StaticResource StatusGoodSubtleBrush}">
                            <FontIcon Glyph="&#xE71B;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="13"
                                      Foreground="{StaticResource StatusGoodBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.CorrelatedCountText, Mode=OneWay}"
                                       FontFamily="Segoe UI Variable"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource StatusGoodBrush}" />
                            <TextBlock Text="correlated"
                                       FontSize="10"
                                       Foreground="{StaticResource StatusGoodBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </StackPanel>

        <!-- ══════════════════════════════════════════════════════════════
             ROW 1 — TAB BAR
             Four content tabs: All Findings / Trends / Correlated / History.
             Each tab is a Grid with two rows: the button row and a 3 px
             accent indicator that is visible only when the tab is active.
        ══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="#0AFFFFFF"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,0,24,0">
            <StackPanel Orientation="Horizontal" Spacing="0">

                <!-- ── All Findings tab ─────────────────────────────── -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="3" />
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0"
                            Command="{x:Bind ViewModel.SelectTabAllCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="16,12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="All Findings"
                                       FontFamily="Segoe UI Variable"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{x:Bind ViewModel.AllTabBrush, Mode=OneWay}" />
                            <Border Background="#0AFFFFFF"
                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="7,2"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.AllCountText, Mode=OneWay}"
                                           FontSize="11"
                                           Foreground="{x:Bind ViewModel.AllTabBrush, Mode=OneWay}" />
                            </Border>
                        </StackPanel>
                    </Button>
                    <Border Grid.Row="1"
                            Background="{StaticResource AccentBlueBrush}"
                            CornerRadius="2,2,0,0"
                            Visibility="{x:Bind ViewModel.AllTabIndicatorVisibility, Mode=OneWay}" />
                </Grid>

                <!-- ── Trends tab ───────────────────────────────────── -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="3" />
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0"
                            Command="{x:Bind ViewModel.SelectTabTrendsCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="16,12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Trends"
                                       FontFamily="Segoe UI Variable"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{x:Bind ViewModel.TrendsTabBrush, Mode=OneWay}" />
                            <Border Visibility="{x:Bind ViewModel.TrendBadgeVisibility, Mode=OneWay}"
                                    Background="#0AFFFFFF"
                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="7,2"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.TrendCountText, Mode=OneWay}"
                                           FontSize="11"
                                           Foreground="{x:Bind ViewModel.TrendsTabBrush, Mode=OneWay}" />
                            </Border>
                        </StackPanel>
                    </Button>
                    <Border Grid.Row="1"
                            Background="{StaticResource AccentBlueBrush}"
                            CornerRadius="2,2,0,0"
                            Visibility="{x:Bind ViewModel.TrendsTabIndicatorVisibility, Mode=OneWay}" />
                </Grid>

                <!-- ── Correlated tab ───────────────────────────────── -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="3" />
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0"
                            Command="{x:Bind ViewModel.SelectTabCorrelatedCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="16,12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Correlated"
                                       FontFamily="Segoe UI Variable"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{x:Bind ViewModel.CorrelatedTabBrush, Mode=OneWay}" />
                            <Border Visibility="{x:Bind ViewModel.CorrelatedBadgeVisibility, Mode=OneWay}"
                                    Background="#0AFFFFFF"
                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="7,2"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.CorrelatedCountText, Mode=OneWay}"
                                           FontSize="11"
                                           Foreground="{x:Bind ViewModel.CorrelatedTabBrush, Mode=OneWay}" />
                            </Border>
                        </StackPanel>
                    </Button>
                    <Border Grid.Row="1"
                            Background="{StaticResource AccentBlueBrush}"
                            CornerRadius="2,2,0,0"
                            Visibility="{x:Bind ViewModel.CorrelatedTabIndicatorVisibility, Mode=OneWay}" />
                </Grid>

                <!-- ── History tab ──────────────────────────────────── -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="3" />
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0"
                            Command="{x:Bind ViewModel.SelectTabHistoryCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="16,12">
                        <TextBlock Text="History"
                                   FontFamily="Segoe UI Variable"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{x:Bind ViewModel.HistoryTabBrush, Mode=OneWay}" />
                    </Button>
                    <Border Grid.Row="1"
                            Background="{StaticResource AccentBlueBrush}"
                            CornerRadius="2,2,0,0"
                            Visibility="{x:Bind ViewModel.HistoryTabIndicatorVisibility, Mode=OneWay}" />
                </Grid>

                <!-- ── Actions tab ──────────────────────────────────── -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="3" />
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0"
                            Command="{x:Bind ViewModel.SelectTabActionsCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="16,12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Actions"
                                       FontFamily="Segoe UI Variable"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{x:Bind ViewModel.ActionsTabBrush, Mode=OneWay}" />
                            <Border Background="#0AFFFFFF"
                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="7,2"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.ActionsCountText, Mode=OneWay}"
                                           FontSize="11"
                                           Foreground="{x:Bind ViewModel.ActionsTabBrush, Mode=OneWay}" />
                            </Border>
                        </StackPanel>
                    </Button>
                    <Border Grid.Row="1"
                            Background="{StaticResource AccentBlueBrush}"
                            CornerRadius="2,2,0,0"
                            Visibility="{x:Bind ViewModel.ActionsTabIndicatorVisibility, Mode=OneWay}" />
                </Grid>

                <!-- ── Warnings tab ─────────────────────────────────── -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="3" />
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0"
                            Command="{x:Bind ViewModel.SelectTabWarningsCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="16,12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Warnings"
                                       FontFamily="Segoe UI Variable"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{x:Bind ViewModel.WarningsTabBrush, Mode=OneWay}" />
                            <Border Background="#0AFFFFFF"
                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="7,2"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.WarningsCountText, Mode=OneWay}"
                                           FontSize="11"
                                           Foreground="{x:Bind ViewModel.WarningsTabBrush, Mode=OneWay}" />
                            </Border>
                        </StackPanel>
                    </Button>
                    <Border Grid.Row="1"
                            Background="#F87171"
                            CornerRadius="2,2,0,0"
                            Visibility="{x:Bind ViewModel.WarningsTabIndicatorVisibility, Mode=OneWay}" />
                </Grid>

                <!-- ── Anomalies tab ─────────────────────────────────── -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="3" />
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0"
                            Command="{x:Bind ViewModel.SelectTabAnomaliesCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="16,12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Anomalies"
                                       FontFamily="Segoe UI Variable"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{x:Bind ViewModel.AnomaliesTabBrush, Mode=OneWay}" />
                            <Border Background="#0AFFFFFF"
                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="7,2"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.AnomaliesCountText, Mode=OneWay}"
                                           FontSize="11"
                                           Foreground="{x:Bind ViewModel.AnomaliesTabBrush, Mode=OneWay}" />
                            </Border>
                        </StackPanel>
                    </Button>
                    <Border Grid.Row="1"
                            Background="#FBBF24"
                            CornerRadius="2,2,0,0"
                            Visibility="{x:Bind ViewModel.AnomaliesTabIndicatorVisibility, Mode=OneWay}" />
                </Grid>

                <!-- ── Drift tab ─────────────────────────────────── -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="3" />
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0"
                            Command="{x:Bind ViewModel.SelectTabDriftCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="16,12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Drift"
                                       FontFamily="Segoe UI Variable"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{x:Bind ViewModel.DriftTabBrush, Mode=OneWay}" />
                            <Border Background="#0AFFFFFF"
                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="7,2"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.DriftsCountText, Mode=OneWay}"
                                           FontSize="11"
                                           Foreground="{x:Bind ViewModel.DriftTabBrush, Mode=OneWay}" />
                            </Border>
                        </StackPanel>
                    </Button>
                    <Border Grid.Row="1"
                            Background="#60A5FA"
                            CornerRadius="2,2,0,0"
                            Visibility="{x:Bind ViewModel.DriftTabIndicatorVisibility, Mode=OneWay}" />
                </Grid>

                <!-- ── Personalization tab ── -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="3" />
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0"
                            Command="{x:Bind ViewModel.SelectTabPersonalizationCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="16,12">
                        <TextBlock Text="Your Style"
                                   FontFamily="Segoe UI Variable"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{x:Bind ViewModel.PersonalizationTabBrush, Mode=OneWay}" />
                    </Button>
                    <Border Grid.Row="1"
                            Background="#8B5CF6"
                            CornerRadius="2,2,0,0"
                            Visibility="{x:Bind ViewModel.PersonalizationTabIndicatorVisibility, Mode=OneWay}" />
                </Grid>

            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════
             ROW 2 — FILTER + SORT BAR
             Severity filter chips (left) and sort mode chips (right).
             Hidden when the History tab is active.
        ══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Visibility="{x:Bind ViewModel.FilterBarVisibility, Mode=OneWay}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="32,8,32,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Severity filter chips -->
                <StackPanel Orientation="Horizontal"
                            Spacing="6"
                            VerticalAlignment="Center">

                    <TextBlock Text="Severity:"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,4,0" />

                    <Button Command="{x:Bind ViewModel.FilterAllCommand}"
                            Background="{x:Bind ViewModel.FilterAllBackground, Mode=OneWay}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,4">
                        <TextBlock Text="All"
                                   FontSize="11"
                                   Foreground="{x:Bind ViewModel.FilterAllBrush, Mode=OneWay}" />
                    </Button>

                    <Button Command="{x:Bind ViewModel.FilterWarningsCommand}"
                            Background="{x:Bind ViewModel.FilterWarningsBackground, Mode=OneWay}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,4">
                        <TextBlock Text="Warnings"
                                   FontSize="11"
                                   Foreground="{x:Bind ViewModel.FilterWarningsBrush, Mode=OneWay}" />
                    </Button>

                    <Button Command="{x:Bind ViewModel.FilterTipsCommand}"
                            Background="{x:Bind ViewModel.FilterTipsBackground, Mode=OneWay}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,4">
                        <TextBlock Text="Tips"
                                   FontSize="11"
                                   Foreground="{x:Bind ViewModel.FilterTipsBrush, Mode=OneWay}" />
                    </Button>

                    <Button Command="{x:Bind ViewModel.FilterInfoCommand}"
                            Background="{x:Bind ViewModel.FilterInfoBackground, Mode=OneWay}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,4">
                        <TextBlock Text="Info"
                                   FontSize="11"
                                   Foreground="{x:Bind ViewModel.FilterInfoBrush, Mode=OneWay}" />
                    </Button>

                </StackPanel>

                <!-- Sort chips -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="6"
                            VerticalAlignment="Center">

                    <TextBlock Text="Sort:"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,4,0" />

                    <Button Command="{x:Bind ViewModel.SortByConfidenceCommand}"
                            Background="{x:Bind ViewModel.SortConfidenceBackground, Mode=OneWay}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,4">
                        <TextBlock Text="Confidence ↓"
                                   FontSize="11"
                                   Foreground="{x:Bind ViewModel.SortConfidenceBrush, Mode=OneWay}" />
                    </Button>

                    <Button Command="{x:Bind ViewModel.SortBySeverityCommand}"
                            Background="{x:Bind ViewModel.SortSeverityBackground, Mode=OneWay}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,4">
                        <TextBlock Text="Severity"
                                   FontSize="11"
                                   Foreground="{x:Bind ViewModel.SortSeverityBrush, Mode=OneWay}" />
                    </Button>

                    <Button Command="{x:Bind ViewModel.SortByNewestCommand}"
                            Background="{x:Bind ViewModel.SortNewestBackground, Mode=OneWay}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,4">
                        <TextBlock Text="Newest"
                                   FontSize="11"
                                   Foreground="{x:Bind ViewModel.SortNewestBrush, Mode=OneWay}" />
                    </Button>

                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════
             ROW 3 — CONTENT
             Two overlapping panels: findings list and history list.
             Only one is visible at a time based on the active tab.
        ══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="3">

            <!-- ── FINDINGS PANEL (All / Trends / Correlated tabs) ──── -->
            <ScrollViewer Visibility="{x:Bind ViewModel.FindingsPanelVisibility, Mode=OneWay}"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="32,20,32,48" Spacing="16">

                    <!-- Findings list (visible when results exist) -->
                    <StackPanel Visibility="{x:Bind ViewModel.FindingsListVisibility, Mode=OneWay}"
                                Spacing="12">

                        <!-- Count header -->
                        <TextBlock Text="{x:Bind ViewModel.FindingsCountText, Mode=OneWay}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" />

                        <!-- Insight cards -->
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.DisplayedInsights, Mode=OneWay}"
                                       ItemTemplate="{StaticResource InsightCardTemplate}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="8" Orientation="Vertical" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>

                    </StackPanel>

                    <!-- Empty state (visible when no results match) -->
                    <Border Visibility="{x:Bind ViewModel.NoResultsVisibility, Mode=OneWay}"
                            Background="#0AFFFFFF"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="40,40">
                        <StackPanel HorizontalAlignment="Center"
                                    Spacing="12">
                            <FontIcon Glyph="&#xE9CE;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="36"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      HorizontalAlignment="Center" />
                            <TextBlock Text="No findings"
                                       FontFamily="Segoe UI Variable"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.EmptyStateMessage, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextStyle}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="380" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ── HISTORY PANEL (History tab) ─────────────────────── -->
            <ScrollViewer Visibility="{x:Bind ViewModel.HistoryPanelVisibility, Mode=OneWay}"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="32,20,32,48" Spacing="16">

                    <!-- Loading state -->
                    <StackPanel Visibility="{x:Bind ViewModel.HistoryLoadingVisibility, Mode=OneWay}"
                                Orientation="Horizontal"
                                Spacing="14"
                                HorizontalAlignment="Center"
                                Margin="0,48,0,0">
                        <ProgressRing IsActive="True"
                                      Width="22"
                                      Height="22" />
                        <TextBlock Text="Loading operation history…"
                                   Style="{StaticResource CaptionTextStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- History records list -->
                    <StackPanel Visibility="{x:Bind ViewModel.HistoryListVisibility, Mode=OneWay}"
                                Spacing="12">

                        <!-- Count header + refresh -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{x:Bind ViewModel.HistoryCountText, Mode=OneWay}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />

                            <Button Grid.Column="1"
                                    Command="{x:Bind ViewModel.RefreshHistoryCommand}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="8,4">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE72C;"
                                              FontFamily="Segoe MDL2 Assets"
                                              FontSize="11"
                                              Foreground="{StaticResource TextSecondaryBrush}"
                                              VerticalAlignment="Center" />
                                    <TextBlock Text="Refresh"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Timeline of records -->
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.HistoryRecords, Mode=OneWay}"
                                       ItemTemplate="{StaticResource HistoryRecordTemplate}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="6" Orientation="Vertical" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>

                    </StackPanel>

                    <!-- Empty history state -->
                    <Border Visibility="{x:Bind ViewModel.HistoryEmptyVisibility, Mode=OneWay}"
                            Background="#0AFFFFFF"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="40,40">
                        <StackPanel HorizontalAlignment="Center"
                                    Spacing="12">
                            <FontIcon Glyph="&#xE823;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="36"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      HorizontalAlignment="Center" />
                            <TextBlock Text="No history yet"
                                       FontFamily="Segoe UI Variable"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Actions you run from insight cards are recorded here as an audit trail. Rollbacks are tracked automatically."
                                       Style="{StaticResource CaptionTextStyle}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="340" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ── ACTIONS PANEL (Actions tab) ─────────────────────── -->
            <ScrollViewer Visibility="{x:Bind ViewModel.ActionsPanelVisibility, Mode=OneWay}"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="32,20,32,48" Spacing="16">

                    <!-- Actions list (visible when results exist) -->
                    <StackPanel Visibility="{x:Bind ViewModel.ActionsListVisibility, Mode=OneWay}"
                                Spacing="12">

                        <!-- Count header -->
                        <TextBlock Text="{x:Bind ViewModel.ActionsCountText, Mode=OneWay}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" />

                        <!-- Ranked action cards -->
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.DisplayedActions, Mode=OneWay}"
                                       ItemTemplate="{StaticResource PrioritizedActionCardTemplate}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="8" Orientation="Vertical" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>

                    </StackPanel>

                    <!-- Empty state (no active insights = no recommended actions) -->
                    <Border Visibility="{x:Bind ViewModel.ActionsEmptyVisibility, Mode=OneWay}"
                            Background="#0AFFFFFF"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="40,40">
                        <StackPanel HorizontalAlignment="Center"
                                    Spacing="12">
                            <FontIcon Glyph="&#xE8BD;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="36"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      HorizontalAlignment="Center" />
                            <TextBlock Text="No recommended actions"
                                       FontFamily="Segoe UI Variable"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Actions appear here when the intelligence engine detects active findings with recommended remediation steps."
                                       Style="{StaticResource CaptionTextStyle}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="360" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ── WARNINGS PANEL (Warnings tab) ───────────────────── -->
            <ScrollViewer Visibility="{x:Bind ViewModel.WarningsPanelVisibility, Mode=OneWay}"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="32,20,32,48" Spacing="16">

                    <!-- Warnings list -->
                    <StackPanel Visibility="{x:Bind ViewModel.WarningsListVisibility, Mode=OneWay}"
                                Spacing="12">
                        <TextBlock Text="{x:Bind ViewModel.WarningsCountText, Mode=OneWay}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.DisplayedWarnings, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="8" Orientation="Vertical" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="intel:EarlyWarning">
                                    <Border Background="#0AFFFFFF"
                                            BorderBrush="{StaticResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="16,14">
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <!-- Icon -->
                                            <Border Width="38" Height="38"
                                                    CornerRadius="10"
                                                    Background="{x:Bind SeverityBadgeColor}"
                                                    VerticalAlignment="Center">
                                                <FontIcon Glyph="{x:Bind Glyph}"
                                                          FontFamily="Segoe MDL2 Assets"
                                                          FontSize="16"
                                                          Foreground="{x:Bind SeverityColor}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                            </Border>
                                            <!-- Body -->
                                            <StackPanel Grid.Column="1"
                                                        Spacing="4"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Title}"
                                                           FontFamily="Segoe UI Variable"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind Explanation}"
                                                           FontSize="12"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap" />
                                                <StackPanel Orientation="Horizontal" Spacing="12">
                                                    <TextBlock Text="{x:Bind ConfidenceLabel}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{x:Bind DetectedLabel}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <!-- Severity badge -->
                                            <Border Grid.Column="2"
                                                    CornerRadius="8"
                                                    Padding="10,5"
                                                    Background="{x:Bind SeverityBadgeColor}"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind SeverityLabel}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{x:Bind SeverityColor}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>

                    <!-- Empty state -->
                    <Border Visibility="{x:Bind ViewModel.WarningsEmptyVisibility, Mode=OneWay}"
                            Background="#0AFFFFFF"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="40,40">
                        <StackPanel HorizontalAlignment="Center" Spacing="12">
                            <FontIcon Glyph="&#xE946;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="36"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      HorizontalAlignment="Center" />
                            <TextBlock Text="No active warnings"
                                       FontFamily="Segoe UI Variable"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Early warnings appear when anomaly detection or the Watchtower identifies unusual patterns worth your attention."
                                       Style="{StaticResource CaptionTextStyle}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="360" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ── ANOMALIES PANEL (Anomalies tab) ─────────────────── -->
            <ScrollViewer Visibility="{x:Bind ViewModel.AnomaliesPanelVisibility, Mode=OneWay}"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="32,20,32,48" Spacing="16">

                    <!-- Anomalies list -->
                    <StackPanel Visibility="{x:Bind ViewModel.AnomaliesListVisibility, Mode=OneWay}"
                                Spacing="12">
                        <TextBlock Text="{x:Bind ViewModel.AnomaliesCountText, Mode=OneWay}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.DisplayedAnomalies, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="8" Orientation="Vertical" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="intel:DetectedAnomaly">
                                    <Border Background="#0AFFFFFF"
                                            BorderBrush="{StaticResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="16,14">
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <!-- Metric icon -->
                                            <Border Width="38" Height="38"
                                                    CornerRadius="10"
                                                    Background="{x:Bind SeverityBadgeColor}"
                                                    VerticalAlignment="Center">
                                                <FontIcon Glyph="{x:Bind MetricGlyph}"
                                                          FontFamily="Segoe MDL2 Assets"
                                                          FontSize="16"
                                                          Foreground="{x:Bind SeverityColor}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                            </Border>
                                            <!-- Body -->
                                            <StackPanel Grid.Column="1"
                                                        Spacing="4"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Metric}"
                                                           FontFamily="Segoe UI Variable"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                <TextBlock Text="{x:Bind Description}"
                                                           FontSize="12"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap" />
                                                <StackPanel Orientation="Horizontal" Spacing="12">
                                                    <TextBlock Text="{x:Bind ExpectedMeanLabel}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{x:Bind DivergenceLabel}"
                                                               FontSize="11"
                                                               FontWeight="Medium"
                                                               Foreground="{x:Bind SeverityColor}" />
                                                    <TextBlock Text="{x:Bind DetectedLabel}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <!-- Severity badge -->
                                            <Border Grid.Column="2"
                                                    CornerRadius="8"
                                                    Padding="10,5"
                                                    Background="{x:Bind SeverityBadgeColor}"
                                                    VerticalAlignment="Center">
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="{x:Bind SeverityLabel}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{x:Bind SeverityColor}"
                                                               HorizontalAlignment="Center" />
                                                    <TextBlock Text="{x:Bind ActualValueLabel}"
                                                               FontSize="12"
                                                               FontWeight="Bold"
                                                               Foreground="{x:Bind SeverityColor}"
                                                               HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>

                    <!-- Empty state -->
                    <Border Visibility="{x:Bind ViewModel.AnomaliesEmptyVisibility, Mode=OneWay}"
                            Background="#0AFFFFFF"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="40,40">
                        <StackPanel HorizontalAlignment="Center" Spacing="12">
                            <FontIcon Glyph="&#xE9CE;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="36"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      HorizontalAlignment="Center" />
                            <TextBlock Text="No behavioral anomalies"
                                       FontFamily="Segoe UI Variable"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Anomalies appear when live telemetry deviates significantly from this machine's learned baseline. The baseline needs ~200 observations to activate."
                                       Style="{StaticResource CaptionTextStyle}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="380" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ── DRIFT PANEL (Drift tab) ──────────────────────────── -->
            <ScrollViewer Visibility="{x:Bind ViewModel.DriftPanelVisibility, Mode=OneWay}"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="32,20,32,48" Spacing="16">

                    <!-- Drift list -->
                    <StackPanel Visibility="{x:Bind ViewModel.DriftsListVisibility, Mode=OneWay}"
                                Spacing="12">
                        <TextBlock Text="{x:Bind ViewModel.DriftsCountText, Mode=OneWay}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.DisplayedDrifts, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="8" Orientation="Vertical" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="intel:DetectedDrift">
                                    <Border Background="#0AFFFFFF"
                                            BorderBrush="{StaticResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="16,14">
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <!-- Metric icon -->
                                            <Border Width="38" Height="38"
                                                    CornerRadius="10"
                                                    Background="#0AFFFFFF"
                                                    VerticalAlignment="Center">
                                                <FontIcon Glyph="{x:Bind MetricGlyph}"
                                                          FontFamily="Segoe MDL2 Assets"
                                                          FontSize="16"
                                                          Foreground="{x:Bind DirectionColor}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                            </Border>
                                            <!-- Body -->
                                            <StackPanel Grid.Column="1"
                                                        Spacing="4"
                                                        VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{x:Bind MetricName}"
                                                               FontFamily="Segoe UI Variable"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                    <TextBlock Text="{x:Bind DirectionGlyph}"
                                                               FontSize="14"
                                                               Foreground="{x:Bind DirectionColor}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind Summary}"
                                                           FontSize="12"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind AvgComparisonLabel}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                            </StackPanel>
                                            <!-- Change badge -->
                                            <Border Grid.Column="2"
                                                    CornerRadius="8"
                                                    Padding="10,5"
                                                    Background="#0AFFFFFF"
                                                    VerticalAlignment="Center">
                                                <StackPanel Spacing="3" HorizontalAlignment="Center">
                                                    <TextBlock Text="{x:Bind ChangeLabel}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{x:Bind DirectionColor}"
                                                               HorizontalAlignment="Center" />
                                                    <TextBlock Text="{x:Bind SeverityLabel}"
                                                               FontSize="10"
                                                               Foreground="{x:Bind SeverityColor}"
                                                               HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>

                    <!-- Empty state -->
                    <Border Visibility="{x:Bind ViewModel.DriftsEmptyVisibility, Mode=OneWay}"
                            Background="#0AFFFFFF"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="40,40">
                        <StackPanel HorizontalAlignment="Center" Spacing="12">
                            <FontIcon Glyph="&#xE74D;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="36"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      HorizontalAlignment="Center" />
                            <TextBlock Text="No drift detected"
                                       FontFamily="Segoe UI Variable"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Drift analysis appears after ~30 days of historical data. Drift observations represent gradual multi-week trends — not momentary spikes."
                                       Style="{StaticResource CaptionTextStyle}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="380" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ── PERSONALIZATION PANEL (Your Style tab) ──────────── -->
            <ScrollViewer Visibility="{x:Bind ViewModel.PersonalizationPanelVisibility, Mode=OneWay}"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="32,20,32,48" Spacing="20">

                    <!-- ── Warm state — profile data available ──────── -->
                    <StackPanel Visibility="{x:Bind ViewModel.PersonalizationDataVisibility, Mode=OneWay}"
                                Spacing="16">

                        <!-- Style card -->
                        <Border Background="#0AFFFFFF"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="20,16">
                            <StackPanel Spacing="12">

                                <!-- Header -->
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="{x:Bind ViewModel.PersonalizationStyleGlyph, Mode=OneWay}"
                                              FontFamily="Segoe MDL2 Assets"
                                              FontSize="20"
                                              Foreground="{x:Bind ViewModel.PersonalizationStyleColor, Mode=OneWay}" />
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind ViewModel.PersonalizationStyleLabel, Mode=OneWay}"
                                                   FontFamily="Segoe UI Variable"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{x:Bind ViewModel.PersonalizationStyleColor, Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind ViewModel.PersonalizationSampleCount, Mode=OneWay}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Text="{x:Bind ViewModel.PersonalizationStyleDesc, Mode=OneWay}"
                                           FontSize="13"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" />

                                <!-- Personal insight -->
                                <Border Background="#08FFFFFF"
                                        CornerRadius="8"
                                        Padding="12,8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE82D;"
                                                  FontFamily="Segoe MDL2 Assets"
                                                  FontSize="12"
                                                  Foreground="{x:Bind ViewModel.PersonalizationStyleColor, Mode=OneWay}"
                                                  VerticalAlignment="Top"
                                                  Margin="0,1,0,0" />
                                        <TextBlock Text="{x:Bind ViewModel.PersonalizationStyleInsight, Mode=OneWay}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- Acceptance rate summary -->
                                <Border Background="#0AFFFFFF"
                                        CornerRadius="8"
                                        Padding="12,8">
                                    <TextBlock Text="{x:Bind ViewModel.PersonalizationAcceptanceRate, Mode=OneWay}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Category breakdown -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Category Preferences"
                                       FontFamily="Segoe UI Variable"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.CategoryRateLines, Mode=OneWay}">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border Background="#0AFFFFFF"
                                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="12,8"
                                                Margin="0,0,0,4">
                                            <TextBlock Text="{x:Bind}"
                                                       FontSize="13"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>

                        <!-- Recent interaction history -->
                        <StackPanel Spacing="8"
                                    Visibility="{x:Bind ViewModel.PersonalizationInterventionListVisibility, Mode=OneWay}">
                            <TextBlock Text="Recent Interactions"
                                       FontFamily="Segoe UI Variable"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.RecentInterventions, Mode=OneWay}">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="learn:InterventionRecord">
                                        <Border Background="#0AFFFFFF"
                                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="12,10"
                                                Margin="0,0,0,4">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Accept/dismiss indicator -->
                                                <FontIcon Glyph="&#xE8FB;"
                                                          FontFamily="Segoe MDL2 Assets"
                                                          FontSize="12"
                                                          Foreground="#34D399"
                                                          VerticalAlignment="Center" />

                                                <!-- Action title + category -->
                                                <StackPanel Grid.Column="1"
                                                            Spacing="2"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind ActionTitle}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                    <TextBlock Text="{x:Bind Category}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                </StackPanel>

                                                <!-- Accepted badge -->
                                                <Border Grid.Column="2"
                                                        CornerRadius="6"
                                                        Padding="8,3"
                                                        Background="#0A34D399"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="Accepted"
                                                               FontSize="11"
                                                               Foreground="#34D399" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>

                    </StackPanel>

                    <!-- ── Cold state — not enough data yet ─────────── -->
                    <Border Visibility="{x:Bind ViewModel.PersonalizationColdVisibility, Mode=OneWay}"
                            Background="#0AFFFFFF"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="32,28">
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE8EF;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="32"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      HorizontalAlignment="Center" />
                            <TextBlock Text="Learning Your Style"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="ExplainMyPC adapts its recommendations as you interact with them. Accept or dismiss a few suggestions to get started."
                                       Style="{StaticResource CaptionTextStyle}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="380" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

        </Grid>

    </Grid>
</Page>
