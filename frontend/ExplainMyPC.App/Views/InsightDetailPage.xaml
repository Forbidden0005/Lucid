<Page
    x:Class="ExplainMyPC.Views.InsightDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ExplainMyPC.Views"
    xmlns:vm="using:ExplainMyPC.ViewModels"
    xmlns:intel="using:ExplainMyPC.Services.Intelligence"
    Background="{StaticResource AppBackgroundBrush}">

    <!--
        InsightDetailPage — Operational Investigation Workspace
        ═══════════════════════════════════════════════════════════════════════

        A full-page drill-down into a single intelligence finding. Presents:
          • Navigation bar with back button and breadcrumb
          • Insight summary (icon, title, detail, confidence, severity)
          • Expanded metric chart with time-window selector and stat row
          • Attributed processes
          • Related timeline events (filtered to this finding's ID)
          • Operational narrative (global prose from the narrative engine)
          • Confidence breakdown (rule type, sample coverage, reasoning)

        Everything scrolls together inside a single ScrollViewer so there is
        no fragmented focus management or nested scroll conflict.
    -->

    <Page.Resources>

        <!--
            Compact timeline event item — used in the Related Events section.
            Lighter than the full TimelinePage card (no expand toggle needed).
        -->
        <DataTemplate x:Key="RelatedEventTemplate"
                      x:DataType="vm:TimelineEventViewModel">
            <Border Background="#07FFFFFF"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,10">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Glyph circle -->
                    <Border Width="28" Height="28"
                            CornerRadius="14"
                            Background="{x:Bind AccentBackground}"
                            VerticalAlignment="Center">
                        <FontIcon Glyph="{x:Bind Glyph}"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="11"
                                  Foreground="{x:Bind AccentBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                    </Border>

                    <!-- Title -->
                    <TextBlock Grid.Column="1"
                               Text="{x:Bind Title}"
                               FontFamily="Segoe UI Variable"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <!-- Type chip -->
                    <Border Grid.Column="2"
                            Background="#0AFFFFFF"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="7,3"
                            VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind TypeLabel}"
                                   FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </Border>

                    <!-- Relative time -->
                    <TextBlock Grid.Column="3"
                               Text="{x:Bind RelativeTime}"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>

    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32,24,32,64" Spacing="0">

            <!-- ════════════════════════════════════════════════════════════
                 NAVIGATION BAR — Back button + breadcrumb + severity badge
            ════════════════════════════════════════════════════════════ -->
            <Grid Margin="0,0,0,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Back button -->
                <Button Click="OnGoBackClick"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0,0,16,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE76B;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="13"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="Intelligence"
                                   FontFamily="Segoe UI Variable"
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Breadcrumb separator + insight title -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <TextBlock Text="/"
                               FontSize="16"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Opacity="0.4" />
                    <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                               FontFamily="Segoe UI Variable"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Severity badge -->
                <Border Grid.Column="2"
                        Background="{x:Bind ViewModel.BadgeBackground, Mode=OneWay}"
                        CornerRadius="6"
                        Padding="12,6"
                        VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.SeverityLabel, Mode=OneWay}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{x:Bind ViewModel.AccentBrush, Mode=OneWay}" />
                </Border>
            </Grid>

            <!-- ════════════════════════════════════════════════════════════
                 CLEARED BANNER — shown when finding has resolved
            ════════════════════════════════════════════════════════════ -->
            <Border Visibility="{x:Bind ViewModel.ClearedVisibility, Mode=OneWay}"
                    Background="{StaticResource StatusGoodSubtleBrush}"
                    CornerRadius="10"
                    Padding="20,14"
                    Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE73E;"
                              FontFamily="Segoe MDL2 Assets"
                              FontSize="16"
                              Foreground="{StaticResource StatusGoodBrush}"
                              VerticalAlignment="Center" />
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Finding Resolved"
                                   FontFamily="Segoe UI Variable"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource StatusGoodBrush}" />
                        <TextBlock Text="This condition is no longer active. Historical data is shown below."
                                   FontSize="12"
                                   Foreground="{StaticResource StatusGoodBrush}"
                                   Opacity="0.8" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ════════════════════════════════════════════════════════════
                 INSIGHT SUMMARY CARD
            ════════════════════════════════════════════════════════════ -->
            <Border Style="{StaticResource CardSurface}"
                    Padding="24"
                    Margin="0,0,0,16">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Icon -->
                    <Border Width="48" Height="48"
                            CornerRadius="12"
                            Background="{x:Bind ViewModel.IconContainerBg, Mode=OneWay}"
                            VerticalAlignment="Top">
                        <FontIcon Glyph="{x:Bind ViewModel.IconGlyph}"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="20"
                                  Foreground="{x:Bind ViewModel.AccentBrush, Mode=OneWay}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                    </Border>

                    <!-- Content -->
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                                   Style="{StaticResource PageTitleStyle}"
                                   FontSize="20" />

                        <TextBlock Text="{x:Bind ViewModel.Detail, Mode=OneWay}"
                                   Style="{StaticResource BodyTextStyle}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />

                        <!-- Action hint -->
                        <Border Visibility="{x:Bind ViewModel.ActionHintVisibility, Mode=OneWay}"
                                Background="{x:Bind ViewModel.IconContainerBg, Mode=OneWay}"
                                CornerRadius="6"
                                Padding="12,8"
                                Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE946;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="12"
                                          Foreground="{x:Bind ViewModel.AccentBrush, Mode=OneWay}"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.ActionHint, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Foreground="{x:Bind ViewModel.AccentBrush, Mode=OneWay}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Meta row -->
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <Border Background="#0AFFFFFF"
                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="7,3">
                                <TextBlock Text="{x:Bind ViewModel.RuleIdDisplay}"
                                           FontFamily="Cascadia Code, Consolas, Courier New"
                                           FontSize="10"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </Border>
                            <TextBlock Text="·"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.RelativeTime, Mode=OneWay}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Confidence panel -->
                    <StackPanel Grid.Column="2"
                                Width="120"
                                Spacing="6"
                                VerticalAlignment="Top">
                        <TextBlock Text="Confidence"
                                   FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.ConfidenceText, Mode=OneWay}"
                                   FontFamily="Segoe UI Variable"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="{x:Bind ViewModel.AccentBrush, Mode=OneWay}"
                                   HorizontalAlignment="Center" />
                        <ProgressBar Value="{x:Bind ViewModel.ConfidencePercent, Mode=OneWay}"
                                     Maximum="100"
                                     Style="{StaticResource ConfidenceBar}"
                                     Foreground="{x:Bind ViewModel.AccentBrush, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ════════════════════════════════════════════════════════════
                 METRIC HISTORY CHART
            ════════════════════════════════════════════════════════════ -->
            <Border Visibility="{x:Bind ViewModel.ChartVisibility, Mode=OneWay}"
                    Style="{StaticResource CardSurface}"
                    Padding="24"
                    Margin="0,0,0,16">
                <StackPanel Spacing="16">

                    <!-- Header + time window chips -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="3">
                            <TextBlock Text="METRIC HISTORY"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       CharacterSpacing="100"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.WindowLabel, Mode=OneWay}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>

                        <!-- Time window selector -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="4">
                            <Button Command="{x:Bind ViewModel.SelectWin1MinCommand}"
                                    Background="{x:Bind ViewModel.Win1MinBg, Mode=OneWay}"
                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="9,4">
                                <TextBlock Text="1 min"
                                           FontSize="11"
                                           Foreground="{x:Bind ViewModel.Win1MinFg, Mode=OneWay}" />
                            </Button>
                            <Button Command="{x:Bind ViewModel.SelectWin5MinCommand}"
                                    Background="{x:Bind ViewModel.Win5MinBg, Mode=OneWay}"
                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="9,4">
                                <TextBlock Text="5 min"
                                           FontSize="11"
                                           Foreground="{x:Bind ViewModel.Win5MinFg, Mode=OneWay}" />
                            </Button>
                            <Button Command="{x:Bind ViewModel.SelectWin15MinCommand}"
                                    Background="{x:Bind ViewModel.Win15MinBg, Mode=OneWay}"
                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="9,4">
                                <TextBlock Text="15 min"
                                           FontSize="11"
                                           Foreground="{x:Bind ViewModel.Win15MinFg, Mode=OneWay}" />
                            </Button>
                            <Button Command="{x:Bind ViewModel.SelectWin30MinCommand}"
                                    Background="{x:Bind ViewModel.Win30MinBg, Mode=OneWay}"
                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="9,4">
                                <TextBlock Text="30 min"
                                           FontSize="11"
                                           Foreground="{x:Bind ViewModel.Win30MinFg, Mode=OneWay}" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Chart canvas -->
                    <local:InsightDetailChart ChartData="{x:Bind ViewModel.ChartData, Mode=OneWay}"
                                              Height="200"
                                              HorizontalAlignment="Stretch" />

                    <!-- Stat row -->
                    <Border Background="#05FFFFFF"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Current -->
                            <StackPanel HorizontalAlignment="Center" Spacing="2">
                                <TextBlock Text="Current"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           CharacterSpacing="80"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.CurrentText, Mode=OneWay}"
                                           FontFamily="Segoe UI Variable"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{x:Bind ViewModel.AccentBrush, Mode=OneWay}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>

                            <!-- Average -->
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="2">
                                <TextBlock Text="Average"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           CharacterSpacing="80"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.AverageText, Mode=OneWay}"
                                           FontFamily="Segoe UI Variable"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>

                            <!-- Min -->
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="2">
                                <TextBlock Text="Min"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           CharacterSpacing="80"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.MinText, Mode=OneWay}"
                                           FontFamily="Segoe UI Variable"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>

                            <!-- Max -->
                            <StackPanel Grid.Column="3" HorizontalAlignment="Center" Spacing="2">
                                <TextBlock Text="Max"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           CharacterSpacing="80"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.MaxText, Mode=OneWay}"
                                           FontFamily="Segoe UI Variable"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>

                            <!-- Trend -->
                            <StackPanel Grid.Column="4" HorizontalAlignment="Center" Spacing="2">
                                <TextBlock Text="Trend"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           CharacterSpacing="80"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.TrendText, Mode=OneWay}"
                                           FontFamily="Segoe UI Variable"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>

                </StackPanel>
            </Border>

            <!-- No-chart notice (for forecast / synthesis / session insights) -->
            <Border Visibility="{x:Bind ViewModel.NoChartVisibility, Mode=OneWay}"
                    Background="#07FFFFFF"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="20,16"
                    Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE946;"
                              FontFamily="Segoe MDL2 Assets"
                              FontSize="14"
                              Foreground="{StaticResource TextSecondaryBrush}"
                              VerticalAlignment="Center" />
                    <TextBlock Text="No direct metric is associated with this finding type. Check the narrative and timeline sections for context."
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- ════════════════════════════════════════════════════════════
                 ATTRIBUTED PROCESSES
            ════════════════════════════════════════════════════════════ -->
            <Border Visibility="{x:Bind ViewModel.ProcessesVisibility, Mode=OneWay}"
                    Style="{StaticResource CardSurface}"
                    Padding="24"
                    Margin="0,0,0,16">
                <StackPanel Spacing="14">

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE9F5;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="12"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="ATTRIBUTED PROCESSES"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   CharacterSpacing="100"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.AttributedProcesses, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="8" Orientation="Vertical" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="intel:ProcessAttribution">
                                <Border Background="#07FFFFFF"
                                        BorderBrush="{StaticResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14,10">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="{x:Bind DisplayName}"
                                                       FontFamily="Segoe UI Variable"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind UsageText}"
                                                   FontFamily="Segoe UI Variable"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                   VerticalAlignment="Center" />

                                        <Border Grid.Column="2"
                                                Background="#0AFFFFFF"
                                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="8,3"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind KindLabel}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                </StackPanel>
            </Border>

            <!-- ════════════════════════════════════════════════════════════
                 RELATED TIMELINE EVENTS
            ════════════════════════════════════════════════════════════ -->
            <Border Visibility="{x:Bind ViewModel.RelatedEventsVisibility, Mode=OneWay}"
                    Style="{StaticResource CardSurface}"
                    Padding="24"
                    Margin="0,0,0,16">
                <StackPanel Spacing="14">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE823;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="12"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock Text="RELATED TIMELINE EVENTS"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       CharacterSpacing="100"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <Border Grid.Column="1"
                                Background="#0AFFFFFF"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="9,4">
                            <TextBlock Text="{x:Bind ViewModel.RelatedEventsHeader, Mode=OneWay}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </Border>
                    </Grid>

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.RelatedEvents, Mode=OneWay}"
                                   ItemTemplate="{StaticResource RelatedEventTemplate}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="6" Orientation="Vertical" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>

                </StackPanel>
            </Border>

            <!-- ════════════════════════════════════════════════════════════
                 REMEDIATION HISTORY
            ════════════════════════════════════════════════════════════ -->
            <Border Style="{StaticResource CardSurface}"
                    Padding="24"
                    Margin="0,0,0,16">
                <StackPanel Spacing="14">

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8BD;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="12"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="REMEDIATION HISTORY"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   CharacterSpacing="100"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Loading spinner -->
                    <StackPanel Visibility="{x:Bind ViewModel.HistoryLoadingVisibility, Mode=OneWay}"
                                Orientation="Horizontal"
                                Spacing="12"
                                HorizontalAlignment="Center"
                                Margin="0,8,0,8">
                        <ProgressRing IsActive="True" Width="18" Height="18" />
                        <TextBlock Text="Loading history…"
                                   Style="{StaticResource CaptionTextStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Records list -->
                    <StackPanel Visibility="{x:Bind ViewModel.HistoryListVisibility, Mode=OneWay}"
                                Spacing="6">
                        <TextBlock Text="{x:Bind ViewModel.HistoryCountText, Mode=OneWay}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.ActionHistory, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="6" Orientation="Vertical" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:HistoryRecordViewModel">
                                    <Border Background="#0AFFFFFF"
                                            BorderBrush="{StaticResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14,11">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Width="32" Height="32"
                                                    CornerRadius="16"
                                                    Background="{x:Bind StatusBackground}"
                                                    VerticalAlignment="Center">
                                                <FontIcon Glyph="{x:Bind StatusGlyph}"
                                                          FontFamily="Segoe MDL2 Assets"
                                                          FontSize="12"
                                                          Foreground="{x:Bind StatusBrush}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                            </Border>

                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind ActionTitle}"
                                                           FontFamily="Segoe UI Variable"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <TextBlock Text="{x:Bind RelativeTime}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBlock Text="·"
                                                               FontSize="10"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{x:Bind DurationText}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <Border Grid.Column="2"
                                                    Background="{x:Bind StatusBackground}"
                                                    CornerRadius="5"
                                                    Padding="8,4"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind StatusLabel}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{x:Bind StatusBrush}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>

                    <!-- Empty state -->
                    <Border Visibility="{x:Bind ViewModel.HistoryEmptyVisibility, Mode=OneWay}"
                            Background="#05FFFFFF"
                            CornerRadius="8"
                            Padding="16,12">
                        <TextBlock Text="No remediation actions have been taken for this finding yet."
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                    </Border>

                </StackPanel>
            </Border>

            <!-- ════════════════════════════════════════════════════════════
                 OPERATIONAL NARRATIVE
            ════════════════════════════════════════════════════════════ -->
            <Border Visibility="{x:Bind ViewModel.NarrativeVisibility, Mode=OneWay}"
                    Style="{StaticResource CardSurface}"
                    Padding="24"
                    Margin="0,0,0,16">
                <StackPanel Spacing="14">

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8D4;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="12"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="OPERATIONAL NARRATIVE"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   CharacterSpacing="100"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Headline -->
                    <TextBlock Text="{x:Bind ViewModel.NarrativeHeadline, Mode=OneWay}"
                               FontFamily="Segoe UI Variable"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               TextWrapping="Wrap" />

                    <!-- Paragraphs — rendered as an ItemsRepeater for live updates -->
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.NarrativeParagraphs, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="10" Orientation="Vertical" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           Style="{StaticResource BodyTextStyle}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                </StackPanel>
            </Border>

            <!-- ════════════════════════════════════════════════════════════
                 CONFIDENCE BREAKDOWN
            ════════════════════════════════════════════════════════════ -->
            <Border Style="{StaticResource CardSurface}"
                    Padding="24">
                <StackPanel Spacing="16">

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE9CE;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="12"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="CONFIDENCE BREAKDOWN"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   CharacterSpacing="100"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Rule + confidence row -->
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="10">

                            <!-- Rule ID badge -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Rule"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                                <Border Background="#0AFFFFFF"
                                        BorderBrush="{StaticResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="8,3">
                                    <TextBlock Text="{x:Bind ViewModel.RuleIdDisplay}"
                                               FontFamily="Cascadia Code, Consolas, Courier New"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                </Border>
                            </StackPanel>

                            <!-- Sample / coverage -->
                            <Grid ColumnSpacing="32">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="2">
                                    <TextBlock Text="Evidence"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               CharacterSpacing="80"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.SampleCountText, Mode=OneWay}"
                                               FontFamily="Segoe UI Variable"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Coverage"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               CharacterSpacing="80"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.CoverageText, Mode=OneWay}"
                                               FontFamily="Segoe UI Variable"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </Grid>

                            <!-- Rule type explanation -->
                            <Border Background="#07FFFFFF"
                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,8">
                                <TextBlock Text="{x:Bind ViewModel.ConfidenceRuleText, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </Border>

                        </StackPanel>

                        <!-- Big confidence number -->
                        <StackPanel Grid.Column="1"
                                    Width="110"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="8">
                            <TextBlock Text="{x:Bind ViewModel.ConfidenceText, Mode=OneWay}"
                                       FontFamily="Segoe UI Variable"
                                       FontSize="36"
                                       FontWeight="Bold"
                                       Foreground="{x:Bind ViewModel.AccentBrush, Mode=OneWay}"
                                       HorizontalAlignment="Center" />
                            <ProgressBar Value="{x:Bind ViewModel.ConfidencePercent, Mode=OneWay}"
                                         Maximum="100"
                                         Style="{StaticResource ConfidenceBar}"
                                         Foreground="{x:Bind ViewModel.AccentBrush, Mode=OneWay}" />
                            <TextBlock Text="confidence score"
                                       FontSize="10"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>

</Page>
