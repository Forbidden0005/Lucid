<Application
    x:Class="ExplainMyPC.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- WinUI base styles (must come first) -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Our dark theme colors and brushes -->
                <ResourceDictionary Source="ms-appx:///Styles/AppColors.xaml" />
                <!-- Typography styles -->
                <ResourceDictionary Source="ms-appx:///Styles/AppTypography.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

</Application>
