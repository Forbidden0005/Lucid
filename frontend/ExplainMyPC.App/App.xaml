<Application
    x:Class="ExplainMyPC.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                    XamlControlsResources must come first so our overrides
                    in subsequent dictionaries take precedence.
                -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Styles/AppColors.xaml" />
                <ResourceDictionary Source="ms-appx:///Styles/AppTypography.xaml" />
                <ResourceDictionary Source="ms-appx:///Styles/AppControls.xaml" />
                <ResourceDictionary Source="ms-appx:///Styles/GraphStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

</Application>
