<Page
    x:Class="Lucid.Views.AppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource AppBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32" Spacing="24">

            <StackPanel Spacing="4">
                <TextBlock Text="Apps"
                           Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Installed applications and startup impact"
                           Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>

            <!-- Startup apps -->
            <TextBlock Text="Startup Apps (12)"
                       Style="{StaticResource SectionTitleStyle}" />

            <Border Background="{StaticResource AppSurfaceBrush}"
                    CornerRadius="10" Padding="20"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Spotify" Style="{StaticResource BodyTextStyle}" />
                        <TextBlock Grid.Column="1" Text="High impact"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Foreground="{StaticResource DangerBrush}" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Discord" Style="{StaticResource BodyTextStyle}" />
                        <TextBlock Grid.Column="1" Text="High impact"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Foreground="{StaticResource DangerBrush}" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="OneDrive" Style="{StaticResource BodyTextStyle}" />
                        <TextBlock Grid.Column="1" Text="Medium impact"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Foreground="{StaticResource WarningBrush}" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Windows Security" Style="{StaticResource BodyTextStyle}" />
                        <TextBlock Grid.Column="1" Text="Low impact"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Foreground="{StaticResource SuccessBrush}" />
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>

