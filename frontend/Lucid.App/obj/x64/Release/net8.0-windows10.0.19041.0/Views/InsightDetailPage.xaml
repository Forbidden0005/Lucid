<Page x:ConnectionId='1'
    x:Class="ExplainMyPC.Views.InsightDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ExplainMyPC.Views"
    xmlns:vm="using:ExplainMyPC.ViewModels"
    xmlns:intel="using:ExplainMyPC.Services.Intelligence"
    Background="{StaticResource AppBackgroundBrush}">

    <!--
        InsightDetailPage — Operational Investigation Workspace
        ═══════════════════════════════════════════════════════════════════════

        A full-page drill-down into a single intelligence finding. Presents:
          • Navigation bar with back button and breadcrumb
          • Insight summary (icon, title, detail, confidence, severity)
          • Expanded metric chart with time-window selector and stat row
          • Attributed processes
          • Related timeline events (filtered to this finding's ID)
          • Operational narrative (global prose from the narrative engine)
          • Confidence breakdown (rule type, sample coverage, reasoning)

        Everything scrolls together inside a single ScrollViewer so there is
        no fragmented focus management or nested scroll conflict.
    -->

    <Page.Resources>

        <!--
            Compact timeline event item — used in the Related Events section.
            Lighter than the full TimelinePage card (no expand toggle needed).
        -->
        <DataTemplate x:Key="RelatedEventTemplate"
                                                            >
            <Border x:ConnectionId='3' Background="#07FFFFFF"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,10">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Glyph circle -->
                    <Border x:ConnectionId='4' Width="28" Height="28"
                            CornerRadius="14"
                                                                  
                            VerticalAlignment="Center">
                        <FontIcon x:ConnectionId='8'                       
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="11"
                                                                   
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                    </Border>

                    <!-- Title -->
                    <TextBlock x:ConnectionId='5' Grid.Column="1"
                                                    
                               FontFamily="Segoe UI Variable"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <!-- Type chip -->
                    <Border Grid.Column="2"
                            Background="#0AFFFFFF"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="7,3"
                            VerticalAlignment="Center">
                        <TextBlock x:ConnectionId='7'                          
                                   FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </Border>

                    <!-- Relative time -->
                    <TextBlock x:ConnectionId='6' Grid.Column="3"
                                                           
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>

    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32,24,32,64" Spacing="0">

            <!-- ════════════════════════════════════════════════════════════
                 NAVIGATION BAR — Back button + breadcrumb + severity badge
            ════════════════════════════════════════════════════════════ -->
            <Grid Margin="0,0,0,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Back button -->
                <Button x:ConnectionId='72'                      
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0,0,16,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE76B;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="13"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="Intelligence"
                                   FontFamily="Segoe UI Variable"
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Breadcrumb separator + insight title -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <TextBlock Text="/"
                               FontSize="16"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Opacity="0.4" />
                    <TextBlock x:ConnectionId='75'                                             
                               FontFamily="Segoe UI Variable"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Severity badge -->
                <Border x:ConnectionId='73' Grid.Column="2"
                                                                                    
                        CornerRadius="6"
                        Padding="12,6"
                        VerticalAlignment="Center">
                    <TextBlock x:ConnectionId='74'                                                     
                               FontSize="12"
                               FontWeight="SemiBold"
                                                                                        />
                </Border>
            </Grid>

            <!-- ════════════════════════════════════════════════════════════
                 CLEARED BANNER — shown when finding has resolved
            ════════════════════════════════════════════════════════════ -->
            <Border x:ConnectionId='9'                                                               
                    Background="{StaticResource StatusGoodSubtleBrush}"
                    CornerRadius="10"
                    Padding="20,14"
                    Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE73E;"
                              FontFamily="Segoe MDL2 Assets"
                              FontSize="16"
                              Foreground="{StaticResource StatusGoodBrush}"
                              VerticalAlignment="Center" />
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Finding Resolved"
                                   FontFamily="Segoe UI Variable"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource StatusGoodBrush}" />
                        <TextBlock Text="This condition is no longer active. Historical data is shown below."
                                   FontSize="12"
                                   Foreground="{StaticResource StatusGoodBrush}"
                                   Opacity="0.8" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ════════════════════════════════════════════════════════════
                 INSIGHT SUMMARY CARD
            ════════════════════════════════════════════════════════════ -->
            <Border Style="{StaticResource CardSurface}"
                    Padding="24"
                    Margin="0,0,0,16">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Icon -->
                    <Border x:ConnectionId='61' Width="48" Height="48"
                            CornerRadius="12"
                                                                                        
                            VerticalAlignment="Top">
                        <FontIcon x:ConnectionId='71'                                     
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="20"
                                                                                          
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                    </Border>

                    <!-- Content -->
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock x:ConnectionId='64'                                             
                                   Style="{StaticResource PageTitleStyle}"
                                   FontSize="20" />

                        <TextBlock x:ConnectionId='65'                                              
                                   Style="{StaticResource BodyTextStyle}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />

                        <!-- Action hint -->
                        <Border x:ConnectionId='66'                                                                  
                                                                                            
                                CornerRadius="6"
                                Padding="12,8"
                                Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon x:ConnectionId='69' Glyph="&#xE946;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="12"
                                                                                                  
                                          VerticalAlignment="Center" />
                                <TextBlock x:ConnectionId='70'                                                  
                                           Style="{StaticResource CaptionTextStyle}"
                                                                                                   
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Meta row -->
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <Border Background="#0AFFFFFF"
                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="7,3">
                                <TextBlock x:ConnectionId='68'                                        
                                           FontFamily="Cascadia Code, Consolas, Courier New"
                                           FontSize="10"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </Border>
                            <TextBlock Text="·"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:ConnectionId='67'                                                    
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Confidence panel -->
                    <StackPanel Grid.Column="2"
                                Width="120"
                                Spacing="6"
                                VerticalAlignment="Top">
                        <TextBlock Text="Confidence"
                                   FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:ConnectionId='62'                                                      
                                   FontFamily="Segoe UI Variable"
                                   FontSize="28"
                                   FontWeight="Bold"
                                                                                           
                                   HorizontalAlignment="Center" />
                        <ProgressBar x:ConnectionId='63'                                                          
                                     Maximum="100"
                                     Style="{StaticResource ConfidenceBar}"
                                                                                              />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ════════════════════════════════════════════════════════════
                 METRIC HISTORY CHART
            ════════════════════════════════════════════════════════════ -->
            <Border x:ConnectionId='10'                                                             
                    Style="{StaticResource CardSurface}"
                    Padding="24"
                    Margin="0,0,0,16">
                <StackPanel Spacing="16">

                    <!-- Header + time window chips -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="3">
                            <TextBlock Text="METRIC HISTORY"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       CharacterSpacing="100"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock x:ConnectionId='60'                                                   
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>

                        <!-- Time window selector -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="4">
                            <Button x:ConnectionId='52'                                                  
                                                                                          
                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="9,4">
                                <TextBlock x:ConnectionId='59' Text="1 min"
                                           FontSize="11"
                                                                                                  />
                            </Button>
                            <Button x:ConnectionId='53'                                                  
                                                                                          
                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="9,4">
                                <TextBlock x:ConnectionId='58' Text="5 min"
                                           FontSize="11"
                                                                                                  />
                            </Button>
                            <Button x:ConnectionId='54'                                                   
                                                                                           
                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="9,4">
                                <TextBlock x:ConnectionId='57' Text="15 min"
                                           FontSize="11"
                                                                                                   />
                            </Button>
                            <Button x:ConnectionId='55'                                                   
                                                                                           
                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="9,4">
                                <TextBlock x:ConnectionId='56' Text="30 min"
                                           FontSize="11"
                                                                                                   />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Chart canvas -->
                    <local:InsightDetailChart x:ConnectionId='46'                                                      
                                              Height="200"
                                              HorizontalAlignment="Stretch" />

                    <!-- Stat row -->
                    <Border Background="#05FFFFFF"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Current -->
                            <StackPanel HorizontalAlignment="Center" Spacing="2">
                                <TextBlock Text="Current"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           CharacterSpacing="80"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:ConnectionId='51'                                                   
                                           FontFamily="Segoe UI Variable"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                                                                                   
                                           HorizontalAlignment="Center" />
                            </StackPanel>

                            <!-- Average -->
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="2">
                                <TextBlock Text="Average"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           CharacterSpacing="80"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:ConnectionId='50'                                                   
                                           FontFamily="Segoe UI Variable"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>

                            <!-- Min -->
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="2">
                                <TextBlock Text="Min"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           CharacterSpacing="80"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:ConnectionId='49'                                               
                                           FontFamily="Segoe UI Variable"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>

                            <!-- Max -->
                            <StackPanel Grid.Column="3" HorizontalAlignment="Center" Spacing="2">
                                <TextBlock Text="Max"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           CharacterSpacing="80"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:ConnectionId='48'                                               
                                           FontFamily="Segoe UI Variable"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>

                            <!-- Trend -->
                            <StackPanel Grid.Column="4" HorizontalAlignment="Center" Spacing="2">
                                <TextBlock Text="Trend"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           CharacterSpacing="80"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:ConnectionId='47'                                                 
                                           FontFamily="Segoe UI Variable"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>

                </StackPanel>
            </Border>

            <!-- No-chart notice (for forecast / synthesis / session insights) -->
            <Border x:ConnectionId='11'                                                               
                    Background="#07FFFFFF"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="20,16"
                    Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE946;"
                              FontFamily="Segoe MDL2 Assets"
                              FontSize="14"
                              Foreground="{StaticResource TextSecondaryBrush}"
                              VerticalAlignment="Center" />
                    <TextBlock Text="No direct metric is associated with this finding type. Check the narrative and timeline sections for context."
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- ════════════════════════════════════════════════════════════
                 ATTRIBUTED PROCESSES
            ════════════════════════════════════════════════════════════ -->
            <Border x:ConnectionId='12'                                                                 
                    Style="{StaticResource CardSurface}"
                    Padding="24"
                    Margin="0,0,0,16">
                <StackPanel Spacing="14">

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE9F5;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="12"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="ATTRIBUTED PROCESSES"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   CharacterSpacing="100"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <ItemsRepeater x:ConnectionId='40'                                                                  >
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="8" Orientation="Vertical" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate                                      >
                                <Border x:ConnectionId='42' Background="#07FFFFFF"
                                        BorderBrush="{StaticResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14,10">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center" Spacing="1">
                                            <TextBlock x:ConnectionId='45'                            
                                                       FontFamily="Segoe UI Variable"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <TextBlock x:ConnectionId='43' Grid.Column="1"
                                                                            
                                                   FontFamily="Segoe UI Variable"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                   VerticalAlignment="Center" />

                                        <Border Grid.Column="2"
                                                Background="#0AFFFFFF"
                                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="8,3"
                                                VerticalAlignment="Center">
                                            <TextBlock x:ConnectionId='44'                          
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                </StackPanel>
            </Border>

            <!-- ════════════════════════════════════════════════════════════
                 RELATED TIMELINE EVENTS
            ════════════════════════════════════════════════════════════ -->
            <Border x:ConnectionId='13'                                                                     
                    Style="{StaticResource CardSurface}"
                    Padding="24"
                    Margin="0,0,0,16">
                <StackPanel Spacing="14">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE823;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="12"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock Text="RELATED TIMELINE EVENTS"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       CharacterSpacing="100"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <Border Grid.Column="1"
                                Background="#0AFFFFFF"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="9,4">
                            <TextBlock x:ConnectionId='39'                                                           
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </Border>
                    </Grid>

                    <ItemsRepeater x:ConnectionId='38'                                                            
                                   ItemTemplate="{StaticResource RelatedEventTemplate}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="6" Orientation="Vertical" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>

                </StackPanel>
            </Border>

            <!-- ════════════════════════════════════════════════════════════
                 REMEDIATION HISTORY
            ════════════════════════════════════════════════════════════ -->
            <Border Style="{StaticResource CardSurface}"
                    Padding="24"
                    Margin="0,0,0,16">
                <StackPanel Spacing="14">

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8BD;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="12"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="REMEDIATION HISTORY"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   CharacterSpacing="100"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Loading spinner -->
                    <StackPanel x:ConnectionId='24'                                                                      
                                Orientation="Horizontal"
                                Spacing="12"
                                HorizontalAlignment="Center"
                                Margin="0,8,0,8">
                        <ProgressRing IsActive="True" Width="18" Height="18" />
                        <TextBlock Text="Loading history…"
                                   Style="{StaticResource CaptionTextStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Records list -->
                    <StackPanel x:ConnectionId='25'                                                                   
                                Spacing="6">
                        <TextBlock x:ConnectionId='27'                                                        
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <ItemsRepeater x:ConnectionId='28'                                                            >
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="6" Orientation="Vertical" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate                                       >
                                    <Border x:ConnectionId='30' Background="#0AFFFFFF"
                                            BorderBrush="{StaticResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14,11">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border x:ConnectionId='31' Width="32" Height="32"
                                                    CornerRadius="16"
                                                                                          
                                                    VerticalAlignment="Center">
                                                <FontIcon x:ConnectionId='37'                             
                                                          FontFamily="Segoe MDL2 Assets"
                                                          FontSize="12"
                                                                                           
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                            </Border>

                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock x:ConnectionId='34'                            
                                                           FontFamily="Segoe UI Variable"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <TextBlock x:ConnectionId='35'                             
                                                               FontSize="10"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBlock Text="·"
                                                               FontSize="10"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBlock x:ConnectionId='36'                             
                                                               FontSize="10"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <Border x:ConnectionId='32' Grid.Column="2"
                                                                                          
                                                    CornerRadius="5"
                                                    Padding="8,4"
                                                    VerticalAlignment="Center">
                                                <TextBlock x:ConnectionId='33'                            
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                                                             />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>

                    <!-- Empty state -->
                    <Border x:ConnectionId='26'                                                                    
                            Background="#05FFFFFF"
                            CornerRadius="8"
                            Padding="16,12">
                        <TextBlock Text="No remediation actions have been taken for this finding yet."
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                    </Border>

                </StackPanel>
            </Border>

            <!-- ════════════════════════════════════════════════════════════
                 OPERATIONAL NARRATIVE
            ════════════════════════════════════════════════════════════ -->
            <Border x:ConnectionId='14'                                                                 
                    Style="{StaticResource CardSurface}"
                    Padding="24"
                    Margin="0,0,0,16">
                <StackPanel Spacing="14">

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8D4;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="12"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="OPERATIONAL NARRATIVE"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   CharacterSpacing="100"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Headline -->
                    <TextBlock x:ConnectionId='21'                                                         
                               FontFamily="Segoe UI Variable"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               TextWrapping="Wrap" />

                    <!-- Paragraphs — rendered as an ItemsRepeater for live updates -->
                    <ItemsRepeater x:ConnectionId='22'                                                                  >
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="10" Orientation="Vertical" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           Style="{StaticResource BodyTextStyle}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                </StackPanel>
            </Border>

            <!-- ════════════════════════════════════════════════════════════
                 CONFIDENCE BREAKDOWN
            ════════════════════════════════════════════════════════════ -->
            <Border Style="{StaticResource CardSurface}"
                    Padding="24">
                <StackPanel Spacing="16">

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE9CE;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="12"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="CONFIDENCE BREAKDOWN"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   CharacterSpacing="100"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Rule + confidence row -->
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="10">

                            <!-- Rule ID badge -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Rule"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                                <Border Background="#0AFFFFFF"
                                        BorderBrush="{StaticResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="8,3">
                                    <TextBlock x:ConnectionId='20'                                        
                                               FontFamily="Cascadia Code, Consolas, Courier New"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                </Border>
                            </StackPanel>

                            <!-- Sample / coverage -->
                            <Grid ColumnSpacing="32">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="2">
                                    <TextBlock Text="Evidence"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               CharacterSpacing="80"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock x:ConnectionId='19'                                                       
                                               FontFamily="Segoe UI Variable"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Coverage"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               CharacterSpacing="80"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock x:ConnectionId='18'                                                    
                                               FontFamily="Segoe UI Variable"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </Grid>

                            <!-- Rule type explanation -->
                            <Border Background="#07FFFFFF"
                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,8">
                                <TextBlock x:ConnectionId='17'                                                          
                                           Style="{StaticResource CaptionTextStyle}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </Border>

                        </StackPanel>

                        <!-- Big confidence number -->
                        <StackPanel Grid.Column="1"
                                    Width="110"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="8">
                            <TextBlock x:ConnectionId='15'                                                      
                                       FontFamily="Segoe UI Variable"
                                       FontSize="36"
                                       FontWeight="Bold"
                                                                                               
                                       HorizontalAlignment="Center" />
                            <ProgressBar x:ConnectionId='16'                                                          
                                         Maximum="100"
                                         Style="{StaticResource ConfidenceBar}"
                                                                                                  />
                            <TextBlock Text="confidence score"
                                       FontSize="10"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>

</Page>

