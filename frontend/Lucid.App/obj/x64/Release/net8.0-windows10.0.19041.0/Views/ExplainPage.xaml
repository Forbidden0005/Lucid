<Page x:ConnectionId='1'
    x:Class="ExplainMyPC.Views.ExplainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource AppBackgroundBrush}"
                        >

    <!--
        ExplainPage.xaml — Flagship operational reasoning workspace.

        Six live-data-driven sections driven by ExplainMyPcEngine:
          1. System Summary Hero
          2. What Changed?
          3. What's Causing This?
          4. What Happens Next?
          5. Recommended Next Actions
          6. Why We Believe This

        All content binds to ExplainViewModel via DataContext set in code-behind.
        Engine updates arrive on the UI thread — collections update in-place.
    -->

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32,32,32,56" Spacing="28">

            <!-- ═══════════════════════════════════════════════════════════════
                 PAGE HEADER
            ═══════════════════════════════════════════════════════════════ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock Text="Explain My PC"
                               Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Operational reasoning — what is happening, why, and what to do next"
                               Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>

                <!-- Live update pill -->
                <Border Grid.Column="1"
                        Background="{StaticResource AppSurfaceBrush}"
                        CornerRadius="12" Padding="12,6"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE121;" FontFamily="Segoe MDL2 Assets"
                                  FontSize="11"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="{Binding LastUpdatedText}"
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════════
                 SECTION 1 — SYSTEM SUMMARY HERO
            ═══════════════════════════════════════════════════════════════ -->
            <Border x:ConnectionId='2' x:Name="CardHero"
                    Style="{StaticResource CardElevated}"
                    Padding="0"
                                                        
                                                      >
                <Border.RenderTransform><CompositeTransform /></Border.RenderTransform>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left accent stripe — color reflects health state -->
                    <Border Grid.Column="0"
                            CornerRadius="8,0,0,8"
                            Background="{Binding HeroAccentBrush}" />

                    <!-- Content -->
                    <StackPanel Grid.Column="1" Padding="26,24,26,24" Spacing="16">

                        <!-- Status row: state pill + headline + confidence badge -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Health state pill -->
                            <Border CornerRadius="10" Padding="10,4"
                                    VerticalAlignment="Center">
                                <Border.Background>
                                    <SolidColorBrush Color="#1A6CA3F7" />
                                </Border.Background>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="{Binding HeroGlyph}"
                                              FontFamily="Segoe MDL2 Assets"
                                              FontSize="12"
                                              Foreground="{Binding HealthStateBrush}"
                                              VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding HealthState}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{Binding HealthStateBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Headline -->
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Headline}"
                                       Style="{StaticResource SectionTitleStyle}"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />

                            <!-- Confidence badge -->
                            <Border Grid.Column="2"
                                    Background="{StaticResource AppSurfaceBrush}"
                                    CornerRadius="8" Padding="10,4"
                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE8D4;" FontFamily="Segoe MDL2 Assets"
                                              FontSize="10"
                                              Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding ConfidenceText}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Divider -->
                        <Border Height="1" Background="{StaticResource BorderSubtleBrush}" />

                        <!-- Summary narrative -->
                        <TextBlock Text="{Binding SummaryNarrative}"
                                   Style="{StaticResource BodyTextStyle}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   LineHeight="22" />

                        <!-- Dominant causes chips (hidden when healthy) -->
                        <StackPanel Spacing="8"
                                    Visibility="{Binding DominantCausesVisibility}">
                            <TextBlock Text="Key factors:"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <ItemsControl ItemsSource="{Binding DominantCauses}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource AppSurfaceBrush}"
                                                CornerRadius="8" Padding="10,4"
                                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                                BorderThickness="1">
                                            <TextBlock Text="{Binding}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Data points footer -->
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE8D4;" FontFamily="Segoe MDL2 Assets"
                                          FontSize="10"
                                          Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding DataPointsText}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE121;" FontFamily="Segoe MDL2 Assets"
                                          FontSize="10"
                                          Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding LastUpdatedText}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════
                 SECTION 2 — WHAT CHANGED?
            ═══════════════════════════════════════════════════════════════ -->
            <StackPanel Spacing="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE81C;" FontFamily="Segoe MDL2 Assets"
                                  FontSize="14"
                                  Foreground="{StaticResource AccentBlueBrush}"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="What Changed?"
                                   Style="{StaticResource SectionTitleStyle}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="{Binding RecentChangesLabel}"
                               Style="{StaticResource CaptionTextStyle}"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- Empty state -->
                <Border Style="{StaticResource CardSurface}" Padding="20"
                        Visibility="{Binding NoRecentChangesVisibility}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                  FontSize="14"
                                  Foreground="{StaticResource StatusGoodBrush}" />
                        <TextBlock Text="No significant changes detected in the last 4 hours."
                                   Style="{StaticResource CaptionTextStyle}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Change items -->
                <ItemsControl ItemsSource="{Binding RecentChanges}"
                              Visibility="{Binding RecentChangesVisibility}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:ConnectionId='7' Style="{StaticResource CardSurface}"
                                    Padding="16,14" Margin="0,0,0,6"
                                                                        
                                                                      >
                                <Border.RenderTransform><CompositeTransform /></Border.RenderTransform>
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Colored dot -->
                                    <Border Width="10" Height="10" CornerRadius="5"
                                            Background="{Binding DotBrush}"
                                            VerticalAlignment="Top"
                                            Margin="0,5,0,0" />

                                    <!-- Content -->
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="{Binding Title}"
                                                   Style="{StaticResource CardTitleStyle}"
                                                   FontSize="13" />
                                        <TextBlock Text="{Binding Detail}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding HasDetailVisibility}" />
                                    </StackPanel>

                                    <!-- Timestamp -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding TimeText}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Top" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ═══════════════════════════════════════════════════════════════
                 SECTION 3 — WHAT'S CAUSING THIS?
            ═══════════════════════════════════════════════════════════════ -->
            <StackPanel Spacing="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE946;" FontFamily="Segoe MDL2 Assets"
                                  FontSize="14"
                                  Foreground="{StaticResource AccentBlueBrush}"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="What's Causing This?"
                                   Style="{StaticResource SectionTitleStyle}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="{Binding CausalSectionLabel}"
                               Style="{StaticResource CaptionTextStyle}"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- Empty state -->
                <Border Style="{StaticResource CardSurface}" Padding="20"
                        Visibility="{Binding NoCausalFactorsVisibility}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                  FontSize="14"
                                  Foreground="{StaticResource StatusGoodBrush}" />
                        <TextBlock Text="No active conditions identified — all monitored metrics appear normal."
                                   Style="{StaticResource CaptionTextStyle}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Causal factor cards -->
                <ItemsControl ItemsSource="{Binding CausalFactors}"
                              Visibility="{Binding CausalFactorsVisibility}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:ConnectionId='6' Style="{StaticResource CardSurface}"
                                    Padding="0" Margin="0,0,0,8"
                                                                        
                                                                      >
                                <Border.RenderTransform><CompositeTransform /></Border.RenderTransform>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Domain accent stripe -->
                                    <Border Grid.Column="0"
                                            CornerRadius="8,0,0,8"
                                            Background="{Binding AccentBrush}" />

                                    <!-- Content -->
                                    <StackPanel Grid.Column="1" Padding="18,16,18,16" Spacing="10">

                                        <!-- Header row -->
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Domain icon -->
                                            <Border Width="34" Height="34" CornerRadius="8"
                                                    VerticalAlignment="Top">
                                                <Border.Background>
                                                    <SolidColorBrush Color="#1A6CA3F7" />
                                                </Border.Background>
                                                <FontIcon Glyph="{Binding DomainGlyph}"
                                                          FontFamily="Segoe MDL2 Assets"
                                                          FontSize="15"
                                                          Foreground="{Binding AccentBrush}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                            </Border>

                                            <!-- Title + domain label -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{Binding Title}"
                                                           Style="{StaticResource CardTitleStyle}" />
                                                <TextBlock Text="{Binding DomainLabel}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                            </StackPanel>

                                            <!-- Confidence -->
                                            <Border Grid.Column="2"
                                                    Background="{StaticResource AppSurfaceBrush}"
                                                    CornerRadius="6" Padding="8,3"
                                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                                    BorderThickness="1"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{Binding ConfidenceText}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                            </Border>
                                        </Grid>

                                        <!-- Explanation -->
                                        <TextBlock Text="{Binding Explanation}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   TextWrapping="Wrap"
                                                   LineHeight="20" />

                                        <!-- Process attribution -->
                                        <StackPanel Orientation="Horizontal" Spacing="6"
                                                    Visibility="{Binding HasAttributionVisibility}">
                                            <FontIcon Glyph="&#xE779;" FontFamily="Segoe MDL2 Assets"
                                                      FontSize="10"
                                                      Foreground="{StaticResource TextSecondaryBrush}"
                                                      VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding AttributionText}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>

                                        <!-- Confidence bar -->
                                        <StackPanel Spacing="4">
                                            <ProgressBar Value="{Binding ConfidencePercent}"
                                                         Maximum="100"
                                                         Style="{StaticResource ConfidenceBar}"
                                                         Foreground="{Binding AccentBrush}" />
                                        </StackPanel>

                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ═══════════════════════════════════════════════════════════════
                 SECTION 4 — WHAT HAPPENS NEXT?
            ═══════════════════════════════════════════════════════════════ -->
            <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE787;" FontFamily="Segoe MDL2 Assets"
                              FontSize="14"
                              Foreground="{StaticResource AccentBlueBrush}"
                              VerticalAlignment="Center" />
                    <TextBlock Text="What Happens Next?"
                               Style="{StaticResource SectionTitleStyle}" />
                </StackPanel>

                <!-- Stable state -->
                <Border Style="{StaticResource CardSurface}" Padding="20"
                        Visibility="{Binding NoForecastsVisibility}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                  FontSize="14"
                                  Foreground="{StaticResource StatusGoodBrush}" />
                        <TextBlock Text="No concerning trends detected — system appears stable based on current readings."
                                   Style="{StaticResource CaptionTextStyle}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Forecast cards -->
                <ItemsControl ItemsSource="{Binding Forecasts}"
                              Visibility="{Binding ForecastsVisibility}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:ConnectionId='5' Style="{StaticResource CardSurface}"
                                    Padding="18,16" Margin="0,0,0,8"
                                                                        
                                                                      >
                                <Border.RenderTransform><CompositeTransform /></Border.RenderTransform>
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Severity icon -->
                                    <Border Width="36" Height="36" CornerRadius="8"
                                            VerticalAlignment="Top">
                                        <Border.Background>
                                            <SolidColorBrush Color="#1AFFFFFF" />
                                        </Border.Background>
                                        <FontIcon Glyph="{Binding SeverityGlyph}"
                                                  FontFamily="Segoe MDL2 Assets"
                                                  FontSize="16"
                                                  Foreground="{Binding SeverityBrush}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Content -->
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <TextBlock Text="{Binding Title}"
                                                   Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Text="{Binding Projection}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="6"
                                                    Visibility="{Binding HasMitigationVisibility}">
                                            <FontIcon Glyph="&#xE946;" FontFamily="Segoe MDL2 Assets"
                                                      FontSize="10"
                                                      Foreground="{StaticResource TextSecondaryBrush}"
                                                      VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding MitigationHint}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontStyle="Italic"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Confidence -->
                                    <Border Grid.Column="2"
                                            Background="{StaticResource AppSurfaceBrush}"
                                            CornerRadius="6" Padding="8,3"
                                            BorderBrush="{StaticResource BorderSubtleBrush}"
                                            BorderThickness="1" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding ConfidenceText}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ═══════════════════════════════════════════════════════════════
                 SECTION 5 — RECOMMENDED NEXT ACTIONS
            ═══════════════════════════════════════════════════════════════ -->
            <StackPanel Spacing="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE768;" FontFamily="Segoe MDL2 Assets"
                                  FontSize="14"
                                  Foreground="{StaticResource AccentBlueBrush}"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="Recommended Next Actions"
                                   Style="{StaticResource SectionTitleStyle}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="{Binding RecommendationsCountText}"
                               Style="{StaticResource CaptionTextStyle}"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- Empty state -->
                <Border Style="{StaticResource CardSurface}" Padding="20"
                        Visibility="{Binding NoRecommendationsVisibility}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                  FontSize="14"
                                  Foreground="{StaticResource StatusGoodBrush}" />
                        <TextBlock Text="No actions recommended — your system appears to be in good condition."
                                   Style="{StaticResource CaptionTextStyle}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Recommendation cards -->
                <ItemsControl ItemsSource="{Binding Recommendations}"
                              Visibility="{Binding RecommendationsVisibility}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:ConnectionId='4' Style="{StaticResource CardSurface}"
                                    Padding="18,16" Margin="0,0,0,8"
                                                                        
                                                                      >
                                <Border.RenderTransform><CompositeTransform /></Border.RenderTransform>
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Rank circle -->
                                    <Border Width="36" Height="36" CornerRadius="18"
                                            Background="{Binding RankBrush}"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Rank}"
                                                   FontSize="14" FontWeight="Bold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Content -->
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <TextBlock Text="{Binding ActionTitle}"
                                                   Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Text="{Binding WhyItMatters}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   TextWrapping="Wrap"
                                                   LineHeight="18" />

                                        <!-- Attribute chips -->
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                            <!-- Expected benefit -->
                                            <Border Background="{StaticResource StatusInfoSubtleBrush}"
                                                    CornerRadius="4" Padding="7,3">
                                                <TextBlock Text="{Binding ExpectedBenefit}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource StatusInfoBrush}" />
                                            </Border>

                                            <!-- Reversible badge -->
                                            <Border CornerRadius="4" Padding="7,3"
                                                    Background="{StaticResource StatusGoodSubtleBrush}">
                                                <TextBlock Text="{Binding RollbackLabel}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource StatusGoodBrush}" />
                                            </Border>

                                            <!-- Risk badge -->
                                            <Border Background="{StaticResource AppSurfaceBrush}"
                                                    CornerRadius="4" Padding="7,3"
                                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                                    BorderThickness="1">
                                                <TextBlock Text="{Binding RiskLabel}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                            </Border>

                                            <!-- Effectiveness badge (shown when warm data exists) -->
                                            <Border Visibility="{Binding EffectivenessVisible}"
                                                    CornerRadius="4" Padding="7,3"
                                                    Background="{StaticResource AppBackgroundBrush}"
                                                    BorderBrush="{StaticResource StatusGoodBrush}"
                                                    BorderThickness="1">
                                                <ToolTipService.ToolTip>
                                                    <ToolTip Content="{Binding EffectivenessText}" />
                                                </ToolTipService.ToolTip>
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <FontIcon Glyph="&#xE930;"
                                                              FontFamily="Segoe MDL2 Assets"
                                                              FontSize="10"
                                                              Foreground="{StaticResource StatusGoodBrush}" />
                                                    <TextBlock Text="{Binding EffectivenessLabel}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource StatusGoodBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Time estimate -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Top"
                                                Spacing="2" HorizontalAlignment="Center">
                                        <Border Background="{StaticResource AppSurfaceBrush}"
                                                CornerRadius="6" Padding="8,4"
                                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                                BorderThickness="1">
                                            <TextBlock Text="{Binding EstimatedTime}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="effort"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ═══════════════════════════════════════════════════════════════
                 SECTION 6 — WHY WE BELIEVE THIS
            ═══════════════════════════════════════════════════════════════ -->
            <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE8D4;" FontFamily="Segoe MDL2 Assets"
                              FontSize="14"
                              Foreground="{StaticResource AccentBlueBrush}"
                              VerticalAlignment="Center" />
                    <TextBlock Text="Why We Believe This"
                               Style="{StaticResource SectionTitleStyle}" />
                </StackPanel>

                <Border Style="{StaticResource CardSurface}" Padding="20">
                    <StackPanel Spacing="0">
                        <ItemsControl ItemsSource="{Binding Evidence}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,10,0,10" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Row separator (except first) -->
                                        <Border Grid.ColumnSpan="3"
                                                Height="1"
                                                Background="{StaticResource BorderSubtleBrush}"
                                                VerticalAlignment="Top"
                                                Margin="0,-10,0,0" />

                                        <TextBlock Text="{Binding Label}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Top"
                                                   Margin="0,6,0,0" />

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Value}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Top"
                                                   Margin="0,6,0,0"
                                                   LineHeight="18" />

                                        <!-- Kind badge -->
                                        <Border Grid.Column="2"
                                                CornerRadius="4" Padding="7,2"
                                                VerticalAlignment="Top"
                                                Margin="0,6,0,0">
                                            <Border.Background>
                                                <SolidColorBrush Color="#1AFFFFFF" />
                                            </Border.Background>
                                            <TextBlock Text="{Binding KindLabel}"
                                                       FontSize="10"
                                                       Foreground="{Binding KindBrush}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>

