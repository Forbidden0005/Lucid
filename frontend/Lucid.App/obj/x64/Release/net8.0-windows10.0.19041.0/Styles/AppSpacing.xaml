<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ════════════════════════════════════════════════════════════════
        ExplainMyPC Spacing System — 4-pt grid
        Source of truth: docs/ui-guidelines.md

        Usage examples:
          Spacing="{StaticResource Space8}"
          Width="{StaticResource IconContainerMD}"
          Padding="{StaticResource CardPaddingMD}"
          CornerRadius="{StaticResource RadiusMD}"
        ════════════════════════════════════════════════════════════════
    -->

    <!-- ── Numeric spacing scale ─────────────────────────────────────
         Use for Spacing= on StackPanel, or Width/Height/FontSize.      -->
    <x:Double x:Key="Space4">4</x:Double>
    <x:Double x:Key="Space6">6</x:Double>
    <x:Double x:Key="Space8">8</x:Double>
    <x:Double x:Key="Space12">12</x:Double>
    <x:Double x:Key="Space16">16</x:Double>
    <x:Double x:Key="Space20">20</x:Double>
    <x:Double x:Key="Space24">24</x:Double>
    <x:Double x:Key="Space28">28</x:Double>
    <x:Double x:Key="Space32">32</x:Double>
    <x:Double x:Key="Space48">48</x:Double>

    <!-- ── Thickness tokens ──────────────────────────────────────────
         Use for Padding= / Margin= / BorderThickness=.                 -->

    <!-- Page outer padding -->
    <Thickness x:Key="PagePadding">32,32,32,48</Thickness>

    <!-- Card interior padding variants -->
    <Thickness x:Key="CardPaddingSM">16</Thickness>
    <Thickness x:Key="CardPaddingMD">20</Thickness>
    <Thickness x:Key="CardPaddingLG">24</Thickness>
    <Thickness x:Key="CardPaddingXL">28</Thickness>

    <!-- Badge / chip / pill padding -->
    <Thickness x:Key="BadgePadding">10,5</Thickness>
    <Thickness x:Key="TagPadding">8,4</Thickness>
    <Thickness x:Key="TagPaddingSM">7,3</Thickness>
    <Thickness x:Key="PillPadding">12,6</Thickness>

    <!-- ── Corner radius tokens ──────────────────────────────────────
         Use for CornerRadius=.                                         -->
    <CornerRadius x:Key="RadiusXS">4</CornerRadius>
    <CornerRadius x:Key="RadiusSM">6</CornerRadius>
    <CornerRadius x:Key="RadiusMD">10</CornerRadius>
    <CornerRadius x:Key="RadiusLG">14</CornerRadius>
    <CornerRadius x:Key="RadiusFull">999</CornerRadius>
    <CornerRadius x:Key="RadiusIcon">10</CornerRadius>
    <CornerRadius x:Key="RadiusBar">2</CornerRadius>

    <!-- ── Icon container size scale ─────────────────────────────────
         Use for Width= and Height= on icon container Borders.          -->
    <x:Double x:Key="IconContainerSM">28</x:Double>
    <x:Double x:Key="IconContainerMD">40</x:Double>
    <x:Double x:Key="IconContainerLG">44</x:Double>

</ResourceDictionary>

