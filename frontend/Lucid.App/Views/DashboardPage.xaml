<Page
    x:Class="Lucid.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Lucid.ViewModels"
    xmlns:intel="using:Lucid.Services.Intelligence"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="Page_Loaded">

    <!--
        InsightCardTemplate — live DataTemplate bound to InsightCardViewModel.

        ⚠️  CompositeTransform must be declared inline (not in a Style) so that
        each card gets its own transform instance. See AppCards.xaml for details.

        IsExpanded / ExpandedVisibility / ExpandChevron all require Mode=OneWay
        so they react to the ToggleExpandedCommand without rebuilding the tree.

        ActionCardTemplate must be declared BEFORE InsightCardTemplate so the
        StaticResource forward-reference inside InsightCardTemplate resolves.
    -->
    <Page.Resources>

        <!--
            ActionCardTemplate — immutable display card for a SystemAction.
            ActionCardViewModel has no INotifyPropertyChanged — all bindings
            use the default OneTime mode.
        -->
        <DataTemplate x:Key="ActionCardTemplate"
                      x:DataType="vm:ActionCardViewModel">
            <Border Background="#0AFFFFFF"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,12">
                <StackPanel Spacing="10">

                    <!-- ── Header: icon · title / description · risk badge ── -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Impact-coloured icon -->
                        <Border Width="32" Height="32"
                                CornerRadius="8"
                                Background="{x:Bind ImpactBackground}"
                                VerticalAlignment="Top">
                            <FontIcon Glyph="&#xE8BD;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="13"
                                      Foreground="{x:Bind ImpactBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>

                        <!-- Title + description -->
                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="3">
                            <TextBlock Text="{x:Bind Title}"
                                       FontFamily="Segoe UI Variable"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{x:Bind Description}"
                                       Style="{StaticResource CaptionTextStyle}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Risk badge -->
                        <Border Grid.Column="2"
                                Background="{x:Bind RiskBackground}"
                                CornerRadius="6"
                                Padding="8,4"
                                VerticalAlignment="Top">
                            <TextBlock Text="{x:Bind RiskLabel}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{x:Bind RiskBrush}" />
                        </Border>
                    </Grid>

                    <!-- ── Chips: impact · effort · reversible ──────────── -->
                    <StackPanel Orientation="Horizontal"
                                Spacing="6"
                                Margin="44,0,0,0">

                        <!-- Impact chip -->
                        <Border Background="{x:Bind ImpactBackground}"
                                CornerRadius="4"
                                Padding="8,3">
                            <TextBlock Text="{x:Bind ImpactLabel}"
                                       FontSize="11"
                                       Foreground="{x:Bind ImpactBrush}" />
                        </Border>

                        <!-- Effort chip -->
                        <Border Background="#0AFFFFFF"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,3">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE823;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="10"
                                          Foreground="{StaticResource TextSecondaryBrush}"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind EffortText}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Reversible chip — hidden when not reversible -->
                        <Border Visibility="{x:Bind ReversibleVisibility}"
                                Background="{StaticResource StatusGoodSubtleBrush}"
                                CornerRadius="4"
                                Padding="8,3">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE72C;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="10"
                                          Foreground="{StaticResource StatusGoodBrush}"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="Reversible"
                                           FontSize="11"
                                           Foreground="{StaticResource StatusGoodBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ── Static confirmation risk notice ───────────────────
                         Shown whenever RequiresConfirmation=true so the user
                         always sees the risk text before clicking Run.
                         This is the static note from SystemAction; the
                         interactive confirmation panel is handled by the
                         Execution sub-ViewModel below.
                    ──────────────────────────────────────────────────────── -->
                    <Border Visibility="{x:Bind ConfirmationVisibility}"
                            Background="{StaticResource StatusModerateSubtleBrush}"
                            CornerRadius="6"
                            Padding="10,7"
                            Margin="44,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7BA;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="12"
                                      Foreground="{StaticResource StatusModerateBrush}"
                                      VerticalAlignment="Top"
                                      Margin="0,1,0,0" />
                            <TextBlock Text="{x:Bind ConfirmationMessage}"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Foreground="{StaticResource StatusModerateBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- ══════════════════════════════════════════════════════
                         EXECUTION PANEL
                         All states driven by Execution (ActionExecutionViewModel).
                         Only one state-section is visible at a time.
                    ══════════════════════════════════════════════════════ -->

                    <!-- Thin separator between static info and interactive UI -->
                    <Border Height="1"
                            Background="{StaticResource BorderSubtleBrush}"
                            Margin="44,2,0,2" />

                    <!-- ── IDLE: Run + Preview buttons ──────────────────────
                         Visible when State=Idle and an executor is registered.
                    ──────────────────────────────────────────────────────── -->
                    <StackPanel Visibility="{x:Bind Execution.IdleControlsVisibility, Mode=OneWay}"
                                Orientation="Horizontal"
                                Spacing="8"
                                Margin="44,0,0,0">

                        <!-- Preview (dry-run) -->
                        <Button Command="{x:Bind Execution.DryRunCommand}"
                                CornerRadius="5"
                                Padding="10,5">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE946;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="11"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="Preview"
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Run -->
                        <Button Command="{x:Bind Execution.RunCommand}"
                                Background="{StaticResource StatusInfoTintBrush}"
                                CornerRadius="5"
                                Padding="10,5">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE768;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="11"
                                          Foreground="{StaticResource StatusInfoBrush}"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="Run"
                                           FontSize="12"
                                           Foreground="{StaticResource StatusInfoBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- ── IDLE: Coming soon chip ───────────────────────────
                         Visible when no executor is registered for this action.
                    ──────────────────────────────────────────────────────── -->
                    <Border Visibility="{x:Bind Execution.NotImplementedVisibility}"
                            Background="#08FFFFFF"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="9,4"
                            Margin="44,0,0,0"
                            HorizontalAlignment="Left">
                        <TextBlock Text="Coming soon"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </Border>

                    <!-- ── CONFIRMATION PENDING ─────────────────────────────
                         Visible when the user clicked Run on a risky action.
                         Shows the risk description and Confirm / Cancel buttons.
                    ──────────────────────────────────────────────────────── -->
                    <Border Visibility="{x:Bind Execution.ConfirmationVisibility, Mode=OneWay}"
                            Background="{StaticResource StatusModerateSubtleBrush}"
                            CornerRadius="8"
                            Padding="12,10"
                            Margin="44,0,0,0">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7BA;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="13"
                                          Foreground="{StaticResource StatusModerateBrush}"
                                          VerticalAlignment="Top"
                                          Margin="0,2,0,0" />
                                <TextBlock Text="{x:Bind Execution.ConfirmationMessage}"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Foreground="{StaticResource StatusModerateBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Command="{x:Bind Execution.ConfirmCommand}"
                                        CornerRadius="5"
                                        Padding="12,5">
                                    <TextBlock Text="Confirm"
                                               FontSize="12" />
                                </Button>
                                <Button Command="{x:Bind Execution.CancelConfirmationCommand}"
                                        CornerRadius="5"
                                        Padding="12,5">
                                    <TextBlock Text="Cancel"
                                               FontSize="12" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ── RUNNING / DRY-RUNNING ────────────────────────────
                         Spinner + status label + Cancel link.
                    ──────────────────────────────────────────────────────── -->
                    <StackPanel Visibility="{x:Bind Execution.ProgressVisibility, Mode=OneWay}"
                                Orientation="Horizontal"
                                Spacing="10"
                                Margin="44,0,0,0">
                        <ProgressRing IsActive="{x:Bind Execution.IsRunning, Mode=OneWay}"
                                      Width="16"
                                      Height="16" />
                        <TextBlock Text="{x:Bind Execution.StatusMessage, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   VerticalAlignment="Center" />
                        <Button Command="{x:Bind Execution.CancelExecutionCommand}"
                                CornerRadius="4"
                                Padding="8,3"
                                VerticalAlignment="Center">
                            <TextBlock Text="Cancel"
                                       FontSize="11" />
                        </Button>
                    </StackPanel>

                    <!-- ── RESULT ───────────────────────────────────────────
                         State icon + outcome message.
                         Rollback button: visible only when executor captured
                         a rollback snapshot (CanRollback=true).
                         Run again: always visible to reset and retry.
                    ──────────────────────────────────────────────────────── -->
                    <StackPanel Visibility="{x:Bind Execution.ResultVisibility, Mode=OneWay}"
                                Spacing="6"
                                Margin="44,0,0,0">

                        <!-- Icon + message row -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="{x:Bind Execution.StateGlyph, Mode=OneWay}"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="14"
                                      Foreground="{x:Bind Execution.StateBrush, Mode=OneWay}"
                                      VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind Execution.StatusMessage, Mode=OneWay}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{x:Bind Execution.StateBrush, Mode=OneWay}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Action links row -->
                        <StackPanel Orientation="Horizontal" Spacing="8">

                            <!-- Rollback — only when executor captured a snapshot -->
                            <Button Visibility="{x:Bind Execution.RollbackVisibility, Mode=OneWay}"
                                    Command="{x:Bind Execution.RollbackCommand}"
                                    CornerRadius="5"
                                    Padding="10,4">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE72C;"
                                              FontFamily="Segoe MDL2 Assets"
                                              FontSize="11"
                                              VerticalAlignment="Center" />
                                    <TextBlock Text="Undo"
                                               FontSize="11"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Run again -->
                            <HyperlinkButton Command="{x:Bind Execution.ResetToIdleCommand}"
                                             Content="Run again"
                                             FontSize="11"
                                             Padding="0"
                                             VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- ── LOG PANEL ────────────────────────────────────────
                         Live-updating execution log. Entries stream in as the
                         executor writes them. Visible whenever LogEntries has
                         at least one entry. Persists after execution.
                    ──────────────────────────────────────────────────────── -->
                    <Border Visibility="{x:Bind Execution.LogVisibility, Mode=OneWay}"
                            Background="#07FFFFFF"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,8"
                            Margin="44,0,0,0">
                        <StackPanel Spacing="4">
                            <TextBlock Text="EXECUTION LOG"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       CharacterSpacing="100"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,4" />
                            <ItemsRepeater ItemsSource="{x:Bind Execution.LogEntries, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="3" Orientation="Vertical" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ActionLogEntryViewModel">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Timestamp}"
                                                       FontSize="10"
                                                       FontFamily="Cascadia Code, Consolas, Courier New"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Top" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind LevelLabel}"
                                                       FontSize="10"
                                                       FontFamily="Cascadia Code, Consolas, Courier New"
                                                       Foreground="{x:Bind LevelBrush}"
                                                       VerticalAlignment="Top" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{x:Bind Message}"
                                                       FontSize="11"
                                                       Foreground="{x:Bind LevelBrush}"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Top" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="InsightCardTemplate"
                      x:DataType="vm:InsightCardViewModel">
            <Border Style="{StaticResource CardSurface}"
                    Padding="20"
                    Margin="0,0,0,0"
                    PointerEntered="Card_PointerEntered"
                    PointerExited="Card_PointerExited">
                <Border.RenderTransform>
                    <CompositeTransform />
                </Border.RenderTransform>
                <StackPanel Spacing="10">

                    <!-- ── Always-visible header row ────────────────────── -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Icon container -->
                        <Border Width="40" Height="40"
                                CornerRadius="10"
                                Background="{x:Bind IconContainerBackground, Mode=OneWay}"
                                VerticalAlignment="Top">
                            <FontIcon Glyph="{x:Bind IconGlyph, Mode=OneWay}"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="16"
                                      Foreground="{x:Bind AccentBrush, Mode=OneWay}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>

                        <!-- Title + one-line preview + confidence/timestamp -->
                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="4">
                            <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                       Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="{x:Bind DetailPreview, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextStyle}"
                                       TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal"
                                        Spacing="6"
                                        Margin="0,2,0,0">
                                <TextBlock Text="{x:Bind ConfidenceText, Mode=OneWay}"
                                           FontSize="11"
                                           Foreground="{x:Bind AccentBrush, Mode=OneWay}" />
                                <TextBlock Text="confidence  ·"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{x:Bind RelativeTime, Mode=OneWay}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Severity badge + correlation tag + expand toggle -->
                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Top"
                                    HorizontalAlignment="Right"
                                    Spacing="6">
                            <Border Background="{x:Bind BadgeBackground, Mode=OneWay}"
                                    CornerRadius="6"
                                    Padding="10,5">
                                <TextBlock Text="{x:Bind SeverityLabel, Mode=OneWay}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{x:Bind AccentBrush, Mode=OneWay}" />
                            </Border>

                            <!-- Correlated tag — only visible for synthesis insights -->
                            <Border Visibility="{x:Bind CorrelatedTagVisibility, Mode=OneWay}"
                                    Background="#0AFFFFFF"
                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,5"
                                    HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE71B;"
                                              FontFamily="Segoe MDL2 Assets"
                                              FontSize="10"
                                              Foreground="{StaticResource TextSecondaryBrush}"
                                              VerticalAlignment="Center" />
                                    <TextBlock Text="Correlated"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>

                            <Button Command="{x:Bind ToggleExpandedCommand}"
                                    HorizontalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="4,2"
                                    CornerRadius="4">
                                <FontIcon Glyph="{x:Bind ExpandChevron, Mode=OneWay}"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="11"
                                          Foreground="{StaticResource TextSecondaryBrush}" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- ── Expandable detail panel ───────────────────────── -->
                    <StackPanel Visibility="{x:Bind ExpandedVisibility, Mode=OneWay}"
                                Spacing="12">

                        <Border Height="1"
                                Background="{StaticResource BorderSubtleBrush}" />

                        <!-- Full detail paragraph -->
                        <TextBlock Text="{x:Bind Detail, Mode=OneWay}"
                                   Style="{StaticResource BodyTextStyle}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />

                        <!-- ── Process attribution section ──────────────────────
                             Shown when the rule identified top CPU/RAM/GPU
                             consumers. Empty when no process crosses the threshold
                             or when the process sampler has not yet warmed up.
                             GPU attributions show "Detected" (heuristic, ~55 %
                             confidence); CPU/RAM show measured values (~90 %).
                        ──────────────────────────────────────────────────────── -->
                        <Border Visibility="{x:Bind AttributionsVisibility, Mode=OneWay}"
                                Background="#07FFFFFF"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,10">
                            <StackPanel Spacing="8">
                                <TextBlock Text="ATTRIBUTED PROCESSES"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           CharacterSpacing="100"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <ItemsRepeater ItemsSource="{x:Bind AttributedProcesses, Mode=OneWay}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Spacing="6" Orientation="Vertical" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="intel:ProcessAttribution">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Process name -->
                                                <TextBlock Text="{x:Bind DisplayName}"
                                                           FontFamily="Segoe UI Variable"
                                                           FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />

                                                <!-- Usage value (e.g. "82%", "8.1 GB", "Detected") -->
                                                <TextBlock Grid.Column="1"
                                                           Text="{x:Bind UsageText}"
                                                           FontFamily="Segoe UI Variable"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                           VerticalAlignment="Center" />

                                                <!-- Kind badge: CPU / RAM / GPU -->
                                                <Border Grid.Column="2"
                                                        Background="#0AFFFFFF"
                                                        BorderBrush="{StaticResource BorderSubtleBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="7,2"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind KindLabel}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </Border>

                        <!-- Action hint chip (only when ActionHint is non-null) -->
                        <Border Visibility="{x:Bind ActionHintVisibility}"
                                Background="{x:Bind ActionHintBackground}"
                                CornerRadius="6"
                                Padding="12,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE946;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="12"
                                          Foreground="{x:Bind AccentBrush}"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind ActionHint}"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Foreground="{x:Bind AccentBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Confidence bar -->
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Confidence"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ConfidenceText, Mode=OneWay}"
                                           FontSize="11"
                                           Foreground="{x:Bind AccentBrush, Mode=OneWay}" />
                            </StackPanel>
                            <ProgressBar Value="{x:Bind ConfidencePercent, Mode=OneWay}"
                                         Maximum="100"
                                         Style="{StaticResource ConfidenceBar}"
                                         Foreground="{x:Bind AccentBrush, Mode=OneWay}" />
                        </StackPanel>

                        <!-- Recommended actions (hidden when the rule provides none) -->
                        <StackPanel Visibility="{x:Bind ActionsVisibility, Mode=OneWay}"
                                    Spacing="8">
                            <Border Height="1"
                                    Background="{StaticResource BorderSubtleBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8BD;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="11"
                                          Foreground="{StaticResource TextSecondaryBrush}"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="Recommended Actions"
                                           FontFamily="Segoe UI Variable"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <ItemsRepeater ItemsSource="{x:Bind Actions, Mode=OneWay}"
                                           ItemTemplate="{StaticResource ActionCardTemplate}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="6" Orientation="Vertical" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                        </StackPanel>

                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <!--
        DashboardPage.xaml — System overview with health score, live metrics,
        trends, quick actions, and active insights.

        All card styles, badge styles, progress bar styles, and button styles
        are sourced from the shared design system (AppCards/AppBadges/
        AppProgress/AppButtons.xaml merged in App.xaml).

        Data: x:Bind connects all dynamic text and numeric values to
        DashboardViewModel (exposed as ViewModel on the code-behind class).
        Mode=OneWay ensures the UI reacts to future property changes when
        live telemetry is wired up in Phase 2.

        Animations: AnimationHelper drives progress bar entrance on load.
        Hover effects: AnimationHelper scale + border brighten on pointer enter/exit.

        NOTE: Each animated Border has its own inline CompositeTransform.
        See AppCards.xaml for an explanation of why this is required.
    -->

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32,32,32,48" Spacing="28">

            <!-- ══════════════════════════════════════════════════════════
                 PAGE HEADER
            ══════════════════════════════════════════════════════════ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock Text="Dashboard"
                               Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Your system at a glance"
                               Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>

                <!-- System status pill -->
                <Border Grid.Column="1"
                        Background="{StaticResource StatusGoodSubtleBrush}"
                        CornerRadius="12" Padding="12,6"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="8" Height="8"
                                 Fill="{StaticResource StatusGoodBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.SystemStatusText, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Foreground="{StaticResource StatusGoodBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════
                 COMPANION SHORTCUT — opens the floating operational companion
            ══════════════════════════════════════════════════════════ -->
            <Border Background="#16182A"
                    BorderBrush="#2A2A3E"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="28" Height="28"
                            CornerRadius="8"
                            Background="#1E2F52"
                            VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE946;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="14"
                                  Foreground="#4E9FFF"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="Operational Companion"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#C8C8D8" />
                        <TextBlock Text="Ask questions about your system in a floating overlay"
                                   FontSize="11"
                                   Foreground="#6B6B8A" />
                    </StackPanel>

                    <Button Grid.Column="2"
                            CornerRadius="8"
                            Background="#1E2F52"
                            BorderBrush="#3F5A8A"
                            BorderThickness="1"
                            Padding="14,6"
                            FontSize="12"
                            Foreground="#7EB5FF"
                            Click="OpenCompanionButton_Click"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE946;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="11"
                                      Foreground="#4E9FFF" />
                            <TextBlock Text="Open" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════
                 HEALTH SCORE CARD
            ══════════════════════════════════════════════════════════ -->
            <Border Style="{StaticResource CardSurface}"
                    Padding="28"
                    PointerEntered="Card_PointerEntered"
                    PointerExited="Card_PointerExited">
                <Border.RenderTransform>
                    <CompositeTransform />
                </Border.RenderTransform>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Score ring -->
                    <Grid Grid.Column="0" Width="90" Height="90">
                        <ProgressRing IsIndeterminate="False"
                                      Value="{x:Bind ViewModel.HealthScore, Mode=OneWay}"
                                      Maximum="100"
                                      Width="90" Height="90"
                                      Background="Transparent"
                                      Foreground="{StaticResource StatusGoodBrush}" />
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.HealthScoreText, Mode=OneWay}"
                                       Style="{StaticResource MetricLargeStyle}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="/100"
                                       Style="{StaticResource CaptionTextStyle}"
                                       HorizontalAlignment="Center"
                                       Margin="0,-4,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- Health details -->
                    <StackPanel Grid.Column="1"
                                Margin="28,0,0,0"
                                VerticalAlignment="Center"
                                Spacing="8">
                        <TextBlock Text="{x:Bind ViewModel.HealthTitle, Mode=OneWay}"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.HealthDescription, Mode=OneWay}"
                                   Style="{StaticResource BodyTextStyle}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />

                        <!-- Sub-scores -->
                        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Width="6" Height="6"
                                         Fill="{StaticResource StatusGoodBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.PerformanceScoreText, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Width="6" Height="6"
                                         Fill="{StaticResource StatusGoodBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.SecurityScoreText, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Width="6" Height="6"
                                         Fill="{StaticResource StatusModerateBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.StorageScoreText, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Width="6" Height="6"
                                         Fill="{StaticResource StatusGoodBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.PrivacyScoreText, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Weekly trend indicator -->
                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center"
                                Spacing="2">
                        <FontIcon Glyph="&#xE70E;" FontFamily="Segoe MDL2 Assets"
                                  FontSize="16"
                                  Foreground="{StaticResource StatusGoodBrush}"
                                  HorizontalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.TrendLabel, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Foreground="{StaticResource StatusGoodBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="this week"
                                   Style="{StaticResource CaptionTextStyle}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════
                 LIVE METRICS — progress bars animate on page load
            ══════════════════════════════════════════════════════════ -->
            <TextBlock Text="Live Metrics"
                       Style="{StaticResource SectionTitleStyle}" />

            <Grid ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- CPU Card -->
                <Border Grid.Column="0"
                        Style="{StaticResource CardSurface}"
                        Padding="20"
                        PointerEntered="Card_PointerEntered"
                        PointerExited="Card_PointerExited">
                    <Border.RenderTransform>
                        <CompositeTransform />
                    </Border.RenderTransform>
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <!-- Small 28px icon container — CornerRadius="6" for compact size -->
                                <Border Width="28" Height="28" CornerRadius="6"
                                        Background="{StaticResource StatusInfoTintBrush}">
                                    <FontIcon Glyph="&#xE950;" FontFamily="Segoe MDL2 Assets"
                                              FontSize="13"
                                              Foreground="{StaticResource StatusInfoBrush}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="CPU"
                                           Style="{StaticResource CardTitleStyle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Ellipse Grid.Column="1" Width="8" Height="8"
                                     Fill="{StaticResource StatusGoodBrush}"
                                     VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="{x:Bind ViewModel.CpuDisplay, Mode=OneWay}"
                                   Style="{StaticResource MetricMediumStyle}" />

                        <ProgressBar x:Name="CpuBar"
                                     Style="{StaticResource UsageBar}"
                                     Foreground="{StaticResource AccentBlueBrush}" />

                        <TextBlock Text="{x:Bind ViewModel.CpuDetail, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Border>

                <!-- RAM Card -->
                <Border Grid.Column="1"
                        Style="{StaticResource CardSurface}"
                        Padding="20"
                        PointerEntered="Card_PointerEntered"
                        PointerExited="Card_PointerExited">
                    <Border.RenderTransform>
                        <CompositeTransform />
                    </Border.RenderTransform>
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="28" Height="28" CornerRadius="6"
                                        Background="{StaticResource AccentCyanTintBrush}">
                                    <FontIcon Glyph="&#xE964;" FontFamily="Segoe MDL2 Assets"
                                              FontSize="13"
                                              Foreground="{StaticResource AccentCyanBrush}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="RAM"
                                           Style="{StaticResource CardTitleStyle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Ellipse Grid.Column="1" Width="8" Height="8"
                                     Fill="{StaticResource StatusModerateBrush}"
                                     VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="{x:Bind ViewModel.RamDisplay, Mode=OneWay}"
                                   Style="{StaticResource MetricMediumStyle}" />

                        <ProgressBar x:Name="RamBar"
                                     Style="{StaticResource UsageBar}"
                                     Foreground="{StaticResource AccentCyanBrush}" />

                        <TextBlock Text="{x:Bind ViewModel.RamDetail, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Border>

                <!-- GPU Card -->
                <Border Grid.Column="2"
                        Style="{StaticResource CardSurface}"
                        Padding="20"
                        PointerEntered="Card_PointerEntered"
                        PointerExited="Card_PointerExited">
                    <Border.RenderTransform>
                        <CompositeTransform />
                    </Border.RenderTransform>
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="28" Height="28" CornerRadius="6"
                                        Background="{StaticResource StatusGoodTintBrush}">
                                    <FontIcon Glyph="&#xE7F4;" FontFamily="Segoe MDL2 Assets"
                                              FontSize="13"
                                              Foreground="{StaticResource StatusGoodBrush}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="GPU"
                                           Style="{StaticResource CardTitleStyle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Ellipse Grid.Column="1" Width="8" Height="8"
                                     Fill="{StaticResource StatusGoodBrush}"
                                     VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="{x:Bind ViewModel.GpuDisplay, Mode=OneWay}"
                                   Style="{StaticResource MetricMediumStyle}" />

                        <ProgressBar x:Name="GpuBar"
                                     Style="{StaticResource UsageBar}"
                                     Foreground="{StaticResource StatusGoodBrush}" />

                        <TextBlock Text="{x:Bind ViewModel.GpuDetail, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Border>

                <!-- Disk Card -->
                <Border Grid.Column="3"
                        Style="{StaticResource CardSurface}"
                        Padding="20"
                        PointerEntered="Card_PointerEntered"
                        PointerExited="Card_PointerExited">
                    <Border.RenderTransform>
                        <CompositeTransform />
                    </Border.RenderTransform>
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="28" Height="28" CornerRadius="6"
                                        Background="{StaticResource StatusModerateTintBrush}">
                                    <FontIcon Glyph="&#xEDA2;" FontFamily="Segoe MDL2 Assets"
                                              FontSize="13"
                                              Foreground="{StaticResource StatusModerateBrush}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Disk"
                                           Style="{StaticResource CardTitleStyle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Ellipse Grid.Column="1" Width="8" Height="8"
                                     Fill="{StaticResource StatusGoodBrush}"
                                     VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="{x:Bind ViewModel.DiskDisplay, Mode=OneWay}"
                                   Style="{StaticResource MetricMediumStyle}" />

                        <ProgressBar x:Name="DiskBar"
                                     Style="{StaticResource UsageBar}"
                                     Foreground="{StaticResource StatusModerateBrush}" />

                        <TextBlock Text="{x:Bind ViewModel.DiskDetail, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════
                 RECENT TRENDS
            ══════════════════════════════════════════════════════════ -->
            <TextBlock Text="Recent Trends"
                       Style="{StaticResource SectionTitleStyle}"
                       Margin="0,4,0,0" />

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Boot time -->
                <Border Grid.Column="0"
                        Style="{StaticResource CardSurface}"
                        Padding="20"
                        PointerEntered="Card_PointerEntered"
                        PointerExited="Card_PointerExited">
                    <Border.RenderTransform>
                        <CompositeTransform />
                    </Border.RenderTransform>
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xEC49;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="14"
                                      Foreground="{StaticResource AccentBlueBrush}" />
                            <TextBlock Text="Boot Time"
                                       Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind ViewModel.BootTimeValue, Mode=OneWay}"
                                       Style="{StaticResource MetricMediumStyle}" />
                            <Border Background="{StaticResource StatusGoodSubtleBrush}"
                                    CornerRadius="4" Padding="6,2"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.BootTimeDelta, Mode=OneWay}"
                                           FontSize="11"
                                           Foreground="{StaticResource StatusGoodBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="vs. last week average"
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Border>

                <!-- Avg CPU -->
                <Border Grid.Column="1"
                        Style="{StaticResource CardSurface}"
                        Padding="20"
                        PointerEntered="Card_PointerEntered"
                        PointerExited="Card_PointerExited">
                    <Border.RenderTransform>
                        <CompositeTransform />
                    </Border.RenderTransform>
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE9D2;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="14"
                                      Foreground="{StaticResource AccentCyanBrush}" />
                            <TextBlock Text="Avg CPU (7d)"
                                       Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind ViewModel.CpuAvgValue, Mode=OneWay}"
                                       Style="{StaticResource MetricMediumStyle}" />
                            <Border Background="{StaticResource StatusModerateSubtleBrush}"
                                    CornerRadius="4" Padding="6,2"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.CpuAvgDelta, Mode=OneWay}"
                                           FontSize="11"
                                           Foreground="{StaticResource StatusModerateBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="vs. last week average"
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Border>

                <!-- Avg RAM (7d) -->
                <Border Grid.Column="2"
                        Style="{StaticResource CardSurface}"
                        Padding="20"
                        PointerEntered="Card_PointerEntered"
                        PointerExited="Card_PointerExited">
                    <Border.RenderTransform>
                        <CompositeTransform />
                    </Border.RenderTransform>
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE964;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="14"
                                      Foreground="{StaticResource AccentCyanBrush}" />
                            <TextBlock Text="Avg RAM (7d)"
                                       Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind ViewModel.RamAvgValue, Mode=OneWay}"
                                       Style="{StaticResource MetricMediumStyle}" />
                            <Border Background="{StaticResource StatusModerateSubtleBrush}"
                                    CornerRadius="4" Padding="6,2"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.RamAvgDelta, Mode=OneWay}"
                                           FontSize="11"
                                           Foreground="{StaticResource StatusModerateBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="vs. last week average"
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Border>

                <!-- Disk free -->
                <Border Grid.Column="3"
                        Style="{StaticResource CardSurface}"
                        Padding="20"
                        PointerEntered="Card_PointerEntered"
                        PointerExited="Card_PointerExited">
                    <Border.RenderTransform>
                        <CompositeTransform />
                    </Border.RenderTransform>
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xEDA2;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="14"
                                      Foreground="{StaticResource StatusModerateBrush}" />
                            <TextBlock Text="Disk Free"
                                       Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind ViewModel.DiskFreeValue, Mode=OneWay}"
                                       Style="{StaticResource MetricMediumStyle}" />
                            <Border Background="{StaticResource StatusCriticalSubtleBrush}"
                                    CornerRadius="4" Padding="6,2"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.DiskFreeDelta, Mode=OneWay}"
                                           FontSize="11"
                                           Foreground="{StaticResource StatusCriticalBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="live from telemetry"
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════
                 QUICK ACTIONS
            ══════════════════════════════════════════════════════════ -->
            <TextBlock Text="Quick Actions"
                       Style="{StaticResource SectionTitleStyle}"
                       Margin="0,4,0,0" />

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource ActionButton}">
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE946;" FontFamily="Segoe MDL2 Assets"
                                  FontSize="18"
                                  Foreground="{StaticResource AccentBlueBrush}"
                                  HorizontalAlignment="Center" />
                        <TextBlock Text="Explain My PC"
                                   Style="{StaticResource CaptionTextStyle}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="1" Style="{StaticResource ActionButton}">
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE71C;" FontFamily="Segoe MDL2 Assets"
                                  FontSize="18"
                                  Foreground="{StaticResource AccentCyanBrush}"
                                  HorizontalAlignment="Center" />
                        <TextBlock Text="Full Scan"
                                   Style="{StaticResource CaptionTextStyle}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="2" Style="{StaticResource ActionButton}">
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                  FontSize="18"
                                  Foreground="{StaticResource StatusGoodBrush}"
                                  HorizontalAlignment="Center" />
                        <TextBlock Text="Cleanup"
                                   Style="{StaticResource CaptionTextStyle}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="3" Style="{StaticResource ActionButton}">
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE7B3;" FontFamily="Segoe MDL2 Assets"
                                  FontSize="18"
                                  Foreground="{StaticResource StatusModerateBrush}"
                                  HorizontalAlignment="Center" />
                        <TextBlock Text="Startup Apps"
                                   Style="{StaticResource CaptionTextStyle}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════
                 SMART ACTIONS
                 Top 3 ranked recommended actions from GlobalRecommendationPrioritizer.
                 Hidden when no active insights have recommended actions.
            ══════════════════════════════════════════════════════════ -->
            <Grid Visibility="{x:Bind ViewModel.SmartActionsVisibility, Mode=OneWay}"
                  Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Smart Actions"
                           Style="{StaticResource SectionTitleStyle}" />
                <Border Grid.Column="1"
                        Background="{StaticResource StatusGoodSubtleBrush}"
                        CornerRadius="10" Padding="8,3"
                        VerticalAlignment="Center">
                    <TextBlock Text="Ranked by impact"
                               FontSize="11"
                               Foreground="{StaticResource StatusGoodBrush}" />
                </Border>
            </Grid>

            <!--
                Ranked action cards — top 3 only on the dashboard for brevity.
                Full list available on the Insights page Actions tab.
            -->
            <ItemsRepeater Visibility="{x:Bind ViewModel.SmartActionsVisibility, Mode=OneWay}"
                           ItemsSource="{x:Bind ViewModel.SmartActions, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="8" Orientation="Vertical" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:PrioritizedActionViewModel">
                        <Border Background="#0AFFFFFF"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="16,12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Impact icon -->
                                <Border Width="34" Height="34"
                                        CornerRadius="8"
                                        Background="#0AFFFFFF"
                                        VerticalAlignment="Center">
                                    <FontIcon Glyph="{x:Bind ImpactGlyph}"
                                              FontFamily="Segoe MDL2 Assets"
                                              FontSize="13"
                                              Foreground="{x:Bind ImpactColor}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </Border>

                                <!-- Title + effectiveness + source attribution -->
                                <StackPanel Grid.Column="1"
                                            Spacing="2"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title}"
                                               FontFamily="Segoe UI Variable"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{x:Bind EffectivenessLabel}"
                                                   FontSize="11"
                                                   Foreground="{x:Bind EffectivenessColor}" />
                                        <TextBlock Text="&#xB7;"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind SourceInsightTitle}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Priority label badge -->
                                <Border Grid.Column="2"
                                        CornerRadius="6"
                                        Padding="8,4"
                                        Background="#0AFFFFFF"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind PriorityLabel}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{x:Bind PriorityColor}" />
                                </Border>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <!-- ══════════════════════════════════════════════════════════
                 WHY RECOMMENDED — personalization context for top action.
                 Shown when the personalization profile has learned
                 the user's preferences (≥ 3 recorded interactions).
            ══════════════════════════════════════════════════════════ -->
            <Border Visibility="{x:Bind ViewModel.PersonalizedRecommendationsVisibility, Mode=OneWay}"
                    Background="#081A4E9F"
                    BorderBrush="#1A4E9F"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,10">
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE946;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="11"
                                  Foreground="#4E9FFF" />
                        <TextBlock Text="Why recommended"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#4E9FFF" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.TopActionWhyRecommended, Mode=OneWay}"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════════════════════
                 EARLY WARNINGS
                 Synthesized from anomaly detections and Watchtower alerts.
                 Hidden when no warnings are active.
            ══════════════════════════════════════════════════════════ -->
            <Grid Visibility="{x:Bind ViewModel.WarningsVisibility, Mode=OneWay}"
                  Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Early Warnings"
                           Style="{StaticResource SectionTitleStyle}" />
                <Border Grid.Column="1"
                        Background="#1AF87171"
                        CornerRadius="10" Padding="8,3"
                        VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.WarningCountText, Mode=OneWay}"
                               FontSize="11"
                               Foreground="#F87171" />
                </Border>
            </Grid>

            <ItemsRepeater Visibility="{x:Bind ViewModel.WarningsVisibility, Mode=OneWay}"
                           ItemsSource="{x:Bind ViewModel.ActiveWarnings, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="8" Orientation="Vertical" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="intel:EarlyWarning">
                        <Border Background="#0AFFFFFF"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="16,12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Warning icon -->
                                <Border Width="34" Height="34"
                                        CornerRadius="8"
                                        Background="{x:Bind SeverityBadgeColor}"
                                        VerticalAlignment="Center">
                                    <FontIcon Glyph="{x:Bind Glyph}"
                                              FontFamily="Segoe MDL2 Assets"
                                              FontSize="14"
                                              Foreground="{x:Bind SeverityColor}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </Border>

                                <!-- Title + explanation -->
                                <StackPanel Grid.Column="1"
                                            Spacing="2"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title}"
                                               FontFamily="Segoe UI Variable"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Explanation}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               MaxLines="2" />
                                </StackPanel>

                                <!-- Severity + confidence badge -->
                                <StackPanel Grid.Column="2"
                                            Spacing="4"
                                            VerticalAlignment="Center">
                                    <Border CornerRadius="6"
                                            Padding="8,3"
                                            Background="{x:Bind SeverityBadgeColor}">
                                        <TextBlock Text="{x:Bind SeverityLabel}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{x:Bind SeverityColor}" />
                                    </Border>
                                    <TextBlock Text="{x:Bind ConfidenceLabel}"
                                               FontSize="10"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <!-- ══════════════════════════════════════════════════════════
                 ANOMALY SUMMARY
                 Short-term behavioral anomalies vs machine baseline.
                 Hidden when telemetry is within learned norms.
            ══════════════════════════════════════════════════════════ -->
            <Grid Visibility="{x:Bind ViewModel.AnomaliesVisibility, Mode=OneWay}"
                  Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Behavioral Anomalies"
                           Style="{StaticResource SectionTitleStyle}" />
                <Border Grid.Column="1"
                        Background="#1AFBBF24"
                        CornerRadius="10" Padding="8,3"
                        VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.AnomalyCountText, Mode=OneWay}"
                               FontSize="11"
                               Foreground="#FBBF24" />
                </Border>
            </Grid>

            <ItemsRepeater Visibility="{x:Bind ViewModel.AnomaliesVisibility, Mode=OneWay}"
                           ItemsSource="{x:Bind ViewModel.ActiveAnomalies, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="8" Orientation="Vertical" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="intel:DetectedAnomaly">
                        <Border Background="#0AFFFFFF"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="16,12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Metric icon -->
                                <Border Width="34" Height="34"
                                        CornerRadius="8"
                                        Background="{x:Bind SeverityBadgeColor}"
                                        VerticalAlignment="Center">
                                    <FontIcon Glyph="{x:Bind MetricGlyph}"
                                              FontFamily="Segoe MDL2 Assets"
                                              FontSize="14"
                                              Foreground="{x:Bind SeverityColor}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </Border>

                                <!-- Description + expected range -->
                                <StackPanel Grid.Column="1"
                                            Spacing="2"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Metric}"
                                               FontFamily="Segoe UI Variable"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind Description}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               MaxLines="2" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{x:Bind ExpectedMeanLabel}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="&#x2192;"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind ActualValueLabel}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{x:Bind SeverityColor}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Divergence + time -->
                                <StackPanel Grid.Column="2"
                                            Spacing="4"
                                            VerticalAlignment="Center">
                                    <Border CornerRadius="6"
                                            Padding="8,3"
                                            Background="{x:Bind SeverityBadgeColor}">
                                        <TextBlock Text="{x:Bind SeverityLabel}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{x:Bind SeverityColor}" />
                                    </Border>
                                    <TextBlock Text="{x:Bind DivergenceLabel}"
                                               FontSize="10"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <!-- ══════════════════════════════════════════════════════════
                 DRIFT TRENDS
                 Long-term operational drift from the Watchtower layer.
                 Hidden when no significant drift is detected.
            ══════════════════════════════════════════════════════════ -->
            <Grid Visibility="{x:Bind ViewModel.DriftsVisibility, Mode=OneWay}"
                  Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Drift Trends"
                           Style="{StaticResource SectionTitleStyle}" />
                <Border Grid.Column="1"
                        Background="#1A60A5FA"
                        CornerRadius="10" Padding="8,3"
                        VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.DriftCountText, Mode=OneWay}"
                               FontSize="11"
                               Foreground="#60A5FA" />
                </Border>
            </Grid>

            <ItemsRepeater Visibility="{x:Bind ViewModel.DriftsVisibility, Mode=OneWay}"
                           ItemsSource="{x:Bind ViewModel.ActiveDrifts, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="8" Orientation="Vertical" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="intel:DetectedDrift">
                        <Border Background="#0AFFFFFF"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14,10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Metric glyph -->
                                <Border Width="32" Height="32"
                                        CornerRadius="8"
                                        Background="#0AFFFFFF"
                                        VerticalAlignment="Center">
                                    <FontIcon Glyph="{x:Bind MetricGlyph}"
                                              FontFamily="Segoe MDL2 Assets"
                                              FontSize="13"
                                              Foreground="{x:Bind DirectionColor}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </Border>

                                <!-- Metric name + summary -->
                                <StackPanel Grid.Column="1"
                                            Spacing="2"
                                            VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{x:Bind MetricName}"
                                                   FontFamily="Segoe UI Variable"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{x:Bind DirectionGlyph}"
                                                   FontSize="13"
                                                   Foreground="{x:Bind DirectionColor}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind AvgComparisonLabel}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>

                                <!-- Change label -->
                                <Border Grid.Column="2"
                                        CornerRadius="6"
                                        Padding="8,4"
                                        Background="#0AFFFFFF"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ChangeLabel}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{x:Bind DirectionColor}" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <!-- ══════════════════════════════════════════════════════════
                 MACHINE PERSONALITY
                 Deterministic operational character classification.
                 Hidden until sufficient historical data is available.
            ══════════════════════════════════════════════════════════ -->
            <TextBlock Text="Machine Personality"
                       Style="{StaticResource SectionTitleStyle}"
                       Margin="0,4,0,0"
                       Visibility="{x:Bind ViewModel.PersonalityVisibility, Mode=OneWay}" />

            <Border Visibility="{x:Bind ViewModel.PersonalityVisibility, Mode=OneWay}"
                    Background="#0AFFFFFF"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20,16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Personality icon -->
                    <Border Width="44" Height="44"
                            CornerRadius="10"
                            Background="{x:Bind ViewModel.PersonalityBadgeBgColor, Mode=OneWay}"
                            VerticalAlignment="Center">
                        <FontIcon Glyph="{x:Bind ViewModel.PersonalityGlyph, Mode=OneWay}"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="18"
                                  Foreground="{x:Bind ViewModel.PersonalityAccentColor, Mode=OneWay}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                    </Border>

                    <!-- Personality details -->
                    <StackPanel Grid.Column="1"
                                Spacing="4"
                                VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.PersonalityTitle, Mode=OneWay}"
                                   FontFamily="Segoe UI Variable"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{x:Bind ViewModel.PersonalityAccentColor, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.PersonalityDescription, Mode=OneWay}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Confidence badge -->
                    <Border Grid.Column="2"
                            CornerRadius="8"
                            Padding="10,6"
                            Background="{x:Bind ViewModel.PersonalityBadgeBgColor, Mode=OneWay}"
                            VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.PersonalityConfidence, Mode=OneWay}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{x:Bind ViewModel.PersonalityAccentColor, Mode=OneWay}" />
                    </Border>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════
                 OPERATIONAL STYLE
                 Derived from recorded interaction history.
                 Hidden until ≥ 3 interventions recorded.
            ══════════════════════════════════════════════════════════ -->
            <TextBlock Text="Your Operational Style"
                       Style="{StaticResource SectionTitleStyle}"
                       Margin="0,4,0,0"
                       Visibility="{x:Bind ViewModel.OperationalStyleVisibility, Mode=OneWay}" />

            <Border Visibility="{x:Bind ViewModel.OperationalStyleVisibility, Mode=OneWay}"
                    Background="#0AFFFFFF"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20,16">
                <StackPanel Spacing="10">

                    <!-- Style header: icon + label + sample count -->
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Style icon -->
                        <Border Width="40" Height="40"
                                CornerRadius="10"
                                Background="#0AFFFFFF"
                                VerticalAlignment="Center">
                            <FontIcon Glyph="{x:Bind ViewModel.OperationalStyleGlyph, Mode=OneWay}"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="17"
                                      Foreground="{x:Bind ViewModel.OperationalStyleColor, Mode=OneWay}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>

                        <!-- Style label + description -->
                        <StackPanel Grid.Column="1"
                                    Spacing="3"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.OperationalStyleLabel, Mode=OneWay}"
                                       FontFamily="Segoe UI Variable"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{x:Bind ViewModel.OperationalStyleColor, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.OperationalStyleDescription, Mode=OneWay}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Sample count badge -->
                        <Border Grid.Column="2"
                                CornerRadius="8"
                                Padding="8,4"
                                Background="#0AFFFFFF"
                                VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.OperationalStyleSampleCount, Mode=OneWay}"
                                       FontSize="10"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </Border>
                    </Grid>

                    <!-- Personal insight sentence -->
                    <Border Background="#08FFFFFF"
                            CornerRadius="8"
                            Padding="12,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE82D;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="12"
                                      Foreground="{x:Bind ViewModel.OperationalStyleColor, Mode=OneWay}"
                                      VerticalAlignment="Top"
                                      Margin="0,1,0,0" />
                            <TextBlock Text="{x:Bind ViewModel.OperationalStyleInsight, Mode=OneWay}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════════════════════
                 ACTIVE INSIGHTS
            ══════════════════════════════════════════════════════════ -->
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Active Insights"
                           Style="{StaticResource SectionTitleStyle}" />
                <Border Grid.Column="1"
                        Background="{StaticResource StatusInfoSubtleBrush}"
                        CornerRadius="10" Padding="8,3">
                    <TextBlock Text="{x:Bind ViewModel.InsightCountText, Mode=OneWay}"
                               FontSize="11"
                               Foreground="{StaticResource StatusInfoBrush}" />
                </Border>
            </Grid>

            <!--
                Live grouped insight cards, sorted Warnings → Recommendations → Informational.
                Each InsightGroupViewModel contains sorted InsightCardViewModels.
                Only non-empty groups are present in InsightGroups.
            -->
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.InsightGroups, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="20" Orientation="Vertical" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:InsightGroupViewModel">
                        <StackPanel Spacing="8">

                            <!-- Group header: coloured icon + title + count badge -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="{x:Bind GroupIcon}"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="13"
                                          Foreground="{x:Bind GroupAccentBrush}"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind GroupTitle}"
                                           FontFamily="Segoe UI Variable"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{x:Bind GroupAccentBrush}"
                                           VerticalAlignment="Center" />
                                <Border Background="{x:Bind GroupTintBrush}"
                                        CornerRadius="8"
                                        Padding="7,2"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind CountText}"
                                               FontSize="11"
                                               Foreground="{x:Bind GroupAccentBrush}" />
                                </Border>
                            </StackPanel>

                            <!-- Cards in this severity group -->
                            <ItemsRepeater ItemsSource="{x:Bind Cards}"
                                           ItemTemplate="{StaticResource InsightCardTemplate}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="8" Orientation="Vertical" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>

                        </StackPanel>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

        </StackPanel>
    </ScrollViewer>
</Page>
