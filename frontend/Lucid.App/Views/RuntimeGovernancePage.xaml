<Page
    x:Class="Lucid.Views.RuntimeGovernancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Lucid.Views"
    xmlns:vm="using:Lucid.ViewModels"
    Background="{StaticResource AppBackgroundBrush}">

    <!--
        RuntimeGovernancePage.xaml — Runtime Governance
        ═══════════════════════════════════════════════════════════════════════
        Shows the live operational posture of Lucid's resource governance
        layer: current runtime mode, active concurrency slots, deferred workloads,
        and adaptive polling rates.

        Sections (top to bottom):
          1. Page header + Refresh button
          2. Loading indicator
          3. Runtime mode banner (Normal / throttled)
          4. Polling rate cards (Telemetry · Process · Background slots)
          5. Active workloads list
          6. Deferred workloads list

        All content binds to RuntimeGovernanceViewModel via DataContext.
        No XAML converters — all Visibility properties exposed from ViewModel.
    -->

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32,32,32,56" Spacing="24">

            <!-- ═══════════════════════════════════════════════════════════════
                 1. PAGE HEADER
            ═══════════════════════════════════════════════════════════════ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock Text="Runtime Governance"
                               Style="{StaticResource TitleTextBlockStyle}"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock Text="Live operational posture — adaptive polling, workload concurrency, and throttling decisions."
                               Style="{StaticResource SecondaryBodyStyle}" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource AccentButtonStyle}" />
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════════
                 2. LOADING INDICATOR
            ═══════════════════════════════════════════════════════════════ -->
            <StackPanel Spacing="12"
                        Visibility="{Binding LoadingVisibility}"
                        HorizontalAlignment="Center"
                        Margin="0,32,0,0">
                <ProgressRing IsActive="True" Width="40" Height="40"
                              Foreground="{StaticResource AccentPurpleBrush}" />
                <TextBlock Text="Loading governance state…"
                           Style="{StaticResource SecondaryBodyStyle}"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Content (hidden while loading) -->
            <StackPanel Visibility="{Binding ContentVisibility}" Spacing="24">

                <!-- ═══════════════════════════════════════════════════════════
                     3. RUNTIME MODE BANNER
                ═══════════════════════════════════════════════════════════ -->

                <!-- Normal mode — calm green banner -->
                <Border Visibility="{Binding IsNormalVisibility}"
                        Background="#0F1D14"
                        BorderBrush="#22C55E"
                        BorderThickness="0,0,0,2"
                        CornerRadius="8"
                        Padding="20,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Glyph="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                  Foreground="#22C55E" FontSize="20"
                                  VerticalAlignment="Center" Margin="0,0,16,0" />

                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="Normal"
                                       FontWeight="SemiBold" FontSize="15"
                                       Foreground="#22C55E" />
                            <TextBlock Text="{Binding ModeDescription}"
                                       Style="{StaticResource SecondaryBodyStyle}" />
                        </StackPanel>

                        <Border Grid.Column="2"
                                Background="#22C55E20"
                                BorderBrush="#22C55E"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,4"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding SnapshotTime}"
                                       FontSize="11"
                                       Foreground="#22C55E" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Non-Normal mode — amber warning banner -->
                <Border Visibility="{Binding IsNotNormalVisibility}"
                        Background="#1D1700"
                        BorderBrush="#F59E0B"
                        BorderThickness="0,0,0,2"
                        CornerRadius="8"
                        Padding="20,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Glyph="&#xE7BA;" FontFamily="Segoe MDL2 Assets"
                                  Foreground="#F59E0B" FontSize="20"
                                  VerticalAlignment="Center" Margin="0,0,16,0" />

                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{Binding ModeLabel}"
                                       FontWeight="SemiBold" FontSize="15"
                                       Foreground="#F59E0B" />
                            <TextBlock Text="{Binding ModeDescription}"
                                       Style="{StaticResource SecondaryBodyStyle}" />
                            <TextBlock Text="{Binding ThrottlingReasons}"
                                       FontSize="12"
                                       Foreground="#D97706"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <Border Grid.Column="2"
                                Background="#F59E0B20"
                                BorderBrush="#F59E0B"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,4"
                                VerticalAlignment="Top">
                            <TextBlock Text="{Binding SnapshotTime}"
                                       FontSize="11"
                                       Foreground="#F59E0B" />
                        </Border>
                    </Grid>
                </Border>

                <!-- ═══════════════════════════════════════════════════════════
                     4. POLLING RATE + CONCURRENCY CARDS
                ═══════════════════════════════════════════════════════════ -->
                <TextBlock Text="Resource Budget"
                           Style="{StaticResource SectionHeaderStyle}" />

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Telemetry Interval -->
                    <Border Grid.Column="0"
                            Background="{StaticResource CardBackgroundBrush}"
                            CornerRadius="8" Padding="16,14">
                        <StackPanel Spacing="6">
                            <FontIcon Glyph="&#xE9F3;" FontFamily="Segoe MDL2 Assets"
                                      Foreground="{StaticResource AccentPurpleBrush}"
                                      FontSize="16" />
                            <TextBlock Text="{Binding TelemetryInterval}"
                                       FontSize="22" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBlock Text="Telemetry Interval"
                                       Style="{StaticResource SecondaryBodyStyle}"
                                       FontSize="12" />
                        </StackPanel>
                    </Border>

                    <!-- Process Interval -->
                    <Border Grid.Column="1"
                            Background="{StaticResource CardBackgroundBrush}"
                            CornerRadius="8" Padding="16,14">
                        <StackPanel Spacing="6">
                            <FontIcon Glyph="&#xE9F5;" FontFamily="Segoe MDL2 Assets"
                                      Foreground="{StaticResource AccentPurpleBrush}"
                                      FontSize="16" />
                            <TextBlock Text="{Binding ProcessInterval}"
                                       FontSize="22" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBlock Text="Process Sample Interval"
                                       Style="{StaticResource SecondaryBodyStyle}"
                                       FontSize="12" />
                        </StackPanel>
                    </Border>

                    <!-- Background Slots -->
                    <Border Grid.Column="2"
                            Background="{StaticResource CardBackgroundBrush}"
                            CornerRadius="8" Padding="16,14">
                        <StackPanel Spacing="6">
                            <FontIcon Glyph="&#xE8F4;" FontFamily="Segoe MDL2 Assets"
                                      Foreground="{StaticResource AccentPurpleBrush}"
                                      FontSize="16" />
                            <TextBlock Text="{Binding BackgroundSlots}"
                                       FontSize="22" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBlock Text="Background Slots"
                                       Style="{StaticResource SecondaryBodyStyle}"
                                       FontSize="12" />
                        </StackPanel>
                    </Border>

                    <!-- Active Workloads -->
                    <Border Grid.Column="3"
                            Background="{StaticResource CardBackgroundBrush}"
                            CornerRadius="8" Padding="16,14">
                        <StackPanel Spacing="6">
                            <FontIcon Glyph="&#xE768;" FontFamily="Segoe MDL2 Assets"
                                      Foreground="{StaticResource AccentPurpleBrush}"
                                      FontSize="16" />
                            <TextBlock Text="{Binding ActiveWorkloadCount}"
                                       FontSize="22" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBlock Text="Active Workloads"
                                       Style="{StaticResource SecondaryBodyStyle}"
                                       FontSize="12" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ═══════════════════════════════════════════════════════════
                     5. ACTIVE WORKLOADS
                ═══════════════════════════════════════════════════════════ -->
                <TextBlock Text="Active Workloads"
                           Style="{StaticResource SectionHeaderStyle}" />

                <!-- Empty state -->
                <Border Visibility="{Binding NoActiveWorkloadsVisibility}"
                        Background="{StaticResource CardBackgroundBrush}"
                        CornerRadius="8" Padding="24,20">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                  Foreground="#22C55E" FontSize="28"
                                  HorizontalAlignment="Center" />
                        <TextBlock Text="No workloads currently executing"
                                   Style="{StaticResource SecondaryBodyStyle}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Workload list -->
                <ItemsControl Visibility="{Binding HasActiveWorkloadsVisibility}"
                              ItemsSource="{Binding ActiveWorkloads}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ActiveWorkloadViewModel">
                            <Border Background="{StaticResource CardBackgroundBrush}"
                                    CornerRadius="8" Padding="16,14"
                                    Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Priority badge -->
                                    <StackPanel Grid.Column="0" Spacing="4"
                                                VerticalAlignment="Center"
                                                Margin="0,0,16,0" Width="80">
                                        <Border Visibility="{x:Bind ForegroundBadgeVisibility}"
                                                Background="#1E40AF20"
                                                BorderBrush="#3B82F6"
                                                BorderThickness="1"
                                                CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="Foreground" FontSize="10"
                                                       Foreground="#3B82F6"
                                                       HorizontalAlignment="Center" />
                                        </Border>
                                        <Border Visibility="{x:Bind BackgroundBadgeVisibility}"
                                                Background="#7C3AED20"
                                                BorderBrush="#8B5CF6"
                                                BorderThickness="1"
                                                CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="Background" FontSize="10"
                                                       Foreground="#8B5CF6"
                                                       HorizontalAlignment="Center" />
                                        </Border>
                                        <Border Visibility="{x:Bind IdleOnlyBadgeVisibility}"
                                                Background="#065F4620"
                                                BorderBrush="#10B981"
                                                BorderThickness="1"
                                                CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="Idle Only" FontSize="10"
                                                       Foreground="#10B981"
                                                       HorizontalAlignment="Center" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Name + category -->
                                    <StackPanel Grid.Column="1" Spacing="2"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}"
                                                   FontWeight="SemiBold" FontSize="14"
                                                   Foreground="{StaticResource PrimaryTextBrush}" />
                                        <TextBlock Text="{x:Bind CategoryLabel}"
                                                   Style="{StaticResource SecondaryBodyStyle}"
                                                   FontSize="12" />
                                    </StackPanel>

                                    <!-- Timing -->
                                    <StackPanel Grid.Column="2" Spacing="2"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Right">
                                        <TextBlock Text="{x:Bind ElapsedText}"
                                                   FontSize="18" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentPurpleBrush}"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Text="{x:Bind StartedText}"
                                                   Style="{StaticResource SecondaryBodyStyle}"
                                                   FontSize="11"
                                                   HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ═══════════════════════════════════════════════════════════
                     6. DEFERRED WORKLOADS
                ═══════════════════════════════════════════════════════════ -->
                <TextBlock Text="Deferred Workloads"
                           Style="{StaticResource SectionHeaderStyle}" />

                <!-- Empty state -->
                <Border Visibility="{Binding NoDeferredWorkloadsVisibility}"
                        Background="{StaticResource CardBackgroundBrush}"
                        CornerRadius="8" Padding="24,20">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                  Foreground="#22C55E" FontSize="28"
                                  HorizontalAlignment="Center" />
                        <TextBlock Text="No workloads currently deferred"
                                   Style="{StaticResource SecondaryBodyStyle}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Deferred list -->
                <ItemsControl Visibility="{Binding HasDeferredWorkloadsVisibility}"
                              ItemsSource="{Binding DeferredWorkloads}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DeferredWorkloadViewModel">
                            <Border Background="{StaticResource CardBackgroundBrush}"
                                    CornerRadius="8" Padding="16,14"
                                    Margin="0,0,0,8"
                                    BorderBrush="#F59E0B40"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Deferred icon -->
                                    <FontIcon Grid.Column="0"
                                              Glyph="&#xE8A4;" FontFamily="Segoe MDL2 Assets"
                                              Foreground="#F59E0B" FontSize="18"
                                              VerticalAlignment="Center"
                                              Margin="0,0,16,0" />

                                    <!-- Name + reason -->
                                    <StackPanel Grid.Column="1" Spacing="2"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}"
                                                   FontWeight="SemiBold" FontSize="14"
                                                   Foreground="{StaticResource PrimaryTextBrush}" />
                                        <TextBlock Text="{x:Bind CategoryLabel}"
                                                   Style="{StaticResource SecondaryBodyStyle}"
                                                   FontSize="12" />
                                        <TextBlock Text="{x:Bind Reason}"
                                                   FontSize="11"
                                                   Foreground="#D97706"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>

                                    <!-- Wait time -->
                                    <StackPanel Grid.Column="2" Spacing="2"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Right">
                                        <TextBlock Text="{x:Bind DeferredText}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#F59E0B"
                                                   HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ═══════════════════════════════════════════════════════════
                     7. POLICY REFERENCE TABLE
                ═══════════════════════════════════════════════════════════ -->
                <TextBlock Text="Mode Policy Reference"
                           Style="{StaticResource SectionHeaderStyle}" />

                <Border Background="{StaticResource CardBackgroundBrush}"
                        CornerRadius="8" Padding="20,16">
                    <StackPanel Spacing="0">
                        <!-- Header row -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Mode"          Style="{StaticResource MetricLabelStyle}" Grid.Column="0" />
                            <TextBlock Text="Telemetry"     Style="{StaticResource MetricLabelStyle}" Grid.Column="1" />
                            <TextBlock Text="Background"    Style="{StaticResource MetricLabelStyle}" Grid.Column="2" />
                            <TextBlock Text="Idle Work"     Style="{StaticResource MetricLabelStyle}" Grid.Column="3" />
                        </Grid>

                        <Rectangle Height="1" Fill="{StaticResource SubtleDividerBrush}" Margin="0,0,0,8" />

                        <!-- Normal -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Normal"      FontSize="13" Foreground="#22C55E"          Grid.Column="0" />
                            <TextBlock Text="1.5 s"       Style="{StaticResource SecondaryBodyStyle}" Grid.Column="1" />
                            <TextBlock Text="3 slots"     Style="{StaticResource SecondaryBodyStyle}" Grid.Column="2" />
                            <TextBlock Text="Allowed"     Style="{StaticResource SecondaryBodyStyle}" Grid.Column="3" />
                        </Grid>

                        <!-- High Load -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="High Load"   FontSize="13" Foreground="#F59E0B"          Grid.Column="0" />
                            <TextBlock Text="3.0 s"       Style="{StaticResource SecondaryBodyStyle}" Grid.Column="1" />
                            <TextBlock Text="1 slot"      Style="{StaticResource SecondaryBodyStyle}" Grid.Column="2" />
                            <TextBlock Text="Deferred"    Style="{StaticResource SecondaryBodyStyle}" Grid.Column="3" />
                        </Grid>

                        <!-- Gaming -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Gaming"      FontSize="13" Foreground="#F59E0B"          Grid.Column="0" />
                            <TextBlock Text="4.0 s"       Style="{StaticResource SecondaryBodyStyle}" Grid.Column="1" />
                            <TextBlock Text="Paused"      Style="{StaticResource SecondaryBodyStyle}" Grid.Column="2" />
                            <TextBlock Text="Deferred"    Style="{StaticResource SecondaryBodyStyle}" Grid.Column="3" />
                        </Grid>

                        <!-- Low Power -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Low Power"   FontSize="13" Foreground="#F59E0B"          Grid.Column="0" />
                            <TextBlock Text="6.0 s"       Style="{StaticResource SecondaryBodyStyle}" Grid.Column="1" />
                            <TextBlock Text="Paused"      Style="{StaticResource SecondaryBodyStyle}" Grid.Column="2" />
                            <TextBlock Text="Deferred"    Style="{StaticResource SecondaryBodyStyle}" Grid.Column="3" />
                        </Grid>

                        <!-- Thermal Protection -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Thermal Prot." FontSize="13" Foreground="#EF4444"         Grid.Column="0" />
                            <TextBlock Text="2.5 s"         Style="{StaticResource SecondaryBodyStyle}" Grid.Column="1" />
                            <TextBlock Text="Halted"        Style="{StaticResource SecondaryBodyStyle}" Grid.Column="2" />
                            <TextBlock Text="Halted"        Style="{StaticResource SecondaryBodyStyle}" Grid.Column="3" />
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
            <!-- end ContentVisibility panel -->

        </StackPanel>
    </ScrollViewer>
</Page>
