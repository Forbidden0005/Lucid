<Page
    x:Class="Lucid.Views.MachineBehaviorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Lucid.ViewModels"
    Background="{StaticResource AppBackgroundBrush}">

    <!--
        MachineBehaviorPage.xaml — Machine Identity, Workload Profiling & Behavioral Context
        ═══════════════════════════════════════════════════════════════════════════════════════
        Context-aware machine behavioral understanding workspace.

        Sections (top to bottom):
          1. Page header + Refresh
          2. Loading indicator
          3. Current Workload — live classification badge + rationale
          4. Machine Identity — dominant/secondary workloads + behavioral narrative
          5. Workload Breakdown — proportional session distribution
          6. Behavioral Patterns — recurring anomalies and correlations
          7. Recent Sessions — chronological session history
          8. Context Narrative — combined behavioral explanation paragraph
    -->

    <ScrollViewer x:Name="RootScrollViewer"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32,32,32,56" Spacing="24">

            <!-- ═══════════════════════════════════════════════════════════════
                 1. PAGE HEADER
            ═══════════════════════════════════════════════════════════════ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock Text="Machine Behavior"
                               Style="{StaticResource TitleTextBlockStyle}"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock Text="Behavioral identity, workload classification, and recurring pattern analysis — understanding how this machine is actually used."
                               Style="{StaticResource SecondaryBodyStyle}" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource AccentButtonStyle}" />
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════════
                 2. LOADING INDICATOR
            ═══════════════════════════════════════════════════════════════ -->
            <StackPanel Visibility="{Binding LoadingVisibility}"
                        HorizontalAlignment="Center" Margin="0,32,0,0" Spacing="12">
                <ProgressRing IsActive="True" Width="40" Height="40"
                              Foreground="{StaticResource AccentPurpleBrush}" />
                <TextBlock Text="Loading behavioral profile…"
                           Style="{StaticResource SecondaryBodyStyle}"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Content panel -->
            <StackPanel Visibility="{Binding ContentVisibility}" Spacing="24">

                <!-- ═══════════════════════════════════════════════════════════
                     3. CURRENT WORKLOAD
                ═══════════════════════════════════════════════════════════ -->
                <TextBlock Text="Current Workload"
                           Style="{StaticResource SectionHeaderStyle}" />

                <Border Background="{StaticResource CardBackgroundBrush}"
                        CornerRadius="8" Padding="20,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Workload color dot -->
                        <Ellipse Grid.Column="0"
                                 Width="14" Height="14"
                                 VerticalAlignment="Center"
                                 Margin="0,0,14,0">
                            <Ellipse.Fill>
                                <SolidColorBrush Color="{Binding CurrentWorkloadColor}" />
                            </Ellipse.Fill>
                        </Ellipse>

                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentWorkloadLabel}"
                                       FontSize="20" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBlock Text="{Binding CurrentWorkloadRationale}"
                                       Style="{StaticResource SecondaryBodyStyle}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Grid.Column="2" CornerRadius="12"
                                Padding="10,4"
                                VerticalAlignment="Center"
                                Margin="16,0,0,0"
                                Background="#1A1A2E">
                            <TextBlock Text="{Binding CurrentConfidenceLabel}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                        </Border>
                    </Grid>
                </Border>

                <!-- ═══════════════════════════════════════════════════════════
                     4. MACHINE IDENTITY
                ═══════════════════════════════════════════════════════════ -->
                <TextBlock Text="Machine Identity"
                           Style="{StaticResource SectionHeaderStyle}" />

                <Border Background="{StaticResource CardBackgroundBrush}"
                        CornerRadius="8" Padding="20,18">
                    <StackPanel Spacing="16">

                        <!-- Identity narrative -->
                        <TextBlock Text="{Binding IdentityNarrative}"
                                   FontSize="14"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   TextWrapping="Wrap" />

                        <!-- Dominant / Secondary / Stats -->
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Dominant workload -->
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Primary Workload"
                                           Style="{StaticResource SecondaryBodyStyle}"
                                           FontSize="11" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                        <Ellipse.Fill>
                                            <SolidColorBrush Color="{Binding DominantWorkloadColor}" />
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <TextBlock Text="{Binding DominantWorkloadLabel}"
                                               FontSize="15" FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryTextBrush}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Secondary workload -->
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Secondary Workload"
                                           Style="{StaticResource SecondaryBodyStyle}"
                                           FontSize="11" />
                                <TextBlock Text="{Binding SecondaryWorkloadLabel}"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                            </StackPanel>

                            <!-- Stats -->
                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Text="{Binding TotalSessionsText}"
                                           Style="{StaticResource SecondaryBodyStyle}"
                                           FontSize="12" />
                                <TextBlock Text="{Binding ProfileConfidenceLabel}"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════════════════════════
                     5. WORKLOAD BREAKDOWN
                ═══════════════════════════════════════════════════════════ -->
                <TextBlock Text="Session Distribution"
                           Style="{StaticResource SectionHeaderStyle}" />

                <!-- No data state -->
                <Border Visibility="{Binding NoBreakdownVisibility}"
                        Background="{StaticResource CardBackgroundBrush}"
                        CornerRadius="8" Padding="24,20">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE9D9;" FontFamily="Segoe MDL2 Assets"
                                  Foreground="{StaticResource SecondaryTextBrush}"
                                  FontSize="28" HorizontalAlignment="Center" />
                        <TextBlock Text="Session distribution will appear after workloads are recorded."
                                   Style="{StaticResource SecondaryBodyStyle}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Workload breakdown bars -->
                <ItemsControl Visibility="{Binding HasBreakdownVisibility}"
                              ItemsSource="{Binding WorkloadBreakdown}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:WorkloadShareViewModel">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="44" />
                                </Grid.ColumnDefinitions>

                                <!-- Label with color dot -->
                                <StackPanel Orientation="Horizontal" Spacing="6"
                                            VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                        <Ellipse.Fill>
                                            <SolidColorBrush Color="{x:Bind Color}" />
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <TextBlock Text="{x:Bind Label}"
                                               FontSize="13"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Progress bar -->
                                <ProgressBar Grid.Column="1"
                                             Value="{x:Bind BarValue}"
                                             Minimum="0" Maximum="100"
                                             Height="6"
                                             VerticalAlignment="Center"
                                             Margin="12,0">
                                    <ProgressBar.Foreground>
                                        <SolidColorBrush Color="{x:Bind Color}" />
                                    </ProgressBar.Foreground>
                                </ProgressBar>

                                <!-- Percentage -->
                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind Percentage}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ═══════════════════════════════════════════════════════════
                     6. BEHAVIORAL PATTERNS
                ═══════════════════════════════════════════════════════════ -->
                <TextBlock Text="Behavioral Patterns"
                           Style="{StaticResource SectionHeaderStyle}" />

                <!-- Empty state -->
                <Border Visibility="{Binding NoPatternsVisibility}"
                        Background="{StaticResource CardBackgroundBrush}"
                        CornerRadius="8" Padding="24,20">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                  Foreground="#22C55E" FontSize="28"
                                  HorizontalAlignment="Center" />
                        <TextBlock Text="No recurring patterns detected yet — more sessions will surface behavioral trends."
                                   Style="{StaticResource SecondaryBodyStyle}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Pattern cards -->
                <ItemsControl Visibility="{Binding HasPatternsVisibility}"
                              ItemsSource="{Binding DetectedPatterns}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PatternViewModel">
                            <Border Background="{StaticResource CardBackgroundBrush}"
                                    CornerRadius="8" Padding="16,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Workload color accent strip -->
                                    <Border Grid.Column="0" CornerRadius="2" Margin="0,0,14,0">
                                        <Border.Background>
                                            <SolidColorBrush Color="{x:Bind WorkloadColor}" />
                                        </Border.Background>
                                    </Border>

                                    <!-- Content -->
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="{x:Bind Label}"
                                                   FontWeight="SemiBold" FontSize="14"
                                                   Foreground="{StaticResource PrimaryTextBrush}" />
                                        <TextBlock Text="{x:Bind Description}"
                                                   Style="{StaticResource SecondaryBodyStyle}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="12"
                                                    Margin="0,4,0,0">
                                            <TextBlock Text="{x:Bind ObservationText}"
                                                       Style="{StaticResource SecondaryBodyStyle}"
                                                       FontSize="11" />
                                            <TextBlock Text="{x:Bind LastSeenText}"
                                                       Style="{StaticResource SecondaryBodyStyle}"
                                                       FontSize="11" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Confidence badge -->
                                    <Border Grid.Column="2" CornerRadius="10" Padding="8,3"
                                            VerticalAlignment="Top" Margin="12,0,0,0">
                                        <Border.Background>
                                            <SolidColorBrush Color="{x:Bind ConfidenceColor}"
                                                             Opacity="0.15" />
                                        </Border.Background>
                                        <TextBlock Text="{x:Bind ConfidenceLabel}"
                                                   FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Foreground>
                                                <SolidColorBrush Color="{x:Bind ConfidenceColor}" />
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ═══════════════════════════════════════════════════════════
                     7. RECENT SESSIONS
                ═══════════════════════════════════════════════════════════ -->
                <TextBlock Text="Recent Sessions"
                           Style="{StaticResource SectionHeaderStyle}" />

                <!-- Empty state -->
                <Border Visibility="{Binding NoSessionsVisibility}"
                        Background="{StaticResource CardBackgroundBrush}"
                        CornerRadius="8" Padding="24,20">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE823;" FontFamily="Segoe MDL2 Assets"
                                  Foreground="{StaticResource SecondaryTextBrush}"
                                  FontSize="28" HorizontalAlignment="Center" />
                        <TextBlock Text="Sessions are recorded as they complete. Use the app for a while to build history."
                                   Style="{StaticResource SecondaryBodyStyle}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Session rows -->
                <ItemsControl Visibility="{Binding HasSessionsVisibility}"
                              ItemsSource="{Binding RecentSessions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SessionSummaryViewModel">
                            <Border Background="{StaticResource CardBackgroundBrush}"
                                    CornerRadius="6" Padding="14,10"
                                    Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Workload color dot -->
                                    <Ellipse Grid.Column="0"
                                             Width="8" Height="8"
                                             VerticalAlignment="Center">
                                        <Ellipse.Fill>
                                            <SolidColorBrush Color="{x:Bind WorkloadColor}" />
                                        </Ellipse.Fill>
                                    </Ellipse>

                                    <!-- Workload + time range -->
                                    <StackPanel Grid.Column="1" Spacing="2"
                                                VerticalAlignment="Center"
                                                Margin="8,0,0,0">
                                        <TextBlock Text="{x:Bind WorkloadLabel}"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{StaticResource PrimaryTextBrush}" />
                                        <TextBlock Text="{x:Bind TimeRangeText}"
                                                   Style="{StaticResource SecondaryBodyStyle}"
                                                   FontSize="11" />
                                    </StackPanel>

                                    <!-- Duration -->
                                    <TextBlock Grid.Column="2"
                                               Text="{x:Bind DurationText}"
                                               Style="{StaticResource SecondaryBodyStyle}"
                                               FontSize="12" VerticalAlignment="Center" />

                                    <!-- Peak metrics -->
                                    <StackPanel Grid.Column="3"
                                                Orientation="Horizontal" Spacing="12"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind PeakCpuText}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                        <TextBlock Text="{x:Bind PeakRamText}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                    </StackPanel>

                                    <!-- Stress badges -->
                                    <StackPanel Grid.Column="4"
                                                Orientation="Horizontal" Spacing="4"
                                                VerticalAlignment="Center">
                                        <Border Visibility="{x:Bind ThermalBadge}"
                                                Background="#2D0A0A" CornerRadius="6"
                                                Padding="6,2">
                                            <TextBlock Text="Hot"
                                                       FontSize="10" FontWeight="SemiBold"
                                                       Foreground="#EF4444" />
                                        </Border>
                                        <Border Visibility="{x:Bind MemoryBadge}"
                                                Background="#0A1A2D" CornerRadius="6"
                                                Padding="6,2">
                                            <TextBlock Text="RAM"
                                                       FontSize="10" FontWeight="SemiBold"
                                                       Foreground="#3B82F6" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ═══════════════════════════════════════════════════════════
                     8. CONTEXT NARRATIVE
                ═══════════════════════════════════════════════════════════ -->
                <TextBlock Text="Behavioral Context"
                           Style="{StaticResource SectionHeaderStyle}" />

                <Border Background="{StaticResource CardBackgroundBrush}"
                        CornerRadius="8" Padding="20,16">
                    <StackPanel Spacing="8">
                        <FontIcon Glyph="&#xE946;" FontFamily="Segoe MDL2 Assets"
                                  Foreground="{StaticResource AccentPurpleBrush}"
                                  FontSize="18" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding ContextNarrative}"
                                   FontSize="14" LineHeight="22"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

            </StackPanel>
            <!-- end ContentVisibility panel -->

        </StackPanel>
    </ScrollViewer>
</Page>
