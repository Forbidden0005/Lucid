<Window
    x:Class="Lucid.Views.CompanionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:companion="using:Lucid.Services.Companion"
    Title="Lucid Companion">

    <!--
        Companion Overlay Window — floats above all other windows.

        Three mode layouts controlled by ViewModel.Mode:
          Bubble   (64×64)   — circular icon, click to expand
          Compact  (320×60)  — status strip with quick expand
          Expanded (360×560) — full conversation panel

        Layout is driven by Visibility strings from the ViewModel.
        No converters — all Visibility values are strings emitted directly
        from ViewModel and model computed properties.

        Quick action buttons use Click="Handler" in code-behind because
        WinUI 3 x:Bind cannot resolve ViewModel commands from within an
        ItemTemplate whose DataContext is the individual item.
    -->

    <Grid x:Name="RootGrid"
          RequestedTheme="Dark">


        <!-- ══════════════════════════════════════════════════════════════════
             BUBBLE MODE — 64×64 circular button
        ══════════════════════════════════════════════════════════════════ -->
        <Border Visibility="{x:Bind ViewModel.BubbleVisibility, Mode=OneWay}"
                Width="64" Height="64"
                CornerRadius="32"
                Background="#1E1E2E"
                BorderBrush="#3F3F5A"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Button Width="64" Height="64"
                    CornerRadius="32"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind ViewModel.ExpandFromBubbleCommand}"
                    ToolTipService.ToolTip="Open companion">
                <Grid>
                    <Ellipse Width="8" Height="8"
                             Fill="{x:Bind ViewModel.StatusColor, Mode=OneWay}"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Top"
                             Margin="0,8,8,0" />
                    <FontIcon Glyph="&#xE946;"
                              FontFamily="Segoe MDL2 Assets"
                              FontSize="22"
                              Foreground="#4E9FFF"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                </Grid>
            </Button>
        </Border>


        <!-- ══════════════════════════════════════════════════════════════════
             COMPACT MODE — 320×60 status strip
        ══════════════════════════════════════════════════════════════════ -->
        <Border Visibility="{x:Bind ViewModel.CompactVisibility, Mode=OneWay}"
                CornerRadius="12"
                Background="#1E1E2E"
                BorderBrush="#3F3F5A"
                BorderThickness="1">

            <Grid Height="60" Padding="12,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Drag handle (covers the left+center columns; designated in code-behind) -->
                <Grid x:Name="CompactDragHandle"
                      Grid.Column="0" Grid.ColumnSpan="2"
                      Background="Transparent" />

                <!-- App icon -->
                <Border Grid.Column="0"
                        Width="24" Height="24"
                        CornerRadius="6"
                        Background="#4E9FFF"
                        VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE946;"
                              FontFamily="Segoe MDL2 Assets"
                              FontSize="12"
                              Foreground="White"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                </Border>

                <!-- Status headline -->
                <StackPanel Grid.Column="1"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="Lucid"
                               FontSize="11"
                               FontWeight="Medium"
                               Foreground="#6B6B8A"
                               Margin="0,0,0,2" />
                    <TextBlock Text="{x:Bind ViewModel.StatusHeadline, Mode=OneWay}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#E4E4F0"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="1" />
                </StackPanel>

                <!-- Buttons -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="2"
                            VerticalAlignment="Center">

                    <Ellipse Width="8" Height="8"
                             Fill="{x:Bind ViewModel.StatusColor, Mode=OneWay}"
                             VerticalAlignment="Center"
                             Margin="0,0,6,0" />

                    <Button Width="32" Height="32"
                            CornerRadius="8"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind ViewModel.ToggleModeCommand}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.ModeToggleTooltip, Mode=OneWay}">
                        <FontIcon Glyph="&#xE740;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="12"
                                  Foreground="#A1A1AA" />
                    </Button>

                    <Button Width="32" Height="32"
                            CornerRadius="8"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind ViewModel.MinimizeToBubbleCommand}"
                            ToolTipService.ToolTip="Minimize to bubble">
                        <FontIcon Glyph="&#xE921;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="12"
                                  Foreground="#A1A1AA" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>


        <!-- ══════════════════════════════════════════════════════════════════
             EXPANDED MODE — 360×560 conversation panel
        ══════════════════════════════════════════════════════════════════ -->
        <Border Visibility="{x:Bind ViewModel.ExpandedVisibility, Mode=OneWay}"
                CornerRadius="14"
                Background="#1A1A2E"
                BorderBrush="#3F3F5A"
                BorderThickness="1">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />    <!-- Header / drag handle -->
                    <RowDefinition Height="Auto" />  <!-- Status bar -->
                    <RowDefinition Height="*" />     <!-- Message list -->
                    <RowDefinition Height="Auto" />  <!-- Quick actions -->
                    <RowDefinition Height="Auto" />  <!-- Input area -->
                </Grid.RowDefinitions>

                <!-- ── Header (drag handle) ──────────────────────────────────── -->
                <Grid Grid.Row="0"
                      x:Name="ExpandedDragHandle"
                      Padding="14,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="24" Height="24"
                            CornerRadius="6"
                            Background="#4E9FFF"
                            VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE946;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="12"
                                  Foreground="White"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="Operational Companion"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#E4E4F0" />
                        <TextBlock Text="Local · Deterministic · Explainable"
                                   FontSize="10"
                                   Foreground="#6B6B8A" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="2"
                                VerticalAlignment="Center">

                        <Button Width="32" Height="32"
                                CornerRadius="8"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{x:Bind ViewModel.ClearConversationCommand}"
                                ToolTipService.ToolTip="Clear conversation">
                            <FontIcon Glyph="&#xE74D;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="12"
                                      Foreground="#6B6B8A" />
                        </Button>

                        <Button Width="32" Height="32"
                                CornerRadius="8"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{x:Bind ViewModel.ToggleModeCommand}"
                                ToolTipService.ToolTip="Compact view">
                            <FontIcon Glyph="&#xE73F;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="12"
                                      Foreground="#6B6B8A" />
                        </Button>

                        <Button Width="32" Height="32"
                                CornerRadius="8"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{x:Bind ViewModel.MinimizeToBubbleCommand}"
                                ToolTipService.ToolTip="Minimize">
                            <FontIcon Glyph="&#xE921;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="12"
                                      Foreground="#6B6B8A" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ── Status bar ─────────────────────────────────────────────── -->
                <Border Grid.Row="1"
                        Background="#16162A"
                        Padding="14,7"
                        BorderBrush="#2A2A3E"
                        BorderThickness="0,1,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0"
                                 Width="8" Height="8"
                                 Fill="{x:Bind ViewModel.StatusColor, Mode=OneWay}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind ViewModel.StatusHeadline, Mode=OneWay}"
                                   FontSize="12"
                                   Foreground="#B0B0C8"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>

                <!-- ── Message list ───────────────────────────────────────────── -->
                <ScrollViewer Grid.Row="2"
                              x:Name="MessageScroller"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,8,0,4">
                    <StackPanel Spacing="0">

                        <!-- Empty state -->
                        <Border Visibility="{x:Bind ViewModel.NoMessagesVisibility, Mode=OneWay}"
                                Margin="20,32,20,0">
                            <StackPanel Spacing="10" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE946;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="32"
                                          Foreground="#3F3F5A"
                                          HorizontalAlignment="Center" />
                                <TextBlock Text="Ask me anything about your system."
                                           FontSize="12"
                                           Foreground="#6B6B8A"
                                           TextAlignment="Center"
                                           TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Border>

                        <!-- Message bubbles -->
                        <ItemsRepeater x:Name="MessageList"
                                       ItemsSource="{x:Bind ViewModel.Messages, Mode=OneWay}"
                                       Margin="8,0">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="4" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="companion:CompanionMessage">
                                    <Grid Margin="4,4,4,0">

                                        <!-- User message -->
                                        <Border Visibility="{x:Bind UserBubbleVisibility}"
                                                Background="#2A3A5C"
                                                CornerRadius="12,12,4,12"
                                                Padding="12,8"
                                                MaxWidth="270"
                                                HorizontalAlignment="Right">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{x:Bind Text}"
                                                           FontSize="12.5"
                                                           Foreground="#E4E4F0"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind TimeLabel}"
                                                           FontSize="10"
                                                           Foreground="#6B7280"
                                                           HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Border>

                                        <!-- System message -->
                                        <Grid Visibility="{x:Bind SystemBubbleVisibility}"
                                              HorizontalAlignment="Left"
                                              MaxWidth="295">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Width="24" Height="24"
                                                    CornerRadius="12"
                                                    Background="#23233A"
                                                    VerticalAlignment="Top"
                                                    Margin="0,2,8,0">
                                                <FontIcon Glyph="{x:Bind CategoryGlyph}"
                                                          FontFamily="Segoe MDL2 Assets"
                                                          FontSize="11"
                                                          Foreground="{x:Bind CategoryColor}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                            </Border>

                                            <Border Grid.Column="1"
                                                    Background="#23233A"
                                                    CornerRadius="4,12,12,12"
                                                    Padding="12,8">
                                                <StackPanel Spacing="5">
                                                    <TextBlock Text="{x:Bind Text}"
                                                               FontSize="12.5"
                                                               Foreground="#D4D4E8"
                                                               TextWrapping="Wrap"
                                                               LineHeight="18" />
                                                    <TextBlock Text="{x:Bind TimeLabel}"
                                                               FontSize="10"
                                                               Foreground="#4B5563" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <!-- Processing indicator -->
                        <Border Visibility="{x:Bind ViewModel.ProcessingVisibility, Mode=OneWay}"
                                HorizontalAlignment="Left"
                                Margin="20,8,0,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ProgressRing Width="16" Height="16"
                                              IsActive="True"
                                              Foreground="#4E9FFF" />
                                <TextBlock Text="Analyzing…"
                                           FontSize="11"
                                           Foreground="#6B7280"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Border Height="8" />
                    </StackPanel>
                </ScrollViewer>

                <!-- ── Quick actions ──────────────────────────────────────────── -->
                <ScrollViewer Grid.Row="3"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              Padding="10,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <!--
                            Quick action buttons — Click is handled in code-behind
                            because WinUI 3 x:Bind cannot resolve ViewModel commands
                            from inside a DataTemplate (the DataContext is QuickAction,
                            not CompanionViewModel). The code-behind uses the Tag to
                            identify the QuickAction and dispatch to the ViewModel.
                        -->
                        <ItemsRepeater x:Name="QuickActionList"
                                       ItemsSource="{x:Bind ViewModel.QuickActions}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="6" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="companion:QuickAction">
                                    <Button Background="#1E2233"
                                            BorderBrush="#3F3F5A"
                                            BorderThickness="1"
                                            CornerRadius="16"
                                            Padding="10,6"
                                            FontSize="11.5"
                                            Foreground="#B0B0C8"
                                            Tag="{x:Bind}"
                                            Click="QuickAction_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon Glyph="{x:Bind Glyph}"
                                                      FontFamily="Segoe MDL2 Assets"
                                                      FontSize="11"
                                                      Foreground="#6B9FFF" />
                                            <TextBlock Text="{x:Bind Label}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </ScrollViewer>

                <!-- ── Input area ─────────────────────────────────────────────── -->
                <Border Grid.Row="4"
                        Background="#16162A"
                        BorderBrush="#2A2A3E"
                        BorderThickness="0,1,0,0"
                        Padding="10,8"
                        CornerRadius="0,0,14,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 x:Name="InputBox"
                                 Text="{x:Bind ViewModel.InputText, Mode=TwoWay}"
                                 PlaceholderText="Ask about your system…"
                                 Background="#0D0D1A"
                                 BorderBrush="#3F3F5A"
                                 Foreground="#E4E4F0"
                                 FontSize="12.5"
                                 CornerRadius="10,4,4,10"
                                 Padding="12,8"
                                 MinHeight="36"
                                 AcceptsReturn="False"
                                 TextWrapping="NoWrap"
                                 KeyDown="InputBox_KeyDown" />

                        <Button Grid.Column="1"
                                Width="36" Height="36"
                                CornerRadius="4,10,10,4"
                                Background="#4E9FFF"
                                BorderThickness="0"
                                Margin="4,0,0,0"
                                Command="{x:Bind ViewModel.SendMessageCommand}"
                                ToolTipService.ToolTip="Send (Enter)">
                            <FontIcon Glyph="&#xE724;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="14"
                                      Foreground="White" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

    </Grid>
</Window>
