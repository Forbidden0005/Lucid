<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <RootNamespace>Lucid.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Tests run as x64 to match the main project platform -->
    <PlatformTarget>x64</PlatformTarget>
    <!--
      WindowsAppSDK 1.5 injects legacy win10-* RIDs transitively from Lucid.App.
      The .NET 10 SDK portable RID graph rejects those during test builds, so
      constrain tests to the single portable RID they actually run under.
    -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk"    Version="17.11.1" />
    <PackageReference Include="xunit"                      Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio"  Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector"         Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions"           Version="6.12.1" />
    <PackageReference Include="Moq"                        Version="4.20.72" />
  </ItemGroup>

  <!--
    Link pure service files directly instead of referencing Lucid.App.
    A ProjectReference pulls WinUI/WindowsAppSDK build targets into the test
    project, which makes unit tests run packaging/resource tasks they do not
    need. Keep this list focused on production files covered by tests.
  -->
  <ItemGroup>
    <Compile Include="..\Lucid.App\Services\Execution\Validation\ProcessExecutionFingerprint.cs"
             Link="App\Services\Execution\Validation\ProcessExecutionFingerprint.cs" />
    <Compile Include="..\Lucid.App\Services\Execution\Validation\ProcessIdentityValidator.cs"
             Link="App\Services\Execution\Validation\ProcessIdentityValidator.cs" />
    <Compile Include="..\Lucid.App\Services\Execution\Validation\VerifiedProcessTarget.cs"
             Link="App\Services\Execution\Validation\VerifiedProcessTarget.cs" />
    <Compile Include="..\Lucid.App\Services\Infrastructure\Startup\StartupHealthSnapshot.cs"
             Link="App\Services\Infrastructure\Startup\StartupHealthSnapshot.cs" />
    <Compile Include="..\Lucid.App\Services\Infrastructure\Startup\StartupTimeoutGuard.cs"
             Link="App\Services\Infrastructure\Startup\StartupTimeoutGuard.cs" />
    <Compile Include="..\Lucid.App\Services\Persistence\Reliability\WriteQueueMetrics.cs"
             Link="App\Services\Persistence\Reliability\WriteQueueMetrics.cs" />
    <Compile Include="..\Lucid.App\Services\Privacy\PrivacyPermissionWriter.cs"
             Link="App\Services\Privacy\PrivacyPermissionWriter.cs" />
    <Compile Include="..\Lucid.App\Services\Settings\AppSettings.cs"
             Link="App\Services\Settings\AppSettings.cs" />
    <Compile Include="..\Lucid.App\Services\Trust\EndpointValidation\EndpointTrustClassification.cs"
             Link="App\Services\Trust\EndpointValidation\EndpointTrustClassification.cs" />
    <Compile Include="..\Lucid.App\Services\Trust\EndpointValidation\EndpointValidationResult.cs"
             Link="App\Services\Trust\EndpointValidation\EndpointValidationResult.cs" />
    <Compile Include="..\Lucid.App\Services\Trust\EndpointValidation\LocalEndpointValidator.cs"
             Link="App\Services\Trust\EndpointValidation\LocalEndpointValidator.cs" />
    <Compile Include="..\Lucid.App\Services\Trust\Integrity\ConsentIntegrityValidator.cs"
             Link="App\Services\Trust\Integrity\ConsentIntegrityValidator.cs" />
    <Compile Include="..\Lucid.App\Services\Trust\Integrity\SignedTrustEnvelope.cs"
             Link="App\Services\Trust\Integrity\SignedTrustEnvelope.cs" />
    <Compile Include="..\Lucid.App\Services\Trust\Integrity\TrustIntegrityService.cs"
             Link="App\Services\Trust\Integrity\TrustIntegrityService.cs" />
    <Compile Include="..\Lucid.App\Services\Trust\Integrity\TrustPostureRecoveryManager.cs"
             Link="App\Services\Trust\Integrity\TrustPostureRecoveryManager.cs" />
  </ItemGroup>

</Project>
