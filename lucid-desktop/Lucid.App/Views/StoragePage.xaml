<Page
    x:Class="Lucid.Views.StoragePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Lucid.ViewModels"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="Page_Loaded">

    <!-- DataContext is set to the ViewModel so item templates below can reach
         its RelayCommands via {Binding DataContext.…, ElementName=RootScrollViewer};
         the page's own x:Bind bindings use the ViewModel property and are unaffected. -->
    <ScrollViewer x:Name="RootScrollViewer"
                  DataContext="{x:Bind ViewModel}"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32,32,32,48" Spacing="24">

            <!-- ── Header ──────────────────────────────────────────── -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="Storage Intelligence"
                               Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Large file discovery, duplicate detection, and cleanup opportunities"
                               Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>

                <!-- Scan / Cancel buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource PrimaryButton}"
                            Visibility="{x:Bind ViewModel.ScanButtonVisibility, Mode=OneWay}"
                            Command="{x:Bind ViewModel.ScanCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE71E;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                            <TextBlock Text="Scan Drive" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}"
                            Visibility="{x:Bind ViewModel.CancelButtonVisibility, Mode=OneWay}"
                            Command="{x:Bind ViewModel.CancelScanCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                            <TextBlock Text="Cancel" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ── Scan progress ──────────────────────────────────── -->
            <Border Visibility="{x:Bind ViewModel.ProgressVisibility, Mode=OneWay}"
                    Style="{StaticResource CardSurface}" Padding="20">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ProgressRing IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}"
                                      Width="18" Height="18"
                                      Foreground="{StaticResource AccentBlueBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.ScanPhase, Mode=OneWay}"
                                   Style="{StaticResource CardTitleStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <ProgressBar Value="{x:Bind ViewModel.ScanPercent, Mode=OneWay}"
                                 Maximum="100"
                                 Foreground="{StaticResource AccentBlueBrush}"
                                 Background="{StaticResource BarTrackBrush}"
                                 Height="4" CornerRadius="2" />
                    <TextBlock Text="{x:Bind ViewModel.ScanSubtext, Mode=OneWay}"
                               Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>
            </Border>

            <!-- ── Empty state ────────────────────────────────────── -->
            <Border Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}"
                    Style="{StaticResource CardSurface}" Padding="40">
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xEDA2;" FontFamily="Segoe MDL2 Assets"
                              FontSize="40" Foreground="{StaticResource TextSecondaryBrush}"
                              HorizontalAlignment="Center" />
                    <TextBlock Text="No scan results yet"
                               Style="{StaticResource SectionTitleStyle}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Run a scan to discover large files, duplicates, and storage breakdown."
                               Style="{StaticResource CaptionTextStyle}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               MaxWidth="360" />
                </StackPanel>
            </Border>

            <!-- ── Results area ───────────────────────────────────── -->
            <StackPanel Visibility="{x:Bind ViewModel.ResultsVisibility, Mode=OneWay}"
                        Spacing="20">

                <!-- Summary stat chips -->
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border Style="{StaticResource CardSurface}" Padding="16,10">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Files Scanned"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.TotalScanned, Mode=OneWay}"
                                       Style="{StaticResource CardTitleStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardSurface}" Padding="16,10">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Large Files"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.LargeFilesSummary, Mode=OneWay}"
                                       Style="{StaticResource CardTitleStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardSurface}" Padding="16,10">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Duplicate Waste"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.WasteSummary, Mode=OneWay}"
                                       Style="{StaticResource CardTitleStyle}"
                                       Foreground="{StaticResource StatusModerateBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardSurface}" Padding="16,10">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Scan Duration"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.ScanDuration, Mode=OneWay}"
                                       Style="{StaticResource CardTitleStyle}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Tab bar -->
                <StackPanel Orientation="Horizontal" Spacing="0">
                    <Button Command="{x:Bind ViewModel.SelectTabOverviewCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,0">
                        <TextBlock Text="Overview" />
                    </Button>
                    <Button Command="{x:Bind ViewModel.SelectTabLargeFilesCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,0">
                        <TextBlock Text="Large Files" />
                    </Button>
                    <Button Command="{x:Bind ViewModel.SelectTabDuplicatesCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,0">
                        <TextBlock Text="Duplicates" />
                    </Button>
                    <Button Command="{x:Bind ViewModel.SelectTabDownloadsCommand}"
                            Style="{StaticResource SecondaryButton}">
                        <TextBlock Text="Old Downloads" />
                    </Button>
                </StackPanel>

                <!-- ── Overview tab: category heatmap ─────────────── -->
                <StackPanel Visibility="{x:Bind ViewModel.OverviewPanelVisibility, Mode=OneWay}"
                            Spacing="12">
                    <TextBlock Text="Storage by Category"
                               Style="{StaticResource SectionTitleStyle}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CategoryRowViewModel">
                                <Border Style="{StaticResource CardSurface}" Padding="16,12">
                                    <StackPanel Spacing="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Label}"
                                                       Style="{StaticResource BodyTextStyle}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind FileCount}"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       Margin="12,0" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind Size}"
                                                       Style="{StaticResource CardTitleStyle}"
                                                       Foreground="{StaticResource AccentBlueBrush}" />
                                        </Grid>
                                        <!-- Heatmap bar -->
                                        <Grid Height="4" CornerRadius="2">
                                            <Border Background="{StaticResource BarTrackBrush}"
                                                    CornerRadius="2" />
                                            <Border Background="{StaticResource AccentBlueBrush}"
                                                    CornerRadius="2"
                                                    HorizontalAlignment="Left"
                                                    MinWidth="4" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ── Large Files tab ────────────────────────────── -->
                <StackPanel Visibility="{x:Bind ViewModel.LargeFilesPanelVisibility, Mode=OneWay}"
                            Spacing="12">
                    <TextBlock Text="Largest Files (≥ 50 MB)"
                               Style="{StaticResource SectionTitleStyle}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.LargeFiles, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LargeFileViewModel">
                                <Border Style="{StaticResource CardSurface}" Padding="16,14">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{x:Bind Name}"
                                                       Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="{x:Bind Path}"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Age}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind Size}"
                                                   Style="{StaticResource CardTitleStyle}"
                                                   Foreground="{StaticResource StatusModerateBrush}"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="3"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding DataContext.DeleteLargeFileCommand, ElementName=RootScrollViewer}"
                                                CommandParameter="{x:Bind}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="Stage for deletion" FontSize="11" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ── Duplicates tab ─────────────────────────────── -->
                <StackPanel Visibility="{x:Bind ViewModel.DuplicatesPanelVisibility, Mode=OneWay}"
                            Spacing="12">
                    <TextBlock Text="Duplicate File Groups"
                               Style="{StaticResource SectionTitleStyle}" />

                    <!-- Actionable groups — safe to remove -->
                    <ItemsControl Visibility="{x:Bind ViewModel.ActionableDuplicatesVisibility, Mode=OneWay}"
                                  ItemsSource="{x:Bind ViewModel.DuplicateGroups, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DuplicateGroupViewModel">
                                <Border Style="{StaticResource CardSurface}" Padding="16,14">
                                    <StackPanel Spacing="10">
                                        <!-- Group header -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{x:Bind KeepName}"
                                                           Style="{StaticResource CardTitleStyle}" />
                                                <TextBlock Text="{x:Bind KeepPath}"
                                                           Style="{StaticResource CaptionTextStyle}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="2"
                                                        Margin="12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Count}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind Waste}"
                                                           Style="{StaticResource CardTitleStyle}"
                                                           Foreground="{StaticResource StatusModerateBrush}" />
                                            </StackPanel>
                                            <Button Grid.Column="2"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Command="{Binding DataContext.DeleteDuplicatesCommand, ElementName=RootScrollViewer}"
                                                    CommandParameter="{x:Bind}"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="Remove duplicates" FontSize="11" />
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- No actionable duplicates (but some may be protected, below) -->
                    <Border Visibility="{x:Bind ViewModel.NoActionableDuplicatesVisibility, Mode=OneWay}"
                            Style="{StaticResource CardSurface}" Padding="16,14">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                      Foreground="{StaticResource StatusGoodBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock Text="No duplicates need action right now. Anything found in a protected system location is listed below to review manually."
                                       Style="{StaticResource BodyTextStyle}"
                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Protected — review manually. In system-managed locations, so
                         Lucid won't delete them (removing an app-managed copy can
                         break the program that owns it). -->
                    <StackPanel Visibility="{x:Bind ViewModel.ProtectedDuplicatesVisibility, Mode=OneWay}"
                                Spacing="8" Margin="0,8,0,0">
                        <TextBlock Text="Protected — review manually"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="These duplicates live in protected system locations (Windows, Program Files, ProgramData, driver and credential stores). Lucid won't remove them automatically, because deleting an app-managed copy can break the program that owns it. Open the location to review or remove them yourself if you're sure."
                                   Style="{StaticResource CaptionTextStyle}"
                                   TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.ProtectedDuplicateGroups, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DuplicateGroupViewModel">
                                    <Border Style="{StaticResource CardSurface}" Padding="16,14">
                                        <StackPanel Spacing="10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="2">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="&#xE72E;" FontFamily="Segoe MDL2 Assets"
                                                                  FontSize="12"
                                                                  Foreground="{StaticResource TextSecondaryBrush}"
                                                                  VerticalAlignment="Center" />
                                                        <TextBlock Text="{x:Bind KeepName}"
                                                                   Style="{StaticResource CardTitleStyle}" />
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind KeepPath}"
                                                               Style="{StaticResource CaptionTextStyle}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="2"
                                                            Margin="12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Count}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{x:Bind Waste}"
                                                               Style="{StaticResource CardTitleStyle}"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                </StackPanel>
                                                <Button Grid.Column="2"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Command="{Binding DataContext.OpenGroupLocationCommand, ElementName=RootScrollViewer}"
                                                        CommandParameter="{x:Bind}"
                                                        VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                                                        <TextBlock Text="Open location" FontSize="11" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Possible near-duplicates — review manually. Heuristic
                         matches (similar names, copy patterns, format variants),
                         not byte-identical, so no delete action is offered. -->
                    <StackPanel Visibility="{x:Bind ViewModel.NearDuplicatesVisibility, Mode=OneWay}"
                                Spacing="8" Margin="0,8,0,0">
                        <TextBlock Text="Possible near-duplicates — review manually"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="These file pairs look related — copy or version naming, the same name in different formats, or very similar names and sizes — but their contents are not identical, so Lucid won't offer to delete them. Each pair shows why it was flagged and a confidence level; review them yourself if the redundancy looks real."
                                   Style="{StaticResource CaptionTextStyle}"
                                   TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.NearDuplicates, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:NearDuplicateViewModel">
                                    <Border Style="{StaticResource CardSurface}" Padding="16,14">
                                        <StackPanel Spacing="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{x:Bind NameA}"
                                                               Style="{StaticResource CardTitleStyle}" />
                                                    <TextBlock Text="{x:Bind PathA}"
                                                               Style="{StaticResource CaptionTextStyle}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind NameB}"
                                                               Style="{StaticResource CardTitleStyle}"
                                                               Margin="0,6,0,0" />
                                                    <TextBlock Text="{x:Bind PathB}"
                                                               Style="{StaticResource CaptionTextStyle}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="2"
                                                            Margin="12,0,0,0" VerticalAlignment="Center"
                                                            HorizontalAlignment="Right">
                                                    <TextBlock Text="{x:Bind Confidence}"
                                                               FontSize="11"
                                                               TextAlignment="Right"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{x:Bind Redundant}"
                                                               Style="{StaticResource CardTitleStyle}"
                                                               TextAlignment="Right"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="{x:Bind Reason}"
                                                       Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>

                <!-- ── Old Downloads tab ─────────────────────────── -->
                <StackPanel Visibility="{x:Bind ViewModel.DownloadsPanelVisibility, Mode=OneWay}"
                            Spacing="12">
                    <TextBlock Text="Old Downloads (≥ 90 days)"
                               Style="{StaticResource SectionTitleStyle}" />
                    <Border Style="{StaticResource CardSurface}" Padding="16,12">
                        <StackPanel Spacing="6">
                            <TextBlock TextWrapping="Wrap"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Text="Files in your Downloads folder that haven't been modified in 90+ days. Use the Repair Center → Clean Old Downloads action to stage them for deletion with full rollback support." />
                            <Button Style="{StaticResource PrimaryButton}"
                                    Margin="0,4,0,0"
                                    Command="{x:Bind ViewModel.ScanCommand}">
                                <TextBlock Text="Scan to find old downloads" />
                            </Button>
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.OldDownloads, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LargeFileViewModel">
                                <Border Style="{StaticResource CardSurface}" Padding="14,10">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Name}"
                                                   Style="{StaticResource BodyTextStyle}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Age}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind Size}"
                                                   Style="{StaticResource CardTitleStyle}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Status text -->
                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                           Style="{StaticResource CaptionTextStyle}"
                           Visibility="{x:Bind ViewModel.ResultsVisibility, Mode=OneWay}" />

            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
