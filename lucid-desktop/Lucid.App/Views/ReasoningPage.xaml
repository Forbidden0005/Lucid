<Page
    x:Class="Lucid.Views.ReasoningPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Lucid.ViewModels"
    Background="{StaticResource AppBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24,20,24,32" Spacing="20"
                    MaxWidth="1100"
                    HorizontalAlignment="Left">

            <!-- ══ Page header ════════════════════════════════════════════════ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Reasoning"
                               Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Active inferences, context, patterns, and calibration from the cognitive intelligence layer"
                               Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding LastRefreshedText}"
                               Style="{StaticResource MetaTextStyle}"
                               VerticalAlignment="Center"
                               Opacity="0.5" />
                    <Button Content="Refresh"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>
            </Grid>

            <!-- ══ Loading ════════════════════════════════════════════════════ -->
            <ProgressBar IsIndeterminate="True"
                         Visibility="{Binding LoadingVisibility}"
                         Margin="0,4,0,0" />

            <!-- ══ Content (hidden while loading) ════════════════════════════ -->
            <StackPanel Spacing="20"
                        Visibility="{Binding ContentVisibility}">

                <!-- ── Workload Context card ─────────────────────────────── -->
                <Border Background="{StaticResource AppSurfaceBrush}"
                        CornerRadius="12"
                        Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Activity glyph badge -->
                        <Border Grid.Column="0"
                                Width="52" Height="52"
                                CornerRadius="26"
                                Background="#1A3B82F6"
                                Margin="0,0,16,0"
                                VerticalAlignment="Top">
                            <FontIcon Glyph="{Binding WorkloadActivityGlyph}"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="22"
                                      Foreground="{StaticResource AccentBlueBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>

                        <!-- Context details -->
                        <StackPanel Grid.Column="1" Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Current Context"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Opacity="0.6"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding WorkloadLabel}"
                                       Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="{Binding WorkloadConfidenceText}"
                                       Style="{StaticResource MetaTextStyle}"
                                       Opacity="0.6" />

                            <!-- Expected ranges row -->
                            <StackPanel Orientation="Horizontal" Spacing="20"
                                        Margin="0,4,0,0">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="CPU expected"
                                               Style="{StaticResource MetaTextStyle}"
                                               Opacity="0.5" />
                                    <TextBlock Text="{Binding ExpectedCpuRangeText}"
                                               Style="{StaticResource CardBodyStyle}" />
                                </StackPanel>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="RAM expected"
                                               Style="{StaticResource MetaTextStyle}"
                                               Opacity="0.5" />
                                    <TextBlock Text="{Binding ExpectedRamRangeText}"
                                               Style="{StaticResource CardBodyStyle}" />
                                </StackPanel>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Thermal expected"
                                               Style="{StaticResource MetaTextStyle}"
                                               Opacity="0.5" />
                                    <TextBlock Text="{Binding ExpectedThermalRangeText}"
                                               Style="{StaticResource CardBodyStyle}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Context flags -->
                            <StackPanel Orientation="Horizontal" Spacing="8"
                                        Visibility="{Binding ContextFlagsVisibility}"
                                        Margin="0,4,0,0">
                                <FontIcon Glyph="&#xE946;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="12"
                                          Foreground="#FBBF24"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ContextFlagsText}"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Foreground="#FBBF24"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Attention budget badge -->
                        <Border Grid.Column="2"
                                CornerRadius="8"
                                Padding="12,8"
                                VerticalAlignment="Top">
                            <StackPanel Spacing="4" HorizontalAlignment="Right">
                                <TextBlock Text="Interrupt budget"
                                           Style="{StaticResource MetaTextStyle}"
                                           HorizontalAlignment="Right"
                                           Opacity="0.5" />
                                <TextBlock Text="{Binding AttentionBudgetText}"
                                           Style="{StaticResource CaptionTextStyle}"
                                           HorizontalAlignment="Right">
                                    <TextBlock.Foreground>
                                        <SolidColorBrush Color="{Binding AttentionBudgetColor}" />
                                    </TextBlock.Foreground>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ── Active Inferences ─────────────────────────────────── -->
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE9CE;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="16"
                                  Foreground="{StaticResource AccentBlueBrush}"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="Active Inferences"
                                   Style="{StaticResource SectionTitleStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Empty state -->
                    <Border Background="{StaticResource AppSurfaceBrush}"
                            CornerRadius="10"
                            Padding="20"
                            Visibility="{Binding NoInferencesVisibility}">
                        <TextBlock Text="No inferences at this time. The reasoning engine runs on the next telemetry cycle."
                                   Style="{StaticResource BodyTextStyle}"
                                   Opacity="0.6" />
                    </Border>

                    <!-- Inference cards -->
                    <ItemsControl ItemsSource="{Binding Inferences}"
                                  Visibility="{Binding InferenceListVisibility}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:InferenceCardViewModel">
                                <Border Background="{StaticResource AppSurfaceBrush}"
                                        CornerRadius="10"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Priority accent stripe -->
                                        <Border Grid.Column="0" CornerRadius="10,0,0,10">
                                            <Border.Background>
                                                <SolidColorBrush Color="{x:Bind PriorityColor}" />
                                            </Border.Background>
                                        </Border>

                                        <!-- Content -->
                                        <StackPanel Grid.Column="1" Padding="16" Spacing="8">
                                            <!-- Header row -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Spacing="4">
                                                    <TextBlock Text="{x:Bind Headline}"
                                                               Style="{StaticResource CardTitleStyle}"
                                                               TextWrapping="Wrap" />
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <!-- Priority badge -->
                                                        <Border CornerRadius="3" Padding="6,2">
                                                            <Border.Background>
                                                                <SolidColorBrush Color="{x:Bind PriorityColor}" Opacity="0.15" />
                                                            </Border.Background>
                                                            <TextBlock Text="{x:Bind PriorityLabel}"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold">
                                                                <TextBlock.Foreground>
                                                                    <SolidColorBrush Color="{x:Bind PriorityColor}" />
                                                                </TextBlock.Foreground>
                                                            </TextBlock>
                                                        </Border>
                                                        <!-- Domains -->
                                                        <TextBlock Text="{x:Bind DomainsText}"
                                                                   Style="{StaticResource MetaTextStyle}"
                                                                   VerticalAlignment="Center"
                                                                   Opacity="0.6" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Confidence + evidence -->
                                                <StackPanel Grid.Column="1" Spacing="3"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Top">
                                                    <TextBlock Text="{x:Bind ConfidenceText}"
                                                               Style="{StaticResource MetaTextStyle}"
                                                               HorizontalAlignment="Right" />
                                                    <TextBlock Text="{x:Bind EvidenceCountText}"
                                                               Style="{StaticResource MetaTextStyle}"
                                                               HorizontalAlignment="Right"
                                                               Opacity="0.5" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- Explanation -->
                                            <TextBlock Text="{x:Bind Explanation}"
                                                       Style="{StaticResource BodyTextStyle}"
                                                       TextWrapping="Wrap"
                                                       Opacity="0.8" />

                                            <!-- Trajectory (optional) -->
                                            <StackPanel Orientation="Horizontal" Spacing="8"
                                                        Visibility="{x:Bind TrajectoryVisibility}">
                                                <FontIcon Glyph="&#xE72B;"
                                                          FontFamily="Segoe MDL2 Assets"
                                                          FontSize="11"
                                                          Foreground="#94A3B8"
                                                          VerticalAlignment="Center" />
                                                <TextBlock Text="{x:Bind Trajectory}"
                                                           Style="{StaticResource CaptionTextStyle}"
                                                           TextWrapping="Wrap"
                                                           Opacity="0.7"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>

                                            <!-- Suppression note -->
                                            <Border Background="#0AFBBF24"
                                                    CornerRadius="6"
                                                    Padding="10,6"
                                                    Visibility="{x:Bind SuppressedVisibility}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xEA3A;"
                                                              FontFamily="Segoe MDL2 Assets"
                                                              FontSize="12"
                                                              Foreground="#FBBF24"
                                                              VerticalAlignment="Center" />
                                                    <TextBlock Style="{StaticResource CaptionTextStyle}"
                                                               Foreground="#FBBF24"
                                                               TextWrapping="Wrap"
                                                               VerticalAlignment="Center">
                                                        <Run Text="Context-filtered: " />
                                                        <Run Text="{x:Bind SuppressionReason}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>

                                            <!-- Workload context tag -->
                                            <TextBlock Text="{x:Bind WorkloadContextText}"
                                                       Style="{StaticResource MetaTextStyle}"
                                                       Opacity="0.45"
                                                       Visibility="{x:Bind WorkloadVisibility}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ── Recommendations ───────────────────────────────────── -->
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE8F4;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="16"
                                  Foreground="{StaticResource AccentBlueBrush}"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="Recommendations"
                                   Style="{StaticResource SectionTitleStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <Border Background="{StaticResource AppSurfaceBrush}"
                            CornerRadius="10"
                            Padding="20"
                            Visibility="{Binding NoRecommendationsVisibility}">
                        <TextBlock Text="No recommendations at this time."
                                   Style="{StaticResource BodyTextStyle}"
                                   Opacity="0.6" />
                    </Border>

                    <ItemsControl ItemsSource="{Binding Recommendations}"
                                  Visibility="{Binding RecommendationListVisibility}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RecommendationCardViewModel">
                                <Border Background="{StaticResource AppSurfaceBrush}"
                                        CornerRadius="10"
                                        Padding="16"
                                        Margin="0,0,0,8">
                                    <StackPanel Spacing="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <TextBlock Text="{x:Bind Headline}"
                                                           Style="{StaticResource CardTitleStyle}"
                                                           TextWrapping="Wrap" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Border CornerRadius="3" Padding="6,2">
                                                        <Border.Background>
                                                            <SolidColorBrush Color="{x:Bind SeverityColor}" Opacity="0.15" />
                                                        </Border.Background>
                                                        <TextBlock Text="{x:Bind SeverityLabel}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold">
                                                            <TextBlock.Foreground>
                                                                <SolidColorBrush Color="{x:Bind SeverityColor}" />
                                                            </TextBlock.Foreground>
                                                        </TextBlock>
                                                    </Border>
                                                    <TextBlock Text="{x:Bind Domain}"
                                                               Style="{StaticResource MetaTextStyle}"
                                                               VerticalAlignment="Center"
                                                               Opacity="0.6" />
                                                    <TextBlock Text="{x:Bind ActionCountText}"
                                                               Style="{StaticResource MetaTextStyle}"
                                                               VerticalAlignment="Center"
                                                               Opacity="0.6" />
                                                </StackPanel>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind UrgencyPhrase}"
                                                       Style="{StaticResource MetaTextStyle}"
                                                       VerticalAlignment="Top"
                                                       Opacity="0.55" />
                                        </Grid>

                                        <TextBlock Text="{x:Bind Summary}"
                                                   Style="{StaticResource BodyTextStyle}"
                                                   TextWrapping="Wrap"
                                                   Opacity="0.8" />

                                        <!-- Reasoning explanation -->
                                        <TextBlock Text="{x:Bind ReasoningExplanation}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   TextWrapping="Wrap"
                                                   Opacity="0.6"
                                                   Visibility="{x:Bind ReasoningVisibility}" />

                                        <!-- Fatigue note -->
                                        <Border Background="{StaticResource AppChipBrush}"
                                                CornerRadius="6"
                                                Padding="10,6"
                                                Visibility="{x:Bind FatigueNoteVisibility}">
                                            <TextBlock Text="{x:Bind FatigueNote}"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       Opacity="0.7" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ── Recurring Patterns ────────────────────────────────── -->
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE823;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="16"
                                  Foreground="{StaticResource AccentBlueBrush}"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="Recurring Patterns"
                                   Style="{StaticResource SectionTitleStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <Border Background="{StaticResource AppSurfaceBrush}"
                            CornerRadius="10"
                            Padding="20"
                            Visibility="{Binding NoPatternsVisibility}">
                        <TextBlock Text="No recurring patterns detected yet. Patterns emerge after multiple sessions."
                                   Style="{StaticResource BodyTextStyle}"
                                   Opacity="0.6" />
                    </Border>

                    <ItemsControl ItemsSource="{Binding Patterns}"
                                  Visibility="{Binding PatternListVisibility}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PatternRowViewModel">
                                <Border Background="{StaticResource AppSurfaceBrush}"
                                        CornerRadius="10"
                                        Padding="16"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Text="{x:Bind Description}"
                                                       Style="{StaticResource CardTitleStyle}"
                                                       TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <!-- Stability badge -->
                                                <Border CornerRadius="3" Padding="6,2">
                                                    <Border.Background>
                                                        <SolidColorBrush Color="{x:Bind StabilityColor}" Opacity="0.15" />
                                                    </Border.Background>
                                                    <TextBlock Text="{x:Bind StabilityLabel}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold">
                                                        <TextBlock.Foreground>
                                                            <SolidColorBrush Color="{x:Bind StabilityColor}" />
                                                        </TextBlock.Foreground>
                                                    </TextBlock>
                                                </Border>
                                                <TextBlock Text="{x:Bind DomainsText}"
                                                           Style="{StaticResource MetaTextStyle}"
                                                           VerticalAlignment="Center"
                                                           Opacity="0.6" />
                                                <TextBlock Text="{x:Bind WorkloadContextText}"
                                                           Style="{StaticResource MetaTextStyle}"
                                                           VerticalAlignment="Center"
                                                           Opacity="0.5"
                                                           Visibility="{x:Bind WorkloadVisibility}" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind RecurrenceSummary}"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       Opacity="0.6" />
                                        </StackPanel>

                                        <!-- Confidence + occurrences -->
                                        <StackPanel Grid.Column="1" Spacing="4"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind OccurrenceText}"
                                                       FontSize="22"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Right">
                                                <TextBlock.Foreground>
                                                    <SolidColorBrush Color="{x:Bind ConfidenceColor}" />
                                                </TextBlock.Foreground>
                                            </TextBlock>
                                            <TextBlock Text="{x:Bind ConfidenceText}"
                                                       Style="{StaticResource MetaTextStyle}"
                                                       HorizontalAlignment="Right"
                                                       Opacity="0.6" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ── Adaptive Baselines ────────────────────────────────── -->
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE9D9;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="16"
                                  Foreground="{StaticResource AccentBlueBrush}"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="Adaptive Baselines"
                                   Style="{StaticResource SectionTitleStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <Border Background="{StaticResource AppSurfaceBrush}"
                            CornerRadius="10"
                            Padding="20"
                            Visibility="{Binding NoBaselinesVisibility}">
                        <TextBlock Text="No baselines established yet. Baselines build as Lucid observes your machine under different workloads."
                                   Style="{StaticResource BodyTextStyle}"
                                   Opacity="0.6" />
                    </Border>

                    <Border Background="{StaticResource AppSurfaceBrush}"
                            CornerRadius="10"
                            Padding="4,0"
                            Visibility="{Binding BaselineListVisibility}">
                        <ItemsControl ItemsSource="{Binding Baselines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:BaselineProfileViewModel">
                                    <Grid Padding="16,12"
                                          BorderBrush="{StaticResource BorderSubtleBrush}"
                                          BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{x:Bind MetricName}"
                                                   Style="{StaticResource CardBodyStyle}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind WorkloadLabel}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Opacity="0.7"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{x:Bind RangeText}"
                                                   Style="{StaticResource CardBodyStyle}"
                                                   FontFamily="Cascadia Code, Consolas, monospace"
                                                   FontSize="12"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3"
                                                   Text="{x:Bind SamplesText}"
                                                   Style="{StaticResource MetaTextStyle}"
                                                   Opacity="0.5"
                                                   VerticalAlignment="Center" />
                                        <Border Grid.Column="4"
                                                CornerRadius="3"
                                                Padding="6,2"
                                                VerticalAlignment="Center">
                                            <Border.Background>
                                                <SolidColorBrush Color="{x:Bind ReliabilityColor}" Opacity="0.15" />
                                            </Border.Background>
                                            <TextBlock Text="{x:Bind ReliabilityLabel}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold">
                                                <TextBlock.Foreground>
                                                    <SolidColorBrush Color="{x:Bind ReliabilityColor}" />
                                                </TextBlock.Foreground>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>

                <!-- ── Calibration Health ─────────────────────────────────── -->
                <Border Background="{StaticResource AppSurfaceBrush}"
                        CornerRadius="12"
                        Padding="20">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8B3;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="16"
                                      Foreground="{StaticResource AccentBlueBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock Text="Confidence Calibration"
                                       Style="{StaticResource SectionTitleStyle}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Status -->
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Status"
                                           Style="{StaticResource MetaTextStyle}"
                                           Opacity="0.5" />
                                <TextBlock Text="{Binding CalibrationStatusText}"
                                           Style="{StaticResource CardBodyStyle}"
                                           FontWeight="SemiBold">
                                    <TextBlock.Foreground>
                                        <SolidColorBrush Color="{Binding CalibrationStatusColor}" />
                                    </TextBlock.Foreground>
                                </TextBlock>
                            </StackPanel>

                            <!-- Adjustment factor -->
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Adjustment factor"
                                           Style="{StaticResource MetaTextStyle}"
                                           Opacity="0.5" />
                                <TextBlock Text="{Binding AdjustmentFactorText}"
                                           Style="{StaticResource CardBodyStyle}"
                                           FontFamily="Cascadia Code, Consolas, monospace"
                                           FontSize="14" />
                            </StackPanel>

                            <!-- Tracked types -->
                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Text="Inference types tracked"
                                           Style="{StaticResource MetaTextStyle}"
                                           Opacity="0.5" />
                                <TextBlock Text="{Binding TrackedInferenceTypes}"
                                           Style="{StaticResource CardBodyStyle}" />
                            </StackPanel>
                        </Grid>

                        <!-- Drift note (conditional) -->
                        <Border Background="#0AFBBF24"
                                CornerRadius="8"
                                Padding="12,10"
                                Visibility="{Binding DriftVisibility}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE946;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="14"
                                          Foreground="#FBBF24"
                                          VerticalAlignment="Top"
                                          Margin="0,1,0,0" />
                                <TextBlock Text="{Binding DriftMessage}"
                                           Style="{StaticResource CaptionTextStyle}"
                                           TextWrapping="Wrap"
                                           Foreground="#FBBF24"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource CaptionTextStyle}"
                                   TextWrapping="Wrap"
                                   Opacity="0.5">
                            <Run Text="Lucid monitors whether its confidence predictions match observed outcomes. " />
                            <Run Text="An adjustment factor below 1.0 means the engine is becoming more conservative; above 1.0 means it is gaining confidence." />
                        </TextBlock>
                    </StackPanel>
                </Border>

            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
