<Page
    x:Class="Lucid.Views.SecurityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Lucid.ViewModels"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="Page_Loaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32,32,32,48" Spacing="24">

            <!-- ── Header ────────────────────────────────────────── -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="Security Intelligence"
                               Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Local trust analysis, startup persistence, and Windows security posture"
                               Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}"
                            Command="{x:Bind ViewModel.OpenWindowsSecurityCommand}">
                        <TextBlock Text="Open Defender" />
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}"
                            Visibility="{x:Bind ViewModel.ScanButtonVisibility, Mode=OneWay}"
                            Command="{x:Bind ViewModel.ScanCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xEA18;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                            <TextBlock Text="Scan" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}"
                            Visibility="{x:Bind ViewModel.CancelButtonVisibility, Mode=OneWay}"
                            Command="{x:Bind ViewModel.CancelScanCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                            <TextBlock Text="Cancel" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ── Scan progress ──────────────────────────────────── -->
            <Border Visibility="{x:Bind ViewModel.ProgressVisibility, Mode=OneWay}"
                    Style="{StaticResource CardSurface}" Padding="20">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ProgressRing IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}"
                                      Width="18" Height="18"
                                      Foreground="{StaticResource AccentBlueBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.ScanPhase, Mode=OneWay}"
                                   Style="{StaticResource CardTitleStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <ProgressBar Value="{x:Bind ViewModel.ScanProgress, Mode=OneWay}"
                                 Maximum="100" Height="4" CornerRadius="2"
                                 Foreground="{StaticResource AccentBlueBrush}"
                                 Background="{StaticResource BarTrackBrush}" />
                </StackPanel>
            </Border>

            <!-- ── Empty state ────────────────────────────────────── -->
            <Border Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}"
                    Style="{StaticResource CardSurface}" Padding="40">
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xEA18;" FontFamily="Segoe MDL2 Assets"
                              FontSize="40" Foreground="{StaticResource TextSecondaryBrush}"
                              HorizontalAlignment="Center" />
                    <TextBlock Text="No scan results yet"
                               Style="{StaticResource SectionTitleStyle}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Run a scan to analyze startup trust, Windows security features, and detect unsigned persistence."
                               Style="{StaticResource CaptionTextStyle}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="380" />
                </StackPanel>
            </Border>

            <!-- ── Results ────────────────────────────────────────── -->
            <StackPanel Visibility="{x:Bind ViewModel.ResultsVisibility, Mode=OneWay}"
                        Spacing="24">

                <!-- Posture score + summary chips -->
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border Style="{StaticResource CardSurface}" Padding="20,16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Security Posture"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.PostureScore, Mode=OneWay}"
                                       FontSize="36" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBlueBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.PostureLabel, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardSurface}" Padding="20,16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Findings"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.Findings.Count, Mode=OneWay}"
                                       Style="{StaticResource CardTitleStyle}"
                                       FontSize="24" />
                            <TextBlock Text="items to review"
                                       Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardSurface}" Padding="20,16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Startup Entries"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.StartupEntries.Count, Mode=OneWay}"
                                       Style="{StaticResource CardTitleStyle}"
                                       FontSize="24" />
                            <TextBlock Text="analyzed"
                                       Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ── Windows Security Features ────────────────── -->
                <StackPanel Spacing="12">
                    <TextBlock Text="Windows Security Features"
                               Style="{StaticResource SectionTitleStyle}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Features, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SecurityFeatureViewModel">
                                <Border Style="{StaticResource CardSurface}" Padding="16,12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Status icon -->
                                        <Border Width="32" Height="32" CornerRadius="6"
                                                Background="{StaticResource StatusGoodSubtleBrush}"
                                                Visibility="{x:Bind GoodVisibility}">
                                            <FontIcon Glyph="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                                      FontSize="14"
                                                      Foreground="{StaticResource StatusGoodBrush}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                        </Border>
                                        <Border Width="32" Height="32" CornerRadius="6"
                                                Background="{StaticResource StatusModerateSubtleBrush}"
                                                Visibility="{x:Bind WarningVisibility}">
                                            <FontIcon Glyph="&#xE7BA;" FontFamily="Segoe MDL2 Assets"
                                                      FontSize="14"
                                                      Foreground="{StaticResource StatusModerateBrush}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                        </Border>
                                        <!-- Name + detail -->
                                        <StackPanel Grid.Column="1" Spacing="2"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name}"
                                                       Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock Text="{x:Bind Detail}"
                                                       Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>
                                        <!-- Status label -->
                                        <TextBlock Grid.Column="2" Text="{x:Bind StatusLabel}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ── Security Findings ────────────────────────── -->
                <StackPanel Spacing="12">
                    <TextBlock Text="Security Findings"
                               Style="{StaticResource SectionTitleStyle}" />

                    <!-- No findings banner -->
                    <Border Style="{StaticResource CardSurface}" Padding="24"
                            Visibility="{x:Bind ViewModel.NoFindingsVisibility, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="20"
                                      Foreground="{StaticResource StatusGoodBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock Text="No significant findings — your startup configuration looks clean."
                                       Style="{StaticResource BodyTextStyle}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Findings, Mode=OneWay}"
                                  Visibility="{x:Bind ViewModel.FindingsVisibility, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="10" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SecurityFindingViewModel">
                                <Border Style="{StaticResource CardSurface}" Padding="20">
                                    <StackPanel Spacing="12">
                                        <!-- Finding header -->
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="{x:Bind Title}"
                                                           Style="{StaticResource CardTitleStyle}" />
                                                <TextBlock Text="{x:Bind Detail}"
                                                           Style="{StaticResource CaptionTextStyle}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Border Grid.Column="1" CornerRadius="6"
                                                    Padding="8,3"
                                                    Background="{StaticResource StatusCriticalSubtleBrush}"
                                                    Visibility="{x:Bind HighBadgeVisibility}">
                                                <TextBlock Text="{x:Bind Severity}"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource StatusCriticalBrush}" />
                                            </Border>
                                            <Border Grid.Column="1" CornerRadius="6"
                                                    Padding="8,3"
                                                    Background="{StaticResource StatusModerateSubtleBrush}"
                                                    Visibility="{x:Bind ModerateBadgeVisibility}">
                                                <TextBlock Text="{x:Bind Severity}"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource StatusModerateBrush}" />
                                            </Border>
                                            <Border Grid.Column="2" CornerRadius="6"
                                                    Padding="8,3"
                                                    Background="{StaticResource AppBackgroundBrush}"
                                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                                    BorderThickness="1">
                                                <TextBlock Text="{x:Bind TrustLabel}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                            </Border>
                                        </Grid>

                                        <!-- Explanation -->
                                        <Border Background="{StaticResource AppBackgroundBrush}"
                                                CornerRadius="8" Padding="12,10">
                                            <TextBlock Text="{x:Bind Explanation}"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       TextWrapping="Wrap" />
                                        </Border>

                                        <!-- Confidence -->
                                        <TextBlock Text="{x:Bind Confidence}"
                                                   FontSize="11" FontStyle="Italic"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />

                                        <!-- Action buttons -->
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Style="{StaticResource SecondaryButton}"
                                                    Tag="{x:Bind}"
                                                    Click="OpenFileLocation_Click"
                                                    Visibility="{x:Bind FilePathVisibility}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xEC50;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                                                    <TextBlock Text="Open location" FontSize="11" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource SecondaryButton}"
                                                    Tag="{x:Bind}"
                                                    Click="OpenVirusTotal_Click"
                                                    Visibility="{x:Bind FilePathVisibility}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                                                    <TextBlock Text="Search VirusTotal" FontSize="11" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ── Startup Trust Analysis ────────────────────── -->
                <StackPanel Spacing="12">
                    <TextBlock Text="Startup Trust Analysis"
                               Style="{StaticResource SectionTitleStyle}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.StartupEntries, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:StartupTrustViewModel">
                                <Border Style="{StaticResource CardSurface}" Padding="16,12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind Name}"
                                                           Style="{StaticResource CardTitleStyle}" />
                                                <Border Background="{StaticResource StatusModerateSubtleBrush}"
                                                        CornerRadius="4" Padding="5,2"
                                                        Visibility="{x:Bind RiskBadgeVisibility}">
                                                    <TextBlock Text="Review" FontSize="10"
                                                               Foreground="{StaticResource StatusModerateBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind Publisher}"
                                                       Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Location}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind TrustLabel}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                        <Border Grid.Column="3" CornerRadius="4" Padding="6,2"
                                                Background="{StaticResource StatusGoodSubtleBrush}"
                                                Visibility="{x:Bind SignedBadgeVisibility}">
                                            <TextBlock Text="Signed" FontSize="10"
                                                       Foreground="{StaticResource StatusGoodBrush}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Disclaimer -->
                <Border Background="{StaticResource AppBackgroundBrush}"
                        CornerRadius="8" Padding="16,12">
                    <TextBlock TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextStyle}"
                               Text="Lucid surfaces observations for your review — it does not claim to detect malware and is not a replacement for antivirus software. All analysis is local. No files are uploaded." />
                </Border>

                <!-- Status text -->
                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                           Style="{StaticResource CaptionTextStyle}" />

            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
