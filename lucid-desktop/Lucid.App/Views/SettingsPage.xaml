<Page
    x:Class="Lucid.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource AppBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32" Spacing="24">

            <StackPanel Spacing="4">
                <TextBlock Text="Settings"
                           Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="App preferences and configuration"
                           Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>

            <!-- ── General ─────────────────────────────────────────────────── -->
            <TextBlock Text="General"
                       Style="{StaticResource SectionTitleStyle}" />

            <Border Background="{StaticResource AppSurfaceBrush}"
                    CornerRadius="10" Padding="20"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="16">

                    <!-- Theme: dark is the native design; full theming planned for a future release -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Theme" Style="{StaticResource BodyTextStyle}" />
                            <TextBlock Text="Full theme selection coming in a future release"
                                       Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="Dark"
                                   Style="{StaticResource BodyTextStyle}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Rectangle Height="1" Fill="{StaticResource BorderSubtleBrush}" Margin="0,4,0,4" />

                    <!-- Telemetry refresh rate: adaptive, driven by RuntimeGovernanceService -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Telemetry refresh rate" Style="{StaticResource BodyTextStyle}" />
                            <TextBlock Text="Adaptive — throttled automatically under system load"
                                       Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind ViewModel.TelemetryRateText, Mode=OneWay}"
                                   Style="{StaticResource BodyTextStyle}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Rectangle Height="1" Fill="{StaticResource BorderSubtleBrush}" Margin="0,4,0,4" />

                    <!-- Start with Windows -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Start with Windows" Style="{StaticResource BodyTextStyle}" />
                            <TextBlock Text="Launch Lucid automatically when you sign in"
                                       Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      IsOn="{x:Bind ViewModel.AutoStartEnabled, Mode=TwoWay}"
                                      OnContent="" OffContent=""
                                      VerticalAlignment="Center" />
                    </Grid>

                    <Rectangle Height="1" Fill="{StaticResource BorderSubtleBrush}" Margin="0,4,0,4" />

                    <!-- Periodic background scans -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Periodic background scans" Style="{StaticResource BodyTextStyle}" />
                            <TextBlock Text="Preference saved — background scan scheduling coming in a future release"
                                       Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      IsOn="{x:Bind ViewModel.AutoScanEnabled, Mode=TwoWay}"
                                      OnContent="" OffContent=""
                                      VerticalAlignment="Center" />
                    </Grid>

                    <Rectangle Height="1" Fill="{StaticResource BorderSubtleBrush}" Margin="0,4,0,4" />

                    <!-- Usage telemetry -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Usage telemetry" Style="{StaticResource BodyTextStyle}" />
                            <TextBlock Text="Anonymous app usage data — always opt-in, never auto-enabled"
                                       Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      IsOn="{x:Bind ViewModel.UsageTelemetryEnabled, Mode=TwoWay}"
                                      OnContent="" OffContent=""
                                      VerticalAlignment="Center" />
                    </Grid>

                    <Rectangle Height="1" Fill="{StaticResource BorderSubtleBrush}" Margin="0,4,0,4" />

                    <!-- Desktop context awareness (consent-gated capture) -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Desktop context awareness" Style="{StaticResource BodyTextStyle}" />
                            <TextBlock Text="Lets the companion see the active window title, Explorer folder, and a short clipboard preview — nothing is stored, always opt-in"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      IsOn="{x:Bind ViewModel.DesktopContextEnabled, Mode=TwoWay}"
                                      OnContent="" OffContent=""
                                      VerticalAlignment="Center" />
                    </Grid>

                </StackPanel>
            </Border>

            <!-- ── Operational Trust ───────────────────────────────────────── -->
            <TextBlock Text="Operational Trust"
                       Style="{StaticResource SectionTitleStyle}" />

            <Border Background="{StaticResource AppSurfaceBrush}"
                    CornerRadius="10" Padding="20"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="16">

                    <!-- Automation consent mode -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Automation consent" Style="{StaticResource BodyTextStyle}" />
                            <TextBlock Text="When to ask before Lucid takes an action"
                                       Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  Width="200"
                                  SelectedIndex="{x:Bind ViewModel.ConsentModeIndex, Mode=TwoWay}"
                                  VerticalAlignment="Center">
                            <ComboBoxItem Content="Ask always"                    Tag="AskAlways" />
                            <ComboBoxItem Content="Ask for medium &amp; high risk" Tag="AskForMediumAndHighRisk" />
                            <ComboBoxItem Content="Ask for high risk only"         Tag="AskHighRiskOnly" />
                            <ComboBoxItem Content="Guided (no auto-execution)"     Tag="GuidedOnly" />
                            <ComboBoxItem Content="Observe only (no execution)"    Tag="ObserveOnly" />
                        </ComboBox>
                    </Grid>

                    <Rectangle Height="1" Fill="{StaticResource BorderSubtleBrush}" Margin="0,4,0,4" />

                    <!-- Automation mode -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Automation mode" Style="{StaticResource BodyTextStyle}" />
                            <TextBlock Text="How Lucid handles automated steps"
                                       Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  Width="200"
                                  SelectedIndex="{x:Bind ViewModel.AutomationModeIndex, Mode=TwoWay}"
                                  VerticalAlignment="Center">
                            <ComboBoxItem Content="Confirm before each step"           Tag="ConfirmBeforeAction" />
                            <ComboBoxItem Content="Semi-automatic (low risk only)"     Tag="SemiAutomatic" />
                            <ComboBoxItem Content="Guided assist"                      Tag="GuidedAssist" />
                            <ComboBoxItem Content="Observe only"                       Tag="ObserveOnly" />
                        </ComboBox>
                    </Grid>

                    <Rectangle Height="1" Fill="{StaticResource BorderSubtleBrush}" Margin="0,4,0,4" />

                    <!-- Trust posture -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Trust posture" Style="{StaticResource BodyTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.TrustPostureCaption, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="Reset to standard"
                                Style="{StaticResource SecondaryButton}"
                                Command="{x:Bind ViewModel.ResetTrustPostureCommand}"
                                VerticalAlignment="Center" />
                    </Grid>

                    <Rectangle Height="1" Fill="{StaticResource BorderSubtleBrush}" Margin="0,4,0,4" />

                    <!-- Audit log retention -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Audit log retention" Style="{StaticResource BodyTextStyle}" />
                            <TextBlock Text="How long action history is kept (30 days)"
                                       Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="30 days"
                                   Style="{StaticResource BodyTextStyle}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Rectangle Height="1" Fill="{StaticResource BorderSubtleBrush}" Margin="0,4,0,4" />

                    <!-- Permanent restrictions disclosure -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Lucid can never do the following — these restrictions cannot be changed:"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="• Access passwords, credentials, or authentication data"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="• Inspect browser autofill or saved logins"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="• Log or monitor keyboard input"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="• Take hidden screenshots"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="• Access webcam or microphone"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="• Read browser tab content or web page source"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="• Upload personal data to any external service"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- ── AI Assistant ────────────────────────────────────────────── -->
            <TextBlock Text="AI Assistant"
                       Style="{StaticResource SectionTitleStyle}" />

            <Border Background="{StaticResource AppSurfaceBrush}"
                    CornerRadius="10" Padding="20"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="16">

                    <!-- Ollama endpoint URL -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Endpoint URL" Style="{StaticResource BodyTextStyle}" />
                            <TextBlock Text="Ollama server address (default: localhost:11434)"
                                       Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <TextBox Grid.Column="1"
                                 Text="{x:Bind ViewModel.LlmEndpointUrl, Mode=TwoWay}"
                                 PlaceholderText="http://localhost:11434"
                                 VerticalAlignment="Center"
                                 LostFocus="{x:Bind ViewModel.OnLlmFieldLostFocus}" />
                    </Grid>

                    <Rectangle Height="1" Fill="{StaticResource BorderSubtleBrush}" Margin="0,4,0,4" />

                    <!-- Model name -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Model" Style="{StaticResource BodyTextStyle}" />
                            <TextBlock Text="Ollama model name — must be pulled first (e.g. ollama pull llama3.2:3b)"
                                       Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <TextBox Grid.Column="1"
                                 Text="{x:Bind ViewModel.LlmModel, Mode=TwoWay}"
                                 PlaceholderText="llama3.2:3b"
                                 VerticalAlignment="Center"
                                 LostFocus="{x:Bind ViewModel.OnLlmFieldLostFocus}" />
                    </Grid>

                    <Rectangle Height="1" Fill="{StaticResource BorderSubtleBrush}" Margin="0,4,0,4" />

                    <!-- Test connection -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Connection" Style="{StaticResource BodyTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.LlmStatusText, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="Test connection"
                                Style="{StaticResource SecondaryButton}"
                                Command="{x:Bind ViewModel.TestConnectionCommand}"
                                IsEnabled="{x:Bind ViewModel.IsTestConnectionEnabled, Mode=OneWay}"
                                VerticalAlignment="Center" />
                    </Grid>

                    <Rectangle Height="1" Fill="{StaticResource BorderSubtleBrush}" Margin="0,4,0,4" />

                    <!-- Apply notice -->
                    <TextBlock Text="Changes apply immediately — the AI assistant uses the new settings on the next message."
                               Style="{StaticResource CaptionTextStyle}"
                               Foreground="{StaticResource TextSecondaryBrush}" />

                </StackPanel>
            </Border>

            <!-- ── About ───────────────────────────────────────────────────── -->
            <TextBlock Text="About"
                       Style="{StaticResource SectionTitleStyle}" />

            <Border Background="{StaticResource AppSurfaceBrush}"
                    CornerRadius="10" Padding="20"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock Text="Lucid" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock Text="Version 0.1.0 (Preview)"
                               Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock Text="A trustworthy Windows intelligence platform."
                               Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
