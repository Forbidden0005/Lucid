<Page
    x:Class="Lucid.Views.ProcessesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Lucid.ViewModels"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="Page_Loaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32,32,32,48" Spacing="24">

            <!-- ── Header ────────────────────────────────────────── -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="Process Intelligence"
                               Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Live behavioral analysis — runaway processes, memory growth, anomaly detection"
                               Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            Spacing="16" VerticalAlignment="Center">
                    <StackPanel Spacing="2" HorizontalAlignment="Right">
                        <TextBlock Text="{x:Bind ViewModel.ProcessCount, Mode=OneWay}"
                                   Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.LastUpdated, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                    <Border Background="{StaticResource StatusModerateSubtleBrush}"
                            CornerRadius="8" Padding="12,6"
                            BorderBrush="{StaticResource StatusModerateBrush}"
                            BorderThickness="1">
                        <TextBlock Text="{x:Bind ViewModel.AnomalyCount, Mode=OneWay}"
                                   Foreground="{StaticResource StatusModerateBrush}"
                                   FontSize="12" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ── Tab bar ──────────────────────────────────────── -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Command="{x:Bind ViewModel.SelectTabAllCommand}"
                        Style="{StaticResource SecondaryButton}">
                    <TextBlock Text="All Processes" />
                </Button>
                <Button Command="{x:Bind ViewModel.SelectTabAnomaliesCommand}"
                        Style="{StaticResource SecondaryButton}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE7BA;" FontFamily="Segoe MDL2 Assets"
                                  FontSize="12"
                                  Foreground="{StaticResource StatusModerateBrush}" />
                        <TextBlock Text="Anomalies" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.SelectTabByCpuCommand}"
                        Style="{StaticResource SecondaryButton}">
                    <TextBlock Text="Top CPU" />
                </Button>
                <Button Command="{x:Bind ViewModel.SelectTabByRamCommand}"
                        Style="{StaticResource SecondaryButton}">
                    <TextBlock Text="Top RAM" />
                </Button>
            </StackPanel>

            <!-- ── All Processes tab ────────────────────────────── -->
            <StackPanel Visibility="{x:Bind ViewModel.AllPanelVisibility, Mode=OneWay}"
                        Spacing="8">
                <ItemsControl ItemsSource="{x:Bind ViewModel.AllProcesses, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProcessRowViewModel">
                            <Border Style="{StaticResource CardSurface}" Padding="16,12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Name + badges -->
                                    <StackPanel Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind Name}"
                                                       Style="{StaticResource CardTitleStyle}" />
                                            <Border Background="{StaticResource StatusModerateSubtleBrush}"
                                                    CornerRadius="4" Padding="5,2"
                                                    Visibility="{x:Bind AnomalyBadgeVisibility}">
                                                <TextBlock Text="&#x26A0;" FontSize="10"
                                                           Foreground="{StaticResource StatusModerateBrush}" />
                                            </Border>
                                            <Border Background="{StaticResource StatusCriticalSubtleBrush}"
                                                    CornerRadius="4" Padding="5,2"
                                                    Visibility="{x:Bind CriticalBadgeVisibility}">
                                                <TextBlock Text="CRITICAL" FontSize="9"
                                                           Foreground="{StaticResource StatusCriticalBrush}" />
                                            </Border>
                                            <Border Background="{StaticResource StatusCriticalSubtleBrush}"
                                                    CornerRadius="4" Padding="5,2"
                                                    Visibility="{x:Bind SecurityBadgeVisibility}"
                                                    ToolTipService.ToolTip="Worth reviewing — see anomaly detail">
                                                <StackPanel Orientation="Horizontal" Spacing="3">
                                                    <FontIcon Glyph="&#xE72E;" FontFamily="Segoe MDL2 Assets"
                                                              FontSize="9"
                                                              Foreground="{StaticResource StatusCriticalBrush}" />
                                                    <TextBlock Text="REVIEW" FontSize="9"
                                                               Foreground="{StaticResource StatusCriticalBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind AnomalySummary}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource StatusModerateBrush}"
                                                   Visibility="{x:Bind AnomalyBadgeVisibility}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind Category}"
                                                       Style="{StaticResource CaptionTextStyle}" />
                                            <TextBlock Text="{x:Bind Publisher, Mode=OneWay}"
                                                       Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- CPU -->
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Cpu, Mode=OneWay}"
                                                   Style="{StaticResource CardTitleStyle}"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{StaticResource AccentBlueBrush}" />
                                        <TextBlock Text="CPU" FontSize="10"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Right" />
                                    </StackPanel>

                                    <!-- RAM -->
                                    <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Ram, Mode=OneWay}"
                                                   Style="{StaticResource CardTitleStyle}"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{StaticResource AccentCyanBrush}" />
                                        <TextBlock Text="RAM" FontSize="10"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Right" />
                                    </StackPanel>

                                    <!-- Uptime -->
                                    <TextBlock Grid.Column="3" Text="{x:Bind Uptime}"
                                               Style="{StaticResource CaptionTextStyle}"
                                               VerticalAlignment="Center" />

                                    <!-- Open location -->
                                    <Button Grid.Column="4"
                                            Style="{StaticResource SecondaryButton}"
                                            Tag="{x:Bind}"
                                            Click="OpenLocation_Click"
                                            VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xEC50;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                                    </Button>

                                    <!-- Terminate -->
                                    <Button Grid.Column="5"
                                            Style="{StaticResource SecondaryButton}"
                                            Tag="{x:Bind}"
                                            Click="Terminate_Click"
                                            Visibility="{x:Bind TerminateButtonVisibility}"
                                            VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                                  FontSize="12"
                                                  Foreground="{StaticResource StatusCriticalBrush}" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ── Anomalies tab ────────────────────────────────── -->
            <StackPanel Visibility="{x:Bind ViewModel.AnomaliesPanelVisibility, Mode=OneWay}"
                        Spacing="12">
                <!-- No anomalies -->
                <Border Style="{StaticResource CardSurface}" Padding="32"
                        Visibility="{x:Bind ViewModel.NoAnomaliesVisibility, Mode=OneWay}">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                  FontSize="32" Foreground="{StaticResource StatusGoodBrush}"
                                  HorizontalAlignment="Center" />
                        <TextBlock Text="No anomalies detected"
                                   Style="{StaticResource SectionTitleStyle}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="All monitored processes are behaving normally."
                                   Style="{StaticResource CaptionTextStyle}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{x:Bind ViewModel.AnomalousProcesses, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.AnomalyListVisibility, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProcessRowViewModel">
                            <Border Style="{StaticResource CardElevated}" Padding="20"
                                    BorderBrush="{StaticResource StatusModerateBrush}"
                                    BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{x:Bind Name}"
                                                           Style="{StaticResource CardTitleStyle}" />
                                                <Border Background="{StaticResource StatusCriticalSubtleBrush}"
                                                        CornerRadius="4" Padding="5,2"
                                                        Visibility="{x:Bind SecurityBadgeVisibility}">
                                                    <TextBlock Text="REVIEW" FontSize="9"
                                                               Foreground="{StaticResource StatusCriticalBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind AnomalySummary}"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       Foreground="{StaticResource StatusModerateBrush}" />
                                            <TextBlock Text="{x:Bind Publisher, Mode=OneWay}"
                                                       Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="2"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Right">
                                            <TextBlock Text="{x:Bind Cpu, Mode=OneWay}"
                                                       Style="{StaticResource CardTitleStyle}"
                                                       Foreground="{StaticResource AccentBlueBrush}" />
                                            <TextBlock Text="{x:Bind Ram, Mode=OneWay}"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       Foreground="{StaticResource AccentCyanBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Style="{StaticResource SecondaryButton}"
                                                Tag="{x:Bind}"
                                                Click="Terminate_Click"
                                                Visibility="{x:Bind TerminateButtonVisibility}"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                                          FontSize="12"
                                                          Foreground="{StaticResource StatusCriticalBrush}" />
                                                <TextBlock Text="Terminate" FontSize="11" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <!-- Detail chips -->
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <TextBlock Text="{x:Bind Category}" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind Threads, Mode=OneWay}" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="threads" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind Handles, Mode=OneWay}" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="handles" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ── Top CPU tab ──────────────────────────────────── -->
            <StackPanel Visibility="{x:Bind ViewModel.ByCpuPanelVisibility, Mode=OneWay}"
                        Spacing="8">
                <TextBlock Text="Top by CPU Usage" Style="{StaticResource SectionTitleStyle}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.TopByCpu, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProcessRowViewModel">
                            <Border Style="{StaticResource CardSurface}" Padding="16,12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Name}"
                                                   Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Text="{x:Bind Category}"
                                                   Style="{StaticResource CaptionTextStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Cpu, Mode=OneWay}"
                                               Style="{StaticResource CardTitleStyle}"
                                               Foreground="{StaticResource AccentBlueBrush}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Ram, Mode=OneWay}"
                                               Style="{StaticResource CaptionTextStyle}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right" />
                                    <Button Grid.Column="3"
                                            Style="{StaticResource SecondaryButton}"
                                            Tag="{x:Bind}"
                                            Click="Terminate_Click"
                                            Visibility="{x:Bind TerminateButtonVisibility}"
                                            VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                                  FontSize="12"
                                                  Foreground="{StaticResource StatusCriticalBrush}" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ── Top RAM tab ──────────────────────────────────── -->
            <StackPanel Visibility="{x:Bind ViewModel.ByRamPanelVisibility, Mode=OneWay}"
                        Spacing="8">
                <TextBlock Text="Top by RAM Usage" Style="{StaticResource SectionTitleStyle}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.TopByRam, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProcessRowViewModel">
                            <Border Style="{StaticResource CardSurface}" Padding="16,12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Name}"
                                                   Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Text="{x:Bind Category}"
                                                   Style="{StaticResource CaptionTextStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Ram, Mode=OneWay}"
                                               Style="{StaticResource CardTitleStyle}"
                                               Foreground="{StaticResource AccentCyanBrush}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Cpu, Mode=OneWay}"
                                               Style="{StaticResource CaptionTextStyle}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right" />
                                    <Button Grid.Column="3"
                                            Style="{StaticResource SecondaryButton}"
                                            Tag="{x:Bind}"
                                            Click="Terminate_Click"
                                            Visibility="{x:Bind TerminateButtonVisibility}"
                                            VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                                  FontSize="12"
                                                  Foreground="{StaticResource StatusCriticalBrush}" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Status text -->
            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                       Style="{StaticResource CaptionTextStyle}"
                       Foreground="{StaticResource StatusModerateBrush}" />

        </StackPanel>
    </ScrollViewer>
</Page>
