<Page
    x:Class="Lucid.Views.PrivacyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Lucid.ViewModels"
    Background="{StaticResource AppBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32,32,32,48" Spacing="24">

            <!-- ── Header ──────────────────────────────────────────────────── -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="Privacy"
                               Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="App permission grants and data access"
                               Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>

                <!-- Refresh button -->
                <Button Grid.Column="1"
                        Style="{StaticResource SecondaryButton}"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.LoadCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ── Loading ─────────────────────────────────────────────────── -->
            <Border Visibility="{x:Bind ViewModel.LoadingVisibility, Mode=OneWay}"
                    Style="{StaticResource CardSurface}"
                    Padding="32">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <ProgressRing IsActive="True"
                                  Width="28" Height="28"
                                  Foreground="{StaticResource AccentBlueBrush}"
                                  HorizontalAlignment="Center" />
                    <TextBlock Text="Reading privacy permission registry…"
                               Style="{StaticResource CaptionTextStyle}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- ── Content (visible when not loading) ─────────────────────── -->
            <StackPanel Visibility="{x:Bind ViewModel.ContentVisibility, Mode=OneWay}"
                        Spacing="24">

                <!-- Stats bar -->
                <TextBlock Text="{x:Bind ViewModel.StatsText, Mode=OneWay}"
                           Style="{StaticResource CaptionTextStyle}"
                           Foreground="{StaticResource TextSecondaryBrush}" />

                <!-- ── Permission category cards ──────────────────────────── -->
                <StackPanel Visibility="{x:Bind ViewModel.HasCategoriesVisibility, Mode=OneWay}"
                            Spacing="8">

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PrivacyCategoryViewModel">
                                <Border Style="{StaticResource CardSurface}"
                                        Padding="0"
                                        Margin="0,0,0,8"
                                        CornerRadius="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Left accent stripe — color encodes global on/off state -->
                                        <Rectangle Grid.Column="0"
                                                   Fill="{x:Bind AccentBrush}"
                                                   RadiusX="10" RadiusY="10" />

                                        <!-- Card body -->
                                        <StackPanel Grid.Column="1"
                                                    Padding="20,16,20,16"
                                                    Spacing="12">

                                            <!-- Category header row -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Permission glyph -->
                                                <TextBlock Grid.Column="0"
                                                           Text="{x:Bind Glyph}"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="18"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,14,0" />

                                                <!-- Permission name + summary -->
                                                <StackPanel Grid.Column="1"
                                                            Spacing="2"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind DisplayName}"
                                                               Style="{StaticResource BodyTextStyle}"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="{x:Bind SummaryText}"
                                                               Style="{StaticResource CaptionTextStyle}"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                </StackPanel>

                                                <!-- Global status badge + app count -->
                                                <StackPanel Grid.Column="2"
                                                            Spacing="3"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind GlobalStatusText}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{x:Bind GlobalStatusBrush}"
                                                               HorizontalAlignment="Right" />
                                                    <TextBlock Text="{x:Bind CountText}"
                                                               Style="{StaticResource CaptionTextStyle}"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               HorizontalAlignment="Right" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- Separator -->
                                            <Rectangle Height="1"
                                                       Fill="{StaticResource BorderSubtleBrush}"
                                                       Opacity="0.5" />

                                            <!-- Per-app grant rows -->
                                            <ItemsControl ItemsSource="{x:Bind Apps}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:PrivacyAppEntryViewModel">
                                                        <Grid MinHeight="40" Margin="0,2,0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="56" />
                                                                <ColumnDefinition Width="72" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- App name + type label -->
                                                            <StackPanel Grid.Column="0"
                                                                        Spacing="2"
                                                                        VerticalAlignment="Center">
                                                                <TextBlock Text="{x:Bind AppDisplayName}"
                                                                           Style="{StaticResource BodyTextStyle}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{x:Bind AppTypeLabel}"
                                                                           FontSize="11"
                                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                                            </StackPanel>

                                                            <!-- Last used timestamp (hidden when never used) -->
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{x:Bind LastUsedText}"
                                                                       Visibility="{x:Bind LastUsedVisibility}"
                                                                       Style="{StaticResource CaptionTextStyle}"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       VerticalAlignment="Center"
                                                                       Margin="12,0" />

                                                            <!-- Allowed / Denied status — Mode=OneWay because IsAllowed is observable -->
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{x:Bind StatusText, Mode=OneWay}"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{x:Bind StatusBrush, Mode=OneWay}"
                                                                       HorizontalAlignment="Right"
                                                                       VerticalAlignment="Center" />

                                                            <!-- Revoke / Restore toggle button -->
                                                            <Button Grid.Column="3"
                                                                    Content="{x:Bind ToggleLabel, Mode=OneWay}"
                                                                    Command="{x:Bind TogglePermissionCommand}"
                                                                    FontSize="11"
                                                                    Padding="8,4"
                                                                    CornerRadius="6"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Center"
                                                                    Margin="8,0,0,0">
                                                                <ToolTipService.ToolTip>
                                                                    <ToolTip Content="Toggle this app's permission in the Windows ConsentStore" />
                                                                </ToolTipService.ToolTip>
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>

                <!-- ── Empty state ─────────────────────────────────────────── -->
                <Border Visibility="{x:Bind ViewModel.NoCategoriesVisibility, Mode=OneWay}"
                        Style="{StaticResource CardSurface}"
                        Padding="40">
                    <StackPanel Spacing="12" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE72E;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="36"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  HorizontalAlignment="Center" />
                        <TextBlock Text="No permission data found"
                                   Style="{StaticResource SectionTitleStyle}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="No app permission records were found in the Windows privacy registry."
                                   Style="{StaticResource CaptionTextStyle}"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   MaxWidth="360" />
                    </StackPanel>
                </Border>

            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
