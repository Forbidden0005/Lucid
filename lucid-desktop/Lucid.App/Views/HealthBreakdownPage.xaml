<Page
    x:Class="Lucid.Views.HealthBreakdownPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Lucid.ViewModels"
    Background="{StaticResource AppBackgroundBrush}">

    <!--
        HealthBreakdownPage — "why is my health score what it is?"
        Reached by clicking the System Health card on the Dashboard. Shows the
        current score, the scoring rule in plain English, and one row per
        condition that deducted points — each linking to its insight detail
        where the fix lives.
    -->

    <Page.Resources>
        <DataTemplate x:Key="ContributionTemplate" x:DataType="vm:HealthContributionRow">
            <Border Style="{StaticResource CardSurface}" Padding="18" Margin="0,0,0,10">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Points chip -->
                    <Border Grid.Column="0"
                            VerticalAlignment="Center"
                            CornerRadius="8"
                            Padding="12,8"
                            Background="#14FFFFFF">
                        <TextBlock Text="{x:Bind PointsText}"
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="{x:Bind SeverityColor}"
                                   HorizontalAlignment="Center" />
                    </Border>

                    <!-- Title + meta -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyTextStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border CornerRadius="4" Padding="6,1" Background="#14FFFFFF">
                                <TextBlock Text="{x:Bind SeverityLabel}"
                                           FontSize="11"
                                           Foreground="{x:Bind SeverityColor}" />
                            </Border>
                            <TextBlock Text="{x:Bind SeenText}"
                                       Style="{StaticResource CaptionTextStyle}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Fix / review — label depends on whether the condition is still active -->
                    <Button Grid.Column="2"
                            VerticalAlignment="Center"
                            Tag="{x:Bind InsightId}"
                            Click="OnReviewClick"
                            Style="{StaticResource SecondaryButton}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE90F;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                            <TextBlock Text="{x:Bind ActionText}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32" Spacing="20" MaxWidth="900" HorizontalAlignment="Left">

            <!-- Back -->
            <Button Click="OnGoBackClick" Background="Transparent" BorderThickness="0" Padding="4,2">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                              Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="Dashboard" Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>
            </Button>

            <!-- Header: score + label -->
            <Border Style="{StaticResource CardSurface}" Padding="28">
                <Grid ColumnSpacing="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="96" Height="96" VerticalAlignment="Center">
                        <ProgressRing IsIndeterminate="False"
                                      Value="{x:Bind ViewModel.Score, Mode=OneWay}"
                                      Maximum="100" Width="96" Height="96"
                                      Background="Transparent"
                                      Foreground="{StaticResource StatusGoodBrush}" />
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.ScoreText, Mode=OneWay}"
                                       Style="{StaticResource MetricLargeStyle}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="/100" Style="{StaticResource CaptionTextStyle}"
                                       HorizontalAlignment="Center" Margin="0,-4,0,0" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                        <TextBlock Text="{x:Bind ViewModel.ScoreLabel, Mode=OneWay}"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.WindowText, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.FormulaExplanation}"
                                   Style="{StaticResource BodyTextStyle}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Contributions -->
            <TextBlock Text="What's affecting your score" Style="{StaticResource SectionTitleStyle}" />

            <ItemsControl Visibility="{x:Bind ViewModel.ListVisibility, Mode=OneWay}"
                          ItemsSource="{x:Bind ViewModel.Contributions}"
                          ItemTemplate="{StaticResource ContributionTemplate}" />

            <!-- Empty state (genuinely healthy) -->
            <Border Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}"
                    Style="{StaticResource CardSurface}" Padding="28">
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                              Foreground="{StaticResource StatusGoodBrush}" />
                    <TextBlock Text="Nothing is dragging your score down"
                               Style="{StaticResource BodyTextStyle}" HorizontalAlignment="Center" />
                    <TextBlock Text="No conditions worth reviewing were recorded in the past 7 days."
                               Style="{StaticResource CaptionTextStyle}"
                               HorizontalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Error state — a data-load failure, NOT a healthy machine -->
            <Border Visibility="{x:Bind ViewModel.ErrorVisibility, Mode=OneWay}"
                    Style="{StaticResource CardSurface}" Padding="28">
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                              Foreground="{StaticResource StatusModerateBrush}" />
                    <TextBlock Text="Couldn't load your score breakdown"
                               Style="{StaticResource BodyTextStyle}" HorizontalAlignment="Center" />
                    <TextBlock Text="The analytics database was unavailable or busy. This isn't a health result — reopen this page in a moment to try again."
                               Style="{StaticResource CaptionTextStyle}"
                               HorizontalAlignment="Center" TextWrapping="Wrap"
                               TextAlignment="Center" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
