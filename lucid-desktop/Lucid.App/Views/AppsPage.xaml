<Page
    x:Class="Lucid.Views.AppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Lucid.ViewModels"
    Background="{StaticResource AppBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32,32,32,48" Spacing="24">

            <!-- ── Header ────────────────────────────────────────────── -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="Apps"
                               Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Installed applications and startup impact"
                               Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>

                <!-- Refresh button -->
                <Button Grid.Column="1"
                        Style="{StaticResource SecondaryButton}"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.LoadCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ── Loading ────────────────────────────────────────────── -->
            <Border Visibility="{x:Bind ViewModel.LoadingVisibility, Mode=OneWay}"
                    Style="{StaticResource CardSurface}" Padding="32">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <ProgressRing IsActive="True"
                                  Width="28" Height="28"
                                  Foreground="{StaticResource AccentBlueBrush}"
                                  HorizontalAlignment="Center" />
                    <TextBlock Text="Scanning installed applications…"
                               Style="{StaticResource CaptionTextStyle}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- ── Content (visible when not loading) ─────────────────── -->
            <StackPanel Visibility="{x:Bind ViewModel.ContentVisibility, Mode=OneWay}"
                        Spacing="24">

                <!-- Stats bar -->
                <TextBlock Text="{x:Bind ViewModel.StatsText, Mode=OneWay}"
                           Style="{StaticResource CaptionTextStyle}"
                           Foreground="{StaticResource TextSecondaryBrush}" />

                <!-- ── Startup Apps section ──────────────────────────── -->
                <StackPanel Visibility="{x:Bind ViewModel.StartupSectionVisibility, Mode=OneWay}"
                            Spacing="12">

                    <TextBlock Text="Launch at Startup"
                               Style="{StaticResource SectionTitleStyle}" />

                    <ItemsControl ItemsSource="{x:Bind ViewModel.StartupApps, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AppEntryViewModel">
                                <Border Style="{StaticResource CardSurface}"
                                        Padding="20,16"
                                        Margin="0,0,0,8"
                                        CornerRadius="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Impact badge -->
                                        <Border Grid.Column="0"
                                                Background="{x:Bind StartupImpactBrush}"
                                                CornerRadius="4"
                                                Padding="8,4"
                                                Margin="0,0,14,0"
                                                VerticalAlignment="Center"
                                                Opacity="0.18" />
                                        <TextBlock Grid.Column="0"
                                                   Text="{x:Bind StartupImpactLabel}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{x:Bind StartupImpactBrush}"
                                                   Margin="8,4,8,4"
                                                   VerticalAlignment="Center" />

                                        <!-- App info -->
                                        <StackPanel Grid.Column="1" Spacing="3"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name}"
                                                       Style="{StaticResource BodyTextStyle}"
                                                       FontWeight="SemiBold" />
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="{x:Bind Publisher}"
                                                           Style="{StaticResource CaptionTextStyle}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Visibility="{x:Bind PublisherVisibility}" />
                                                <TextBlock Text="{x:Bind StartupLocationText}"
                                                           Style="{StaticResource CaptionTextStyle}"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Toggle button -->
                                        <Button Grid.Column="2"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{x:Bind ToggleStartupCommand}"
                                                VerticalAlignment="Center"
                                                Margin="12,0,0,0">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{x:Bind ToggleStartupGlyph, Mode=OneWay}"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="12"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{x:Bind ToggleStartupLabel, Mode=OneWay}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- No startup apps notice -->
                <Border Visibility="{x:Bind ViewModel.NoStartupAppsVisibility, Mode=OneWay}"
                        Style="{StaticResource CardSurface}" Padding="20">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                  FontSize="16" Foreground="{StaticResource SuccessBrush}"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="No apps are registered to launch at startup."
                                   Style="{StaticResource BodyTextStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- ── All Installed Apps section ───────────────────── -->
                <StackPanel Visibility="{x:Bind ViewModel.HasAppsVisibility, Mode=OneWay}"
                            Spacing="12">

                    <TextBlock Text="All Installed Apps"
                               Style="{StaticResource SectionTitleStyle}" />

                    <Border Style="{StaticResource CardSurface}"
                            Padding="0"
                            CornerRadius="10">
                        <ListView ItemsSource="{x:Bind ViewModel.AllApps, Mode=OneWay}"
                                  SelectionMode="None"
                                  IsItemClickEnabled="False">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="20,14" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:AppEntryViewModel">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Name + publisher -->
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{x:Bind Name}"
                                                       Style="{StaticResource BodyTextStyle}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Publisher}"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{x:Bind PublisherVisibility}" />
                                        </StackPanel>

                                        <!-- Startup impact chip (if linked) -->
                                        <Border Grid.Column="1"
                                                Visibility="{x:Bind StartupVisibility}"
                                                Margin="12,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind StartupImpactLabel}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{x:Bind StartupImpactBrush}" />
                                        </Border>

                                        <!-- Install date -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{x:Bind InstallDateText}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Visibility="{x:Bind DateVisibility}"
                                                   VerticalAlignment="Center" />

                                        <!-- Size -->
                                        <TextBlock Grid.Column="3"
                                                   Text="{x:Bind SizeText}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Visibility="{x:Bind SizeVisibility}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </StackPanel>

                <!-- No apps at all -->
                <Border Visibility="{x:Bind ViewModel.NoAppsVisibility, Mode=OneWay}"
                        Style="{StaticResource CardSurface}" Padding="40">
                    <StackPanel Spacing="12" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE74C;" FontFamily="Segoe MDL2 Assets"
                                  FontSize="36" Foreground="{StaticResource TextSecondaryBrush}"
                                  HorizontalAlignment="Center" />
                        <TextBlock Text="No installed applications found"
                                   Style="{StaticResource SectionTitleStyle}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Could not read the Windows application registry."
                                   Style="{StaticResource CaptionTextStyle}"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   MaxWidth="360" />
                    </StackPanel>
                </Border>

            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
