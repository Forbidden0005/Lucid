<UserControl
    x:Class="Lucid.Views.SparklineControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        SparklineControl — Compact metric history visualizer

        Layout:
          Row 0: Canvas (fixed 64 px tall, stretches full width)
                 Populated entirely in code-behind via Redraw() for
                 precise canvas coordinate control.
          Row 1: Trend summary text (e.g. "▲ 18% over 5 min")

        Rendered shapes (in z-order):
          1. Rectangle  — ±1σ baseline band (when baseline data is available)
          2. Polygon    — area fill under the history line (20% alpha)
          3. Polyline   — history line (solid, 1.5 px)
          4. Polyline   — forecast projection (dashed, 40% alpha)

        All brushes are static fields allocated once at class init —
        zero allocations per telemetry tick.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Canvas x:Name="SparkCanvas"
                Height="64"
                HorizontalAlignment="Stretch"
                SizeChanged="OnCanvasSizeChanged" />

        <TextBlock x:Name="TrendText"
                   Grid.Row="1"
                   FontFamily="Segoe UI Variable"
                   FontSize="10"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   HorizontalAlignment="Right"
                   Margin="0,3,0,0" />
    </Grid>
</UserControl>
