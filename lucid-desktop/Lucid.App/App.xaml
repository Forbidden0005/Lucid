<Application
    x:Class="Lucid.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- WinUI base styles (must come first) -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />

                <!--
                    ── Lucid Design System ──────────────────────────
                    Merge order matters: AppColors must come first because
                    all other dictionaries reference its brush keys.
                -->

                <!-- 1. Colour palette + semantic status aliases -->
                <ResourceDictionary Source="ms-appx:///Themes/AppColors.xaml" />

                <!-- 2. Spacing / thickness / corner-radius tokens -->
                <ResourceDictionary Source="ms-appx:///Themes/AppSpacing.xaml" />

                <!-- 3. Typography -->
                <ResourceDictionary Source="ms-appx:///Themes/AppTypography.xaml" />

                <!-- 4. Component styles (each depends on AppColors) -->
                <ResourceDictionary Source="ms-appx:///Themes/AppCards.xaml" />
                <ResourceDictionary Source="ms-appx:///Themes/AppBadges.xaml" />
                <ResourceDictionary Source="ms-appx:///Themes/AppProgress.xaml" />
                <ResourceDictionary Source="ms-appx:///Themes/AppButtons.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

</Application>
