<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Lucid</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!--
      Disable XBind diagnostics on CLI builds.
      The 2-pass XAML pipeline (Pass1 → XamlPreCompile → Pass2) requires an
      intermediate DLL that only VS design-time builds produce. Disabling this
      lets dotnet build complete cleanly; x:Bind still works at runtime.
      Visual Studio re-enables it automatically via its own build path.
    -->
    <EnableXBindDiagnostics>false</EnableXBindDiagnostics>
    <Configurations>Debug;Release;Lucid</Configurations>
    <!-- Required for stackalloc in NativeScannerService P/Invoke wrapper -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinUI 3 via Windows App SDK -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260529003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" PrivateAssets="all" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
  </ItemGroup>

  <!--
    Source compilation uses default SDK globbing: every .cs under the project is
    compiled automatically, so new files need no per-file <Compile Include>.
    The removes below carve out the only files that must NOT compile:
      • Controls\ and Models\ — placeholder/future code; the paired Controls XAML
        is excluded by the <Page Remove="Controls\**"/> group below.
      • Services\MockTelemetryService.cs — depends on the excluded Models\ types.
      • ViewModels\ShellViewModel.cs / SystemIssueViewModel.cs — stubs referencing
        Core.MVVM / Core.Navigation / Models namespaces that don't exist yet.
    (Replaces the former 483-entry hand-maintained <Compile Include> allow-list,
    which silently dropped any new file that wasn't added to it by hand.)
  -->
  <ItemGroup>
    <Compile Remove="Controls\**\*.cs" />
    <Compile Remove="Models\**\*.cs" />
    <Compile Remove="Services\MockTelemetryService.cs" />
    <Compile Remove="ViewModels\ShellViewModel.cs" />
    <Compile Remove="ViewModels\SystemIssueViewModel.cs" />
  </ItemGroup>

  <!-- Exclude custom controls XAML (they reference excluded code) -->
  <ItemGroup>
    <Page Remove="Controls\**" />
  </ItemGroup>

  <!--
    Copy lucid_scanner.dll from the Rust release build into the app output directory.
    The DLL is only available after a release build of lucid-native/ (cargo build, release profile).
    If the file does not exist the copy is skipped (ContinueOnError) so the C# build
    succeeds without Rust — NativeScannerService.IsAvailable will return false at runtime.
  -->
  <Target Name="CopyLucidNativeDll" AfterTargets="Build">
    <PropertyGroup>
      <LucidNativeDll>$(MSBuildThisFileDirectory)..\..\lucid-native\target\release\lucid_scanner.dll</LucidNativeDll>
    </PropertyGroup>
    <Copy SourceFiles="$(LucidNativeDll)"
          DestinationFolder="$(OutputPath)"
          SkipUnchangedFiles="true"
          ContinueOnError="true"
          Condition="Exists('$(LucidNativeDll)')" />
    <Message Text="Copied lucid_scanner.dll to $(OutputPath)" Importance="normal"
             Condition="Exists('$(LucidNativeDll)')" />
    <Message Text="lucid_scanner.dll not found — skipping native copy (run cargo build --release in lucid-native/)" Importance="low"
             Condition="!Exists('$(LucidNativeDll)')" />
  </Target>

</Project>
