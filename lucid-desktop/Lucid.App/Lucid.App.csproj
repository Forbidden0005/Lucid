<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Lucid</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!--
      Disable XBind diagnostics on CLI builds.
      The 2-pass XAML pipeline (Pass1 → XamlPreCompile → Pass2) requires an
      intermediate DLL that only VS design-time builds produce. Disabling this
      lets dotnet build complete cleanly; x:Bind still works at runtime.
      Visual Studio re-enables it automatically via its own build path.
    -->
    <EnableXBindDiagnostics>false</EnableXBindDiagnostics>
    <Configurations>Debug;Release;Lucid</Configurations>
    <!-- Required for stackalloc in NativeScannerService P/Invoke wrapper -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LucidNativeDll Condition="'$(LucidNativeDll)' == ''">$(MSBuildThisFileDirectory)..\..\lucid-native\target\release\lucid_scanner.dll</LucidNativeDll>
    <!--
      The native scanner is built, tested (19 Rust tests) and copied when present,
      but NOTHING CALLS IT YET: NativeScannerService.ScanDirectoryAsync /
      GetTopFilesAsync have no production call sites, and storage analysis runs
      entirely on the managed FileSystemScanner.

      Why it isn't simply wired up: StorageAnalysisService.RunScan is a single
      traversal that produces large files, duplicate candidates, category totals
      and progress together. The native FFI only exposes aggregate totals
      (lucid_scan_directory) and top-N largest (lucid_scan_top_files) — neither
      can feed that pass, so adopting it today would mean a SECOND full traversal
      of the drive and would be slower overall. Real adoption needs a streaming
      entry point on the Rust side (a per-entry callback across the FFI boundary)
      that can replace FileSystemScanner.Enumerate wholesale.

      Until such a consumer exists, failing a Release build over a missing DLL
      gates the build on an artifact with no runtime effect. Set
      RequireLucidNativeDll=true (or restore the Release condition below) as soon
      as the first real call site lands.
    -->
    <RequireLucidNativeDll Condition="'$(RequireLucidNativeDll)' == ''">false</RequireLucidNativeDll>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinUI 3 via Windows App SDK -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260529003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" PrivateAssets="all" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lucid.Core\Lucid.Core.csproj" />
  </ItemGroup>

  <!--
    Copy lucid_scanner.dll from the Rust release build into the app output and publish directories.
    The DLL is only available after a release build of lucid-native/ (cargo build, release profile).
    Release builds fail when the DLL is missing so broken native artifacts are caught before runtime.
  -->
  <Target Name="CopyLucidNativeDll" AfterTargets="Build">
    <Error Text="lucid_scanner.dll is required for Release builds. Run cargo build --release in lucid-native/ before building Lucid.App."
           Condition="'$(RequireLucidNativeDll)' == 'true' and !Exists('$(LucidNativeDll)')" />
    <Copy SourceFiles="$(LucidNativeDll)"
          DestinationFolder="$(OutputPath)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(LucidNativeDll)')" />
    <Message Text="Copied lucid_scanner.dll to $(OutputPath)" Importance="normal"
             Condition="Exists('$(LucidNativeDll)')" />
    <Message Text="lucid_scanner.dll not found — skipping native copy (run cargo build --release in lucid-native/)" Importance="low"
             Condition="'$(RequireLucidNativeDll)' != 'true' and !Exists('$(LucidNativeDll)')" />
  </Target>

  <Target Name="CopyLucidNativeDllToPublishDirectory" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <Error Text="lucid_scanner.dll is required for Release publish output. Run cargo build --release in lucid-native/ before publishing Lucid.App."
           Condition="'$(RequireLucidNativeDll)' == 'true' and !Exists('$(LucidNativeDll)')" />
    <Copy SourceFiles="$(LucidNativeDll)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(LucidNativeDll)')" />
    <Message Text="Copied lucid_scanner.dll to $(PublishDir)" Importance="normal"
             Condition="Exists('$(LucidNativeDll)')" />
  </Target>

</Project>
