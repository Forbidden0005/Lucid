<Window
    x:Class="Lucid.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Title="Lucid">

    <!--
        Dark theme forced so the entire window uses our custom palette,
        regardless of the system-wide Windows theme setting.
    -->
    <Grid x:Name="RootGrid"
          RequestedTheme="Dark"
          Background="{StaticResource AppBackgroundBrush}">

        <!-- ════════════════════════════════════════════════════════════════
             NavigationView: responsive sidebar + inline content

             PaneDisplayMode="Auto" gives us:
               Wide (>=1024px)  -> full sidebar with labels
               Medium (>=720px) -> compact icon-only sidebar
               Narrow           -> hamburger overlay
        ════════════════════════════════════════════════════════════════ -->
        <muxc:NavigationView
            x:Name="NavView"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            AlwaysShowHeader="False"
            OpenPaneLength="228"
            CompactModeThresholdWidth="720"
            ExpandedModeThresholdWidth="1024"
            PaneDisplayMode="Auto"
            Background="{StaticResource AppBackgroundBrush}"
            ItemInvoked="NavView_ItemInvoked">

            <!-- Override NavigationView pane background via theme resources -->
            <muxc:NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground"
                                 Color="{StaticResource AppSurfaceColor}" />
                <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground"
                                 Color="{StaticResource AppSurfaceColor}" />
            </muxc:NavigationView.Resources>

            <!-- ── Sidebar Header: App Icon + Name ─────────────────────── -->
            <muxc:NavigationView.PaneHeader>
                <Grid Padding="16,16,16,12">
                    <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="28" Height="28"
                                    CornerRadius="6"
                                    Background="{StaticResource AccentBlueBrush}">
                                <FontIcon Glyph="&#xE9F5;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="14"
                                          Foreground="White"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Lucid"
                                       Style="{StaticResource AppNameStyle}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="System Intelligence"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Margin="38,0,0,0" />
                    </StackPanel>
                </Grid>
            </muxc:NavigationView.PaneHeader>

            <!-- ── Navigation Items ────────────────────────────────────── -->
            <muxc:NavigationView.MenuItems>

                <!--
                    Chat is the home surface — first item, selected at launch.
                    Everything below it is the analysis workspace you reach when
                    you want to look at the data yourself rather than ask about it.
                -->
                <muxc:NavigationViewItem x:Name="NavChat"
                                         Tag="chat"
                                         Content="Chat"
                                         IsSelected="True">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8BD;" FontFamily="Segoe MDL2 Assets" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItemSeparator />

                <muxc:NavigationViewItem x:Name="NavDashboard"
                                         Tag="dashboard"
                                         Content="Dashboard">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" FontFamily="Segoe MDL2 Assets" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem Tag="explain"
                                         Content="Explain My PC">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" FontFamily="Segoe MDL2 Assets" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem Tag="insights"
                                         Content="Intelligence">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9CE;" FontFamily="Segoe MDL2 Assets" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItemSeparator />

                <muxc:NavigationViewItem Tag="security"
                                         Content="Security">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE72E;" FontFamily="Segoe MDL2 Assets" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem Tag="processes"
                                         Content="Processes">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9F5;" FontFamily="Segoe MDL2 Assets" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem Tag="storage"
                                         Content="Storage">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEDA2;" FontFamily="Segoe MDL2 Assets" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem Tag="apps"
                                         Content="Apps">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE71D;" FontFamily="Segoe MDL2 Assets" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem Tag="privacy"
                                         Content="Privacy">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7B3;" FontFamily="Segoe MDL2 Assets" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem Tag="repairs"
                                         Content="Repairs">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90F;" FontFamily="Segoe MDL2 Assets" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItemSeparator />

                <muxc:NavigationViewItem Tag="timeline"
                                         Content="Timeline">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE823;" FontFamily="Segoe MDL2 Assets" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem Tag="replay"
                                         Content="Replay">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" FontFamily="Segoe MDL2 Assets" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem Tag="historical"
                                         Content="Historical">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" FontFamily="Segoe MDL2 Assets" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem Tag="behavior"
                                         Content="Behavior">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" FontFamily="Segoe MDL2 Assets" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem Tag="reasoning"
                                         Content="Reasoning">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9CE;" FontFamily="Segoe MDL2 Assets" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem Tag="devices"
                                         Content="Devices">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" FontFamily="Segoe MDL2 Assets" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem Tag="governance"
                                         Content="Runtime">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9E9;" FontFamily="Segoe MDL2 Assets" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem Tag="watchtower"
                                         Content="Watchtower">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7B7;" FontFamily="Segoe MDL2 Assets" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem Tag="remediation"
                                         Content="Remediation">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90F;" FontFamily="Segoe MDL2 Assets" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem Tag="simulation"
                                         Content="Simulate">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE950;" FontFamily="Segoe MDL2 Assets" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem Tag="diagnostics"
                                         Content="Diagnostics">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE773;" FontFamily="Segoe MDL2 Assets" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem Tag="investigation"
                                         Content="Investigate">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B3;" FontFamily="Segoe MDL2 Assets" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

            </muxc:NavigationView.MenuItems>

            <!-- ── Footer: Companion toggle + Settings ────────────────── -->
            <muxc:NavigationView.FooterMenuItems>

                <muxc:NavigationViewItem x:Name="NavCompanion"
                                         Content="Companion"
                                         Tapped="NavCompanion_Tapped"
                                         ToolTipService.ToolTip="Open Operational Companion">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" FontFamily="Segoe MDL2 Assets" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem Tag="settings"
                                         Content="Settings">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" FontFamily="Segoe MDL2 Assets" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.FooterMenuItems>

            <!-- ════════════════════════════════════════════════════════════
                 Content Frame — pages are loaded here when sidebar items
                 are clicked. NavigationView_ItemInvoked in code-behind
                 calls ContentFrame.Navigate() to switch pages.
            ════════════════════════════════════════════════════════════ -->
            <Frame x:Name="ContentFrame"
                   Background="{StaticResource AppBackgroundBrush}" />

        </muxc:NavigationView>
    </Grid>
</Window>
