<Page x:ConnectionId='1'
    x:Class="ExplainMyPC.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ExplainMyPC.ViewModels"
    xmlns:intel="using:ExplainMyPC.Services.Intelligence"
    Background="{StaticResource AppBackgroundBrush}"
                        >

    <!--
        InsightCardTemplate — live DataTemplate bound to InsightCardViewModel.

        ⚠️  CompositeTransform must be declared inline (not in a Style) so that
        each card gets its own transform instance. See AppCards.xaml for details.

        IsExpanded / ExpandedVisibility / ExpandChevron all require Mode=OneWay
        so they react to the ToggleExpandedCommand without rebuilding the tree.

        ActionCardTemplate must be declared BEFORE InsightCardTemplate so the
        StaticResource forward-reference inside InsightCardTemplate resolves.
    -->
    <Page.Resources>

        <!--
            ActionCardTemplate — immutable display card for a SystemAction.
            ActionCardViewModel has no INotifyPropertyChanged — all bindings
            use the default OneTime mode.
        -->
        <DataTemplate x:Key="ActionCardTemplate"
                                                         >
            <Border x:ConnectionId='32' Background="#0AFFFFFF"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,12">
                <StackPanel Spacing="10">

                    <!-- ── Header: icon · title / description · risk badge ── -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Impact-coloured icon -->
                        <Border x:ConnectionId='63' Width="32" Height="32"
                                CornerRadius="8"
                                                                      
                                VerticalAlignment="Top">
                            <FontIcon x:ConnectionId='68' Glyph="&#xE8BD;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="13"
                                                                       
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>

                        <!-- Title + description -->
                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="3">
                            <TextBlock x:ConnectionId='66'                      
                                       FontFamily="Segoe UI Variable"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock x:ConnectionId='67'                            
                                       Style="{StaticResource CaptionTextStyle}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Risk badge -->
                        <Border x:ConnectionId='64' Grid.Column="2"
                                                                    
                                CornerRadius="6"
                                Padding="8,4"
                                VerticalAlignment="Top">
                            <TextBlock x:ConnectionId='65'                          
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                                                       />
                        </Border>
                    </Grid>

                    <!-- ── Chips: impact · effort · reversible ──────────── -->
                    <StackPanel Orientation="Horizontal"
                                Spacing="6"
                                Margin="44,0,0,0">

                        <!-- Impact chip -->
                        <Border x:ConnectionId='59'                                       
                                CornerRadius="4"
                                Padding="8,3">
                            <TextBlock x:ConnectionId='62'                            
                                       FontSize="11"
                                                                         />
                        </Border>

                        <!-- Effort chip -->
                        <Border Background="#0AFFFFFF"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,3">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE823;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="10"
                                          Foreground="{StaticResource TextSecondaryBrush}"
                                          VerticalAlignment="Center" />
                                <TextBlock x:ConnectionId='61'                           
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Reversible chip — hidden when not reversible -->
                        <Border x:ConnectionId='60'                                           
                                Background="{StaticResource StatusGoodSubtleBrush}"
                                CornerRadius="4"
                                Padding="8,3">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE72C;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="10"
                                          Foreground="{StaticResource StatusGoodBrush}"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="Reversible"
                                           FontSize="11"
                                           Foreground="{StaticResource StatusGoodBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ── Static confirmation risk notice ───────────────────
                         Shown whenever RequiresConfirmation=true so the user
                         always sees the risk text before clicking Run.
                         This is the static note from SystemAction; the
                         interactive confirmation panel is handled by the
                         Execution sub-ViewModel below.
                    ──────────────────────────────────────────────────────── -->
                    <Border x:ConnectionId='33'                                             
                            Background="{StaticResource StatusModerateSubtleBrush}"
                            CornerRadius="6"
                            Padding="10,7"
                            Margin="44,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7BA;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="12"
                                      Foreground="{StaticResource StatusModerateBrush}"
                                      VerticalAlignment="Top"
                                      Margin="0,1,0,0" />
                            <TextBlock x:ConnectionId='58'                                    
                                       Style="{StaticResource CaptionTextStyle}"
                                       Foreground="{StaticResource StatusModerateBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- ══════════════════════════════════════════════════════
                         EXECUTION PANEL
                         All states driven by Execution (ActionExecutionViewModel).
                         Only one state-section is visible at a time.
                    ══════════════════════════════════════════════════════ -->

                    <!-- Thin separator between static info and interactive UI -->
                    <Border Height="1"
                            Background="{StaticResource BorderSubtleBrush}"
                            Margin="44,2,0,2" />

                    <!-- ── IDLE: Run + Preview buttons ──────────────────────
                         Visible when State=Idle and an executor is registered.
                    ──────────────────────────────────────────────────────── -->
                    <StackPanel x:ConnectionId='34'                                                                    
                                Orientation="Horizontal"
                                Spacing="8"
                                Margin="44,0,0,0">

                        <!-- Preview (dry-run) -->
                        <Button x:ConnectionId='56'                                           
                                CornerRadius="5"
                                Padding="10,5">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE946;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="11"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="Preview"
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Run -->
                        <Button x:ConnectionId='57'                                        
                                Background="{StaticResource StatusInfoTintBrush}"
                                CornerRadius="5"
                                Padding="10,5">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE768;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="11"
                                          Foreground="{StaticResource StatusInfoBrush}"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="Run"
                                           FontSize="12"
                                           Foreground="{StaticResource StatusInfoBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- ── IDLE: Coming soon chip ───────────────────────────
                         Visible when no executor is registered for this action.
                    ──────────────────────────────────────────────────────── -->
                    <Border x:ConnectionId='35'                                                         
                            Background="#08FFFFFF"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="9,4"
                            Margin="44,0,0,0"
                            HorizontalAlignment="Left">
                        <TextBlock Text="Coming soon"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </Border>

                    <!-- ── CONFIRMATION PENDING ─────────────────────────────
                         Visible when the user clicked Run on a risky action.
                         Shows the risk description and Confirm / Cancel buttons.
                    ──────────────────────────────────────────────────────── -->
                    <Border x:ConnectionId='36'                                                                    
                            Background="{StaticResource StatusModerateSubtleBrush}"
                            CornerRadius="8"
                            Padding="12,10"
                            Margin="44,0,0,0">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7BA;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="13"
                                          Foreground="{StaticResource StatusModerateBrush}"
                                          VerticalAlignment="Top"
                                          Margin="0,2,0,0" />
                                <TextBlock x:ConnectionId='55'                                              
                                           Style="{StaticResource CaptionTextStyle}"
                                           Foreground="{StaticResource StatusModerateBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:ConnectionId='53'                                            
                                        CornerRadius="5"
                                        Padding="12,5">
                                    <TextBlock Text="Confirm"
                                               FontSize="12" />
                                </Button>
                                <Button x:ConnectionId='54'                                                       
                                        CornerRadius="5"
                                        Padding="12,5">
                                    <TextBlock Text="Cancel"
                                               FontSize="12" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ── RUNNING / DRY-RUNNING ────────────────────────────
                         Spinner + status label + Cancel link.
                    ──────────────────────────────────────────────────────── -->
                    <StackPanel x:ConnectionId='37'                                                                
                                Orientation="Horizontal"
                                Spacing="10"
                                Margin="44,0,0,0">
                        <ProgressRing x:ConnectionId='50'                                                     
                                      Width="16"
                                      Height="16" />
                        <TextBlock x:ConnectionId='51'                                                     
                                   Style="{StaticResource CaptionTextStyle}"
                                   VerticalAlignment="Center" />
                        <Button x:ConnectionId='52'                                                    
                                CornerRadius="4"
                                Padding="8,3"
                                VerticalAlignment="Center">
                            <TextBlock Text="Cancel"
                                       FontSize="11" />
                        </Button>
                    </StackPanel>

                    <!-- ── RESULT ───────────────────────────────────────────
                         State icon + outcome message.
                         Rollback button: visible only when executor captured
                         a rollback snapshot (CanRollback=true).
                         Run again: always visible to reset and retry.
                    ──────────────────────────────────────────────────────── -->
                    <StackPanel x:ConnectionId='38'                                                              
                                Spacing="6"
                                Margin="44,0,0,0">

                        <!-- Icon + message row -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon x:ConnectionId='48'                                                   
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="14"
                                                                                             
                                      VerticalAlignment="Center" />
                            <TextBlock x:ConnectionId='49'                                                     
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                                                                              
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Action links row -->
                        <StackPanel Orientation="Horizontal" Spacing="8">

                            <!-- Rollback — only when executor captured a snapshot -->
                            <Button x:ConnectionId='46'                                                                
                                                                                
                                    CornerRadius="5"
                                    Padding="10,4">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE72C;"
                                              FontFamily="Segoe MDL2 Assets"
                                              FontSize="11"
                                              VerticalAlignment="Center" />
                                    <TextBlock Text="Undo"
                                               FontSize="11"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Run again -->
                            <HyperlinkButton x:ConnectionId='47'                                                
                                             Content="Run again"
                                             FontSize="11"
                                             Padding="0"
                                             VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- ── LOG PANEL ────────────────────────────────────────
                         Live-updating execution log. Entries stream in as the
                         executor writes them. Visible whenever LogEntries has
                         at least one entry. Persists after execution.
                    ──────────────────────────────────────────────────────── -->
                    <Border x:ConnectionId='39'                                                           
                            Background="#07FFFFFF"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,8"
                            Margin="44,0,0,0">
                        <StackPanel Spacing="4">
                            <TextBlock Text="EXECUTION LOG"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       CharacterSpacing="100"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,4" />
                            <ItemsRepeater x:ConnectionId='40'                                                         >
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="3" Orientation="Vertical" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate                                        >
                                        <Grid x:ConnectionId='42' ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:ConnectionId='43'                          
                                                       FontSize="10"
                                                       FontFamily="Cascadia Code, Consolas, Courier New"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Top" />
                                            <TextBlock x:ConnectionId='44' Grid.Column="1"
                                                                                 
                                                       FontSize="10"
                                                       FontFamily="Cascadia Code, Consolas, Courier New"
                                                                                       
                                                       VerticalAlignment="Top" />
                                            <TextBlock x:ConnectionId='45' Grid.Column="2"
                                                                              
                                                       FontSize="11"
                                                                                       
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Top" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="InsightCardTemplate"
                                                          >
            <Border x:ConnectionId='3' Style="{StaticResource CardSurface}"
                    Padding="20"
                    Margin="0,0,0,0"
                                                        
                                                      >
                <Border.RenderTransform>
                    <CompositeTransform />
                </Border.RenderTransform>
                <StackPanel Spacing="10">

                    <!-- ── Always-visible header row ────────────────────── -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Icon container -->
                        <Border x:ConnectionId='20' Width="40" Height="40"
                                CornerRadius="10"
                                                                                          
                                VerticalAlignment="Top">
                            <FontIcon x:ConnectionId='30'                                        
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="16"
                                                                                    
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>

                        <!-- Title + one-line preview + confidence/timestamp -->
                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="4">
                            <TextBlock x:ConnectionId='26'                                   
                                       Style="{StaticResource CardTitleStyle}" />
                            <TextBlock x:ConnectionId='27'                                           
                                       Style="{StaticResource CaptionTextStyle}"
                                       TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal"
                                        Spacing="6"
                                        Margin="0,2,0,0">
                                <TextBlock x:ConnectionId='28'                                            
                                           FontSize="11"
                                                                                          />
                                <TextBlock Text="confidence  ·"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock x:ConnectionId='29'                                          
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Severity badge + correlation tag + expand toggle -->
                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Top"
                                    HorizontalAlignment="Right"
                                    Spacing="6">
                            <Border x:ConnectionId='21'                                                   
                                    CornerRadius="6"
                                    Padding="10,5">
                                <TextBlock x:ConnectionId='25'                                           
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                                                                          />
                            </Border>

                            <!-- Correlated tag — only visible for synthesis insights -->
                            <Border x:ConnectionId='22'                                                           
                                    Background="#0AFFFFFF"
                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,5"
                                    HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE71B;"
                                              FontFamily="Segoe MDL2 Assets"
                                              FontSize="10"
                                              Foreground="{StaticResource TextSecondaryBrush}"
                                              VerticalAlignment="Center" />
                                    <TextBlock Text="Correlated"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>

                            <Button x:ConnectionId='23'                                         
                                    HorizontalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="4,2"
                                    CornerRadius="4">
                                <FontIcon x:ConnectionId='24'                                            
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="11"
                                          Foreground="{StaticResource TextSecondaryBrush}" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- ── Expandable detail panel ───────────────────────── -->
                    <StackPanel x:ConnectionId='4'                                                      
                                Spacing="12">

                        <Border Height="1"
                                Background="{StaticResource BorderSubtleBrush}" />

                        <!-- Full detail paragraph -->
                        <TextBlock x:ConnectionId='5'                                    
                                   Style="{StaticResource BodyTextStyle}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />

                        <!-- ── Process attribution section ──────────────────────
                             Shown when the rule identified top CPU/RAM/GPU
                             consumers. Empty when no process crosses the threshold
                             or when the process sampler has not yet warmed up.
                             GPU attributions show "Detected" (heuristic, ~55 %
                             confidence); CPU/RAM show measured values (~90 %).
                        ──────────────────────────────────────────────────────── -->
                        <Border x:ConnectionId='6'                                                          
                                Background="#07FFFFFF"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,10">
                            <StackPanel Spacing="8">
                                <TextBlock Text="ATTRIBUTED PROCESSES"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           CharacterSpacing="100"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <ItemsRepeater x:ConnectionId='14'                                                        >
                                    <ItemsRepeater.Layout>
                                        <StackLayout Spacing="6" Orientation="Vertical" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate                                      >
                                            <Grid x:ConnectionId='16' ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Process name -->
                                                <TextBlock x:ConnectionId='17'                            
                                                           FontFamily="Segoe UI Variable"
                                                           FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />

                                                <!-- Usage value (e.g. "82%", "8.1 GB", "Detected") -->
                                                <TextBlock x:ConnectionId='18' Grid.Column="1"
                                                                                    
                                                           FontFamily="Segoe UI Variable"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                           VerticalAlignment="Center" />

                                                <!-- Kind badge: CPU / RAM / GPU -->
                                                <Border Grid.Column="2"
                                                        Background="#0AFFFFFF"
                                                        BorderBrush="{StaticResource BorderSubtleBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="7,2"
                                                        VerticalAlignment="Center">
                                                    <TextBlock x:ConnectionId='19'                          
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </Border>

                        <!-- Action hint chip (only when ActionHint is non-null) -->
                        <Border x:ConnectionId='7'                                           
                                                                          
                                CornerRadius="6"
                                Padding="12,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon x:ConnectionId='12' Glyph="&#xE946;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="12"
                                                                           
                                          VerticalAlignment="Center" />
                                <TextBlock x:ConnectionId='13'                           
                                           Style="{StaticResource CaptionTextStyle}"
                                                                            
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Confidence bar -->
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Confidence"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock x:ConnectionId='11'                                            
                                           FontSize="11"
                                                                                          />
                            </StackPanel>
                            <ProgressBar x:ConnectionId='10'                                                
                                         Maximum="100"
                                         Style="{StaticResource ConfidenceBar}"
                                                                                        />
                        </StackPanel>

                        <!-- Recommended actions (hidden when the rule provides none) -->
                        <StackPanel x:ConnectionId='8'                                                     
                                    Spacing="8">
                            <Border Height="1"
                                    Background="{StaticResource BorderSubtleBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8BD;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="11"
                                          Foreground="{StaticResource TextSecondaryBrush}"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="Recommended Actions"
                                           FontFamily="Segoe UI Variable"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <ItemsRepeater x:ConnectionId='9'                                            
                                           ItemTemplate="{StaticResource ActionCardTemplate}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="6" Orientation="Vertical" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                        </StackPanel>

                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <!--
        DashboardPage.xaml — System overview with health score, live metrics,
        trends, quick actions, and active insights.

        All card styles, badge styles, progress bar styles, and button styles
        are sourced from the shared design system (AppCards/AppBadges/
        AppProgress/AppButtons.xaml merged in App.xaml).

        Data: x:Bind connects all dynamic text and numeric values to
        DashboardViewModel (exposed as ViewModel on the code-behind class).
        Mode=OneWay ensures the UI reacts to future property changes when
        live telemetry is wired up in Phase 2.

        Animations: AnimationHelper drives progress bar entrance on load.
        Hover effects: AnimationHelper scale + border brighten on pointer enter/exit.

        NOTE: Each animated Border has its own inline CompositeTransform.
        See AppCards.xaml for an explanation of why this is required.
    -->

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32,32,32,48" Spacing="28">

            <!-- ══════════════════════════════════════════════════════════
                 PAGE HEADER
            ══════════════════════════════════════════════════════════ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock Text="Dashboard"
                               Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Your system at a glance"
                               Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>

                <!-- System status pill -->
                <Border Grid.Column="1"
                        Background="{StaticResource StatusGoodSubtleBrush}"
                        CornerRadius="12" Padding="12,6"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="8" Height="8"
                                 Fill="{StaticResource StatusGoodBrush}" />
                        <TextBlock x:ConnectionId='113'                                                        
                                   Style="{StaticResource CaptionTextStyle}"
                                   Foreground="{StaticResource StatusGoodBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════
                 HEALTH SCORE CARD
            ══════════════════════════════════════════════════════════ -->
            <Border x:ConnectionId='69' Style="{StaticResource CardSurface}"
                    Padding="28"
                                                        
                                                      >
                <Border.RenderTransform>
                    <CompositeTransform />
                </Border.RenderTransform>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Score ring -->
                    <Grid Grid.Column="0" Width="90" Height="90">
                        <ProgressRing x:ConnectionId='111' IsIndeterminate="False"
                                                                                         
                                      Maximum="100"
                                      Width="90" Height="90"
                                      Background="Transparent"
                                      Foreground="{StaticResource StatusGoodBrush}" />
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <TextBlock x:ConnectionId='112'                                                       
                                       Style="{StaticResource MetricLargeStyle}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="/100"
                                       Style="{StaticResource CaptionTextStyle}"
                                       HorizontalAlignment="Center"
                                       Margin="0,-4,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- Health details -->
                    <StackPanel Grid.Column="1"
                                Margin="28,0,0,0"
                                VerticalAlignment="Center"
                                Spacing="8">
                        <TextBlock x:ConnectionId='105'                                                   
                                   Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock x:ConnectionId='106'                                                         
                                   Style="{StaticResource BodyTextStyle}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />

                        <!-- Sub-scores -->
                        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Width="6" Height="6"
                                         Fill="{StaticResource StatusGoodBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock x:ConnectionId='110'                                                            
                                           Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Width="6" Height="6"
                                         Fill="{StaticResource StatusGoodBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock x:ConnectionId='109'                                                         
                                           Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Width="6" Height="6"
                                         Fill="{StaticResource StatusModerateBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock x:ConnectionId='108'                                                        
                                           Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Width="6" Height="6"
                                         Fill="{StaticResource StatusGoodBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock x:ConnectionId='107'                                                        
                                           Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Weekly trend indicator -->
                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center"
                                Spacing="2">
                        <FontIcon Glyph="&#xE70E;" FontFamily="Segoe MDL2 Assets"
                                  FontSize="16"
                                  Foreground="{StaticResource StatusGoodBrush}"
                                  HorizontalAlignment="Center" />
                        <TextBlock x:ConnectionId='104'                                                  
                                   Style="{StaticResource CaptionTextStyle}"
                                   Foreground="{StaticResource StatusGoodBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="this week"
                                   Style="{StaticResource CaptionTextStyle}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════
                 LIVE METRICS — progress bars animate on page load
            ══════════════════════════════════════════════════════════ -->
            <TextBlock Text="Live Metrics"
                       Style="{StaticResource SectionTitleStyle}" />

            <Grid ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- CPU Card -->
                <Border x:ConnectionId='88' Grid.Column="0"
                        Style="{StaticResource CardSurface}"
                        Padding="20"
                                                            
                                                          >
                    <Border.RenderTransform>
                        <CompositeTransform />
                    </Border.RenderTransform>
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <!-- Small 28px icon container — CornerRadius="6" for compact size -->
                                <Border Width="28" Height="28" CornerRadius="6"
                                        Background="{StaticResource StatusInfoTintBrush}">
                                    <FontIcon Glyph="&#xE950;" FontFamily="Segoe MDL2 Assets"
                                              FontSize="13"
                                              Foreground="{StaticResource StatusInfoBrush}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="CPU"
                                           Style="{StaticResource CardTitleStyle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Ellipse Grid.Column="1" Width="8" Height="8"
                                     Fill="{StaticResource StatusGoodBrush}"
                                     VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock x:ConnectionId='101'                                                  
                                   Style="{StaticResource MetricMediumStyle}" />

                        <ProgressBar x:ConnectionId='102' x:Name="CpuBar"
                                     Style="{StaticResource UsageBar}"
                                     Foreground="{StaticResource AccentBlueBrush}" />

                        <TextBlock x:ConnectionId='103'                                                 
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Border>

                <!-- RAM Card -->
                <Border x:ConnectionId='89' Grid.Column="1"
                        Style="{StaticResource CardSurface}"
                        Padding="20"
                                                            
                                                          >
                    <Border.RenderTransform>
                        <CompositeTransform />
                    </Border.RenderTransform>
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="28" Height="28" CornerRadius="6"
                                        Background="{StaticResource AccentCyanTintBrush}">
                                    <FontIcon Glyph="&#xE964;" FontFamily="Segoe MDL2 Assets"
                                              FontSize="13"
                                              Foreground="{StaticResource AccentCyanBrush}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="RAM"
                                           Style="{StaticResource CardTitleStyle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Ellipse Grid.Column="1" Width="8" Height="8"
                                     Fill="{StaticResource StatusModerateBrush}"
                                     VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock x:ConnectionId='98'                                                  
                                   Style="{StaticResource MetricMediumStyle}" />

                        <ProgressBar x:ConnectionId='99' x:Name="RamBar"
                                     Style="{StaticResource UsageBar}"
                                     Foreground="{StaticResource AccentCyanBrush}" />

                        <TextBlock x:ConnectionId='100'                                                 
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Border>

                <!-- GPU Card -->
                <Border x:ConnectionId='90' Grid.Column="2"
                        Style="{StaticResource CardSurface}"
                        Padding="20"
                                                            
                                                          >
                    <Border.RenderTransform>
                        <CompositeTransform />
                    </Border.RenderTransform>
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="28" Height="28" CornerRadius="6"
                                        Background="{StaticResource StatusGoodTintBrush}">
                                    <FontIcon Glyph="&#xE7F4;" FontFamily="Segoe MDL2 Assets"
                                              FontSize="13"
                                              Foreground="{StaticResource StatusGoodBrush}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="GPU"
                                           Style="{StaticResource CardTitleStyle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Ellipse Grid.Column="1" Width="8" Height="8"
                                     Fill="{StaticResource StatusGoodBrush}"
                                     VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock x:ConnectionId='95'                                                  
                                   Style="{StaticResource MetricMediumStyle}" />

                        <ProgressBar x:ConnectionId='96' x:Name="GpuBar"
                                     Style="{StaticResource UsageBar}"
                                     Foreground="{StaticResource StatusGoodBrush}" />

                        <TextBlock x:ConnectionId='97'                                                 
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Border>

                <!-- Disk Card -->
                <Border x:ConnectionId='91' Grid.Column="3"
                        Style="{StaticResource CardSurface}"
                        Padding="20"
                                                            
                                                          >
                    <Border.RenderTransform>
                        <CompositeTransform />
                    </Border.RenderTransform>
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="28" Height="28" CornerRadius="6"
                                        Background="{StaticResource StatusModerateTintBrush}">
                                    <FontIcon Glyph="&#xEDA2;" FontFamily="Segoe MDL2 Assets"
                                              FontSize="13"
                                              Foreground="{StaticResource StatusModerateBrush}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Disk"
                                           Style="{StaticResource CardTitleStyle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Ellipse Grid.Column="1" Width="8" Height="8"
                                     Fill="{StaticResource StatusGoodBrush}"
                                     VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock x:ConnectionId='92'                                                   
                                   Style="{StaticResource MetricMediumStyle}" />

                        <ProgressBar x:ConnectionId='93' x:Name="DiskBar"
                                     Style="{StaticResource UsageBar}"
                                     Foreground="{StaticResource StatusModerateBrush}" />

                        <TextBlock x:ConnectionId='94'                                                  
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════
                 RECENT TRENDS
            ══════════════════════════════════════════════════════════ -->
            <TextBlock Text="Recent Trends"
                       Style="{StaticResource SectionTitleStyle}"
                       Margin="0,4,0,0" />

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Boot time -->
                <Border x:ConnectionId='79' Grid.Column="0"
                        Style="{StaticResource CardSurface}"
                        Padding="20"
                                                            
                                                          >
                    <Border.RenderTransform>
                        <CompositeTransform />
                    </Border.RenderTransform>
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xEC49;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="14"
                                      Foreground="{StaticResource AccentBlueBrush}" />
                            <TextBlock Text="Boot Time"
                                       Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:ConnectionId='86'                                                     
                                       Style="{StaticResource MetricMediumStyle}" />
                            <Border Background="{StaticResource StatusGoodSubtleBrush}"
                                    CornerRadius="4" Padding="6,2"
                                    VerticalAlignment="Center">
                                <TextBlock x:ConnectionId='87'                                                     
                                           FontSize="11"
                                           Foreground="{StaticResource StatusGoodBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="vs. last week average"
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Border>

                <!-- Avg CPU -->
                <Border x:ConnectionId='80' Grid.Column="1"
                        Style="{StaticResource CardSurface}"
                        Padding="20"
                                                            
                                                          >
                    <Border.RenderTransform>
                        <CompositeTransform />
                    </Border.RenderTransform>
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE9D2;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="14"
                                      Foreground="{StaticResource AccentCyanBrush}" />
                            <TextBlock Text="Avg CPU (24h)"
                                       Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:ConnectionId='84'                                                   
                                       Style="{StaticResource MetricMediumStyle}" />
                            <Border Background="{StaticResource StatusModerateSubtleBrush}"
                                    CornerRadius="4" Padding="6,2"
                                    VerticalAlignment="Center">
                                <TextBlock x:ConnectionId='85'                                                   
                                           FontSize="11"
                                           Foreground="{StaticResource StatusModerateBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="vs. last week average"
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Border>

                <!-- Disk free -->
                <Border x:ConnectionId='81' Grid.Column="2"
                        Style="{StaticResource CardSurface}"
                        Padding="20"
                                                            
                                                          >
                    <Border.RenderTransform>
                        <CompositeTransform />
                    </Border.RenderTransform>
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xEDA2;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="14"
                                      Foreground="{StaticResource StatusModerateBrush}" />
                            <TextBlock Text="Disk Free"
                                       Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:ConnectionId='82'                                                     
                                       Style="{StaticResource MetricMediumStyle}" />
                            <Border Background="{StaticResource StatusCriticalSubtleBrush}"
                                    CornerRadius="4" Padding="6,2"
                                    VerticalAlignment="Center">
                                <TextBlock x:ConnectionId='83'                                                     
                                           FontSize="11"
                                           Foreground="{StaticResource StatusCriticalBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="in the last 7 days"
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════
                 QUICK ACTIONS
            ══════════════════════════════════════════════════════════ -->
            <TextBlock Text="Quick Actions"
                       Style="{StaticResource SectionTitleStyle}"
                       Margin="0,4,0,0" />

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource ActionButton}">
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE946;" FontFamily="Segoe MDL2 Assets"
                                  FontSize="18"
                                  Foreground="{StaticResource AccentBlueBrush}"
                                  HorizontalAlignment="Center" />
                        <TextBlock Text="Explain My PC"
                                   Style="{StaticResource CaptionTextStyle}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="1" Style="{StaticResource ActionButton}">
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE71C;" FontFamily="Segoe MDL2 Assets"
                                  FontSize="18"
                                  Foreground="{StaticResource AccentCyanBrush}"
                                  HorizontalAlignment="Center" />
                        <TextBlock Text="Full Scan"
                                   Style="{StaticResource CaptionTextStyle}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="2" Style="{StaticResource ActionButton}">
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                  FontSize="18"
                                  Foreground="{StaticResource StatusGoodBrush}"
                                  HorizontalAlignment="Center" />
                        <TextBlock Text="Cleanup"
                                   Style="{StaticResource CaptionTextStyle}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="3" Style="{StaticResource ActionButton}">
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE7B3;" FontFamily="Segoe MDL2 Assets"
                                  FontSize="18"
                                  Foreground="{StaticResource StatusModerateBrush}"
                                  HorizontalAlignment="Center" />
                        <TextBlock Text="Startup Apps"
                                   Style="{StaticResource CaptionTextStyle}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════
                 ACTIVE INSIGHTS
            ══════════════════════════════════════════════════════════ -->
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Active Insights"
                           Style="{StaticResource SectionTitleStyle}" />
                <Border Grid.Column="1"
                        Background="{StaticResource StatusInfoSubtleBrush}"
                        CornerRadius="10" Padding="8,3">
                    <TextBlock x:ConnectionId='78'                                                        
                               FontSize="11"
                               Foreground="{StaticResource StatusInfoBrush}" />
                </Border>
            </Grid>

            <!--
                Live grouped insight cards, sorted Warnings → Recommendations → Informational.
                Each InsightGroupViewModel contains sorted InsightCardViewModels.
                Only non-empty groups are present in InsightGroups.
            -->
            <ItemsRepeater x:ConnectionId='70'                                                            >
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="20" Orientation="Vertical" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate                                      >
                        <StackPanel x:ConnectionId='72' Spacing="8">

                            <!-- Group header: coloured icon + title + count badge -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon x:ConnectionId='74'                           
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="13"
                                                                                
                                          VerticalAlignment="Center" />
                                <TextBlock x:ConnectionId='75'                           
                                           FontFamily="Segoe UI Variable"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                                                                 
                                           VerticalAlignment="Center" />
                                <Border x:ConnectionId='76'                                     
                                        CornerRadius="8"
                                        Padding="7,2"
                                        VerticalAlignment="Center">
                                    <TextBlock x:ConnectionId='77'                          
                                               FontSize="11"
                                                                                      />
                                </Border>
                            </StackPanel>

                            <!-- Cards in this severity group -->
                            <ItemsRepeater x:ConnectionId='73'                             
                                           ItemTemplate="{StaticResource InsightCardTemplate}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="8" Orientation="Vertical" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>

                        </StackPanel>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

        </StackPanel>
    </ScrollViewer>
</Page>

