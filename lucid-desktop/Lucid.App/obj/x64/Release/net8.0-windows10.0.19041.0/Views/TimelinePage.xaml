<Page x:ConnectionId='1'
    x:Class="ExplainMyPC.Views.TimelinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ExplainMyPC.Views"
    xmlns:vm="using:ExplainMyPC.ViewModels"
    Background="{StaticResource AppBackgroundBrush}">

    <!--
        TimelinePage — Operational Timeline
        ═══════════════════════════════════════════════════════════════════════════

        Layout: fixed header (title + count) → filter chip strip → scrollable
        event list. The outer Grid pins the top two rows and lets Row 2 fill
        the remaining height so the list scrolls independently.

        List structure:
          FlatItems is a mixed ObservableCollection<object> of two types:
            TimelineGroupHeaderViewModel  — section divider (Now / Last 15m / Today / Earlier)
            TimelineEventViewModel        — event card

          TimelineItemTemplateSelector routes each item to the correct DataTemplate.
          This avoids CollectionViewSource group-binding complexity while keeping the
          ListView virtualised across the full flat list.

        Event card layout (per card):
          ┌── 3px accent stripe ──┬─────────────────────────────────────────────┐
          │                       │ [Glyph]  Title                [Tag]  Time ▼ │
          │                       │          Process: Chrome, discord             │
          │                       │ ─────────────────────────────────────────── │ (expanded)
          │                       │ Detail paragraph…                            │
          │                       │ Timestamp: h:mm:ss tt                        │
          └───────────────────────┴─────────────────────────────────────────────┘

        Animations:
          EntranceThemeTransition on the ListView gives a smooth slide-in when the
          page first loads. Individual card expand/collapse uses Visibility toggling
          (no custom Storyboard required).
    -->

    <Page.Resources>

        <!-- ── Template selector ──────────────────────────────────────────── -->
        <local:TimelineItemTemplateSelector x:Key="TimelineTemplateSelector">

            <!-- Section header template -->
            <local:TimelineItemTemplateSelector.HeaderTemplate>
                <DataTemplate                                             >
                    <Grid x:ConnectionId='3' Padding="4,20,4,8">
                        <StackPanel Orientation="Horizontal" Spacing="10"
                                    VerticalAlignment="Center">

                            <!-- Section label (all-caps, spaced) -->
                            <TextBlock x:ConnectionId='4'                      
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       CharacterSpacing="75"
                                       Foreground="{StaticResource SecondaryTextBrush}" />

                            <!-- Event count badge -->
                            <Border Background="#1AFFFFFF"
                                    CornerRadius="10"
                                    Padding="7,1">
                                <TextBlock x:ConnectionId='5'                          
                                           FontSize="11"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                            </Border>
                        </StackPanel>

                        <!-- Hairline separator -->
                        <Rectangle Height="1"
                                   Fill="#18FFFFFF"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,0" />
                    </Grid>
                </DataTemplate>
            </local:TimelineItemTemplateSelector.HeaderTemplate>

            <!-- Event card template -->
            <local:TimelineItemTemplateSelector.EventTemplate>
                <DataTemplate                                       >
                    <Border x:ConnectionId='7' Background="{StaticResource AppSurfaceBrush}"
                            CornerRadius="10"
                            BorderBrush="{StaticResource AppBorderSubtleBrush}"
                            BorderThickness="1"
                            Margin="0,0,0,6">

                        <!-- Inline CompositeTransform for hover scale (per-card, not shared) -->
                        <Border.RenderTransform>
                            <CompositeTransform />
                        </Border.RenderTransform>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- ── Severity accent stripe ─────────────────── -->
                            <Border x:ConnectionId='8' Grid.Column="0"
                                                                     
                                    CornerRadius="10,0,0,10" />

                            <!-- ── Card content ───────────────────────────── -->
                            <StackPanel Grid.Column="1"
                                        Padding="14,12,14,12"
                                        Spacing="0">

                                <!-- Header row: glyph + title + meta -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Glyph container -->
                                    <Border x:ConnectionId='14' Grid.Column="0"
                                            Width="32" Height="32"
                                            CornerRadius="8"
                                                                                  
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center">
                                        <FontIcon x:ConnectionId='21'                       
                                                  FontFamily="Segoe MDL2 Assets"
                                                  FontSize="15"
                                                                                   
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Title -->
                                    <TextBlock x:ConnectionId='15' Grid.Column="1"
                                                                    
                                               Style="{StaticResource CardTitleStyle}"
                                               VerticalAlignment="Center"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" />

                                    <!-- Right meta: type chip + time + expand toggle -->
                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                Spacing="8"
                                                VerticalAlignment="Center"
                                                Margin="12,0,0,0">

                                        <!-- Type label chip -->
                                        <Border x:ConnectionId='16'                                       
                                                CornerRadius="10"
                                                Padding="8,3">
                                            <TextBlock x:ConnectionId='20'                          
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                                                         />
                                        </Border>

                                        <!-- Relative time -->
                                        <TextBlock x:ConnectionId='17'                             
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   VerticalAlignment="Center"
                                                   MinWidth="54" />

                                        <!-- Expand toggle (hidden when no detail or processes) -->
                                        <Button x:ConnectionId='18'                                       
                                                                                            
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Width="28" Height="28"
                                                Padding="0"
                                                VerticalAlignment="Center"
                                                ToolTipService.ToolTip="Show details">
                                            <FontIcon x:ConnectionId='19'                                          
                                                      FontFamily="Segoe MDL2 Assets"
                                                      FontSize="11"
                                                      Foreground="{StaticResource SecondaryTextBrush}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Process attribution line (always visible when present) -->
                                <StackPanel x:ConnectionId='9' Orientation="Horizontal"
                                                                                     
                                            Margin="44,6,0,0"
                                            Spacing="6">
                                    <FontIcon Glyph="&#xE9F5;"
                                              FontFamily="Segoe MDL2 Assets"
                                              FontSize="11"
                                              Foreground="{StaticResource SecondaryTextBrush}"
                                              VerticalAlignment="Center" />
                                    <TextBlock x:ConnectionId='13'                              
                                               FontSize="12"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- Expanded detail panel -->
                                <Border x:ConnectionId='10'                                                             
                                        Background="#0AFFFFFF"
                                        CornerRadius="6"
                                        Padding="12,10"
                                        Margin="0,10,0,0">
                                    <StackPanel Spacing="8">

                                        <!-- Detail text -->
                                        <TextBlock x:ConnectionId='11'                       
                                                   Style="{StaticResource BodyTextStyle}"
                                                   TextWrapping="Wrap"
                                                   IsTextSelectionEnabled="True" />

                                        <!-- Timestamp footer -->
                                        <TextBlock x:ConnectionId='12'                              
                                                   FontSize="11"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   FontFamily="Consolas" />
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </local:TimelineItemTemplateSelector.EventTemplate>

        </local:TimelineItemTemplateSelector>

    </Page.Resources>

    <!-- ── Page root ──────────────────────────────────────────────────────── -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- header -->
            <RowDefinition Height="Auto" />   <!-- filter chips -->
            <RowDefinition Height="*" />      <!-- scrollable list -->
        </Grid.RowDefinitions>

        <!-- ── Header ────────────────────────────────────────────────────── -->
        <Grid Grid.Row="0" Padding="32,28,32,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Operational Timeline"
                           Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Chronological record of system events, findings, and actions."
                           Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>

            <!-- Live event count badge -->
            <Border Grid.Column="1"
                    Background="{StaticResource AppElevatedSurfaceBrush}"
                    BorderBrush="{StaticResource AppBorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="14,6"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE823;"
                              FontFamily="Segoe MDL2 Assets"
                              FontSize="13"
                              Foreground="{StaticResource AccentBlueBrush}" />
                    <TextBlock>
                        <Run x:ConnectionId='41'                                                        />
                        <Run Text=" events" Foreground="{StaticResource SecondaryTextBrush}" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ── Filter chip strip ─────────────────────────────────────────── -->
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      Padding="32,18,32,0">
            <StackPanel Orientation="Horizontal" Spacing="8">

                <!-- Warnings chip -->
                <Button x:ConnectionId='26'                                                        
                                                                                  
                                                                                       
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="14,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon x:ConnectionId='39' Glyph="&#xE7BA;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="12"
                                                                                               />
                        <TextBlock x:ConnectionId='40' Text="Warnings"
                                   FontSize="13" FontWeight="SemiBold"
                                                                                                />
                    </StackPanel>
                </Button>

                <!-- Recommendations chip -->
                <Button x:ConnectionId='27'                                                               
                                                                                         
                                                                                              
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="14,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon x:ConnectionId='37' Glyph="&#xE946;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="12"
                                                                                                      />
                        <TextBlock x:ConnectionId='38' Text="Recommendations"
                                   FontSize="13" FontWeight="SemiBold"
                                                                                                       />
                    </StackPanel>
                </Button>

                <!-- Forecasts chip -->
                <Button x:ConnectionId='28'                                                         
                                                                                   
                                                                                        
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="14,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon x:ConnectionId='35' Glyph="&#xE9D9;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="12"
                                                                                                />
                        <TextBlock x:ConnectionId='36' Text="Forecasts"
                                   FontSize="13" FontWeight="SemiBold"
                                                                                                 />
                    </StackPanel>
                </Button>

                <!-- Actions chip -->
                <Button x:ConnectionId='29'                                                       
                                                                                 
                                                                                      
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="14,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon x:ConnectionId='33' Glyph="&#xE768;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="12"
                                                                                              />
                        <TextBlock x:ConnectionId='34' Text="Actions"
                                   FontSize="13" FontWeight="SemiBold"
                                                                                               />
                    </StackPanel>
                </Button>

                <!-- Session chip -->
                <Button x:ConnectionId='30'                                                        
                                                                                  
                                                                                       
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="14,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon x:ConnectionId='31' Glyph="&#xE7B8;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="12"
                                                                                               />
                        <TextBlock x:ConnectionId='32' Text="Session"
                                   FontSize="13" FontWeight="SemiBold"
                                                                                                />
                    </StackPanel>
                </Button>

            </StackPanel>
        </ScrollViewer>

        <!-- ── Event list ─────────────────────────────────────────────────── -->
        <Grid Grid.Row="2" Margin="32,18,32,24">

            <!-- Empty state -->
            <StackPanel x:ConnectionId='22'                                                                  
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                <FontIcon Glyph="&#xE823;"
                          FontFamily="Segoe MDL2 Assets"
                          FontSize="48"
                          Foreground="{StaticResource SecondaryTextBrush}"
                          HorizontalAlignment="Center" />
                <TextBlock Text="No events yet"
                           Style="{StaticResource SectionTitleStyle}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Events appear here as the system is monitored."
                           Style="{StaticResource CaptionTextStyle}"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Virtualized timeline list -->
            <ListView x:ConnectionId='23'                                                        
                      ItemTemplateSelector="{StaticResource TimelineTemplateSelector}"
                                                                                 
                      SelectionMode="None"
                      IsItemClickEnabled="False">

                <!-- Smooth entrance animation when page loads -->
                <ListView.Transitions>
                    <TransitionCollection>
                        <EntranceThemeTransition />
                    </TransitionCollection>
                </ListView.Transitions>

                <!-- Strip the default ListViewItem chrome: remove selection highlight,
                     padding, and focus rectangles so cards render flush -->
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment"   Value="Stretch" />
                        <Setter Property="Padding"                    Value="0" />
                        <Setter Property="Margin"                     Value="0" />
                        <Setter Property="MinHeight"                  Value="0" />
                        <Setter Property="Background"                 Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ContentPresenter HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Stretch" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>

            </ListView>
        </Grid>

    </Grid>
</Page>

