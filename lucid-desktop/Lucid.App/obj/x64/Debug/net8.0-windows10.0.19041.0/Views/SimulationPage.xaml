<Page
    x:Class="Lucid.Views.SimulationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Lucid.Views"
    xmlns:vm="using:Lucid.ViewModels"
    Background="{StaticResource AppBackgroundBrush}">

    <!--
        SimulationPage.xaml — Operational "What If?" Simulation
        ══════════════════════════════════════════════════════════════════════
        Predictive operational planning: simulate outcomes before acting.

        Sections:
          1. Page header
          2. Scenario Builder (type chips + horizon)
          3. Simulation loading indicator
          4. Low-data notice
          5. Scenario narrative + confidence
          6. Outcome Comparison (WithAction vs WithoutAction branches)
          7. Branch Timeline (trajectory visualization)
          8. Operational Risk View
          9. Historical Basis
         10. Privacy footer

        Simulation philosophy:
          • Estimates only — never claims certainty
          • Confidence score always visible
          • Historical basis always explained
          • Never auto-applies changes

        No XAML converters — Visibility properties exposed from ViewModel.
    -->

    <ScrollViewer x:ConnectionId='2' x:Name="RootScrollViewer"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32,32,32,56" Spacing="24">

            <!-- ═══════════════════════════════════════════════════════════════
                 1. PAGE HEADER
            ═══════════════════════════════════════════════════════════════ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock Text="What If? Simulator"
                               Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Explore projected outcomes before taking action — estimate, compare, and plan with confidence-aware forecasts"
                               Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>

                <Button Grid.Column="1"
                        Command="{Binding RunSimulationCommand}"
                        VerticalAlignment="Center"
                        Padding="14,8" CornerRadius="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                        <TextBlock Text="Run Simulation" FontSize="13" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════════
                 2. QUICK SCENARIO PRESETS
                 Six one-tap shortcuts that pre-configure a meaningful scenario
                 and horizon — the fastest path to useful results.
            ═══════════════════════════════════════════════════════════════ -->
            <Border Background="{StaticResource AppSurfaceBrush}"
                    CornerRadius="12" Padding="24,18">
                <StackPanel Spacing="12">

                    <StackPanel Spacing="2">
                        <TextBlock Text="Quick Scenarios"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Tap to instantly run a common simulation with pre-tuned settings."
                                   Style="{StaticResource BodyTextStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <ItemsRepeater ItemsSource="{Binding ScenarioPresets}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="148"
                                               MinColumnSpacing="8"
                                               MinRowSpacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate                                        >
                                <Button x:ConnectionId='59' Command="{Binding DataContext.SelectPresetCommand, ElementName=RootScrollViewer}"
                                                                   
                                        HorizontalAlignment="Stretch"
                                        Padding="12,10" CornerRadius="8">
                                    <StackPanel Spacing="2">
                                        <TextBlock x:ConnectionId='60'                     
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock x:ConnectionId='61'                            
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════
                 3. CUSTOM SCENARIO BUILDER
            ═══════════════════════════════════════════════════════════════ -->
            <Border Background="{StaticResource AppSurfaceBrush}"
                    CornerRadius="12" Padding="24,20">
                <StackPanel Spacing="16">

                    <StackPanel Spacing="4">
                        <TextBlock Text="Custom Scenario"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Select what you want to simulate. Each scenario models a specific intervention or continuation path."
                                   Style="{StaticResource BodyTextStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Scenario chips -->
                    <ItemsRepeater ItemsSource="{Binding ScenarioChips}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="160"
                                               MinColumnSpacing="8"
                                               MinRowSpacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate                                          >
                                <Button x:ConnectionId='54' Command="{Binding DataContext.SelectScenarioCommand, ElementName=RootScrollViewer}"
                                                                                
                                        HorizontalAlignment="Stretch"
                                        Padding="12,10" CornerRadius="8">
                                    <Button.BorderBrush>
                                        <SolidColorBrush x:ConnectionId='55'                                                   />
                                    </Button.BorderBrush>
                                    <StackPanel Spacing="3">
                                        <TextBlock x:ConnectionId='56'                      
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock x:ConnectionId='57'                            
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <!-- Horizon selector -->
                    <StackPanel Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Forecast horizon"
                                       FontWeight="SemiBold" FontSize="13"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding HorizonLabel}"
                                       FontWeight="SemiBold" FontSize="13"
                                       Foreground="{StaticResource AccentBlueBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <Slider Value="{Binding HorizonIndex, Mode=TwoWay}"
                                Minimum="0" Maximum="4" StepFrequency="1"
                                TickFrequency="1" TickPlacement="BottomRight"
                                SnapsTo="Ticks" />
                        <StackPanel Orientation="Horizontal" Spacing="0">
                            <TextBlock Text="15 min" Style="{StaticResource CaptionTextStyle}" Width="72" />
                            <TextBlock Text="1 hr"   Style="{StaticResource CaptionTextStyle}" Width="72" />
                            <TextBlock Text="4 hrs"  Style="{StaticResource CaptionTextStyle}" Width="72" />
                            <TextBlock Text="24 hrs" Style="{StaticResource CaptionTextStyle}" Width="72" />
                            <TextBlock Text="7 days" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════
                 3. SIMULATING INDICATOR
            ═══════════════════════════════════════════════════════════════ -->
            <Border Visibility="{Binding SimulatingVisibility}"
                    Background="{StaticResource AppSurfaceBrush}"
                    CornerRadius="12" Padding="20,16">
                <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center">
                    <ProgressRing IsActive="True" Width="20" Height="20" />
                    <TextBlock Text="Running simulation…"
                               VerticalAlignment="Center"
                               Style="{StaticResource BodyTextStyle}" />
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════
                 RESULTS — only shown when HasResult is true
            ═══════════════════════════════════════════════════════════════ -->
            <StackPanel Visibility="{Binding ResultVisibility}" Spacing="24">

                <!-- ═══════════════════════════════════════════════════════════
                     DECISION CARD — headline verdict derived from simulation
                     Appears first so users get the "so what?" answer immediately.
                ═══════════════════════════════════════════════════════════ -->
                <Border Visibility="{Binding DecisionCardVisibility}"
                        Background="{StaticResource AppSurfaceBrush}"
                        CornerRadius="12" Padding="24,20">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: headline + gain summary -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding HeadlineVerdict}"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ProjectedGainSummary}"
                                       Style="{StaticResource BodyTextStyle}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Right: decision badge + urgency -->
                        <StackPanel Grid.Column="1" Spacing="8"
                                    HorizontalAlignment="Right" MinWidth="110">

                            <Border Background="#0A000000" CornerRadius="16"
                                    Padding="12,5">
                                <TextBlock Text="{Binding DecisionLabel}"
                                           FontWeight="Bold" FontSize="13"
                                           Foreground="{Binding DecisionColor}"
                                           HorizontalAlignment="Center" />
                            </Border>

                            <StackPanel Orientation="Horizontal" Spacing="5"
                                        HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE916;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="11"
                                          Foreground="{Binding UrgencyColor}" />
                                <TextBlock Text="{Binding UrgencyLabel}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{Binding UrgencyColor}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ═══════════════════════════════════════════════════════════
                     LOW-DATA NOTICE
                ═══════════════════════════════════════════════════════════ -->
                <Border Visibility="{Binding InsufficientDataVisibility}"
                        Background="{StaticResource AppSurfaceBrush}"
                        CornerRadius="12" Padding="20,16"
                        BorderBrush="#F59E0B" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE9CE;" FontFamily="Segoe MDL2 Assets"
                                  FontSize="16" Foreground="#F59E0B"
                                  VerticalAlignment="Center" />
                        <TextBlock TextWrapping="Wrap"
                                   Style="{StaticResource BodyTextStyle}"
                                   VerticalAlignment="Center">
                            Simulation is based on limited data. Estimates will improve with more operational history. Keep Lucid running to build a stronger baseline.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════════════════════════
                     5. SCENARIO NARRATIVE + CONFIDENCE
                ═══════════════════════════════════════════════════════════ -->
                <Border Background="{StaticResource AppSurfaceBrush}"
                        CornerRadius="12" Padding="24,20">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Simulation Summary"
                                       Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="{Binding ScenarioNarrative}"
                                       Style="{StaticResource BodyTextStyle}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SimulatedAt}"
                                       Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>

                        <!-- Confidence badge — tier + score -->
                        <StackPanel Grid.Column="1" Spacing="6" HorizontalAlignment="Right"
                                    MinWidth="128">

                            <!-- Tier badge: High / Moderate / Limited / Preliminary -->
                            <Border Background="#0A000000" CornerRadius="12"
                                    Padding="8,3" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding ConfidenceTierLabel}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{Binding ConfidenceTierColor}"
                                           HorizontalAlignment="Center" />
                            </Border>

                            <!-- Numeric score -->
                            <TextBlock Text="{Binding ConfidencePercent}"
                                       FontSize="28" FontWeight="Bold"
                                       Foreground="{Binding ConfidenceColor}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding ConfidenceLabel}"
                                       Style="{StaticResource CaptionTextStyle}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center" />
                            <ProgressBar Value="{Binding ConfidenceValue}"
                                         Maximum="100"
                                         Height="4"
                                         CornerRadius="2"
                                         Foreground="{Binding ConfidenceColor}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ═══════════════════════════════════════════════════════════
                     6. OUTCOME COMPARISON
                ═══════════════════════════════════════════════════════════ -->
                <StackPanel Spacing="12">
                    <TextBlock Text="Outcome Comparison"
                               Style="{StaticResource SectionTitleStyle}" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- WithAction branch -->
                        <Border Grid.Column="0"
                                Background="{StaticResource AppSurfaceBrush}"
                                CornerRadius="12" Padding="18,16"
                                BorderBrush="#60A5FA" BorderThickness="1">
                            <StackPanel Spacing="12">

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                              FontSize="14" Foreground="#60A5FA" />
                                    <TextBlock Text="{Binding WithAction.Label}"
                                               FontWeight="SemiBold" FontSize="14"
                                               Foreground="#60A5FA"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock Text="{Binding WithAction.Narrative}"
                                           Style="{StaticResource BodyTextStyle}"
                                           TextWrapping="Wrap" />

                                <!-- Metric deltas -->
                                <ItemsRepeater ItemsSource="{Binding WithAction.Metrics}">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate                                         >
                                            <Grid x:ConnectionId='49' Padding="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="50" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:ConnectionId='50'                      
                                                           Style="{StaticResource CaptionTextStyle}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock x:ConnectionId='51' Grid.Column="1"
                                                                                         
                                                           FontSize="13"
                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock x:ConnectionId='52' Grid.Column="2"
                                                                                
                                                           FontSize="12"
                                                                                           
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>

                                <!-- Key badges -->
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE77B;" FontFamily="Segoe MDL2 Assets"
                                                  FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Text="{Binding WithAction.StabilityPercent}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="stability"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                Visibility="{Binding WithAction.ReliefDaysVisibility}">
                                        <FontIcon Glyph="&#xE916;" FontFamily="Segoe MDL2 Assets"
                                                  FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Text="{Binding WithAction.ReliefDays}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="estimated relief"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                Visibility="{Binding WithAction.StartupImpactVisibility}">
                                        <FontIcon Glyph="&#xE7FC;" FontFamily="Segoe MDL2 Assets"
                                                  FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Text="{Binding WithAction.StartupImpact}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="boot settling"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Key insights -->
                                <ItemsRepeater ItemsSource="{Binding WithAction.KeyInsights}">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate                      >
                                            <StackPanel x:ConnectionId='46' Orientation="Horizontal" Spacing="6" Padding="0,2">
                                                <FontIcon Glyph="&#xE915;" FontFamily="Segoe MDL2 Assets"
                                                          FontSize="10" Foreground="#60A5FA"
                                                          VerticalAlignment="Top"
                                                          Margin="0,2,0,0" />
                                                <TextBlock x:ConnectionId='47'                
                                                           Style="{StaticResource CaptionTextStyle}"
                                                           TextWrapping="Wrap"
                                                           MaxWidth="240" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </Border>

                        <!-- WithoutAction branch -->
                        <Border Grid.Column="1"
                                Background="{StaticResource AppSurfaceBrush}"
                                CornerRadius="12" Padding="18,16">
                            <StackPanel Spacing="12">

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8FB;" FontFamily="Segoe MDL2 Assets"
                                              FontSize="14" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding WithoutAction.Label}"
                                               FontWeight="SemiBold" FontSize="14"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock Text="{Binding WithoutAction.Narrative}"
                                           Style="{StaticResource BodyTextStyle}"
                                           TextWrapping="Wrap" />

                                <!-- Metric deltas -->
                                <ItemsRepeater ItemsSource="{Binding WithoutAction.Metrics}">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate                                         >
                                            <Grid x:ConnectionId='41' Padding="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="50" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:ConnectionId='42'                      
                                                           Style="{StaticResource CaptionTextStyle}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock x:ConnectionId='43' Grid.Column="1"
                                                                                         
                                                           FontSize="13"
                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock x:ConnectionId='44' Grid.Column="2"
                                                                                
                                                           FontSize="12"
                                                                                           
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>

                                <!-- Key insights -->
                                <ItemsRepeater ItemsSource="{Binding WithoutAction.KeyInsights}">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate                      >
                                            <StackPanel x:ConnectionId='38' Orientation="Horizontal" Spacing="6" Padding="0,2">
                                                <FontIcon Glyph="&#xE915;" FontFamily="Segoe MDL2 Assets"
                                                          FontSize="10" Foreground="{StaticResource MutedTextBrush}"
                                                          VerticalAlignment="Top"
                                                          Margin="0,2,0,0" />
                                                <TextBlock x:ConnectionId='39'                
                                                           Style="{StaticResource CaptionTextStyle}"
                                                           TextWrapping="Wrap"
                                                           MaxWidth="240" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- ═══════════════════════════════════════════════════════════
                     7. BRANCH TIMELINE (Trajectory Visualization)
                ═══════════════════════════════════════════════════════════ -->
                <Border Background="{StaticResource AppSurfaceBrush}"
                        CornerRadius="12" Padding="24,20">
                    <StackPanel Spacing="12">

                        <StackPanel Spacing="4">
                            <TextBlock Text="Projected RAM Trajectory"
                                       Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="RAM usage projected over the simulation horizon. Blue = with action, red = without action."
                                       Style="{StaticResource BodyTextStyle}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Legend — static entries always visible; overlay entries shown only when active -->
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="12" Height="12" CornerRadius="2"
                                        Background="#60A5FA" VerticalAlignment="Center" />
                                <TextBlock Text="With action" Style="{StaticResource CaptionTextStyle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="12" Height="12" CornerRadius="2"
                                        Background="#EF4444" VerticalAlignment="Center" />
                                <TextBlock Text="Without action" Style="{StaticResource CaptionTextStyle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <!-- Anomaly dot legend entry — only shown when active -->
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        Visibility="{Binding AnomalyDotVisibility}">
                                <Ellipse Width="8" Height="8"
                                         Fill="#F87171"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="Current level (anomaly)" Style="{StaticResource CaptionTextStyle}"
                                           Foreground="#F87171"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <!-- Drift overlay legend entry — only shown when active -->
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        Visibility="{Binding DriftOverlayVisibility}">
                                <Border Width="12" Height="12" CornerRadius="2"
                                        Background="#30F59E0B" VerticalAlignment="Center" />
                                <TextBlock Text="Drift zone" Style="{StaticResource CaptionTextStyle}"
                                           Foreground="#F59E0B"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <!-- Confidence band legend entry — only shown when result exists -->
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        Visibility="{Binding ConfidenceBandVisibility}">
                                <Border Width="12" Height="12" CornerRadius="2"
                                        Background="#20FFFFFF" VerticalAlignment="Center" />
                                <TextBlock Text="Confidence band" Style="{StaticResource CaptionTextStyle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Trajectory chart — native Canvas + Polyline (no external packages) -->
                        <Grid HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Y-axis labels -->
                            <Grid Grid.Column="0" Height="130">
                                <TextBlock Text="100%"
                                           Style="{StaticResource CaptionTextStyle}"
                                           VerticalAlignment="Top"
                                           HorizontalAlignment="Right"
                                           Margin="0,0,4,0" />
                                <TextBlock Text="50%"
                                           Style="{StaticResource CaptionTextStyle}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           Margin="0,0,4,0" />
                                <TextBlock Text="0%"
                                           Style="{StaticResource CaptionTextStyle}"
                                           VerticalAlignment="Bottom"
                                           HorizontalAlignment="Right"
                                           Margin="0,0,4,0" />
                            </Grid>

                            <!-- Chart canvas: 560 × 130 px, RAM on Y axis
                                 Overlay draw order (back → front):
                                   1. drift tint rectangle
                                   2. confidence band rectangle
                                   3. grid lines
                                   4. trajectory polylines
                                   5. anomaly epoch dot  (on top of lines)
                                   6. warning flag glyph (top-left corner)
                            -->
                            <Canvas Grid.Column="1"
                                    Width="560" Height="130"
                                    Background="#08FFFFFF">

                                <!-- ── Drift zone tint ─────────────────────────────────────────
                                     Amber wash when active drift observations exist.
                                     Signals that the "without action" trajectory may be
                                     underestimating ongoing degradation.
                                ──────────────────────────────────────────────────────────── -->
                                <Rectangle Canvas.Left="0" Canvas.Top="0"
                                           Width="560" Height="130"
                                           Fill="#08F59E0B"
                                           Visibility="{Binding DriftOverlayVisibility}" />

                                <!-- ── Confidence band ─────────────────────────────────────────
                                     Semi-transparent rectangle spanning the uncertainty envelope
                                     around the chart mid-line.  Height shrinks as confidence
                                     rises; at 100% confidence it collapses to 0 height.
                                ──────────────────────────────────────────────────────────── -->
                                <Rectangle Canvas.Left="0"
                                           Canvas.Top="{Binding ConfidenceBandTop}"
                                           Width="560"
                                           Height="{Binding ConfidenceBandHeight}"
                                           Fill="#0AFFFFFF"
                                           Visibility="{Binding ConfidenceBandVisibility}" />

                                <!-- Horizontal grid lines at 75%, 50%, 25% -->
                                <Line X1="0" Y1="32" X2="560" Y2="32"
                                      Stroke="#12FFFFFF" StrokeThickness="1" />
                                <Line X1="0" Y1="65" X2="560" Y2="65"
                                      Stroke="#18FFFFFF" StrokeThickness="1" />
                                <Line X1="0" Y1="97" X2="560" Y2="97"
                                      Stroke="#12FFFFFF" StrokeThickness="1" />

                                <!-- Without action branch (dashed red) — drawn first so blue is on top -->
                                <Polyline Points="{Binding WithoutActionPoints}"
                                          Stroke="#EF4444"
                                          StrokeThickness="2"
                                          StrokeDashArray="6,3"
                                          StrokeLineJoin="Round" />

                                <!-- With action branch (solid blue) -->
                                <Polyline Points="{Binding WithActionPoints}"
                                          Stroke="#60A5FA"
                                          StrokeThickness="2.5"
                                          StrokeLineJoin="Round" />

                                <!-- ── Anomaly epoch dot ────────────────────────────────────────
                                     A red dot at the left edge of the chart marks the current
                                     machine RAM level.  Appears only when active anomalies exist,
                                     anchoring the viewer's sense of "where the machine is now"
                                     relative to both projected trajectories.
                                     Y is set from ViewModel.AnomalyDotY (live RAM → canvas Y).
                                ──────────────────────────────────────────────────────────── -->
                                <!-- Soft halo — larger semi-transparent disc behind the dot -->
                                <Ellipse Width="14" Height="14"
                                         Fill="#30F87171"
                                         Canvas.Left="0"
                                         Canvas.Top="{Binding AnomalyDotY}"
                                         Visibility="{Binding AnomalyDotVisibility}" />
                                <!-- Solid centre dot -->
                                <Ellipse Width="8" Height="8"
                                         Fill="#F87171"
                                         Canvas.Left="3"
                                         Canvas.Top="{Binding AnomalyDotY}"
                                         Visibility="{Binding AnomalyDotVisibility}" />

                                <!-- ── Warning flag ────────────────────────────────────────────
                                     Amber warning indicator at top-left corner of the chart.
                                     Visible whenever active early warnings exist that are
                                     relevant to the current machine state.
                                ──────────────────────────────────────────────────────────── -->
                                <TextBlock Text="&#xE7BA;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="11"
                                           Foreground="#FBBF24"
                                           Canvas.Left="6"
                                           Canvas.Top="5"
                                           Visibility="{Binding WarningFlagVisibility}" />

                            </Canvas>
                        </Grid>

                        <!-- X-axis time labels -->
                        <Grid MaxWidth="588" HorizontalAlignment="Left"
                              Margin="28,0,0,0">
                            <TextBlock Text="Now"
                                       Style="{StaticResource CaptionTextStyle}"
                                       HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding HorizonLabel}"
                                       Style="{StaticResource CaptionTextStyle}"
                                       HorizontalAlignment="Right" />
                        </Grid>

                        <!-- Branch divergence summary -->
                        <Border Background="#0A000000" CornerRadius="8" Padding="12,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE9CE;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="12"
                                          Foreground="{StaticResource MutedTextBrush}"
                                          VerticalAlignment="Top"
                                          Margin="0,1,0,0" />
                                <TextBlock Text="{Binding DivergenceSummary}"
                                           Style="{StaticResource CaptionTextStyle}"
                                           TextWrapping="Wrap"
                                           MaxWidth="600" />
                            </StackPanel>
                        </Border>

                        <!-- ── Intelligence Context Panel ──────────────────────────────
                             Shown when active anomalies, drifts, or warnings exist.
                             Each signal explains WHY the current machine state may cause
                             the simulation's projections to differ from baseline behaviour.

                             Legend items above the chart already show the visual encoding;
                             this panel explains the underlying intelligence context.
                        ──────────────────────────────────────────────────────────────── -->
                        <Border Visibility="{Binding IntelligenceContextVisibility}"
                                Background="#0AFFFFFF"
                                BorderBrush="#20FBBF24"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,12">
                            <StackPanel Spacing="10">

                                <!-- Header row -->
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE946;"
                                              FontFamily="Segoe MDL2 Assets"
                                              FontSize="12"
                                              Foreground="#FBBF24"
                                              VerticalAlignment="Center" />
                                    <TextBlock Text="ACTIVE INTELLIGENCE SIGNALS"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               CharacterSpacing="80"
                                               Foreground="#FBBF24"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Subtitle: count summary -->
                                <TextBlock Text="{Binding IntelligenceContextLabel}"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,-4,0,0" />

                                <!-- Signal rows — one per anomaly / drift / warning item -->
                                <ItemsRepeater ItemsSource="{Binding IntelligenceContextItems}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Spacing="8" Orientation="Vertical" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Icon badge -->
                                                <Border Width="28" Height="28"
                                                        CornerRadius="6"
                                                        Background="{Binding BadgeColor}"
                                                        VerticalAlignment="Top">
                                                    <FontIcon Glyph="{Binding Glyph}"
                                                              FontFamily="Segoe MDL2 Assets"
                                                              FontSize="12"
                                                              Foreground="{Binding Color}"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                                </Border>

                                                <!-- Label + description -->
                                                <StackPanel Grid.Column="1"
                                                            Spacing="2"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Label}"
                                                               FontFamily="Segoe UI Variable"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding Color}" />
                                                    <TextBlock Text="{Binding Description}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               TextWrapping="Wrap"
                                                               MaxLines="2" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>

                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════════════════════════
                     8. OPERATIONAL RISK VIEW
                ═══════════════════════════════════════════════════════════ -->
                <Border Background="{StaticResource AppSurfaceBrush}"
                        CornerRadius="12" Padding="24,20">
                    <StackPanel Spacing="14">

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE7BA;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="18"
                                      Foreground="{Binding RiskColor}" />
                            <TextBlock Text="Operational Risk"
                                       Style="{StaticResource SectionTitleStyle}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Risk stats row -->
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border CornerRadius="8" Padding="12,10"
                                    Background="#0A000000">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Risk level"
                                               Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock Text="{Binding RiskLevel}"
                                               FontWeight="SemiBold" FontSize="15"
                                               Foreground="{Binding RiskColor}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" CornerRadius="8" Padding="12,10"
                                    Background="#0A000000">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Recurrence likelihood"
                                               Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock Text="{Binding RecurrencePercent}"
                                               FontWeight="SemiBold" FontSize="15"
                                               Foreground="{StaticResource PrimaryTextBrush}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" CornerRadius="8" Padding="12,10"
                                    Background="#0A000000">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Reversible"
                                               Style="{StaticResource CaptionTextStyle}" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="{Binding RiskGlyph}"
                                                  FontFamily="Segoe MDL2 Assets"
                                                  FontSize="14"
                                                  Foreground="{Binding RiskColor}" />
                                        <TextBlock Text="Yes"
                                                   Visibility="{Binding ReversibleBadgeVisibility}"
                                                   FontWeight="SemiBold" FontSize="14"
                                                   Foreground="#34D399"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Risk factors -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Risk factors"
                                       Style="{StaticResource CaptionTextStyle}"
                                       FontWeight="SemiBold" />
                            <ItemsRepeater ItemsSource="{Binding RiskFactors}">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate                                    >
                                        <StackPanel x:ConnectionId='34' Orientation="Horizontal" Spacing="8" Padding="0,3">
                                            <FontIcon Glyph="&#xE7BA;" FontFamily="Segoe MDL2 Assets"
                                                      FontSize="11" Foreground="#EF4444"
                                                      VerticalAlignment="Top" Margin="0,2,0,0" />
                                            <TextBlock x:ConnectionId='35'                     
                                                       Style="{StaticResource BodyTextStyle}"
                                                       TextWrapping="Wrap" MaxWidth="500" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>

                        <!-- Mitigations -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Mitigations"
                                       Style="{StaticResource CaptionTextStyle}"
                                       FontWeight="SemiBold" />
                            <ItemsRepeater ItemsSource="{Binding Mitigations}">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate                      >
                                        <StackPanel x:ConnectionId='31' Orientation="Horizontal" Spacing="8" Padding="0,3">
                                            <FontIcon Glyph="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                                      FontSize="11" Foreground="#34D399"
                                                      VerticalAlignment="Top" Margin="0,2,0,0" />
                                            <TextBlock x:ConnectionId='32'                
                                                       Style="{StaticResource BodyTextStyle}"
                                                       TextWrapping="Wrap" MaxWidth="500" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════════════════════════
                     9. HISTORICAL BASIS
                ═══════════════════════════════════════════════════════════ -->
                <Border Background="{StaticResource AppSurfaceBrush}"
                        CornerRadius="12" Padding="24,20">
                    <StackPanel Spacing="12">

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE9D9;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="18"
                                      Foreground="{StaticResource AccentBlueBrush}" />
                            <TextBlock Text="Historical Basis"
                                       Style="{StaticResource SectionTitleStyle}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="These data sources informed the simulation estimate. More data improves confidence."
                                   Style="{StaticResource BodyTextStyle}"
                                   TextWrapping="Wrap" />

                        <!-- Confidence breakdown -->
                        <TextBlock Text="{Binding ConfidenceExplanation}"
                                   Style="{StaticResource BodyTextStyle}"
                                   TextWrapping="Wrap" />

                        <!-- Confidence factors -->
                        <ItemsRepeater ItemsSource="{Binding ConfidenceFactors}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate                      >
                                    <StackPanel x:ConnectionId='28' Orientation="Horizontal" Spacing="8" Padding="0,3">
                                        <FontIcon Glyph="&#xE9CE;" FontFamily="Segoe MDL2 Assets"
                                                  FontSize="11" Foreground="{StaticResource AccentBlueBrush}"
                                                  VerticalAlignment="Top" Margin="0,2,0,0" />
                                        <TextBlock x:ConnectionId='29'                
                                                   Style="{StaticResource BodyTextStyle}"
                                                   TextWrapping="Wrap" MaxWidth="500" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <!-- Data source cards -->
                        <ItemsRepeater ItemsSource="{Binding HistoricalBasis}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate                                              >
                                    <Border x:ConnectionId='23' Padding="12,10" CornerRadius="8"
                                            Background="#0A000000"
                                            Margin="0,0,0,6">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock x:ConnectionId='25'                           
                                                           FontWeight="SemiBold" FontSize="12"
                                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                                <TextBlock x:ConnectionId='26'                            
                                                           Style="{StaticResource CaptionTextStyle}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBlock x:ConnectionId='24' Grid.Column="1"
                                                                                   
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

            </StackPanel>
            <!-- End ResultVisibility -->

            <!-- ═══════════════════════════════════════════════════════════════
                 SIMULATION HISTORY
                 Shown outside ResultVisibility — persists across simulation runs
                 and restores from disk on every page visit.
            ═══════════════════════════════════════════════════════════════ -->
            <Border Visibility="{Binding HistoryVisibility}"
                    Background="{StaticResource AppSurfaceBrush}"
                    CornerRadius="12" Padding="24,20">
                <StackPanel Spacing="12">

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE9D9;" FontFamily="Segoe MDL2 Assets"
                                  FontSize="18"
                                  Foreground="{StaticResource AccentBlueBrush}" />
                        <TextBlock Text="Simulation History"
                                   Style="{StaticResource SectionTitleStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="Previous simulation results from this session and earlier visits."
                               Style="{StaticResource BodyTextStyle}"
                               TextWrapping="Wrap" />

                    <ItemsRepeater ItemsSource="{Binding SnapshotHistory}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate                                            >
                                <Border x:ConnectionId='12' Background="#0A000000" CornerRadius="8"
                                        Padding="12,10" Margin="0,0,0,5">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: scenario + headline + deltas -->
                                        <StackPanel Spacing="3">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock x:ConnectionId='20'                              
                                                           FontWeight="SemiBold" FontSize="13"
                                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                                <Border Background="#0A000000" CornerRadius="10"
                                                        Padding="7,2">
                                                    <TextBlock x:ConnectionId='21'                              
                                                               FontSize="11" FontWeight="SemiBold"
                                                                                                   />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock x:ConnectionId='17'                                
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       TextWrapping="Wrap" MaxWidth="460" />
                                            <StackPanel Orientation="Horizontal" Spacing="8"
                                                        Margin="0,2,0,0">
                                                <TextBlock x:ConnectionId='18'                              
                                                           FontSize="11" FontWeight="SemiBold"
                                                                                               />
                                                <TextBlock Text="RAM"
                                                           Style="{StaticResource CaptionTextStyle}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock x:ConnectionId='19'                              
                                                           FontSize="11" FontWeight="SemiBold"
                                                                                               />
                                                <TextBlock Text="CPU"
                                                           Style="{StaticResource CaptionTextStyle}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Right: time ago + confidence tier + accuracy badge -->
                                        <StackPanel Grid.Column="1" Spacing="3"
                                                    HorizontalAlignment="Right">
                                            <TextBlock x:ConnectionId='13'                        
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       HorizontalAlignment="Right" />
                                            <TextBlock x:ConnectionId='14'                                    
                                                       FontSize="11" FontWeight="SemiBold"
                                                                                                
                                                       HorizontalAlignment="Right" />
                                            <!-- Accuracy badge — only visible once measurement window elapses -->
                                            <Border x:ConnectionId='15'                                         
                                                    Background="#0A000000"
                                                    CornerRadius="8" Padding="6,2"
                                                    HorizontalAlignment="Right">
                                                <TextBlock x:ConnectionId='16'                              
                                                           FontSize="10" FontWeight="SemiBold"
                                                                                               />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════
                 SCENARIO COMPARISON
                 One-tap batch run of all 6 presets, compared side-by-side.
            ═══════════════════════════════════════════════════════════════ -->
            <Border Background="{StaticResource AppSurfaceBrush}"
                    CornerRadius="12" Padding="24,20">
                <StackPanel Spacing="14">

                    <!-- Header row: title + button -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="2">
                            <TextBlock Text="Compare All Scenarios"
                                       Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Run all 6 preset scenarios at once and compare projected outcomes side-by-side."
                                       Style="{StaticResource BodyTextStyle}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Command="{Binding RunComparisonCommand}"
                                VerticalAlignment="Center"
                                Padding="12,8" CornerRadius="8">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <ProgressRing IsActive="True"
                                              Visibility="{Binding ComparingVisibility}"
                                              Width="14" Height="14"
                                              VerticalAlignment="Center" />
                                <TextBlock Text="Compare All" FontSize="13" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Loading indicator -->
                    <TextBlock Visibility="{Binding ComparingVisibility}"
                               Text="Running all 6 scenario projections — this takes a few seconds…"
                               Style="{StaticResource CaptionTextStyle}" />

                    <!-- Comparison table -->
                    <StackPanel Visibility="{Binding ComparisonVisibility}" Spacing="0">

                        <!-- Column header row -->
                        <Grid Padding="12,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Scenario"
                                       Style="{StaticResource CaptionTextStyle}"
                                       FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="RAM Δ"
                                       Style="{StaticResource CaptionTextStyle}"
                                       FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="CPU Δ"
                                       Style="{StaticResource CaptionTextStyle}"
                                       FontWeight="SemiBold" />
                            <TextBlock Grid.Column="3" Text="Assessment"
                                       Style="{StaticResource CaptionTextStyle}"
                                       FontWeight="SemiBold" />
                            <TextBlock Grid.Column="4" Text="Confidence"
                                       Style="{StaticResource CaptionTextStyle}"
                                       FontWeight="SemiBold" />
                            <TextBlock Grid.Column="5" Text="Horizon"
                                       Style="{StaticResource CaptionTextStyle}"
                                       FontWeight="SemiBold" />
                        </Grid>

                        <!-- Data rows -->
                        <ItemsRepeater ItemsSource="{Binding ComparisonRows}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate                                       >
                                    <Border x:ConnectionId='4' Background="#05FFFFFF" CornerRadius="6"
                                            Padding="12,9" Margin="0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="72" />
                                                <ColumnDefinition Width="72" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="60" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:ConnectionId='5'                              
                                                       FontWeight="SemiBold" FontSize="12"
                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock x:ConnectionId='6' Grid.Column="1"
                                                                                
                                                       FontSize="12" FontWeight="SemiBold"
                                                                                     
                                                       VerticalAlignment="Center" />
                                            <TextBlock x:ConnectionId='7' Grid.Column="2"
                                                                                
                                                       FontSize="12" FontWeight="SemiBold"
                                                                                     
                                                       VerticalAlignment="Center" />
                                            <TextBlock x:ConnectionId='8' Grid.Column="3"
                                                                                
                                                       FontSize="12" FontWeight="SemiBold"
                                                                                      
                                                       VerticalAlignment="Center" />
                                            <TextBlock x:ConnectionId='9' Grid.Column="4"
                                                                                      
                                                       FontSize="11"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock x:ConnectionId='10' Grid.Column="5"
                                                                                   
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════
                 10. PRIVACY FOOTER
            ═══════════════════════════════════════════════════════════════ -->
            <Border Background="{StaticResource AppSurfaceBrush}"
                    CornerRadius="12" Padding="20,16">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE72E;"
                              FontFamily="Segoe MDL2 Assets"
                              FontSize="16"
                              Foreground="{StaticResource MutedTextBrush}"
                              VerticalAlignment="Center" />
                    <TextBlock TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextStyle}"
                               VerticalAlignment="Center">
                        All simulations run locally using your machine's operational history. No data leaves your device. Simulations are read-only estimates — they never apply changes or modify your system.
                    </TextBlock>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>

