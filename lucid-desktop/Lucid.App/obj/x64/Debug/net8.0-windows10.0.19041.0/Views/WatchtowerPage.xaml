<Page
    x:Class="Lucid.Views.WatchtowerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Lucid.Views"
    xmlns:vm="using:Lucid.ViewModels"
    Background="{StaticResource AppBackgroundBrush}">

    <!--
        WatchtowerPage.xaml — Autonomous Operational Watchtower
        ═══════════════════════════════════════════════════════════════════════
        Proactive operational guardianship: early warnings, drift analysis,
        stability forecasts, and maintenance planning.

        The Watchtower ONLY observes, suggests, and forecasts.
        It NEVER auto-remediates or generates fear-based copy.

        Sections (top to bottom):
          1. Page header + Refresh button
          2. Loading indicator
          3. Cold-start / no-data placeholder
          4. Insufficient history notice
          5. Stability Outlook headline
          6. Early Warning Center (alerts)
          7. Operational Drift (metric trends)
          8. Stability Forecasts
          9. Maintenance Planning
         10. Intervention Suggestions

        All content binds via DataContext = WatchtowerViewModel.
        No XAML converters — Visibility properties exposed from ViewModel.
    -->

    <ScrollViewer x:ConnectionId='2' x:Name="RootScrollViewer"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32,32,32,56" Spacing="24">

            <!-- ═══════════════════════════════════════════════════════════════
                 1. PAGE HEADER
            ═══════════════════════════════════════════════════════════════ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock Text="Operational Watchtower"
                               Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Proactive pattern detection, stability forecasting, and maintenance planning — all local, all private"
                               Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>

                <Button Grid.Column="1"
                        Command="{Binding RefreshCommand}"
                        VerticalAlignment="Center"
                        Padding="14,8"
                        CornerRadius="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                        <TextBlock Text="Refresh" FontSize="13" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════════
                 2. LOADING INDICATOR
            ═══════════════════════════════════════════════════════════════ -->
            <Border Visibility="{Binding LoadingVisibility}"
                    Background="{StaticResource AppSurfaceBrush}"
                    CornerRadius="12" Padding="20,16">
                <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center">
                    <ProgressRing IsActive="True" Width="20" Height="20" />
                    <TextBlock Text="Running watchtower analysis…"
                               VerticalAlignment="Center"
                               Style="{StaticResource BodyTextStyle}" />
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════
                 3. NO-DATA PLACEHOLDER
            ═══════════════════════════════════════════════════════════════ -->
            <Border Visibility="{Binding NoDataVisibility}"
                    Background="{StaticResource AppSurfaceBrush}"
                    CornerRadius="12" Padding="40,36">
                <StackPanel HorizontalAlignment="Center" Spacing="12">
                    <FontIcon Glyph="&#xE7B7;"
                              FontFamily="Segoe MDL2 Assets"
                              FontSize="36"
                              Foreground="{StaticResource MutedTextBrush}"
                              HorizontalAlignment="Center" />
                    <TextBlock Text="Watchtower is initialising"
                               Style="{StaticResource SectionTitleStyle}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Click Refresh to run the first analysis pass."
                               Style="{StaticResource BodyTextStyle}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════
                 4. INSUFFICIENT HISTORY NOTICE
            ═══════════════════════════════════════════════════════════════ -->
            <Border Visibility="{Binding InsufficientHistoryVisibility}"
                    Background="{StaticResource AppSurfaceBrush}"
                    CornerRadius="12" Padding="24,20"
                    BorderBrush="{StaticResource AccentBlueBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE9CE;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="18"
                                  Foreground="{StaticResource AccentBlueBrush}" />
                        <TextBlock Text="Building operational baseline"
                                   Style="{StaticResource SectionTitleStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="The Watchtower needs at least a few days of telemetry data before it can produce reliable early warnings and forecasts. Keep Lucid running and check back soon."
                               Style="{StaticResource BodyTextStyle}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding OutlookNarrative}"
                               Style="{StaticResource CaptionTextStyle}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Content sections — only shown when sufficient history exists -->
            <StackPanel Visibility="{Binding SufficientHistoryVisibility}" Spacing="24">

                <!-- ═══════════════════════════════════════════════════════════
                     5. STABILITY OUTLOOK HEADLINE
                ═══════════════════════════════════════════════════════════ -->
                <Border Background="{StaticResource AppSurfaceBrush}"
                        CornerRadius="12" Padding="24,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Icon -->
                        <Border Grid.Column="0"
                                Width="52" Height="52"
                                CornerRadius="26"
                                Background="{StaticResource AppBackgroundBrush}"
                                Margin="0,0,16,0">
                            <FontIcon Glyph="&#xE7B7;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="22"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Foreground="{StaticResource AccentBlueBrush}" />
                        </Border>

                        <!-- Narrative -->
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="Stability Outlook"
                                       Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="{Binding OutlookNarrative}"
                                       Style="{StaticResource BodyTextStyle}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding LastComputedText}"
                                       Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>

                        <!-- Score badge -->
                        <Border Grid.Column="2"
                                CornerRadius="10"
                                Padding="14,8"
                                Margin="16,0,0,0"
                                Background="{StaticResource AppBackgroundBrush}"
                                VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center" Spacing="2">
                                <TextBlock Text="{Binding OutlookScore}"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center">
                                    <TextBlock.Foreground>
                                        <SolidColorBrush Color="{Binding OutlookColor}" />
                                    </TextBlock.Foreground>
                                </TextBlock>
                                <TextBlock Text="{Binding OutlookLabel}"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ═══════════════════════════════════════════════════════════
                     6. EARLY WARNING CENTER
                ═══════════════════════════════════════════════════════════ -->
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="2">
                            <TextBlock Text="Early Warning Center"
                                       Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Patterns detected from your operational history"
                                       Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>

                        <Border Grid.Column="1"
                                CornerRadius="10"
                                Padding="10,4"
                                Background="{StaticResource AppSurfaceBrush}"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding AlertsSummaryText}"
                                       Style="{StaticResource CaptionTextStyle}" />
                        </Border>
                    </Grid>

                    <!-- No alerts -->
                    <Border Visibility="{Binding NoAlertsVisibility}"
                            Background="{StaticResource AppSurfaceBrush}"
                            CornerRadius="10" Padding="20,16">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE930;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="16"
                                      Foreground="#34D399" />
                            <TextBlock Text="No patterns detected — system appears to be operating normally."
                                       Style="{StaticResource BodyTextStyle}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Alert cards -->
                    <ItemsControl Visibility="{Binding AlertsListVisibility}"
                                  ItemsSource="{Binding Alerts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate                                   >
                                <Border x:ConnectionId='40' Background="{StaticResource AppSurfaceBrush}"
                                        CornerRadius="10" Padding="18,14"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Severity accent bar -->
                                        <Border Grid.Column="0"
                                                CornerRadius="2"
                                                Margin="0,0,14,0">
                                            <Border.Background>
                                                <SolidColorBrush x:ConnectionId='49'                              />
                                            </Border.Background>
                                        </Border>

                                        <!-- Content -->
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock x:ConnectionId='44'                      
                                                       Style="{StaticResource CardTitleStyle}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock x:ConnectionId='45'                            
                                                       Style="{StaticResource BodyTextStyle}"
                                                       TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                                                <TextBlock x:ConnectionId='47'                               
                                                           Style="{StaticResource CaptionTextStyle}" />
                                                <TextBlock x:ConnectionId='48'                         
                                                           Style="{StaticResource CaptionTextStyle}" />
                                            </StackPanel>
                                            <TextBlock x:ConnectionId='46'                           
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       Foreground="{StaticResource AccentBlueBrush}"
                                                                                                     />
                                        </StackPanel>

                                        <!-- Severity badge -->
                                        <Border Grid.Column="2"
                                                CornerRadius="6"
                                                Padding="8,4"
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Top">
                                            <Border.Background>
                                                <SolidColorBrush x:ConnectionId='41'                               
                                                                 Opacity="0.15" />
                                            </Border.Background>
                                            <TextBlock x:ConnectionId='42'                              
                                                       FontSize="11"
                                                       FontWeight="SemiBold">
                                                <TextBlock.Foreground>
                                                    <SolidColorBrush x:ConnectionId='43'                                />
                                                </TextBlock.Foreground>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ═══════════════════════════════════════════════════════════
                     7. OPERATIONAL DRIFT
                ═══════════════════════════════════════════════════════════ -->
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Operational Drift"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="How key metrics have shifted over time (7-day vs 30-day averages)"
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>

                    <Border Visibility="{Binding NoDriftVisibility}"
                            Background="{StaticResource AppSurfaceBrush}"
                            CornerRadius="10" Padding="20,16">
                        <TextBlock Text="Insufficient historical data to compute drift."
                                   Style="{StaticResource BodyTextStyle}" />
                    </Border>

                    <Border Visibility="{Binding DriftListVisibility}"
                            Background="{StaticResource AppSurfaceBrush}"
                            CornerRadius="10" Padding="0,4">
                        <ItemsControl ItemsSource="{Binding DriftRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate                                  >
                                    <Grid x:ConnectionId='31' Padding="18,12" MinHeight="52">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <FontIcon x:ConnectionId='32' Grid.Column="0"
                                                                        
                                                  FontFamily="Segoe MDL2 Assets"
                                                  FontSize="14"
                                                  Foreground="{StaticResource MutedTextBrush}" />

                                        <TextBlock x:ConnectionId='33' Grid.Column="1"
                                                                             
                                                   Style="{StaticResource BodyTextStyle}"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold" />

                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    Spacing="16"
                                                    VerticalAlignment="Center">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="7-day" Style="{StaticResource CaptionTextStyle}" />
                                                <TextBlock x:ConnectionId='38'                             
                                                           Style="{StaticResource BodyTextStyle}"
                                                           FontSize="12" />
                                            </StackPanel>
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="30-day" Style="{StaticResource CaptionTextStyle}" />
                                                <TextBlock x:ConnectionId='37'                              
                                                           Style="{StaticResource BodyTextStyle}"
                                                           FontSize="12" />
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock x:ConnectionId='34' Grid.Column="3"
                                                                             
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0">
                                            <TextBlock.Foreground>
                                                <SolidColorBrush x:ConnectionId='36'                             />
                                            </TextBlock.Foreground>
                                        </TextBlock>

                                        <TextBlock x:ConnectionId='35' Grid.Column="4"
                                                                                        
                                                   FontSize="10"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource AccentBlueBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>

                <!-- ═══════════════════════════════════════════════════════════
                     8. STABILITY FORECASTS
                ═══════════════════════════════════════════════════════════ -->
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Stability Forecasts"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Forward-looking projections based on current trends — not predictions, just patterns"
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>

                    <Border Visibility="{Binding NoForecastsVisibility}"
                            Background="{StaticResource AppSurfaceBrush}"
                            CornerRadius="10" Padding="20,16">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE930;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="16"
                                      Foreground="#34D399" />
                            <TextBlock Text="No stability risks projected from current trends."
                                       Style="{StaticResource BodyTextStyle}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <ItemsControl Visibility="{Binding ForecastsListVisibility}"
                                  ItemsSource="{Binding Forecasts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate                                      >
                                <Border x:ConnectionId='22' Background="{StaticResource AppSurfaceBrush}"
                                        CornerRadius="10" Padding="18,14"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock x:ConnectionId='26'                      
                                                       Style="{StaticResource CardTitleStyle}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock x:ConnectionId='27'                            
                                                       Style="{StaticResource BodyTextStyle}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock x:ConnectionId='28'                            
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock x:ConnectionId='29'                               
                                                       Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                                    Margin="16,0,0,0"
                                                    VerticalAlignment="Top"
                                                    HorizontalAlignment="Center"
                                                    Spacing="4">
                                            <TextBlock x:ConnectionId='23'                              
                                                       FontSize="18"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center">
                                                <TextBlock.Foreground>
                                                    <SolidColorBrush x:ConnectionId='25'                            />
                                                </TextBlock.Foreground>
                                            </TextBlock>
                                            <TextBlock Text="risk"
                                                       FontSize="10"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock x:ConnectionId='24'                                 
                                                       FontSize="10"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{StaticResource MutedTextBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ═══════════════════════════════════════════════════════════
                     9. MAINTENANCE PLANNING
                ═══════════════════════════════════════════════════════════ -->
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Maintenance Planning"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Suggested maintenance actions based on usage patterns and system state"
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>

                    <Border Visibility="{Binding NoMaintenanceVisibility}"
                            Background="{StaticResource AppSurfaceBrush}"
                            CornerRadius="10" Padding="20,16">
                        <TextBlock Text="No maintenance recommendations at this time."
                                   Style="{StaticResource BodyTextStyle}" />
                    </Border>

                    <ItemsControl Visibility="{Binding MaintenanceListVisibility}"
                                  ItemsSource="{Binding Maintenance}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate                                         >
                                <Border x:ConnectionId='12' Background="{StaticResource AppSurfaceBrush}"
                                        CornerRadius="10" Padding="18,14"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <FontIcon x:ConnectionId='13' Grid.Column="0"
                                                                                
                                                  FontFamily="Segoe MDL2 Assets"
                                                  FontSize="16"
                                                  Margin="0,0,14,0"
                                                  VerticalAlignment="Top">
                                            <FontIcon.Foreground>
                                                <SolidColorBrush x:ConnectionId='20'                                />
                                            </FontIcon.Foreground>
                                        </FontIcon>

                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock x:ConnectionId='17'                      
                                                       Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock x:ConnectionId='18'                          
                                                       Style="{StaticResource BodyTextStyle}"
                                                       TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                                                <FontIcon Glyph="&#xE917;"
                                                          FontFamily="Segoe MDL2 Assets"
                                                          FontSize="11"
                                                          Foreground="{StaticResource MutedTextBrush}" />
                                                <TextBlock x:ConnectionId='19'                           
                                                           Style="{StaticResource CaptionTextStyle}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <Border Grid.Column="2"
                                                CornerRadius="6"
                                                Padding="8,4"
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Top">
                                            <Border.Background>
                                                <SolidColorBrush x:ConnectionId='14'                               
                                                                 Opacity="0.15" />
                                            </Border.Background>
                                            <TextBlock x:ConnectionId='15'                              
                                                       FontSize="11"
                                                       FontWeight="SemiBold">
                                                <TextBlock.Foreground>
                                                    <SolidColorBrush x:ConnectionId='16'                                />
                                                </TextBlock.Foreground>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ═══════════════════════════════════════════════════════════
                     10. INTERVENTION SUGGESTIONS
                ═══════════════════════════════════════════════════════════ -->
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Suggested Actions"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Ranked suggestions based on active patterns and what has helped this machine before"
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>

                    <Border Visibility="{Binding NoInterventionsVisibility}"
                            Background="{StaticResource AppSurfaceBrush}"
                            CornerRadius="10" Padding="20,16">
                        <TextBlock Text="No intervention suggestions at this time."
                                   Style="{StaticResource BodyTextStyle}" />
                    </Border>

                    <ItemsControl Visibility="{Binding InterventionsListVisibility}"
                                  ItemsSource="{Binding Interventions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate                                          >
                                <Border x:ConnectionId='4' Background="{StaticResource AppSurfaceBrush}"
                                        CornerRadius="10" Padding="18,14"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Priority badge -->
                                        <Border Grid.Column="0"
                                                Width="32" Height="32"
                                                CornerRadius="16"
                                                Background="{StaticResource AppBackgroundBrush}"
                                                Margin="0,0,14,0"
                                                VerticalAlignment="Top">
                                            <TextBlock x:ConnectionId='10'                              
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource AccentBlueBrush}" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock x:ConnectionId='5'                      
                                                       Style="{StaticResource CardTitleStyle}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock x:ConnectionId='6'                          
                                                       Style="{StaticResource BodyTextStyle}"
                                                       TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                                                <TextBlock x:ConnectionId='7'                                   
                                                           FontSize="11"
                                                           FontWeight="SemiBold">
                                                    <TextBlock.Foreground>
                                                        <SolidColorBrush x:ConnectionId='9'                                     />
                                                    </TextBlock.Foreground>
                                                </TextBlock>
                                                <TextBlock x:ConnectionId='8'                               
                                                           Style="{StaticResource CaptionTextStyle}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <FontIcon Grid.Column="2"
                                                  Glyph="&#xE76C;"
                                                  FontFamily="Segoe MDL2 Assets"
                                                  FontSize="14"
                                                  Foreground="{StaticResource MutedTextBrush}"
                                                  Margin="12,0,0,0"
                                                  VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ═══════════════════════════════════════════════════════════
                     PRIVACY STATEMENT
                ═══════════════════════════════════════════════════════════ -->
                <Border Background="{StaticResource AppSurfaceBrush}"
                        CornerRadius="10" Padding="18,14">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72E;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="13"
                                      Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Text="Fully local analysis"
                                       Style="{StaticResource CaptionTextStyle}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="All Watchtower analysis runs entirely on this device. No operational data, alerts, or forecasts are transmitted anywhere. Everything you see here is computed from your local operational database."
                                   Style="{StaticResource CaptionTextStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

            </StackPanel>
            <!-- /SufficientHistoryVisibility -->

        </StackPanel>
    </ScrollViewer>
</Page>

