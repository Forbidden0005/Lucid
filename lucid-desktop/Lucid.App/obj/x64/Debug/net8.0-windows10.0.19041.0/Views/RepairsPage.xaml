<Page x:ConnectionId='1'
    x:Class="Lucid.Views.RepairsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Lucid.ViewModels"
    Background="{StaticResource AppBackgroundBrush}"
                        >

    <!--
        RepairsPage.xaml — Repair Center
        Six repair actions, each with live log streaming, dry-run preview,
        elevation awareness, and restart-required warnings.

        Binding model:
          Page → RepairsViewModel (x:Bind, OneWay)
          Cards ListView → RepairCardViewModel list via DataTemplate x:DataType
    -->

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32,32,32,48" Spacing="24">

            <!-- ═══════════════════════════════════════════════════════
                 PAGE HEADER
            ═══════════════════════════════════════════════════════ -->
            <StackPanel Spacing="4">
                <TextBlock Text="Repair Center"
                           Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Safe, transparent wrappers around trusted Windows repair tools"
                           Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>

            <!-- ═══════════════════════════════════════════════════════
                 ELEVATION WARNING BANNER
            ═══════════════════════════════════════════════════════ -->
            <Border x:ConnectionId='2'                                                                        
                    Background="{StaticResource StatusModerateSubtleBrush}"
                    CornerRadius="10" Padding="16,12"
                    BorderBrush="{StaticResource StatusModerateBrush}"
                    BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE7BA;"
                              FontFamily="Segoe MDL2 Assets"
                              FontSize="16"
                              Foreground="{StaticResource StatusModerateBrush}"
                              VerticalAlignment="Center" />
                    <StackPanel Spacing="2">
                        <TextBlock Text="Not running as administrator"
                                   Style="{StaticResource CardTitleStyle}"
                                   Foreground="{StaticResource StatusModerateBrush}" />
                        <TextBlock Text="Repair tools that modify system files require administrator privileges. Re-launch Lucid as administrator to enable them."
                                   Style="{StaticResource CaptionTextStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════
                 REPAIR CARDS
            ═══════════════════════════════════════════════════════ -->
            <ItemsControl x:ConnectionId='3'                                                          >
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="16" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate                                    >
                        <Border x:ConnectionId='5' Style="{StaticResource CardSurface}" Padding="0">
                            <StackPanel>

                                <!-- ── Card header ─────────────────────── -->
                                <Grid Padding="20,18,20,16" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Icon -->
                                    <Border Width="40" Height="40" CornerRadius="8"
                                            Background="{StaticResource StatusInfoSubtleBrush}">
                                        <FontIcon Glyph="&#xE90F;"
                                                  FontFamily="Segoe MDL2 Assets"
                                                  FontSize="18"
                                                  Foreground="{StaticResource AccentBlueBrush}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Name + purpose -->
                                    <StackPanel Grid.Column="1" Spacing="3"
                                                VerticalAlignment="Center">
                                        <TextBlock x:ConnectionId='33'                            
                                                   Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock x:ConnectionId='34'                        
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- Risk badge -->
                                    <Border Grid.Column="2" CornerRadius="6"
                                            Padding="8,4" VerticalAlignment="Top"
                                            Background="{StaticResource AppBackgroundBrush}"
                                            BorderBrush="{StaticResource BorderSubtleBrush}"
                                            BorderThickness="1">
                                        <TextBlock x:ConnectionId='32'                          
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Border>
                                </Grid>

                                <!-- ── Metadata chips ──────────────────── -->
                                <StackPanel Orientation="Horizontal" Spacing="8"
                                            Padding="20,0,20,14">
                                    <!-- Duration -->
                                    <Border Background="{StaticResource AppBackgroundBrush}"
                                            CornerRadius="6" Padding="8,3"
                                            BorderBrush="{StaticResource BorderSubtleBrush}"
                                            BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon Glyph="&#xE916;"
                                                      FontFamily="Segoe MDL2 Assets"
                                                      FontSize="10"
                                                      Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock x:ConnectionId='31'                                 
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Restart required chip -->
                                    <Border x:ConnectionId='26' Background="{StaticResource StatusModerateSubtleBrush}"
                                            CornerRadius="6" Padding="8,3"
                                                                                                  >
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon Glyph="&#xE777;"
                                                      FontFamily="Segoe MDL2 Assets"
                                                      FontSize="10"
                                                      Foreground="{StaticResource StatusModerateBrush}" />
                                            <TextBlock Text="Restart required"
                                                       FontSize="11"
                                                       Foreground="{StaticResource StatusModerateBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Elevation blocked chip -->
                                    <Border x:ConnectionId='27' Background="{StaticResource StatusModerateSubtleBrush}"
                                            CornerRadius="6" Padding="8,3"
                                                                                            >
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon Glyph="&#xE7EF;"
                                                      FontFamily="Segoe MDL2 Assets"
                                                      FontSize="10"
                                                      Foreground="{StaticResource StatusModerateBrush}" />
                                            <TextBlock Text="Needs admin"
                                                       FontSize="11"
                                                       Foreground="{StaticResource StatusModerateBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Effectiveness badge (only visible when IsWarmEnough) -->
                                    <Border x:ConnectionId='28'                                           
                                            CornerRadius="6" Padding="8,3"
                                            Background="{StaticResource AppBackgroundBrush}"
                                            BorderBrush="{StaticResource StatusGoodBrush}"
                                            BorderThickness="1">
                                        <ToolTipService.ToolTip>
                                            <ToolTip x:ConnectionId='29'                                      />
                                        </ToolTipService.ToolTip>
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon Glyph="&#xE930;"
                                                      FontFamily="Segoe MDL2 Assets"
                                                      FontSize="10"
                                                      Foreground="{StaticResource StatusGoodBrush}" />
                                            <TextBlock x:ConnectionId='30'                                   
                                                       FontSize="11"
                                                       Foreground="{StaticResource StatusGoodBrush}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- ── How-it-works (collapsible) ─────── -->
                                <Border x:ConnectionId='6' Padding="20,0,20,12"
                                                                                     >
                                    <Border Background="{StaticResource AppBackgroundBrush}"
                                            CornerRadius="8" Padding="14,10">
                                        <TextBlock x:ConnectionId='25'                           
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                </Border>

                                <!-- ── Restart warning (metadata) ─────── -->
                                <Border x:ConnectionId='7' Padding="20,0,20,12"
                                                                                              >
                                    <Border Background="{StaticResource StatusModerateSubtleBrush}"
                                            CornerRadius="8" Padding="12,8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE7BA;"
                                                      FontFamily="Segoe MDL2 Assets"
                                                      FontSize="13"
                                                      Foreground="{StaticResource StatusModerateBrush}"
                                                      VerticalAlignment="Center" />
                                            <TextBlock TextWrapping="Wrap"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       Foreground="{StaticResource StatusModerateBrush}">
                                                <Run FontWeight="SemiBold" Text="Restart required: " />
                                                <Run x:ConnectionId='24'                               />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </Border>

                                <!-- ── Divider ─────────────────────────── -->
                                <Border Height="1"
                                        Background="{StaticResource BorderSubtleBrush}"
                                        Margin="0,0,0,14" />

                                <!-- ── Button row ──────────────────────── -->
                                <StackPanel Orientation="Horizontal" Spacing="10"
                                            Padding="20,0,20,16">

                                    <!-- Run button -->
                                    <Button x:ConnectionId='18' Style="{StaticResource PrimaryButton}"
                                                                                                  
                                                                         
                                                                               >
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE768;"
                                                      FontFamily="Segoe MDL2 Assets"
                                                      FontSize="13" />
                                            <TextBlock Text="Run" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Preview button -->
                                    <Button x:ConnectionId='19' Style="{StaticResource SecondaryButton}"
                                                                                                      
                                                                             >
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE8FF;"
                                                      FontFamily="Segoe MDL2 Assets"
                                                      FontSize="13" />
                                            <TextBlock Text="Preview" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Cancel button (shown while running) -->
                                    <Button x:ConnectionId='20' Style="{StaticResource SecondaryButton}"
                                                                                                     
                                                                            >
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE711;"
                                                      FontFamily="Segoe MDL2 Assets"
                                                      FontSize="13" />
                                            <TextBlock Text="Cancel" />
                                        </StackPanel>
                                    </Button>

                                    <!-- How it works toggle -->
                                    <Button x:ConnectionId='21' Style="{StaticResource SecondaryButton}"
                                                                                      
                                                                                                  >
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE946;"
                                                      FontFamily="Segoe MDL2 Assets"
                                                      FontSize="13" />
                                            <TextBlock Text="How it works" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Running indicator -->
                                    <StackPanel x:ConnectionId='22' Orientation="Horizontal" Spacing="8"
                                                VerticalAlignment="Center"
                                                                                            >
                                        <ProgressRing x:ConnectionId='23'                                           
                                                      Width="16" Height="16"
                                                      Foreground="{StaticResource AccentBlueBrush}" />
                                        <TextBlock Text="Running…"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- ── Result banner ───────────────────── -->
                                <Border x:ConnectionId='8' Margin="20,0,20,14"
                                        CornerRadius="8" Padding="12,10"
                                                                                                 
                                        Background="{StaticResource StatusGoodSubtleBrush}">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE73E;"
                                                  FontFamily="Segoe MDL2 Assets"
                                                  FontSize="14"
                                                  Foreground="{StaticResource StatusGoodBrush}"
                                                  VerticalAlignment="Center" />
                                        <TextBlock x:ConnectionId='17'                                           
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Foreground="{StaticResource StatusGoodBrush}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- ── Restart required after execution ── -->
                                <Border x:ConnectionId='9' Margin="20,0,20,14"
                                        CornerRadius="8" Padding="12,10"
                                                                                                         
                                        Background="{StaticResource StatusModerateSubtleBrush}"
                                        BorderBrush="{StaticResource StatusModerateBrush}"
                                        BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE777;"
                                                  FontFamily="Segoe MDL2 Assets"
                                                  FontSize="14"
                                                  Foreground="{StaticResource StatusModerateBrush}"
                                                  VerticalAlignment="Center" />
                                        <TextBlock Text="Restart Windows now for this change to take effect."
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Foreground="{StaticResource StatusModerateBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- ── Live log panel ──────────────────── -->
                                <Border x:ConnectionId='10' Margin="20,0,20,16"
                                                                                        
                                        Background="{StaticResource AppBackgroundBrush}"
                                        CornerRadius="8"
                                        MaxHeight="240">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  Padding="12,8">
                                        <ItemsControl x:ConnectionId='11'                                               >
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate                                        >
                                                    <Grid x:ConnectionId='13' ColumnSpacing="8" Margin="0,1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock x:ConnectionId='14'                          
                                                                   FontFamily="Consolas"
                                                                   FontSize="10"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   VerticalAlignment="Top" />
                                                        <TextBlock x:ConnectionId='15' Grid.Column="1"
                                                                                             
                                                                   FontFamily="Consolas"
                                                                   FontSize="10"
                                                                                                   
                                                                   VerticalAlignment="Top" />
                                                        <TextBlock x:ConnectionId='16' Grid.Column="2"
                                                                                          
                                                                   FontFamily="Consolas"
                                                                   FontSize="10"
                                                                                                   
                                                                   TextWrapping="Wrap" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>

                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</Page>

