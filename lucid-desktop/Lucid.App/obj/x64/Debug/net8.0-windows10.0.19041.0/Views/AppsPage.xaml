<Page x:ConnectionId='1'
    x:Class="Lucid.Views.AppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Lucid.ViewModels"
    Background="{StaticResource AppBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32,32,32,48" Spacing="24">

            <!-- ── Header ────────────────────────────────────────────── -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="Apps"
                               Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Installed applications and startup impact"
                               Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>

                <!-- Refresh button -->
                <Button x:ConnectionId='29' Grid.Column="1"
                        Style="{StaticResource SecondaryButton}"
                        VerticalAlignment="Center"
                                                                >
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ── Loading ────────────────────────────────────────────── -->
            <Border x:ConnectionId='2'                                                               
                    Style="{StaticResource CardSurface}" Padding="32">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <ProgressRing IsActive="True"
                                  Width="28" Height="28"
                                  Foreground="{StaticResource AccentBlueBrush}"
                                  HorizontalAlignment="Center" />
                    <TextBlock Text="Scanning installed applications…"
                               Style="{StaticResource CaptionTextStyle}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- ── Content (visible when not loading) ─────────────────── -->
            <StackPanel x:ConnectionId='3'                                                               
                        Spacing="24">

                <!-- Stats bar -->
                <TextBlock x:ConnectionId='4'                                                 
                           Style="{StaticResource CaptionTextStyle}"
                           Foreground="{StaticResource TextSecondaryBrush}" />

                <!-- ── Startup Apps section ──────────────────────────── -->
                <StackPanel x:ConnectionId='5'                                                                      
                            Spacing="12">

                    <TextBlock Text="Launch at Startup"
                               Style="{StaticResource SectionTitleStyle}" />

                    <ItemsControl x:ConnectionId='18'                                                          >
                        <ItemsControl.ItemTemplate>
                            <DataTemplate                                  >
                                <Border x:ConnectionId='20' Style="{StaticResource CardSurface}"
                                        Padding="20,16"
                                        Margin="0,0,0,8"
                                        CornerRadius="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Impact badge -->
                                        <Border x:ConnectionId='21' Grid.Column="0"
                                                                                        
                                                CornerRadius="4"
                                                Padding="8,4"
                                                Margin="0,0,14,0"
                                                VerticalAlignment="Center"
                                                Opacity="0.18" />
                                        <TextBlock x:ConnectionId='22' Grid.Column="0"
                                                                                     
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                                                           
                                                   Margin="8,4,8,4"
                                                   VerticalAlignment="Center" />

                                        <!-- App info -->
                                        <StackPanel Grid.Column="1" Spacing="3"
                                                    VerticalAlignment="Center">
                                            <TextBlock x:ConnectionId='26'                     
                                                       Style="{StaticResource BodyTextStyle}"
                                                       FontWeight="SemiBold" />
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock x:ConnectionId='27'                          
                                                           Style="{StaticResource CaptionTextStyle}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                                                                     />
                                                <TextBlock x:ConnectionId='28'                                    
                                                           Style="{StaticResource CaptionTextStyle}"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Toggle button -->
                                        <Button x:ConnectionId='23' Grid.Column="2"
                                                Style="{StaticResource SecondaryButton}"
                                                                                       
                                                VerticalAlignment="Center"
                                                Margin="12,0,0,0">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock x:ConnectionId='24'                                                
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="12"
                                                           VerticalAlignment="Center" />
                                                <TextBlock x:ConnectionId='25'                                                
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- No startup apps notice -->
                <Border x:ConnectionId='6'                                                                     
                        Style="{StaticResource CardSurface}" Padding="20">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                  FontSize="16" Foreground="{StaticResource SuccessBrush}"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="No apps are registered to launch at startup."
                                   Style="{StaticResource BodyTextStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- ── All Installed Apps section ───────────────────── -->
                <StackPanel x:ConnectionId='7'                                                               
                            Spacing="12">

                    <TextBlock Text="All Installed Apps"
                               Style="{StaticResource SectionTitleStyle}" />

                    <Border Style="{StaticResource CardSurface}"
                            Padding="0"
                            CornerRadius="10">
                        <ListView x:ConnectionId='9'                                                      
                                  SelectionMode="None"
                                  IsItemClickEnabled="False">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="20,14" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate                                  >
                                    <Grid x:ConnectionId='11'>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Name + publisher -->
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock x:ConnectionId='16'                     
                                                       Style="{StaticResource BodyTextStyle}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:ConnectionId='17'                          
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                                                                 />
                                        </StackPanel>

                                        <!-- Startup impact chip (if linked) -->
                                        <Border x:ConnectionId='12' Grid.Column="1"
                                                                                       
                                                Margin="12,0"
                                                VerticalAlignment="Center">
                                            <TextBlock x:ConnectionId='15'                                   
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                                                                />
                                        </Border>

                                        <!-- Install date -->
                                        <TextBlock x:ConnectionId='13' Grid.Column="2"
                                                                                  
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                                       
                                                   VerticalAlignment="Center" />

                                        <!-- Size -->
                                        <TextBlock x:ConnectionId='14' Grid.Column="3"
                                                                           
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                                       
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </StackPanel>

                <!-- No apps at all -->
                <Border x:ConnectionId='8'                                                              
                        Style="{StaticResource CardSurface}" Padding="40">
                    <StackPanel Spacing="12" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE74C;" FontFamily="Segoe MDL2 Assets"
                                  FontSize="36" Foreground="{StaticResource TextSecondaryBrush}"
                                  HorizontalAlignment="Center" />
                        <TextBlock Text="No installed applications found"
                                   Style="{StaticResource SectionTitleStyle}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Could not read the Windows application registry."
                                   Style="{StaticResource CaptionTextStyle}"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   MaxWidth="360" />
                    </StackPanel>
                </Border>

            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>

