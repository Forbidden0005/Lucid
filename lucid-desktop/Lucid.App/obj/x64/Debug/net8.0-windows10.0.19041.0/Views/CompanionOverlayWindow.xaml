<Window x:ConnectionId='1'
    x:Class="Lucid.Views.CompanionOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:companion="using:Lucid.Services.Companion"
    Title="Lucid Companion">

    <!--
        Companion Overlay Window — floats above all other windows.

        Phase 17C upgrades:
          • System messages now show confidence chips, evidence badges,
            uncertainty notes, and suggested navigation action buttons.
          • SendMessage is async — spinner shown while processing.
          • QuickActions collection is dynamic (contextual suggestions injected).
          • SuggestedAction buttons navigate the main window to the target page.

        Layout modes:
          Bubble   (72x72)    — circular icon; tap to expand, drag to reposition
          Expanded (380x600)  — full conversation panel with quick actions

        Architecture:
          • No OS title bar (ExtendsContentIntoTitleBar = true, SetTitleBar(null))
          • All Visibility values are pre-computed strings on the model (no converters)
    -->

    <Grid x:ConnectionId='2' x:Name="RootGrid"
          RequestedTheme="Dark">


        <!-- ══════════════════════════════════════════════════════════════════
             BUBBLE MODE — 72×72 circular floating icon
             Tap: expand to full panel
             Drag: reposition window (handled in code-behind)
        ══════════════════════════════════════════════════════════════════ -->
        <Grid x:ConnectionId='3'                                                              
              Width="72" Height="72"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
                                                        
                                                    
                                                          >

            <!-- Outer glow ring -->
            <Ellipse Width="72" Height="72"
                     Fill="Transparent"
                     Stroke="#2A3A5C"
                     StrokeThickness="1" />

            <!-- Main bubble body -->
            <Border Width="66" Height="66"
                    CornerRadius="33"
                    Background="#1A1A2E"
                    BorderBrush="#3F3F5A"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <Grid>
                    <!-- Companion glyph -->
                    <FontIcon Glyph="&#xE946;"
                              FontFamily="Segoe MDL2 Assets"
                              FontSize="24"
                              Foreground="#4E9FFF"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />

                    <!-- Active indicator dot -->
                    <Ellipse Width="10" Height="10"
                             Fill="#4E9FFF"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Top"
                             Margin="0,8,8,0" />
                </Grid>
            </Border>
        </Grid>


        <!-- ══════════════════════════════════════════════════════════════════
             EXPANDED MODE — 380×600 conversation panel
        ══════════════════════════════════════════════════════════════════ -->
        <Border x:ConnectionId='4'                                                                
                CornerRadius="14"
                Background="#1A1A2E"
                BorderBrush="#3F3F5A"
                BorderThickness="1">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />    <!-- Row 0: Header / drag handle -->
                    <RowDefinition Height="Auto" />  <!-- Row 1: Context strip -->
                    <RowDefinition Height="Auto" />  <!-- Row 2: LLM setup banner -->
                    <RowDefinition Height="*" />     <!-- Row 3: Message list -->
                    <RowDefinition Height="Auto" />  <!-- Row 4: Workflow progress panel -->
                    <RowDefinition Height="Auto" />  <!-- Row 5: Visual consent panel (18B) -->
                    <RowDefinition Height="Auto" />  <!-- Row 6: Quick actions -->
                    <RowDefinition Height="Auto" />  <!-- Row 7: Input area -->
                </Grid.RowDefinitions>

                <!-- ── Header (drag handle + controls) ──────────────────────── -->
                <Grid x:ConnectionId='5' Grid.Row="0"
                      x:Name="ExpandedDragHandle"
                      Background="Transparent"
                      Padding="14,0,8,0"
                                                                
                                                            
                                                                  >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- App icon badge -->
                    <Border Grid.Column="0"
                            Width="24" Height="24"
                            CornerRadius="6"
                            Background="#4E9FFF"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">
                        <FontIcon Glyph="&#xE946;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="12"
                                  Foreground="White"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                    </Border>

                    <!-- Title area -->
                    <StackPanel Grid.Column="1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <TextBlock Text="Operational Companion"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#E4E4F0" />
                        <TextBlock Text="Local · Deterministic · Explainable"
                                   FontSize="10"
                                   Foreground="#6B6B8A" />
                    </StackPanel>

                    <!-- Action buttons -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="2"
                                VerticalAlignment="Center">

                        <!-- Clear conversation -->
                        <Button x:ConnectionId='60' Width="32" Height="32"
                                CornerRadius="8"
                                Background="Transparent"
                                BorderThickness="0"
                                                         
                                ToolTipService.ToolTip="Clear conversation">
                            <FontIcon Glyph="&#xE74D;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="12"
                                      Foreground="#6B6B8A" />
                        </Button>

                        <!-- Collapse to bubble -->
                        <Button x:ConnectionId='61' Width="32" Height="32"
                                CornerRadius="8"
                                Background="Transparent"
                                BorderThickness="0"
                                                            
                                ToolTipService.ToolTip="Minimize to bubble">
                            <FontIcon Glyph="&#xE921;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="12"
                                      Foreground="#6B6B8A" />
                        </Button>

                        <!-- Close / hide -->
                        <Button x:ConnectionId='62' Width="32" Height="32"
                                CornerRadius="8"
                                Background="Transparent"
                                BorderThickness="0"
                                                         
                                ToolTipService.ToolTip="Close companion">
                            <FontIcon Glyph="&#xE8BB;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="12"
                                      Foreground="#6B6B8A" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ── Divider ─────────────────────────────────────────────── -->
                <Border Grid.Row="0"
                        Height="1"
                        Background="#2A2A3E"
                        VerticalAlignment="Bottom"
                        IsHitTestVisible="False" />

                <!-- ── Context strip — passive workflow awareness ─────────────── -->
                <Border x:ConnectionId='6' Grid.Row="1"
                                                                                            
                        Background="#0F1020"
                        BorderBrush="#2A2A3E"
                        BorderThickness="0,0,0,1"
                        Padding="14,6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon x:ConnectionId='58'                                                     
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="11"
                                  Foreground="#4E9FFF" />
                        <TextBlock x:ConnectionId='59'                                                         
                                   FontSize="11"
                                   Foreground="#6B8AA8"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- ── LLM setup banner ─────────────────────────────────────────── -->
                <Border x:ConnectionId='7' Grid.Row="2"
                                                                                          
                        Background="#100D06"
                        BorderBrush="#2E2010"
                        BorderThickness="0,0,0,1"
                        Padding="12,7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Spinner while checking -->
                        <ProgressRing x:ConnectionId='54' Grid.Column="0"
                                                                                                                
                                      Width="14" Height="14"
                                      IsActive="True"
                                      Foreground="#C09030"
                                      Margin="0,0,8,0" />

                        <!-- Warning glyph after a failed check -->
                        <FontIcon x:ConnectionId='55' Grid.Column="0"
                                                                                                         
                                  Glyph="&#xE7BA;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="12"
                                  Foreground="#C09030"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0" />

                        <TextBlock x:ConnectionId='56' Grid.Column="1"
                                                                                         
                                   FontSize="10.5"
                                   Foreground="#A07828"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />

                        <!-- Retry button (shown only when status is known + failed) -->
                        <Button x:ConnectionId='57' Grid.Column="2"
                                                                                                       
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="6,3"
                                Margin="6,0,0,0"
                                                         
                                ToolTipService.ToolTip="Check AI availability again">
                            <FontIcon Glyph="&#xE72C;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="12"
                                      Foreground="#C09030" />
                        </Button>
                    </Grid>
                </Border>

                <!-- ── Message list ──────────────────────────────────────────── -->
                <ScrollViewer x:ConnectionId='8' Grid.Row="3"
                              x:Name="MessageScroller"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,8,0,4">
                    <StackPanel Spacing="0">

                        <!-- Empty state hint -->
                        <Border x:ConnectionId='31'                                                                  
                                Margin="20,32,20,0">
                            <StackPanel Spacing="10" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE946;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="32"
                                          Foreground="#3F3F5A"
                                          HorizontalAlignment="Center" />
                                <TextBlock Text="Ask me anything about your system."
                                           FontSize="12"
                                           Foreground="#6B6B8A"
                                           TextAlignment="Center"
                                           TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Border>

                        <!-- Message bubbles -->
                        <ItemsRepeater x:ConnectionId='32' x:Name="MessageList"
                                                                                             
                                       Margin="8,0">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="4" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate                                        >
                                    <Grid x:ConnectionId='34' Margin="4,4,4,0">

                                        <!-- ── User message ── right-aligned blue bubble -->
                                        <Border x:ConnectionId='35'                                           
                                                Background="#1E2F52"
                                                CornerRadius="12,12,4,12"
                                                Padding="12,8"
                                                MaxWidth="280"
                                                HorizontalAlignment="Right">
                                            <StackPanel Spacing="4">
                                                <TextBlock x:ConnectionId='52'                     
                                                           FontSize="12.5"
                                                           Foreground="#E4E4F0"
                                                           TextWrapping="Wrap" />
                                                <TextBlock x:ConnectionId='53'                          
                                                           FontSize="10"
                                                           Foreground="#6B7280"
                                                           HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Border>

                                        <!-- ── System message ── left-aligned with icon + enrichment -->
                                        <Grid x:ConnectionId='36'                                             
                                              HorizontalAlignment="Left"
                                              MaxWidth="330">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Category icon -->
                                            <Border Grid.Column="0"
                                                    Width="24" Height="24"
                                                    CornerRadius="12"
                                                    Background="#23233A"
                                                    VerticalAlignment="Top"
                                                    Margin="0,2,8,0">
                                                <FontIcon x:ConnectionId='51'                               
                                                          FontFamily="Segoe MDL2 Assets"
                                                          FontSize="11"
                                                                                             
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                            </Border>

                                            <!-- Message content column -->
                                            <StackPanel Grid.Column="1" Spacing="6">

                                                <!-- Main message bubble -->
                                                <Border Background="#23233A"
                                                        CornerRadius="4,12,12,12"
                                                        Padding="12,8">
                                                    <StackPanel Spacing="5">
                                                        <TextBlock x:ConnectionId='46'                     
                                                                   FontSize="12.5"
                                                                   Foreground="#D4D4E8"
                                                                   TextWrapping="Wrap"
                                                                   LineHeight="18" />

                                                        <!-- Uncertainty note (italic, muted) -->
                                                        <TextBlock x:ConnectionId='47'                                            
                                                                                                  
                                                                   FontSize="10.5"
                                                                   FontStyle="Italic"
                                                                   Foreground="#5B6070"
                                                                   TextWrapping="Wrap" />

                                                        <!-- Footer row: timestamp + confidence chip -->
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock x:ConnectionId='48' Grid.Column="0"
                                                                                                
                                                                       FontSize="10"
                                                                       Foreground="#4B5563"
                                                                       VerticalAlignment="Center" />

                                                            <!-- Confidence chip -->
                                                            <Border x:ConnectionId='49' Grid.Column="1"
                                                                                                              
                                                                    Background="#1A2035"
                                                                    BorderBrush="#2A3A5C"
                                                                    BorderThickness="1"
                                                                    CornerRadius="8"
                                                                    Padding="6,2">
                                                                <TextBlock x:ConnectionId='50'                                  
                                                                           FontSize="9.5"
                                                                           Foreground="#4E7FBF" />
                                                            </Border>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Evidence badge (muted pill row) -->
                                                <ItemsRepeater x:ConnectionId='37'                                         
                                                                                                   >
                                                    <ItemsRepeater.Layout>
                                                        <StackLayout Orientation="Horizontal" Spacing="4" />
                                                    </ItemsRepeater.Layout>
                                                    <ItemsRepeater.ItemTemplate>
                                                        <DataTemplate                                                >
                                                            <Border x:ConnectionId='44' Background="#161628"
                                                                    BorderBrush="#2A2A3E"
                                                                    BorderThickness="1"
                                                                    CornerRadius="6"
                                                                    Padding="5,2">
                                                                <TextBlock x:ConnectionId='45'                       
                                                                           FontSize="9"
                                                                           Foreground="#3D4A60" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsRepeater.ItemTemplate>
                                                </ItemsRepeater>

                                                <!-- Suggested action chips -->
                                                <ItemsRepeater x:ConnectionId='38'                                                 
                                                                                                      
                                                               Margin="0,2,0,0">
                                                    <ItemsRepeater.Layout>
                                                        <StackLayout Orientation="Horizontal" Spacing="4" />
                                                    </ItemsRepeater.Layout>
                                                    <ItemsRepeater.ItemTemplate>
                                                        <DataTemplate                                       >
                                                            <Button x:ConnectionId='40' Background="#1A2233"
                                                                    BorderBrush="#2A4070"
                                                                    BorderThickness="1"
                                                                    CornerRadius="10"
                                                                    Padding="8,4"
                                                                    FontSize="11"
                                                                    Foreground="#7AABDF"
                                                                                  
                                                                                                 >
                                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                                    <FontIcon x:ConnectionId='41'                       
                                                                              FontFamily="Segoe MDL2 Assets"
                                                                              FontSize="10"
                                                                              Foreground="#4E9FFF" />
                                                                    <TextBlock x:ConnectionId='42'                       />
                                                                </StackPanel>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsRepeater.ItemTemplate>
                                                </ItemsRepeater>

                                            </StackPanel>
                                        </Grid>

                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <Border Height="8" />
                    </StackPanel>
                </ScrollViewer>

                <!-- ── Workflow Progress Panel (Phase 17F) ──────────────────────── -->
                <!--
                    Collapsed by default. Shown when AutonomousWorkflowEngine fires
                    WorkflowPlanned. Hidden again on WorkflowCompleted/Cancelled.
                    ReviewPanel sub-section shown only when HumanReviewGate raises
                    ReviewRequired — hides when Approve or Decline is tapped.
                -->
                <Border x:ConnectionId='9' Grid.Row="4"
                        x:Name="WorkflowPanel"
                        Visibility="Collapsed"
                        Background="#0E1320"
                        BorderBrush="#2A3A5C"
                        BorderThickness="0,1,0,0">
                    <StackPanel>

                        <!-- Header: workflow title + step fraction + cancel -->
                        <Grid Padding="12,10,10,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE768;"
                                              FontFamily="Segoe MDL2 Assets"
                                              FontSize="10"
                                              Foreground="#4E9FFF"
                                              VerticalAlignment="Center" />
                                    <TextBlock x:ConnectionId='30' x:Name="WorkflowTitleText"
                                               Text="Running workflow…"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Foreground="#C8D4E8"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock x:ConnectionId='29' x:Name="WorkflowProgressText"
                                           Text="Step 0 of 0"
                                           FontSize="10"
                                           Foreground="#4B5C7A" />
                            </StackPanel>

                            <Button x:ConnectionId='28' Grid.Column="1"
                                    x:Name="CancelWorkflowButton"
                                    Width="28" Height="28"
                                    CornerRadius="6"
                                    Background="#1A1425"
                                    BorderBrush="#3A2A4A"
                                    BorderThickness="1"
                                    Padding="0"
                                                                      
                                    ToolTipService.ToolTip="Cancel workflow">
                                <FontIcon Glyph="&#xE711;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="10"
                                          Foreground="#8B6A8A" />
                            </Button>
                        </Grid>

                        <!-- Progress track -->
                        <ProgressBar x:ConnectionId='22' x:Name="WorkflowProgressBar"
                                     Minimum="0" Maximum="100" Value="0"
                                     Foreground="#4E9FFF"
                                     Background="#1A2035"
                                     Height="2"
                                     Margin="12,0,12,6" />

                        <!-- Step narration -->
                        <TextBlock x:ConnectionId='23' x:Name="WorkflowNarrationText"
                                   FontSize="11"
                                   Foreground="#6B8AA8"
                                   FontStyle="Italic"
                                   TextWrapping="Wrap"
                                   Margin="12,2,12,10" />

                        <!-- Review sub-panel — shown for RequiresApproval steps -->
                        <Border x:ConnectionId='24' x:Name="WorkflowReviewPanel"
                                Visibility="Collapsed"
                                Background="#080F1C"
                                BorderBrush="#1E3050"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="10,0,10,10"
                                Padding="10,8">
                            <StackPanel Spacing="8">
                                <TextBlock x:ConnectionId='25' x:Name="ReviewNarrationText"
                                           FontSize="11"
                                           Foreground="#A0B4C8"
                                           TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8">

                                    <!-- Approve -->
                                    <Button x:ConnectionId='26' x:Name="ApproveButton"
                                            Background="#0F1E14"
                                            BorderBrush="#1E4028"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12,5"
                                            FontSize="11.5"
                                                                       >
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon Glyph="&#xE73E;"
                                                      FontFamily="Segoe MDL2 Assets"
                                                      FontSize="10"
                                                      Foreground="#5ABF80" />
                                            <TextBlock Text="Approve"
                                                       Foreground="#5ABF80" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Decline -->
                                    <Button x:ConnectionId='27' x:Name="DenyButton"
                                            Background="#1C0F16"
                                            BorderBrush="#3A1428"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12,5"
                                            FontSize="11.5"
                                                                    >
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon Glyph="&#xE711;"
                                                      FontFamily="Segoe MDL2 Assets"
                                                      FontSize="10"
                                                      Foreground="#BF5A7A" />
                                            <TextBlock Text="Decline"
                                                       Foreground="#BF5A7A" />
                                        </StackPanel>
                                    </Button>

                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Border>

                <!-- ── Visual Consent Panel (Phase 18B) ─────────────────────── -->
                <!--
                    Collapsed by default. Shown when ConsentBoundScreenAnalysis fires
                    ConsentRequired — the user must explicitly Allow or Deny before any
                    visual analysis proceeds.  Hides when Allow or Deny is tapped.

                    Privacy guarantees enforced at this layer:
                      • One-time snapshot only — no continuous capture
                      • Local only — no data leaves the device
                      • Auto-expires in 5 minutes — never persisted to disk
                -->
                <Border x:ConnectionId='10' Grid.Row="5"
                        x:Name="VisualConsentPanel"
                        Visibility="Collapsed"
                        Background="#080C14"
                        BorderBrush="#1A2A40"
                        BorderThickness="0,1,0,0">
                    <StackPanel Padding="12,8,12,10" Spacing="6">

                        <!-- Header row: camera icon + label -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE722;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="12"
                                      Foreground="#4E9FFF"
                                      VerticalAlignment="Center" />
                            <TextBlock Text="Visual Analysis Request"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="#C8D4E8"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Reason text set in code-behind -->
                        <TextBlock x:ConnectionId='19' x:Name="VisualConsentReasonText"
                                   FontSize="11"
                                   Foreground="#7A9CC0"
                                   TextWrapping="Wrap" />

                        <!-- Privacy notice -->
                        <TextBlock Text="One-time snapshot · Local only · Auto-expires in 5 min"
                                   FontSize="9.5"
                                   Foreground="#3A5068" />

                        <!-- Allow / Deny buttons -->
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">

                            <Button x:ConnectionId='20' x:Name="VisualAllowButton"
                                    Background="#0F1E14"
                                    BorderBrush="#1E4028"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,5"
                                    FontSize="11.5"
                                                                   >
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE722;"
                                              FontFamily="Segoe MDL2 Assets"
                                              FontSize="10"
                                              Foreground="#5ABF80" />
                                    <TextBlock Text="Allow Once"
                                               Foreground="#5ABF80" />
                                </StackPanel>
                            </Button>

                            <Button x:ConnectionId='21' x:Name="VisualDenyButton"
                                    Background="#1C0F16"
                                    BorderBrush="#3A1428"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,5"
                                    FontSize="11.5"
                                                                  >
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE711;"
                                              FontFamily="Segoe MDL2 Assets"
                                              FontSize="10"
                                              Foreground="#BF5A7A" />
                                    <TextBlock Text="Deny"
                                               Foreground="#BF5A7A" />
                                </StackPanel>
                            </Button>

                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── Quick actions row ─────────────────────────────────────── -->
                <Border Grid.Row="6"
                        Background="#16162A"
                        BorderBrush="#2A2A3E"
                        BorderThickness="0,1,0,0">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  Padding="10,8">
                        <ItemsRepeater x:ConnectionId='14' x:Name="QuickActionList"
                                                                                                 >
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="6" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate                                   >
                                    <Button x:ConnectionId='16' Background="#1E2233"
                                            BorderBrush="#3F3F5A"
                                            BorderThickness="1"
                                            CornerRadius="16"
                                            Padding="10,6"
                                            FontSize="11.5"
                                            Foreground="#B0B0C8"
                                                          
                                                                     >
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon x:ConnectionId='17'                       
                                                      FontFamily="Segoe MDL2 Assets"
                                                      FontSize="11"
                                                      Foreground="#6B9FFF" />
                                            <TextBlock x:ConnectionId='18'                       />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                </Border>

                <!-- ── Input area ────────────────────────────────────────────── -->
                <Border Grid.Row="7"
                        Background="#16162A"
                        BorderBrush="#2A2A3E"
                        BorderThickness="0,1,0,0"
                        Padding="10,8"
                        CornerRadius="0,0,14,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:ConnectionId='11' Grid.Column="0"
                                 x:Name="InputBox"
                                                                                 
                                 PlaceholderText="Ask about your system…"
                                 Background="#0D0D1A"
                                 BorderBrush="#3F3F5A"
                                 Foreground="#E4E4F0"
                                 FontSize="12.5"
                                 CornerRadius="10,4,4,10"
                                 Padding="12,8"
                                 MinHeight="36"
                                 AcceptsReturn="False"
                                 TextWrapping="NoWrap"
                                                            />

                        <!-- Send button (shown when not processing) -->
                        <Button x:ConnectionId='12' Grid.Column="1"
                                                                                                 
                                Width="36" Height="36"
                                CornerRadius="4,10,10,4"
                                Background="#4E9FFF"
                                BorderThickness="0"
                                Margin="4,0,0,0"
                                                        
                                ToolTipService.ToolTip="Send (Enter)">
                            <FontIcon Glyph="&#xE724;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="14"
                                      Foreground="White" />
                        </Button>

                        <!-- Spinner (shown while processing) -->
                        <Border x:ConnectionId='13' Grid.Column="1"
                                                                                              
                                Width="36" Height="36"
                                CornerRadius="4,10,10,4"
                                Background="#1A2035"
                                Margin="4,0,0,0">
                            <ProgressRing Width="18" Height="18"
                                          IsActive="True"
                                          Foreground="#4E9FFF" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

    </Grid>
</Window>

