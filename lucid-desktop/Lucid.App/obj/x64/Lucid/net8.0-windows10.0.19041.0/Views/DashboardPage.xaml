                 the user's preferences (≥ 3 recorded interactions).
            ══════════════════════════════════════════════════════════ -->
            <Border x:ConnectionId='72'                                                                                   
                    Background="#081A4E9F"
                    BorderBrush="#1A4E9F"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,10">
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE946;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="11"
                                  Foreground="#4E9FFF" />
