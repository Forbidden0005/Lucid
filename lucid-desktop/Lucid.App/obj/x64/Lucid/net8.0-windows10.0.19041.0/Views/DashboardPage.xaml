                 Hidden when no active insights have recommended actions.
            ══════════════════════════════════════════════════════════ -->
            <Grid x:ConnectionId='70'                                                                    
                  Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Smart Actions"
                           Style="{StaticResource SectionTitleStyle}" />
                <Border Grid.Column="1"
                        Background="{StaticResource StatusGoodSubtleBrush}"
