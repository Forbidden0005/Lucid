<Page x:ConnectionId='1'
    x:Class="Lucid.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Lucid.ViewModels"
    xmlns:intel="using:Lucid.Services.Intelligence"
    Background="{StaticResource AppBackgroundBrush}"
                        >

    <!--
        InsightCardTemplate — live DataTemplate bound to InsightCardViewModel.

        ⚠️  CompositeTransform must be declared inline (not in a Style) so that
        each card gets its own transform instance. See AppCards.xaml for details.

        IsExpanded / ExpandedVisibility / ExpandChevron all require Mode=OneWay
        so they react to the ToggleExpandedCommand without rebuilding the tree.

        ActionCardTemplate must be declared BEFORE InsightCardTemplate so the
        StaticResource forward-reference inside InsightCardTemplate resolves.
    -->
    <Page.Resources>

        <!--
            ActionCardTemplate — immutable display card for a SystemAction.
            ActionCardViewModel has no INotifyPropertyChanged — all bindings
            use the default OneTime mode.
        -->
        <DataTemplate x:Key="ActionCardTemplate"
                                                         >
            <Border x:ConnectionId='32' Background="#0AFFFFFF"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,12">
                <StackPanel Spacing="10">

                    <!-- ── Header: icon · title / description · risk badge ── -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Impact-coloured icon -->
                        <Border x:ConnectionId='63' Width="32" Height="32"
                                CornerRadius="8"
                                                                      
                                VerticalAlignment="Top">
                            <FontIcon x:ConnectionId='68' Glyph="&#xE8BD;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="13"
                                                                       
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>

                        <!-- Title + description -->
                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="3">
                            <TextBlock x:ConnectionId='66'                      
                                       FontFamily="Segoe UI Variable"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock x:ConnectionId='67'                            
                                       Style="{StaticResource CaptionTextStyle}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Risk badge -->
                        <Border x:ConnectionId='64' Grid.Column="2"
                                                                    
                                CornerRadius="6"
                                Padding="8,4"
                                VerticalAlignment="Top">
                            <TextBlock x:ConnectionId='65'                          
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                                                       />
                        </Border>
                    </Grid>

                    <!-- ── Chips: impact · effort · reversible ──────────── -->
                    <StackPanel Orientation="Horizontal"
                                Spacing="6"
                                Margin="44,0,0,0">

                        <!-- Impact chip -->
                        <Border x:ConnectionId='59'                                       
                                CornerRadius="4"
                                Padding="8,3">
                            <TextBlock x:ConnectionId='62'                            
                                       FontSize="11"
                                                                         />
                        </Border>

                        <!-- Effort chip -->
                        <Border Background="#0AFFFFFF"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,3">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE823;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="10"
                                          Foreground="{StaticResource TextSecondaryBrush}"
                                          VerticalAlignment="Center" />
                                <TextBlock x:ConnectionId='61'                           
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Reversible chip — hidden when not reversible -->
                        <Border x:ConnectionId='60'                                           
                                Background="{StaticResource StatusGoodSubtleBrush}"
                                CornerRadius="4"
                                Padding="8,3">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE72C;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="10"
                                          Foreground="{StaticResource StatusGoodBrush}"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="Reversible"
                                           FontSize="11"
                                           Foreground="{StaticResource StatusGoodBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ── Static confirmation risk notice ───────────────────
                         Shown whenever RequiresConfirmation=true so the user
                         always sees the risk text before clicking Run.
                         This is the static note from SystemAction; the
                         interactive confirmation panel is handled by the
                         Execution sub-ViewModel below.
                    ──────────────────────────────────────────────────────── -->
                    <Border x:ConnectionId='33'                                             
                            Background="{StaticResource StatusModerateSubtleBrush}"
                            CornerRadius="6"
                            Padding="10,7"
                            Margin="44,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7BA;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="12"
                                      Foreground="{StaticResource StatusModerateBrush}"
                                      VerticalAlignment="Top"
                                      Margin="0,1,0,0" />
                            <TextBlock x:ConnectionId='58'                                    
                                       Style="{StaticResource CaptionTextStyle}"
                                       Foreground="{StaticResource StatusModerateBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- ══════════════════════════════════════════════════════
                         EXECUTION PANEL
                         All states driven by Execution (ActionExecutionViewModel).
                         Only one state-section is visible at a time.
                    ══════════════════════════════════════════════════════ -->

                    <!-- Thin separator between static info and interactive UI -->
                    <Border Height="1"
                            Background="{StaticResource BorderSubtleBrush}"
                            Margin="44,2,0,2" />

                    <!-- ── IDLE: Run + Preview buttons ──────────────────────
                         Visible when State=Idle and an executor is registered.
                    ──────────────────────────────────────────────────────── -->
                    <StackPanel x:ConnectionId='34'                                                                    
                                Orientation="Horizontal"
                                Spacing="8"
                                Margin="44,0,0,0">

                        <!-- Preview (dry-run) -->
                        <Button x:ConnectionId='56'                                           
                                CornerRadius="5"
                                Padding="10,5">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE946;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="11"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="Preview"
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Run -->
                        <Button x:ConnectionId='57'                                        
                                Background="{StaticResource StatusInfoTintBrush}"
                                CornerRadius="5"
                                Padding="10,5">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE768;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="11"
                                          Foreground="{StaticResource StatusInfoBrush}"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="Run"
                                           FontSize="12"
                                           Foreground="{StaticResource StatusInfoBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- ── IDLE: Coming soon chip ───────────────────────────
                         Visible when no executor is registered for this action.
                    ──────────────────────────────────────────────────────── -->
                    <Border x:ConnectionId='35'                                                         
                            Background="#08FFFFFF"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="9,4"
                            Margin="44,0,0,0"
                            HorizontalAlignment="Left">
                        <TextBlock Text="Coming soon"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </Border>

                    <!-- ── CONFIRMATION PENDING ─────────────────────────────
                         Visible when the user clicked Run on a risky action.
                         Shows the risk description and Confirm / Cancel buttons.
                    ──────────────────────────────────────────────────────── -->
                    <Border x:ConnectionId='36'                                                                    
                            Background="{StaticResource StatusModerateSubtleBrush}"
                            CornerRadius="8"
                            Padding="12,10"
                            Margin="44,0,0,0">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7BA;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="13"
                                          Foreground="{StaticResource StatusModerateBrush}"
                                          VerticalAlignment="Top"
                                          Margin="0,2,0,0" />
                                <TextBlock x:ConnectionId='55'                                              
                                           Style="{StaticResource CaptionTextStyle}"
                                           Foreground="{StaticResource StatusModerateBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:ConnectionId='53'                                            
                                        CornerRadius="5"
                                        Padding="12,5">
                                    <TextBlock Text="Confirm"
                                               FontSize="12" />
                                </Button>
                                <Button x:ConnectionId='54'                                                       
                                        CornerRadius="5"
                                        Padding="12,5">
                                    <TextBlock Text="Cancel"
                                               FontSize="12" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ── RUNNING / DRY-RUNNING ────────────────────────────
                         Spinner + status label + Cancel link.
                    ──────────────────────────────────────────────────────── -->
                    <StackPanel x:ConnectionId='37'                                                                
                                Orientation="Horizontal"
                                Spacing="10"
                                Margin="44,0,0,0">
                        <ProgressRing x:ConnectionId='50'                                                     
                                      Width="16"
                                      Height="16" />
                        <TextBlock x:ConnectionId='51'                                                     
                                   Style="{StaticResource CaptionTextStyle}"
                                   VerticalAlignment="Center" />
                        <Button x:ConnectionId='52'                                                    
                                CornerRadius="4"
                                Padding="8,3"
                                VerticalAlignment="Center">
                            <TextBlock Text="Cancel"
                                       FontSize="11" />
                        </Button>
                    </StackPanel>

                    <!-- ── RESULT ───────────────────────────────────────────
                         State icon + outcome message.
                         Rollback button: visible only when executor captured
                         a rollback snapshot (CanRollback=true).
                         Run again: always visible to reset and retry.
                    ──────────────────────────────────────────────────────── -->
                    <StackPanel x:ConnectionId='38'                                                              
                                Spacing="6"
                                Margin="44,0,0,0">

                        <!-- Icon + message row -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon x:ConnectionId='48'                                                   
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="14"
                                                                                             
                                      VerticalAlignment="Center" />
                            <TextBlock x:ConnectionId='49'                                                     
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                                                                              
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Action links row -->
                        <StackPanel Orientation="Horizontal" Spacing="8">

                            <!-- Rollback — only when executor captured a snapshot -->
                            <Button x:ConnectionId='46'                                                                
                                                                                
                                    CornerRadius="5"
                                    Padding="10,4">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE72C;"
                                              FontFamily="Segoe MDL2 Assets"
                                              FontSize="11"
                                              VerticalAlignment="Center" />
                                    <TextBlock Text="Undo"
                                               FontSize="11"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Run again -->
                            <HyperlinkButton x:ConnectionId='47'                                                
                                             Content="Run again"
                                             FontSize="11"
                                             Padding="0"
                                             VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- ── LOG PANEL ────────────────────────────────────────
                         Live-updating execution log. Entries stream in as the
                         executor writes them. Visible whenever LogEntries has
                         at least one entry. Persists after execution.
                    ──────────────────────────────────────────────────────── -->
                    <Border x:ConnectionId='39'                                                           
                            Background="#07FFFFFF"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,8"
                            Margin="44,0,0,0">
                        <StackPanel Spacing="4">
                            <TextBlock Text="EXECUTION LOG"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       CharacterSpacing="100"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,4" />
                            <ItemsRepeater x:ConnectionId='40'                                                         >
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="3" Orientation="Vertical" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate                                        >
                                        <Grid x:ConnectionId='42' ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:ConnectionId='43'                          
                                                       FontSize="10"
                                                       FontFamily="Cascadia Code, Consolas, Courier New"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Top" />
                                            <TextBlock x:ConnectionId='44' Grid.Column="1"
                                                                                 
                                                       FontSize="10"
                                                       FontFamily="Cascadia Code, Consolas, Courier New"
                                                                                       
                                                       VerticalAlignment="Top" />
                                            <TextBlock x:ConnectionId='45' Grid.Column="2"
                                                                              
                                                       FontSize="11"
                                                                                       
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Top" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="InsightCardTemplate"
                                                          >
            <Border x:ConnectionId='3' Style="{StaticResource CardSurface}"
                    Padding="20"
                    Margin="0,0,0,0"
                                                        
                                                      >
                <Border.RenderTransform>
                    <CompositeTransform />
                </Border.RenderTransform>
                <StackPanel Spacing="10">

                    <!-- ── Always-visible header row ────────────────────── -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Icon container -->
                        <Border x:ConnectionId='20' Width="40" Height="40"
                                CornerRadius="10"
                                                                                          
                                VerticalAlignment="Top">
                            <FontIcon x:ConnectionId='30'                                        
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="16"
                                                                                    
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>

                        <!-- Title + one-line preview + confidence/timestamp -->
                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="4">
                            <TextBlock x:ConnectionId='26'                                   
                                       Style="{StaticResource CardTitleStyle}" />
                            <TextBlock x:ConnectionId='27'                                           
                                       Style="{StaticResource CaptionTextStyle}"
                                       TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal"
                                        Spacing="6"
                                        Margin="0,2,0,0">
                                <TextBlock x:ConnectionId='28'                                            
                                           FontSize="11"
                                                                                          />
                                <TextBlock Text="confidence  ·"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock x:ConnectionId='29'                                          
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Severity badge + correlation tag + expand toggle -->
                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Top"
                                    HorizontalAlignment="Right"
                                    Spacing="6">
                            <Border x:ConnectionId='21'                                                   
                                    CornerRadius="6"
                                    Padding="10,5">
                                <TextBlock x:ConnectionId='25'                                           
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                                                                          />
                            </Border>

                            <!-- Correlated tag — only visible for synthesis insights -->
                            <Border x:ConnectionId='22'                                                           
                                    Background="#0AFFFFFF"
                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,5"
                                    HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE71B;"
                                              FontFamily="Segoe MDL2 Assets"
                                              FontSize="10"
                                              Foreground="{StaticResource TextSecondaryBrush}"
                                              VerticalAlignment="Center" />
                                    <TextBlock Text="Correlated"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>

                            <Button x:ConnectionId='23'                                         
                                    HorizontalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="4,2"
                                    CornerRadius="4">
                                <FontIcon x:ConnectionId='24'                                            
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="11"
                                          Foreground="{StaticResource TextSecondaryBrush}" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- ── Expandable detail panel ───────────────────────── -->
                    <StackPanel x:ConnectionId='4'                                                      
                                Spacing="12">

                        <Border Height="1"
                                Background="{StaticResource BorderSubtleBrush}" />

                        <!-- Full detail paragraph -->
                        <TextBlock x:ConnectionId='5'                                    
                                   Style="{StaticResource BodyTextStyle}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />

                        <!-- ── Process attribution section ──────────────────────
                             Shown when the rule identified top CPU/RAM/GPU
                             consumers. Empty when no process crosses the threshold
                             or when the process sampler has not yet warmed up.
                             GPU attributions show "Detected" (heuristic, ~55 %
                             confidence); CPU/RAM show measured values (~90 %).
                        ──────────────────────────────────────────────────────── -->
                        <Border x:ConnectionId='6'                                                          
                                Background="#07FFFFFF"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,10">
                            <StackPanel Spacing="8">
                                <TextBlock Text="ATTRIBUTED PROCESSES"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           CharacterSpacing="100"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <ItemsRepeater x:ConnectionId='14'                                                        >
                                    <ItemsRepeater.Layout>
                                        <StackLayout Spacing="6" Orientation="Vertical" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate                                      >
                                            <Grid x:ConnectionId='16' ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Process name -->
                                                <TextBlock x:ConnectionId='17'                            
                                                           FontFamily="Segoe UI Variable"
                                                           FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />

                                                <!-- Usage value (e.g. "82%", "8.1 GB", "Detected") -->
                                                <TextBlock x:ConnectionId='18' Grid.Column="1"
                                                                                    
                                                           FontFamily="Segoe UI Variable"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                           VerticalAlignment="Center" />

                                                <!-- Kind badge: CPU / RAM / GPU -->
                                                <Border Grid.Column="2"
                                                        Background="#0AFFFFFF"
                                                        BorderBrush="{StaticResource BorderSubtleBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="7,2"
                                                        VerticalAlignment="Center">
                                                    <TextBlock x:ConnectionId='19'                          
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </Border>

                        <!-- Action hint chip (only when ActionHint is non-null) -->
                        <Border x:ConnectionId='7'                                           
                                                                          
                                CornerRadius="6"
                                Padding="12,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon x:ConnectionId='12' Glyph="&#xE946;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="12"
                                                                           
                                          VerticalAlignment="Center" />
                                <TextBlock x:ConnectionId='13'                           
                                           Style="{StaticResource CaptionTextStyle}"
                                                                            
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Confidence bar -->
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Confidence"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock x:ConnectionId='11'                                            
                                           FontSize="11"
                                                                                          />
                            </StackPanel>
                            <ProgressBar x:ConnectionId='10'                                                
                                         Maximum="100"
                                         Style="{StaticResource ConfidenceBar}"
                                                                                        />
                        </StackPanel>

                        <!-- Recommended actions (hidden when the rule provides none) -->
                        <StackPanel x:ConnectionId='8'                                                     
                                    Spacing="8">
                            <Border Height="1"
                                    Background="{StaticResource BorderSubtleBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8BD;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="11"
                                          Foreground="{StaticResource TextSecondaryBrush}"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="Recommended Actions"
                                           FontFamily="Segoe UI Variable"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <ItemsRepeater x:ConnectionId='9'                                            
                                           ItemTemplate="{StaticResource ActionCardTemplate}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="6" Orientation="Vertical" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                        </StackPanel>

                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <!--
        DashboardPage.xaml — System overview with health score, live metrics,
        trends, quick actions, and active insights.

        All card styles, badge styles, progress bar styles, and button styles
        are sourced from the shared design system (AppCards/AppBadges/
        AppProgress/AppButtons.xaml merged in App.xaml).

        Data: x:Bind connects all dynamic text and numeric values to
        DashboardViewModel (exposed as ViewModel on the code-behind class).
        Mode=OneWay ensures the UI reacts to future property changes when
        live telemetry is wired up in Phase 2.

        Animations: AnimationHelper drives progress bar entrance on load.
        Hover effects: AnimationHelper scale + border brighten on pointer enter/exit.

        NOTE: Each animated Border has its own inline CompositeTransform.
        See AppCards.xaml for an explanation of why this is required.
    -->

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32,32,32,48" Spacing="28">

            <!-- ══════════════════════════════════════════════════════════
                 PAGE HEADER
            ══════════════════════════════════════════════════════════ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock Text="Dashboard"
                               Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Your system at a glance"
                               Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>

                <!-- System status pill -->
                <Border Grid.Column="1"
                        Background="{StaticResource StatusGoodSubtleBrush}"
                        CornerRadius="12" Padding="12,6"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="8" Height="8"
                                 Fill="{StaticResource StatusGoodBrush}" />
                        <TextBlock x:ConnectionId='186'                                                        
                                   Style="{StaticResource CaptionTextStyle}"
                                   Foreground="{StaticResource StatusGoodBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════
                 COMPANION SHORTCUT — opens the floating operational companion
            ══════════════════════════════════════════════════════════ -->
            <Border Background="#16182A"
                    BorderBrush="#2A2A3E"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="28" Height="28"
                            CornerRadius="8"
                            Background="#1E2F52"
                            VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE946;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="14"
                                  Foreground="#4E9FFF"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="Operational Companion"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#C8C8D8" />
                        <TextBlock Text="Ask questions about your system in a floating overlay"
                                   FontSize="11"
                                   Foreground="#6B6B8A" />
                    </StackPanel>

                    <Button x:ConnectionId='185' Grid.Column="2"
