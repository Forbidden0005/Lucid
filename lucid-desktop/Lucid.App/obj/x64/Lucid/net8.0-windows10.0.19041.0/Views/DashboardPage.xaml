                                                   FontWeight="SemiBold"
                                                                                       />
                                    </Border>
                                    <TextBlock x:ConnectionId='128'                                
                                               FontSize="10"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <!-- ══════════════════════════════════════════════════════════
                 ANOMALY SUMMARY
                 Short-term behavioral anomalies vs machine baseline.
                 Hidden when telemetry is within learned norms.
            ══════════════════════════════════════════════════════════ -->
            <Grid x:ConnectionId='75'                                                                 
                  Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Behavioral Anomalies"
                           Style="{StaticResource SectionTitleStyle}" />
                <Border Grid.Column="1"
                        Background="#1AFBBF24"
                        CornerRadius="10" Padding="8,3"
                        VerticalAlignment="Center">
                    <TextBlock x:ConnectionId='123'                                                        
                               FontSize="11"
                               Foreground="#FBBF24" />
                </Border>
            </Grid>

            <ItemsRepeater x:ConnectionId='76'                                                                 
                                                                                        >
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="8" Orientation="Vertical" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate                                   >
                        <Border x:ConnectionId='113' Background="#0AFFFFFF"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="16,12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Metric icon -->
                                <Border x:ConnectionId='114' Width="34" Height="34"
                                        CornerRadius="8"
                                                                                
                                        VerticalAlignment="Center">
                                    <FontIcon x:ConnectionId='122'                             
                                              FontFamily="Segoe MDL2 Assets"
                                              FontSize="14"
                                                                                 
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </Border>

                                <!-- Description + expected range -->
                                <StackPanel Grid.Column="1"
                                            Spacing="2"
                                            VerticalAlignment="Center">
                                    <TextBlock x:ConnectionId='118'                       
                                               FontFamily="Segoe UI Variable"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <TextBlock x:ConnectionId='119'                            
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               MaxLines="2" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock x:ConnectionId='120'                                  
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="&#x2192;"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock x:ConnectionId='121'                                 
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                                                       />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Divergence + time -->
                                <StackPanel Grid.Column="2"
                                            Spacing="4"
                                            VerticalAlignment="Center">
                                    <Border x:ConnectionId='115' CornerRadius="6"
                                            Padding="8,3"
                                                                                    >
                                        <TextBlock x:ConnectionId='117'                              
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                                                       />
                                    </Border>
                                    <TextBlock x:ConnectionId='116'                                
                                               FontSize="10"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <!-- ══════════════════════════════════════════════════════════
                 DRIFT TRENDS
                 Long-term operational drift from the Watchtower layer.
                 Hidden when no significant drift is detected.
            ══════════════════════════════════════════════════════════ -->
            <Grid x:ConnectionId='77'                                                              
                  Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Drift Trends"
                           Style="{StaticResource SectionTitleStyle}" />
                <Border Grid.Column="1"
                        Background="#1A60A5FA"
                        CornerRadius="10" Padding="8,3"
                        VerticalAlignment="Center">
                    <TextBlock x:ConnectionId='111'                                                      
                               FontSize="11"
                               Foreground="#60A5FA" />
                </Border>
            </Grid>

            <ItemsRepeater x:ConnectionId='78'                                                              
                                                                                     >
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="8" Orientation="Vertical" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate                                 >
                        <Border x:ConnectionId='105' Background="#0AFFFFFF"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14,10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Metric glyph -->
                                <Border Width="32" Height="32"
                                        CornerRadius="8"
                                        Background="#0AFFFFFF"
                                        VerticalAlignment="Center">
                                    <FontIcon x:ConnectionId='110'                             
                                              FontFamily="Segoe MDL2 Assets"
                                              FontSize="13"
                                                                                  
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </Border>

                                <!-- Metric name + summary -->
                                <StackPanel Grid.Column="1"
                                            Spacing="2"
                                            VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock x:ConnectionId='108'                           
                                                   FontFamily="Segoe UI Variable"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <TextBlock x:ConnectionId='109'                               
                                                   FontSize="13"
                                                                                       
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock x:ConnectionId='107'                                   
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>

                                <!-- Change label -->
                                <Border Grid.Column="2"
                                        CornerRadius="6"
                                        Padding="8,4"
                                        Background="#0AFFFFFF"
                                        VerticalAlignment="Center">
                                    <TextBlock x:ConnectionId='106'                            
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                                                                    />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <!-- ══════════════════════════════════════════════════════════
                 MACHINE PERSONALITY
                 Deterministic operational character classification.
                 Hidden until sufficient historical data is available.
            ══════════════════════════════════════════════════════════ -->
            <TextBlock x:ConnectionId='79' Text="Machine Personality"
                       Style="{StaticResource SectionTitleStyle}"
                       Margin="0,4,0,0"
                                                                                          />

            <Border x:ConnectionId='80'                                                                   
                    Background="#0AFFFFFF"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20,16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Personality icon -->
                    <Border x:ConnectionId='98' Width="44" Height="44"
                            CornerRadius="10"
                                                                                                
                            VerticalAlignment="Center">
                        <FontIcon x:ConnectionId='103'                                                         
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="18"
                                                                                                     
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                    </Border>

                    <!-- Personality details -->
                    <StackPanel Grid.Column="1"
                                Spacing="4"
                                VerticalAlignment="Center">
                        <TextBlock x:ConnectionId='101'                                                        
                                   FontFamily="Segoe UI Variable"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                                                                                       />
                        <TextBlock x:ConnectionId='102'                                                              
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Confidence badge -->
                    <Border x:ConnectionId='99' Grid.Column="2"
                            CornerRadius="8"
                            Padding="10,6"
                                                                                                
                            VerticalAlignment="Center">
                        <TextBlock x:ConnectionId='100'                                                             
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                                                                                       />
                    </Border>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════
                 OPERATIONAL STYLE
                 Derived from recorded interaction history.
                 Hidden until ≥ 3 interventions recorded.
            ══════════════════════════════════════════════════════════ -->
            <TextBlock x:ConnectionId='81' Text="Your Operational Style"
                       Style="{StaticResource SectionTitleStyle}"
                       Margin="0,4,0,0"
                                                                                               />

            <Border x:ConnectionId='82'                                                                        
                    Background="#0AFFFFFF"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20,16">
                <StackPanel Spacing="10">

                    <!-- Style header: icon + label + sample count -->
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Style icon -->
                        <Border Width="40" Height="40"
                                CornerRadius="10"
                                Background="#0AFFFFFF"
                                VerticalAlignment="Center">
                            <FontIcon x:ConnectionId='97'                                                              
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="17"
                                                                                                        
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>

                        <!-- Style label + description -->
                        <StackPanel Grid.Column="1"
                                    Spacing="3"
                                    VerticalAlignment="Center">
                            <TextBlock x:ConnectionId='95'                                                             
                                       FontFamily="Segoe UI Variable"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                                                                                          />
                            <TextBlock x:ConnectionId='96'                                                                   
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Sample count badge -->
                        <Border Grid.Column="2"
                                CornerRadius="8"
                                Padding="8,4"
                                Background="#0AFFFFFF"
                                VerticalAlignment="Center">
                            <TextBlock x:ConnectionId='94'                                                                   
                                       FontSize="10"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </Border>
                    </Grid>

                    <!-- Personal insight sentence -->
                    <Border Background="#08FFFFFF"
                            CornerRadius="8"
                            Padding="12,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon x:ConnectionId='92' Glyph="&#xE82D;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="12"
                                                                                                        
                                      VerticalAlignment="Top"
                                      Margin="0,1,0,0" />
                            <TextBlock x:ConnectionId='93'                                                               
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════════════════════
                 ACTIVE INSIGHTS
            ══════════════════════════════════════════════════════════ -->
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Active Insights"
                           Style="{StaticResource SectionTitleStyle}" />
                <Border Grid.Column="1"
                        Background="{StaticResource StatusInfoSubtleBrush}"
                        CornerRadius="10" Padding="8,3">
                    <TextBlock x:ConnectionId='91'                                                        
                               FontSize="11"
                               Foreground="{StaticResource StatusInfoBrush}" />
                </Border>
            </Grid>

            <!--
                Live grouped insight cards, sorted Warnings → Recommendations → Informational.
                Each InsightGroupViewModel contains sorted InsightCardViewModels.
                Only non-empty groups are present in InsightGroups.
            -->
            <ItemsRepeater x:ConnectionId='83'                                                            >
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="20" Orientation="Vertical" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate                                      >
                        <StackPanel x:ConnectionId='85' Spacing="8">

                            <!-- Group header: coloured icon + title + count badge -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon x:ConnectionId='87'                           
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="13"
                                                                                
                                          VerticalAlignment="Center" />
                                <TextBlock x:ConnectionId='88'                           
                                           FontFamily="Segoe UI Variable"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                                                                 
                                           VerticalAlignment="Center" />
                                <Border x:ConnectionId='89'                                     
                                        CornerRadius="8"
                                        Padding="7,2"
                                        VerticalAlignment="Center">
                                    <TextBlock x:ConnectionId='90'                          
                                               FontSize="11"
                                                                                      />
                                </Border>
                            </StackPanel>

                            <!-- Cards in this severity group -->
                            <ItemsRepeater x:ConnectionId='86'                             
                                           ItemTemplate="{StaticResource InsightCardTemplate}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="8" Orientation="Vertical" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>

                        </StackPanel>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

        </StackPanel>
    </ScrollViewer>
</Page>

