                                                                                       >
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="8" Orientation="Vertical" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate                                >
                        <Border x:ConnectionId='125' Background="#0AFFFFFF"
