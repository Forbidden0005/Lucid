<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ════════════════════════════════════════════════════════════════
        Lucid Typography
        Font: Segoe UI Variable (ships with Windows 11)
              Segoe UI Variable Display for headings
        Sizes: docs/ui-guidelines.md — 28-36px headers, 18-24px sections,
               14-16px body, 12-13px caption
        ════════════════════════════════════════════════════════════════
    -->

    <!-- Page title — 32 px, SemiBold -->
    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily"  Value="Segoe UI Variable Display" />
        <Setter Property="FontSize"    Value="32" />
        <Setter Property="FontWeight"  Value="SemiBold" />
        <Setter Property="Foreground"  Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="LineHeight"  Value="40" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!-- Page subtitle / description — 14 px, secondary color -->
    <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily"  Value="Segoe UI Variable" />
        <Setter Property="FontSize"    Value="14" />
        <Setter Property="FontWeight"  Value="Normal" />
        <Setter Property="Foreground"  Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Margin"      Value="0,4,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Section heading inside a page — 20 px, SemiBold -->
    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily"  Value="Segoe UI Variable" />
        <Setter Property="FontSize"    Value="20" />
        <Setter Property="FontWeight"  Value="SemiBold" />
        <Setter Property="Foreground"  Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!-- Card heading — 16 px, SemiBold -->
    <Style x:Key="CardTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily"  Value="Segoe UI Variable" />
        <Setter Property="FontSize"    Value="16" />
        <Setter Property="FontWeight"  Value="SemiBold" />
        <Setter Property="Foreground"  Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!-- Standard body copy — 14 px, Normal -->
    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily"   Value="Segoe UI Variable" />
        <Setter Property="FontSize"     Value="14" />
        <Setter Property="FontWeight"   Value="Normal" />
        <Setter Property="Foreground"   Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight"   Value="22" />
    </Style>

    <!-- Muted / helper text — 12 px, secondary color -->
    <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily"   Value="Segoe UI Variable" />
        <Setter Property="FontSize"     Value="12" />
        <Setter Property="FontWeight"   Value="Normal" />
        <Setter Property="Foreground"   Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Large metric display number — 36 px, Bold -->
    <Style x:Key="MetricLargeStyle" TargetType="TextBlock">
        <Setter Property="FontFamily"  Value="Segoe UI Variable Display" />
        <Setter Property="FontSize"    Value="36" />
        <Setter Property="FontWeight"  Value="Bold" />
        <Setter Property="Foreground"  Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!-- Medium metric display number — 24 px, SemiBold -->
    <Style x:Key="MetricMediumStyle" TargetType="TextBlock">
        <Setter Property="FontFamily"  Value="Segoe UI Variable Display" />
        <Setter Property="FontSize"    Value="24" />
        <Setter Property="FontWeight"  Value="SemiBold" />
        <Setter Property="Foreground"  Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!-- App name in the sidebar pane header — 15 px, SemiBold -->
    <Style x:Key="AppNameStyle" TargetType="TextBlock">
        <Setter Property="FontFamily"  Value="Segoe UI Variable Display" />
        <Setter Property="FontSize"    Value="15" />
        <Setter Property="FontWeight"  Value="SemiBold" />
        <Setter Property="Foreground"  Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!-- Explain My PC conversational output text — 15 px, relaxed line height -->
    <Style x:Key="DiagnosticBodyStyle" TargetType="TextBlock">
        <Setter Property="FontFamily"   Value="Segoe UI Variable" />
        <Setter Property="FontSize"     Value="15" />
        <Setter Property="FontWeight"   Value="Normal" />
        <Setter Property="Foreground"   Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight"   Value="24" />
    </Style>

    <!--
        ════════════════════════════════════════════════════════════════
        Convenience aliases
        Short-form style keys used across page XAML.
        ════════════════════════════════════════════════════════════════
    -->

    <!-- Section heading alias (matches SectionTitleStyle) -->
    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontFamily"  Value="Segoe UI Variable" />
        <Setter Property="FontSize"    Value="18" />
        <Setter Property="FontWeight"  Value="SemiBold" />
        <Setter Property="Foreground"  Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!-- Metric label alias — 14 px SemiBold -->
    <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily"  Value="Segoe UI Variable" />
        <Setter Property="FontSize"    Value="14" />
        <Setter Property="FontWeight"  Value="SemiBold" />
        <Setter Property="Foreground"  Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!-- Secondary body — 13 px, muted foreground -->
    <Style x:Key="SecondaryBodyStyle" TargetType="TextBlock">
        <Setter Property="FontFamily"   Value="Segoe UI Variable" />
        <Setter Property="FontSize"     Value="13" />
        <Setter Property="FontWeight"   Value="Normal" />
        <Setter Property="Foreground"   Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight"   Value="20" />
    </Style>

</ResourceDictionary>

