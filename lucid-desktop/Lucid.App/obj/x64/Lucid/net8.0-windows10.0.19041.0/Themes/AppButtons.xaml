<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ════════════════════════════════════════════════════════════════
        Lucid Button Styles

        ActionButton  — tile-style button with icon above label
                        (used in the Dashboard quick-actions row)
        PrimaryButton — high-emphasis action (accent blue fill)
        SecondaryButton — medium-emphasis action (surface + border)

        Note: WinUI 3 button hover/pressed states are driven by the
        control template. These styles set normal-state properties;
        visual states still use WinUI's built-in theme.
        ════════════════════════════════════════════════════════════════
    -->

    <!--
        ActionButton — full-width tile, icon centred above short label.
        Content should be a StackPanel with FontIcon + TextBlock.
    -->
    <Style x:Key="ActionButton" TargetType="Button">
        <Setter Property="HorizontalAlignment"        Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Padding"                    Value="16,14" />
        <Setter Property="CornerRadius"               Value="8" />
        <Setter Property="Background"                 Value="{StaticResource AppSurfaceBrush}" />
        <Setter Property="BorderBrush"                Value="{StaticResource BorderSubtleBrush}" />
    </Style>

    <!-- PrimaryButton — strong call-to-action, accent fill -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="CornerRadius"    Value="8" />
        <Setter Property="Background"      Value="{StaticResource AccentBlueBrush}" />
        <Setter Property="Foreground"      Value="#FFFFFFFF" />
        <Setter Property="Padding"         Value="16,8" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- SecondaryButton — outlined surface button -->
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background"   Value="{StaticResource AppSurfaceBrush}" />
        <Setter Property="BorderBrush"  Value="{StaticResource BorderDefaultBrush}" />
        <Setter Property="Padding"      Value="16,8" />
    </Style>

</ResourceDictionary>

