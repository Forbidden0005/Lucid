<UserControl
    x:Class="Lucid.Controls.TelemetryGraph"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinHeight="48"
    MinWidth="80">

    <!--
        The Canvas hosts two children added entirely in code-behind:
          1. _fillPath  — the gradient fill polygon beneath the line
          2. _graphLine — the stroke line on top

        Using a Canvas (not a Grid) lets us position points with pixel precision
        and avoids any layout interference with the surrounding card content.
    -->
    <Canvas x:Name="RootCanvas" SizeChanged="RootCanvas_SizeChanged" />

</UserControl>
