<UserControl
    x:Class="Lucid.Controls.CompanionAvatar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="132" Height="132"
    IsHitTestVisible="False">

    <!--
        CompanionAvatar — the presence Lucid speaks through.

        Four stacked layers:
          1. Halo   — soft radial bloom, carries most of the "alive" feeling
          2. Ring   — thin dashed orbit, rotates only while Lucid is working
          3. Core   — the body of the blob
          4. Sheen  — off-centre highlight that keeps the core from reading flat

        The artwork is authored once at 132x132 inside a Viewbox, so the same
        markup renders correctly at 44px in a page header and at 148px in the
        empty state — margins, stroke widths and the sheen all scale together
        instead of needing per-size tuning.

        Motion is driven entirely by VisualStateManager (see the State property in
        the code-behind). Every animation targets Opacity or a transform, both of
        which run on the composition thread — the avatar keeps breathing smoothly
        while the UI thread is busy rendering a streaming answer.

        Deliberately IsHitTestVisible="False": this is presence, not a button.
    -->

    <Grid x:Name="StateRoot">

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ActivityStates">

                <!--
                    Idle — slow breathing. Long enough that it reads as calm rather
                    than as something waiting to be clicked.
                -->
                <VisualState x:Name="Idle">
                    <Storyboard>
                        <DoubleAnimation
                            Storyboard.TargetName="CoreTransform"
                            Storyboard.TargetProperty="ScaleX"
                            From="1.0" To="1.035" Duration="0:0:2.4"
                            AutoReverse="True" RepeatBehavior="Forever">
                            <DoubleAnimation.EasingFunction>
                                <SineEase EasingMode="EaseInOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation
                            Storyboard.TargetName="CoreTransform"
                            Storyboard.TargetProperty="ScaleY"
                            From="1.0" To="1.035" Duration="0:0:2.4"
                            AutoReverse="True" RepeatBehavior="Forever">
                            <DoubleAnimation.EasingFunction>
                                <SineEase EasingMode="EaseInOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation
                            Storyboard.TargetName="Halo"
                            Storyboard.TargetProperty="Opacity"
                            From="0.32" To="0.52" Duration="0:0:2.4"
                            AutoReverse="True" RepeatBehavior="Forever">
                            <DoubleAnimation.EasingFunction>
                                <SineEase EasingMode="EaseInOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation
                            Storyboard.TargetName="Ring"
                            Storyboard.TargetProperty="Opacity"
                            To="0.28" Duration="0:0:0.4" />
                    </Storyboard>
                </VisualState>

                <!--
                    Thinking — quicker pulse plus a rotating orbit ring. The ring is
                    the honest signal: it turns only while work is actually in
                    flight, so motion always means something is happening.
                -->
                <VisualState x:Name="Thinking">
                    <Storyboard>
                        <DoubleAnimation
                            Storyboard.TargetName="CoreTransform"
                            Storyboard.TargetProperty="ScaleX"
                            From="0.97" To="1.06" Duration="0:0:0.9"
                            AutoReverse="True" RepeatBehavior="Forever">
                            <DoubleAnimation.EasingFunction>
                                <SineEase EasingMode="EaseInOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation
                            Storyboard.TargetName="CoreTransform"
                            Storyboard.TargetProperty="ScaleY"
                            From="0.97" To="1.06" Duration="0:0:0.9"
                            AutoReverse="True" RepeatBehavior="Forever">
                            <DoubleAnimation.EasingFunction>
                                <SineEase EasingMode="EaseInOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation
                            Storyboard.TargetName="Halo"
                            Storyboard.TargetProperty="Opacity"
                            From="0.45" To="0.8" Duration="0:0:0.9"
                            AutoReverse="True" RepeatBehavior="Forever">
                            <DoubleAnimation.EasingFunction>
                                <SineEase EasingMode="EaseInOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation
                            Storyboard.TargetName="Ring"
                            Storyboard.TargetProperty="Opacity"
                            To="0.9" Duration="0:0:0.3" />
                        <DoubleAnimation
                            Storyboard.TargetName="RingTransform"
                            Storyboard.TargetProperty="Rotation"
                            From="0" To="360" Duration="0:0:5"
                            RepeatBehavior="Forever" />
                    </Storyboard>
                </VisualState>

            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Viewbox Stretch="Uniform">
            <Grid Width="132" Height="132">

                <!-- ── 1. Halo ──────────────────────────────────────────────── -->
                <Ellipse x:Name="Halo" Opacity="0.32">
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5"
                                             RadiusX="0.5" RadiusY="0.5">
                            <GradientStop Color="#5578C8FF" Offset="0.30" />
                            <GradientStop Color="#2A6C7BFF" Offset="0.62" />
                            <GradientStop Color="#00000000" Offset="1.0" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- ── 2. Orbit ring ────────────────────────────────────────── -->
                <Ellipse x:Name="Ring"
                         Margin="10"
                         Opacity="0.28"
                         Stroke="#4E9FFF"
                         StrokeThickness="1"
                         StrokeDashArray="1,5"
                         StrokeDashCap="Round"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <CompositeTransform x:Name="RingTransform" />
                    </Ellipse.RenderTransform>
                </Ellipse>

                <!-- ── 3. Core ──────────────────────────────────────────────── -->
                <Ellipse x:Name="Core"
                         Margin="22"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <CompositeTransform x:Name="CoreTransform" />
                    </Ellipse.RenderTransform>
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.42,0.36" GradientOrigin="0.38,0.30"
                                             RadiusX="0.75" RadiusY="0.75">
                            <GradientStop Color="#FF7FD8FF" Offset="0.0" />
                            <GradientStop Color="#FF4E9FFF" Offset="0.45" />
                            <GradientStop Color="#FF3556C8" Offset="0.80" />
                            <GradientStop Color="#FF23306B" Offset="1.0" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- ── 4. Sheen ─────────────────────────────────────────────── -->
                <Ellipse x:Name="Sheen"
                         Width="26" Height="18"
                         Margin="0,32,24,0"
                         Opacity="0.35"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Top">
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                            <GradientStop Color="#CCFFFFFF" Offset="0.0" />
                            <GradientStop Color="#00FFFFFF" Offset="1.0" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

            </Grid>
        </Viewbox>

    </Grid>
</UserControl>
